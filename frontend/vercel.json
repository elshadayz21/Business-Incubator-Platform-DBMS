{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://dxvalley-incubator-backend.onrender.com/api/:path*"
    },
    {
      "source": "/v1/:path*",
      "destination": "https://dxvalley-incubator-backend.onrender.com/v1/:path*"
    },
    {
      "source": "/brand/:path*",
      "destination": "https://dxvalley-incubator-backend.onrender.com/brand/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://dxvalley-incubator-backend.onrender.com/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}