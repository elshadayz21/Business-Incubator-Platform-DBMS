# Environment (copy to Website/.env for local dev)
SESSION_SECRET=change-me-to-a-long-random-string
NODE_ENV=development
PORT=3000

# Database — local OR use DATABASE_URL on Render
DB_USER=
DB_HOST=localhost
DB_PASS=
DB_NAME=
DB_PORT=5432
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Production URLs
BASE_URL=http://localhost:3000
# Comma-separated Vercel admin URL(s), e.g. https://your-admin.vercel.app
CORS_ORIGINS=

# Vercel admin UI only — point to Render backend
# VITE_API_URL=https://your-app.onrender.com

# Email (optional — password reset / mass email)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
