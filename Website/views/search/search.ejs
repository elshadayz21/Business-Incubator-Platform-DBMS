<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head.ejs') %>

<body class="bg-surface text-ink min-h-screen flex flex-col font-sans">
    <%- include('../partials/header.ejs') %>

    <main class="flex-1 pb-20">
        <!-- Hero Header -->
        <section class="relative overflow-hidden bg-gradient-to-br from-cyan via-cyan-mid to-cyan-deep text-white py-16 lg:py-20">
            <div class="pointer-events-none absolute -left-24 -top-20 h-[360px] w-[500px] rounded-[48%] border-[50px] border-white/10" aria-hidden="true"></div>
            <div class="pointer-events-none absolute -right-32 -bottom-32 h-[500px] w-[600px] rounded-[50%] border-[70px] border-white/10" aria-hidden="true"></div>
            
            <div class="relative mx-auto max-w-5xl px-6 lg:px-10 text-center">
                <p class="mb-4 inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[.24em] text-white/80">
                    <span class="h-2 w-2 rounded-full bg-orange" aria-hidden="true"></span>
                    Global Engine
                </p>
                <h1 class="text-4xl font-extrabold leading-tight tracking-[-.04em] sm:text-5xl lg:text-6xl">
                    Search the <span class="text-white/75">DxValley Ecosystem</span>
                </h1>
                <p class="mt-4 max-w-2xl mx-auto text-base text-white/85 sm:text-lg">
                    Discover projects, expert mentors, and upcoming workshops tailored for ambitious founders.
                </p>
            </div>
        </section>

        <!-- Search Box Container -->
        <div class="mx-auto max-w-5xl px-6 lg:px-10">
            <form action="/v1/search" method="GET" class="relative -mt-10 z-10 rounded-[24px] border border-line bg-white p-6 sm:p-8 shadow-xl shadow-cyan-deep/5">
                <div class="flex flex-col sm:flex-row gap-4 mb-6">
                    <div class="relative flex-1">
                        <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-muted text-base" aria-hidden="true"></i>
                        <input 
                            id="search-query-input"
                            type="text" 
                            name="q" 
                            placeholder="Type keywords (e.g. Tech, FinTech, UI/UX, AI)..." 
                            class="w-full rounded-xl border border-line bg-surface pl-11 pr-10 py-4 text-base font-semibold text-ink outline-none transition placeholder:text-slate-400 focus:border-cyan focus:ring-2 focus:ring-cyan/20 focus:bg-white"
                            required
                        />
                        <button 
                            type="button" 
                            id="clear-search-btn" 
                            aria-label="Clear search text"
                            class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 hover:text-cyan-dark transition cursor-pointer p-1 rounded-full hover:bg-cyan-soft focus:outline-none"
                            title="Clear search text"
                        >
                            <i class="fa-solid fa-circle-xmark text-lg"></i>
                        </button>
                    </div>
                    <button 
                        type="submit" 
                        class="inline-flex items-center justify-center gap-2 rounded-xl bg-orange px-8 py-4 text-sm font-extrabold uppercase tracking-wider text-white shadow-sm transition hover:bg-orange-dark focus:outline-none focus:ring-2 focus:ring-orange focus:ring-offset-2 shrink-0"
                    >
                        <i class="fa-solid fa-magnifying-glass text-xs" aria-hidden="true"></i>
                        Search
                    </button>
                </div>

                <!-- Entity Filter Pills -->
                <div class="border-t border-line pt-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <span class="text-xs font-bold uppercase tracking-[.16em] text-muted">Filter by entity:</span>
                    <div class="flex flex-wrap gap-3">
                        <label class="inline-flex items-center gap-2.5 rounded-full border border-line bg-surface px-4 py-2 text-xs font-bold text-ink cursor-pointer transition hover:border-cyan/40 hover:bg-cyan-soft <%= types.projects ? 'border-cyan bg-cyan-soft text-cyan-dark' : '' %>">
                            <input 
                                type="checkbox" 
                                name="type" 
                                value="projects" 
                                <%= types.projects ? 'checked' : '' %>
                                class="h-4 w-4 accent-cyan rounded text-cyan focus:ring-cyan"
                            />
                            <span>🚀 Projects</span>
                        </label>
                        <label class="inline-flex items-center gap-2.5 rounded-full border border-line bg-surface px-4 py-2 text-xs font-bold text-ink cursor-pointer transition hover:border-cyan/40 hover:bg-cyan-soft <%= types.mentors ? 'border-cyan bg-cyan-soft text-cyan-dark' : '' %>">
                            <input 
                                type="checkbox" 
                                name="type" 
                                value="mentors" 
                                <%= types.mentors ? 'checked' : '' %>
                                class="h-4 w-4 accent-cyan rounded text-cyan focus:ring-cyan"
                            />
                            <span>🧑‍🏫 Mentors</span>
                        </label>
                        <label class="inline-flex items-center gap-2.5 rounded-full border border-line bg-surface px-4 py-2 text-xs font-bold text-ink cursor-pointer transition hover:border-cyan/40 hover:bg-cyan-soft <%= types.workshops ? 'border-cyan bg-cyan-soft text-cyan-dark' : '' %>">
                            <input 
                                type="checkbox" 
                                name="type" 
                                value="workshops" 
                                <%= types.workshops ? 'checked' : '' %>
                                class="h-4 w-4 accent-cyan rounded text-cyan focus:ring-cyan"
                            />
                            <span>🎓 Workshops</span>
                        </label>
                    </div>
                </div>
            </form>

            <!-- Search Results Section -->
            <div class="mt-12">
                <% if (q.length > 0) { %>
                    <div class="mb-8 flex items-center justify-between border-b border-line pb-4">
                        <h2 class="text-xl font-extrabold tracking-tight text-ink sm:text-2xl">
                            Results for "<span class="text-cyan-dark"><%= q %></span>"
                        </h2>
                        <span class="rounded-full bg-cyan-soft px-3.5 py-1 text-xs font-bold text-cyan-dark">
                            <%= results.length %> <%= results.length === 1 ? 'match' : 'matches' %>
                        </span>
                    </div>

                    <% if (results.length > 0) { %>
                        <div class="grid gap-5">
                            <% results.forEach(item => { %>
                                <article class="group rounded-2xl border border-line bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md hover:border-cyan/40 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
                                    <div class="flex items-start gap-4 min-w-0 flex-1">
                                        <div class="grid h-12 w-12 shrink-0 place-items-center rounded-xl bg-cyan-soft text-2xl text-cyan-dark">
                                            <%= item.icon %>
                                        </div>
                                        <div class="min-w-0 flex-1">
                                            <div class="flex flex-wrap items-center gap-2 mb-2">
                                                <span class="rounded-full bg-cyan-dark px-2.5 py-0.5 text-[10px] font-extrabold uppercase tracking-wider text-white">
                                                    <%= item.typeName %>
                                                </span>
                                                <% if (item.badge) { %>
                                                    <span class="rounded-full border border-line bg-surface px-2.5 py-0.5 text-[10px] font-semibold text-muted">
                                                        <%= item.badge %>
                                                    </span>
                                                <% } %>
                                            </div>
                                            <h3 class="text-lg font-bold text-ink transition group-hover:text-cyan-dark truncate"><%= item.title %></h3>
                                            <% if (item.subtitle) { %>
                                                <p class="text-xs font-semibold text-cyan-dark uppercase tracking-wider mb-2"><%= item.subtitle %></p>
                                            <% } %>
                                            <p class="text-sm text-muted leading-relaxed line-clamp-2"><%= item.description %></p>
                                        </div>
                                    </div>
                                    <a 
                                        href="<%= item.link %>" 
                                        class="inline-flex shrink-0 items-center gap-2 rounded-lg border border-cyan bg-white px-5 py-2.5 text-xs font-bold text-cyan-dark transition hover:bg-cyan hover:text-white"
                                    >
                                        View details
                                        <i class="fa-solid fa-arrow-right text-[10px]" aria-hidden="true"></i>
                                    </a>
                                </article>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <div class="rounded-2xl border border-line bg-white p-12 text-center shadow-sm">
                            <div class="mx-auto grid h-16 w-16 place-items-center rounded-full bg-orange-soft text-2xl text-orange mb-4">
                                <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                            </div>
                            <h3 class="text-2xl font-extrabold text-cyan-dark">No results found</h3>
                            <p class="mt-2 text-sm text-muted max-w-md mx-auto">We couldn't find any matches for "<%= q %>". Try refining your search terms or enabling all entity filters.</p>
                        </div>
                    <% } %>
                <% } else { %>
                    <!-- Empty Search State -->
                    <div class="rounded-2xl border border-line bg-white p-12 text-center shadow-sm">
                        <div class="mx-auto grid h-16 w-16 place-items-center rounded-full bg-cyan-soft text-2xl text-cyan-dark mb-4">
                            <i class="fa-solid fa-lightbulb" aria-hidden="true"></i>
                        </div>
                        <h3 class="text-2xl font-extrabold text-cyan-dark">Enter a search query</h3>
                        <p class="mt-2 text-sm text-muted max-w-md mx-auto">Use the search bar above to look up projects, mentors, and workshops across the DxValley incubator platform.</p>
                    </div>
                <% } %>
            </div>
        </div>
    </main>

    <%- include('../partials/footer.ejs') %>

    <script>
      (() => {
        const input = document.getElementById('search-query-input');
        const clearBtn = document.getElementById('clear-search-btn');
        if (!input || !clearBtn) return;

        const updateClearBtnVisibility = () => {
          if (input.value.trim().length > 0) {
            clearBtn.classList.remove('hidden');
          } else {
            clearBtn.classList.add('hidden');
          }
        };

        updateClearBtnVisibility();

        input.addEventListener('input', updateClearBtnVisibility);

        clearBtn.addEventListener('click', () => {
          input.value = '';
          updateClearBtnVisibility();
          input.focus();
        });
      })();
    </script>
</body>
</html>
