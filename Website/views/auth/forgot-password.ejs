<!DOCTYPE html>
<html lang="en">
  <%- include('../partials/head') %>
  <body class="flex min-h-screen flex-col bg-white font-sans text-ink">
    <main class="flex flex-grow items-center justify-center px-6 py-16">
      <div class="w-full max-w-md">
        <h1 class="text-3xl font-extrabold tracking-[-.03em] text-ink text-center">Forgot your password?</h1>
        <p class="mt-2 text-sm text-muted text-center">Enter your email and we'll send you a reset link.</p>

        <% if (error) { %>
          <div class="mt-6 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700"><%= error %></div>
        <% } %>
        <% if (success) { %>
          <div class="mt-6 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700"><%= success %></div>
        <% } %>

        <form action="/v1/auth/forgot-password" method="POST" class="mt-8 space-y-5">
          <div>
            <label class="block text-xs font-extrabold uppercase tracking-widest text-muted mb-2" for="email">Email</label>
            <input id="email" name="email" type="email" required
              class="w-full rounded-xl border border-line px-4 py-3 text-sm outline-none focus:border-cyan focus:ring-2 focus:ring-cyan/20" />
          </div>
          <button type="submit"
            class="w-full rounded-xl bg-orange px-5 py-3 text-sm font-bold text-white hover:bg-orange-dark transition">
            Send Reset Link
          </button>
        </form>

        <p class="mt-6 text-center text-sm text-muted">
          <a href="/v1/auth/login" class="font-bold text-cyan-dark hover:underline">Back to login</a>
        </p>
      </div>
    </main>
  </body>
</html>