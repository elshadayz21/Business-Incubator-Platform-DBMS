<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>

<body class="bg-surface text-ink min-h-screen flex flex-col font-sans">
    <%- include('../partials/header.ejs') %>

    <main class="flex-1 px-6 py-12 lg:px-10">
        <div class="mx-auto max-w-6xl">
            <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-2 lg:gap-16">

                <!-- Brand panel -->
                <section class="relative overflow-hidden rounded-[28px] bg-gradient-to-br from-cyan via-cyan-mid to-cyan-deep p-10 text-white lg:p-14">
                    <div class="pointer-events-none absolute -left-20 -top-16 h-[340px] w-[460px] rounded-[48%] border-[55px] border-white/10" aria-hidden="true"></div>
                    <div class="pointer-events-none absolute -right-28 bottom-[-200px] h-[420px] w-[520px] rounded-[50%] border-[70px] border-white/10" aria-hidden="true"></div>

                    <div class="relative">
                        <p class="mb-4 inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[.24em] text-white/80">
                            <span class="h-2 w-2 rounded-full bg-orange" aria-hidden="true"></span>
                            DxValley Incubation Center
                        </p>
                        <h1 class="max-w-[480px] text-4xl font-extrabold leading-[1.05] tracking-[-.045em] sm:text-5xl">
                            Start your journey<br />
                            <span class="text-white/75">with DxValley.</span>
                        </h1>
                        <p class="mt-6 max-w-[460px] text-base leading-8 text-white/85">
                            Join the incubator platform to track milestones, access resources, and connect with technical mentors.
                        </p>

                        <ul class="mt-10 space-y-4 text-sm font-semibold text-white/90">
                            <li class="flex items-center gap-3">
                                <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-orange text-xs"><i class="fa-solid fa-check" aria-hidden="true"></i></span>
                                Build and showcase your startup projects
                            </li>
                            <li class="flex items-center gap-3">
                                <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-orange text-xs"><i class="fa-solid fa-check" aria-hidden="true"></i></span>
                                Apply for funding and workshop opportunities
                            </li>
                            <li class="flex items-center gap-3">
                                <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-orange text-xs"><i class="fa-solid fa-check" aria-hidden="true"></i></span>
                                Get mentored by experienced ecosystem leaders
                            </li>
                        </ul>

                        <div class="mt-12 hidden items-center gap-3 rounded-2xl bg-white p-3 text-ink shadow-[0_18px_40px_rgba(0,63,102,.22)] sm:flex">
                            <img src="/brand/dxvalley-wordmark.jpeg" alt="DxValley" class="h-9 w-auto object-contain object-left mix-blend-multiply" loading="lazy" decoding="async" />
                            <span class="h-6 w-px bg-line" aria-hidden="true"></span>
                            <span class="pr-2 text-[10px] font-bold uppercase tracking-wider text-muted">Incubation arm of<br />Cooperative Bank of Oromia</span>
                        </div>
                    </div>
                </section>

                <!-- Form card -->
                <section class="w-full rounded-2xl border border-line bg-white p-8 shadow-sm sm:p-10">
                    <div class="mb-8">
                        <p class="text-xs font-extrabold uppercase tracking-[.2em] text-orange">Get started</p>
                        <h2 class="mt-3 text-3xl font-extrabold tracking-[-.04em] text-cyan-dark sm:text-4xl">Create your account</h2>
                        <p class="mt-2 text-sm text-muted">It only takes a minute to join the community.</p>

                    </div>

                    <div id="errorMessage" class="mb-6 <%= typeof error !== 'undefined' && error ? '' : 'hidden' %> items-start gap-3 rounded-xl border border-red-200 bg-red-50 p-4" role="alert">
                        <i class="fa-solid fa-circle-exclamation mt-0.5 text-red-600" aria-hidden="true"></i>
                        <div class="flex-1 text-sm font-semibold text-red-700">
                            Error: <span id="errorText" class="font-medium italic"><%= typeof error !== 'undefined' ? error : '' %></span>
                        </div>
                    </div>

                    <% if (typeof success !== 'undefined' && success) { %>
                        <div class="mb-6 flex items-start gap-3 rounded-xl border border-green-200 bg-green-50 p-4" role="status">
                            <i class="fa-solid fa-circle-check mt-0.5 text-green-600" aria-hidden="true"></i>
                            <div class="flex-1 text-sm font-semibold text-green-700">
                                Success: <span class="font-medium italic"><%= success %></span>
                            </div>
                        </div>
                    <% } %>
                                        <!-- Invite-Only Warning Banner -->
                                        <% if (typeof token === 'undefined' || !token) { %>
                                            <div class="mb-6 flex items-start gap-3 rounded-xl border border-orange-200 bg-orange-50 p-4" role="alert">
                                                <i class="fa-solid fa-lock mt-0.5 text-orange-600" aria-hidden="true"></i>
                                                <div class="flex-1 text-sm font-semibold text-orange-700">
                                                    Invitation Required: Signup is strictly by invitation only. Please use the secure link provided in your acceptance email to create an account.
                                                </div>
                                            </div>
                                        <% } %>

                                        <form id="signupForm" action="/v1/auth/register" method="POST" class="space-y-6">
                                            <input type="hidden" name="token" value="<%= typeof token !== 'undefined' ? token : '' %>" />
                                            <!-- ... rest of the form ... -->

                    <form id="signupForm" action="/v1/auth/register" method="POST" class="space-y-6">
                        <input type="hidden" name="token" value="<%= typeof token !== 'undefined' ? token : '' %>" />
                        <div>
                            <label class="mb-2 block text-xs font-extrabold uppercase tracking-widest text-muted" for="name">Full name</label>
                            <div class="relative">
                                <i class="fa-solid fa-user pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-sm text-muted" aria-hidden="true"></i>
                                <input id="name" name="name" type="text" autocomplete="name" placeholder="Your name" required
                                    class="w-full rounded-lg border border-line bg-surface py-3 pl-11 pr-4 text-sm font-semibold outline-none transition placeholder:font-normal placeholder:text-slate-400 focus:border-cyan focus:bg-white focus:ring-2 focus:ring-cyan/20" />
                            </div>
                        </div>

                        <div>
                            <label class="mb-2 block text-xs font-extrabold uppercase tracking-widest text-muted" for="email">Email address</label>
                            <div class="relative">
                                <i class="fa-solid fa-envelope pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-sm text-muted" aria-hidden="true"></i>
                                <input id="email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required
                                    class="w-full rounded-lg border border-line bg-surface py-3 pl-11 pr-4 text-sm font-semibold outline-none transition placeholder:font-normal placeholder:text-slate-400 focus:border-cyan focus:bg-white focus:ring-2 focus:ring-cyan/20" />
                            </div>
                        </div>

                        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
                                                    <div>
                                                        <label class="mb-2 block text-xs font-extrabold uppercase tracking-widest text-muted" for="password">Password</label>
                                                        <div class="relative">
                                                            <i class="fa-solid fa-lock pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-sm text-muted" aria-hidden="true"></i>
                                                            <input id="password" name="password" type="password" autocomplete="new-password" placeholder="••••••••" required
                                                                class="w-full rounded-lg border border-line bg-surface py-3 pl-11 pr-4 text-sm font-semibold outline-none transition placeholder:font-normal placeholder:text-slate-400 focus:border-cyan focus:bg-white focus:ring-2 focus:ring-cyan/20" />
                                                        </div>

                                                        <!-- 1. SHOW PASSWORD CHECKBOX -->
                                                        <label class="mt-3 flex items-center gap-2 text-xs font-bold text-muted cursor-pointer">
                                                            <input type="checkbox" id="showPassword" class="h-4 w-4 rounded border-line accent-cyan">
                                                            <span>Show Password</span>
                                                        </label>

                                                        <!-- 2. PASSWORD CHECKLIST -->
                                                        <div id="passwordChecklist" class="mt-4 hidden flex flex-col gap-2 text-xs font-medium text-muted">
                                                            <div id="check-length" class="flex items-center gap-2">
                                                                <i class="fa-solid fa-circle text-[6px] text-slate-400 transition"></i>
                                                                <span>8+ characters</span>
                                                            </div>
                                                            <div id="check-upper" class="flex items-center gap-2">
                                                                <i class="fa-solid fa-circle text-[6px] text-slate-400 transition"></i>
                                                                <span>Uppercase letter</span>
                                                            </div>
                                                            <div id="check-lower" class="flex items-center gap-2">
                                                                <i class="fa-solid fa-circle text-[6px] text-slate-400 transition"></i>
                                                                <span>Lowercase letter</span>
                                                            </div>
                                                            <div id="check-number" class="flex items-center gap-2">
                                                                <i class="fa-solid fa-circle text-[6px] text-slate-400 transition"></i>
                                                                <span>Number</span>
                                                            </div>
                                                            <div id="check-special" class="flex items-center gap-2">
                                                                <i class="fa-solid fa-circle text-[6px] text-slate-400 transition"></i>
                                                                <span>Special character (!@#$)</span>
                                                            </div>
                                                        </div>
                                                    </div>


                            <div>


                                <label class="mb-2 block text-xs font-extrabold uppercase tracking-widest text-muted" for="confirmPassword">Confirm Password</label>
                                <div class="relative">
                                    <i class="fa-solid fa-lock pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-sm text-muted" aria-hidden="true"></i>
                                    <input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" placeholder="••••••••" required
                                        class="w-full rounded-lg border border-line bg-surface py-3 pl-11 pr-4 text-sm font-semibold outline-none transition placeholder:font-normal placeholder:text-slate-400 focus:border-cyan focus:bg-white focus:ring-2 focus:ring-cyan/20" />
                                </div>
                                <p id="passwordMatch" class="mt-2 hidden text-xs font-bold italic" aria-live="polite"></p>
                            </div>
                        </div>

                        <label class="group flex cursor-pointer items-start gap-3 text-sm font-semibold">
                            <input id="terms" name="terms" type="checkbox" required class="mt-1 h-5 w-5 cursor-pointer rounded border-line accent-cyan" />
                            <span class="text-muted transition-colors group-hover:text-ink">I agree to the Terms of Service and Privacy Policy.</span>
                        </label>

                        <button type="submit"
                            class="flex w-full items-center justify-center gap-2 rounded-md bg-cyan px-6 py-3.5 text-sm font-extrabold text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-cyan-dark focus:outline-none focus:ring-2 focus:ring-cyan focus:ring-offset-2">
                            Create Account
                            <i class="fa-solid fa-arrow-right text-xs" aria-hidden="true"></i>
                        </button>

                        <p class="text-center text-sm font-semibold text-muted">
                            Already have an account?
                            <a href="<%= routes.loginRoute %>" class="font-bold text-cyan-dark transition hover:text-orange">Sign in</a>
                        </p>
                    </form>
                </section>
            </div>
        </div>
    </main>

    <script src="/js/signup.js"></script>
</body>
</html>
