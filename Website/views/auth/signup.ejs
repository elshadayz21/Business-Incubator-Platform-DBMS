<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>

<body class="bg-black text-white">
    <%- include('../partials/header.ejs') %>

    <main class="bg-black">
        <div class="mx-auto grid min-h-[780px] max-w-5xl grid-cols-1 items-center gap-10 px-6 py-16 sm:px-10 lg:grid-cols-2 lg:gap-16 lg:px-0 lg:py-20">
            <section class="flex flex-col justify-center text-left">
                <span class="mb-2 font-display text-sm font-black uppercase tracking-[.18em] text-cyan">
                    Get started
                </span>
                <h1 class="mt-3 max-w-[560px] font-display text-5xl font-bold uppercase leading-[.98] tracking-[-.055em] text-white sm:text-[58px]">
                    Create your<br />
                    <span class="text-orange">account</span>
                </h1>
                <p class="mt-7 max-w-[530px] border-l-4 border-cyan pl-6 font-sans text-lg italic leading-[1.55] text-slate-400 sm:text-[21px]">
                    Join the incubator platform to track milestones, access resources, and connect with technical wizards.
                </p>
            </section>

            <section class="relative w-full max-w-[500px] border-4 border-black bg-white p-6 text-black shadow-[8px_8px_0_0_#000] sm:p-10 lg:justify-self-end">
                <div id="errorMessage" class="mb-6 hidden items-start gap-3 border border-red-200 bg-red-50 p-4 text-red-800" role="alert">
                    <i class="fa-solid fa-circle-exclamation mt-0.5 text-red-600" aria-hidden="true"></i>
                    <div class="flex-1 text-sm font-bold">
                        Error: <span id="errorText" class="font-sans font-medium italic"></span>
                    </div>
                </div>

                <% if (typeof success !== 'undefined' && success) { %>
                    <div class="mb-6 flex items-start gap-3 border border-green-200 bg-green-50 p-4 text-green-800" role="status">
                        <i class="fa-solid fa-circle-check mt-0.5 text-green-600" aria-hidden="true"></i>
                        <div class="flex-1 text-sm font-bold">
                            Success: <span class="font-sans font-medium italic"><%= success %></span>
                        </div>
                    </div>
                <% } %>

                <form id="signupForm" action="/v1/auth/register" method="POST" class="space-y-6">
                    <div>
                        <label class="mb-2 block font-display text-xs font-black uppercase tracking-[.16em] text-slate-500" for="name">Full name</label>
                        <input id="name" name="name" type="text" autocomplete="name" placeholder="YOUR NAME" required
                            class="w-full border-4 border-black bg-slate-50 px-4 py-4 font-sans text-base font-bold text-black outline-none placeholder:text-slate-300 transition focus:border-cyan focus:bg-white focus:ring-4 focus:ring-cyan/15" />
                    </div>

                    <div>
                        <label class="mb-2 block font-display text-xs font-black uppercase tracking-[.16em] text-slate-500" for="email">Email address</label>
                        <input id="email" name="email" type="email" autocomplete="email" placeholder="YOU@EXAMPLE.COM" required
                            class="w-full border-4 border-black bg-slate-50 px-4 py-4 font-sans text-base font-bold text-black outline-none placeholder:text-slate-300 transition focus:border-cyan focus:bg-white focus:ring-4 focus:ring-cyan/15" />
                    </div>

                    <div>
                        <label class="mb-2 block font-display text-xs font-black uppercase tracking-[.16em] text-slate-500" for="password">Password</label>
                        <input id="password" name="password" type="password" autocomplete="new-password" placeholder="********" required
                            class="w-full border-4 border-black bg-slate-50 px-4 py-4 font-sans text-base font-bold text-black outline-none placeholder:text-slate-400 transition focus:border-cyan focus:bg-white focus:ring-4 focus:ring-cyan/15" />
                    </div>

                    <div>
                        <label class="mb-2 block font-display text-xs font-black uppercase tracking-[.16em] text-slate-500" for="confirmPassword">Confirm Password</label>
                        <input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" placeholder="********" required
                            class="w-full border-4 border-black bg-slate-50 px-4 py-4 font-sans text-base font-bold text-black outline-none placeholder:text-slate-400 transition focus:border-cyan focus:bg-white focus:ring-4 focus:ring-cyan/15" />
                        <p id="passwordMatch" class="mt-2 hidden text-xs font-black uppercase italic" aria-live="polite"></p>
                    </div>

                    <label class="group flex cursor-pointer items-start gap-3 text-sm font-bold">
                        <input id="terms" name="terms" type="checkbox" required class="mt-1 h-5 w-5 cursor-pointer accent-cyan" />
                        <span class="text-slate-600 transition-colors group-hover:text-black">I agree to the Terms of Service and Privacy Policy.</span>
                    </label>

                    <button type="submit"
                        class="w-full border-4 border-black bg-cyan py-4 font-display text-xl font-black uppercase tracking-[.16em] text-white shadow-[7px_7px_0_0_#000] transition-all hover:translate-y-1 hover:shadow-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan">
                        Create Account
                    </button>

                    <p class="font-display text-center text-sm font-bold uppercase tracking-tight text-slate-500">
                        Already have an account?
                        <a href="<%= routes.loginRoute %>" class="text-cyan underline underline-offset-2 transition hover:bg-cyan hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan">Sign in</a>
                    </p>
                </form>
            </section>
        </div>
    </main>

    <script src="/js/signup.js"></script>
</body>
</html>
