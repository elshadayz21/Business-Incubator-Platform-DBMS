<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>

<body class="bg-surface text-ink min-h-screen flex flex-col font-sans">
    <%- include('../partials/header.ejs') %>

    <main class="relative flex flex-1 items-center justify-center overflow-hidden px-6 py-14 lg:px-10">
        <!-- Decorative background -->
        <div class="pointer-events-none absolute inset-0" aria-hidden="true">
            <div class="absolute -left-36 -top-36 h-[420px] w-[420px] rounded-full bg-cyan/10 blur-3xl"></div>
            <div class="absolute -bottom-44 -right-28 h-[480px] w-[480px] rounded-full bg-orange/10 blur-3xl"></div>
            <div class="absolute left-1/2 top-1/2 hidden h-[760px] w-[760px] -translate-x-1/2 -translate-y-1/2 rounded-full border border-line/80 lg:block"></div>
            <div class="absolute left-1/2 top-1/2 hidden h-[560px] w-[560px] -translate-x-1/2 -translate-y-1/2 rounded-full border border-dashed border-line/60 lg:block"></div>
            <span class="absolute left-[18%] top-[22%] hidden h-2.5 w-2.5 rounded-full bg-cyan/50 lg:block"></span>
            <span class="absolute right-[20%] top-[64%] hidden h-2 w-2 rounded-full bg-orange/50 lg:block"></span>
            <span class="absolute right-[28%] top-[16%] hidden h-1.5 w-1.5 rounded-full bg-cyan-deep/40 lg:block"></span>
        </div>

        <!-- Login card -->
        <section class="relative w-full max-w-md">
            <div class="overflow-hidden rounded-3xl border border-line bg-white shadow-[0_30px_80px_-24px_rgba(0,111,158,.28)]">

                <!-- Card header strip -->
                <div class="h-1.5 w-full bg-gradient-to-r from-cyan via-cyan-mid to-orange"></div>

                <div class="p-8 sm:p-10">
                    <div class="mb-8 text-center">
                        <p class="text-xs font-extrabold uppercase tracking-[.22em] text-orange">Welcome back</p>
                        <h1 class="mt-3 font-display text-3xl font-bold tracking-[-.03em] text-cyan-dark sm:text-[34px]">Sign in to your account</h1>
                        <p class="mx-auto mt-3 max-w-[300px] text-sm leading-6 text-muted">Enter your credentials below to access your dashboard.</p>
                    </div>

                    <% if (typeof success !== 'undefined' && success) { %>
                        <div class="mb-6 flex items-start gap-3 rounded-xl border border-green-200 bg-green-50 p-4" role="status">
                            <i class="fa-solid fa-circle-check mt-0.5 text-green-600" aria-hidden="true"></i>
                            <div class="flex-1 text-sm font-semibold text-green-700">
                                Success: <span class="font-medium italic"><%= success %></span>
                            </div>
                        </div>
                    <% } %>

                    <% if (typeof error !== 'undefined' && error) { %>
                        <div class="mb-6 flex items-start gap-3 rounded-xl border border-red-200 bg-red-50 p-4" role="alert">
                            <i class="fa-solid fa-circle-exclamation mt-0.5 text-red-600" aria-hidden="true"></i>
                            <div class="flex-1 text-sm font-semibold text-red-700">
                                Error: <span class="font-medium italic"><%= error %></span>
                            </div>
                        </div>
                    <% } %>

                    <form action="/v1/auth/login" method="POST" class="space-y-6">
                        <div>
                            <label class="mb-2 block text-xs font-extrabold uppercase tracking-widest text-muted" for="email">Email address</label>
                            <div class="group relative">
                                <i class="fa-solid fa-envelope pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-sm text-muted transition group-focus-within:text-cyan" aria-hidden="true"></i>
                                <input id="email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required
                                    class="w-full rounded-xl border border-line bg-surface py-3.5 pl-11 pr-4 text-sm font-semibold outline-none transition placeholder:font-normal placeholder:text-slate-400 hover:border-slate-300 focus:border-cyan focus:bg-white focus:ring-4 focus:ring-cyan/15" />
                            </div>
                        </div>

                        <div x-data="{ show: false }">
                            <div class="mb-2 flex items-center justify-between">
                                <label class="block text-xs font-extrabold uppercase tracking-widest text-muted" for="password">Password</label>
                                <a href="#forgot" class="text-xs font-bold text-cyan-dark transition hover:text-orange focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan">Forgot?</a>
                            </div>
                            <div class="group relative">
                                <i class="fa-solid fa-lock pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-sm text-muted transition group-focus-within:text-cyan" aria-hidden="true"></i>
                                <input id="password" name="password" :type="show ? 'text' : 'password'" autocomplete="current-password" placeholder="••••••••" required
                                    class="w-full rounded-xl border border-line bg-surface py-3.5 pl-11 pr-12 text-sm font-semibold outline-none transition placeholder:font-normal placeholder:text-slate-400 hover:border-slate-300 focus:border-cyan focus:bg-white focus:ring-4 focus:ring-cyan/15" />
                                <button type="button" @click="show = !show"
                                    class="absolute right-4 top-1/2 -translate-y-1/2 text-muted transition hover:text-cyan-dark focus:outline-none"
                                    :aria-label="show ? 'Hide password' : 'Show password'" aria-label="Show password">
                                    <i class="fa-solid text-sm" :class="show ? 'fa-eye-slash' : 'fa-eye'" aria-hidden="true"></i>
                                </button>
                            </div>
                        </div>

                        <button type="submit"
                            class="flex w-full items-center justify-center gap-2.5 rounded-xl bg-gradient-to-r from-cyan to-cyan-deep px-6 py-4 text-sm font-extrabold uppercase tracking-wide text-white shadow-lg shadow-cyan/25 transition duration-200 hover:-translate-y-0.5 hover:shadow-xl hover:shadow-cyan/30 hover:brightness-105 focus:outline-none focus:ring-4 focus:ring-cyan/30 active:translate-y-0">
                            Sign In
                            <i class="fa-solid fa-arrow-right text-xs transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true"></i>
                        </button>
                    </form>

                    <p class="mt-6 text-center text-sm font-semibold text-muted">
                        Don't have an account?
                        <a href="<%= routes.signupRoute %>" class="font-bold text-cyan-dark transition hover:text-orange">Sign up</a>
                    </p>
                </div>
            </div>

            <p class="mt-6 text-center text-xs font-medium text-muted">
                Protected by DxValley account security
            </p>
        </section>
    </main>
</body>
</html>
