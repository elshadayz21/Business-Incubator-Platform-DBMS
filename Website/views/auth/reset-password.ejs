<!DOCTYPE html>
<html lang="en">
  <%- include('../partials/head') %>
  <body class="flex min-h-screen flex-col bg-white font-sans text-ink">
    <main class="flex flex-grow items-center justify-center px-6 py-16">
      <div class="w-full max-w-md">
        <h1 class="text-3xl font-extrabold tracking-[-.03em] text-ink text-center">Set a new password</h1>

        <% if (error) { %>
          <div class="mt-6 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700"><%= error %></div>
        <% } %>

        <form action="/v1/auth/reset-password/<%= token %>" method="POST" class="mt-8 space-y-5">
          <div>
            <label class="block text-xs font-extrabold uppercase tracking-widest text-muted mb-2" for="newPassword">New Password</label>
            <input id="newPassword" name="newPassword" type="password" required minlength="8"
              class="w-full rounded-xl border border-line px-4 py-3 text-sm outline-none focus:border-cyan focus:ring-2 focus:ring-cyan/20" />
          </div>
          <div>
            <label class="block text-xs font-extrabold uppercase tracking-widest text-muted mb-2" for="confirmPassword">Confirm Password</label>
            <input id="confirmPassword" name="confirmPassword" type="password" required minlength="8"
              class="w-full rounded-xl border border-line px-4 py-3 text-sm outline-none focus:border-cyan focus:ring-2 focus:ring-cyan/20" />
          </div>
          <button type="submit"
            class="w-full rounded-xl bg-orange px-5 py-3 text-sm font-bold text-white hover:bg-orange-dark transition">
            Reset Password
          </button>
        </form>
      </div>
    </main>
  </body>
</html>