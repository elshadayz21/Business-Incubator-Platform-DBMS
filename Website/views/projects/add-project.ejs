<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>

<body class="min-h-screen flex flex-col bg-surface text-ink font-sans">
    <%- include('../partials/header.ejs') %>

    <main class="flex-1 px-6 py-12 lg:px-10">
        <div class="w-full max-w-5xl mx-auto">

            <a href="/v1/projects" class="inline-flex items-center gap-2 text-sm font-bold text-cyan-dark transition hover:text-orange">
                <i class="fa-solid fa-arrow-left text-xs" aria-hidden="true"></i>
                Back to Projects
            </a>

            <div class="mt-8 mb-12">
                <p class="text-xs font-extrabold uppercase tracking-[.2em] text-orange">New Venture</p>
                <h1 class="mt-3 max-w-[680px] text-4xl font-extrabold leading-tight tracking-[-.04em] text-cyan-dark sm:text-5xl">
                    Share Your <span class="text-orange">Innovation</span>
                </h1>
                <p class="mt-4 max-w-2xl text-base leading-7 text-muted">
                    Showcase your project to the community and find the right technical partners.
                </p>
            </div>

            <!-- Flash Messages -->
            <% if (error) { %>
                <div class="mb-8 flex items-start gap-4 rounded-xl border border-red-200 bg-red-50 p-5">
                    <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-red-500 text-white"><i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i></span>
                    <div>
                        <h3 class="text-sm font-extrabold uppercase tracking-wide text-red-700">Error</h3>
                        <p class="mt-0.5 text-sm font-medium text-red-600"><%= error %></p>
                    </div>
                </div>
            <% } %>

            <% if (success) { %>
                <div class="mb-8 flex items-start gap-4 rounded-xl border border-green-200 bg-green-50 p-5">
                    <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-green-500 text-white"><i class="fa-solid fa-rocket" aria-hidden="true"></i></span>
                    <div>
                        <h3 class="text-sm font-extrabold uppercase tracking-wide text-green-700">Success</h3>
                        <p class="mt-0.5 text-sm font-medium text-green-600 italic"><%= success %></p>
                    </div>
                </div>
            <% } %>

            <form action="/v1/projects/create" method="POST" class="space-y-10" id="projectForm">

                <!-- Section 1: Basic Information -->
                <div class="rounded-2xl border border-line bg-white p-8 shadow-sm md:p-10">
                    <div class="mb-8 flex items-center gap-4 border-b border-line pb-6">
                        <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-cyan text-sm font-extrabold text-white">1</span>
                        <div>
                            <h2 class="text-2xl font-extrabold tracking-[-.02em] text-cyan-dark">Basic Information</h2>
                            <p class="mt-1 text-xs font-semibold text-muted">Tell the community what you're building</p>
                        </div>
                    </div>

                    <div class="space-y-8">
                        <div>
                            <label for="name" class="mb-2 block text-xs font-extrabold uppercase tracking-widest text-muted">Project Name <span class="text-orange">*</span></label>
                            <input type="text" id="name" name="name" placeholder="E.g., Neural Flow AI" required
                                class="w-full rounded-lg border border-line bg-surface px-5 py-3.5 text-sm font-semibold outline-none transition placeholder:font-normal placeholder:text-slate-400 focus:border-cyan focus:bg-white focus:ring-2 focus:ring-cyan/20" />
                        </div>

                        <div>
                            <label for="short_description" class="mb-2 block text-xs font-extrabold uppercase tracking-widest text-muted">Elevator Pitch <span class="text-orange">*</span></label>
                            <textarea id="short_description" name="short_description" placeholder="One sentence to rule them all..." rows="2" required
                                class="w-full resize-none rounded-lg border border-line bg-surface px-5 py-3.5 text-sm font-semibold italic outline-none transition placeholder:font-normal placeholder:not-italic placeholder:text-slate-400 focus:border-cyan focus:bg-white focus:ring-2 focus:ring-cyan/20"
                                maxlength="150"></textarea>
                        </div>
                    </div>
                </div>

                <!-- Section 2: The Core Concept -->
                <div class="rounded-2xl border border-line bg-white p-8 shadow-sm md:p-10">
                    <div class="mb-8 flex items-center gap-4 border-b border-line pb-6">
                        <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-orange text-sm font-extrabold text-white">2</span>
                        <div>
                            <h2 class="text-2xl font-extrabold tracking-[-.02em] text-cyan-dark">The Core Concept</h2>
                            <p class="mt-1 text-xs font-semibold text-muted">The problem and your unique fix</p>
                        </div>
                    </div>

                    <div class="space-y-8">
                        <div>
                            <label for="problem" class="mb-2 block text-xs font-extrabold uppercase tracking-widest text-muted">What's Broken? <span class="text-orange">*</span></label>
                            <textarea id="problem" name="problem" placeholder="Describe the pain point..." rows="4" required
                                class="w-full rounded-lg border border-line bg-surface px-5 py-3.5 text-sm font-medium outline-none transition placeholder:font-normal placeholder:text-slate-400 focus:border-cyan focus:bg-white focus:ring-2 focus:ring-cyan/20"></textarea>
                        </div>

                        <div>
                            <label for="solution" class="mb-2 block text-xs font-extrabold uppercase tracking-widest text-muted">The Fix <span class="text-orange">*</span></label>
                            <textarea id="solution" name="solution" placeholder="Explain your unique approach..." rows="4" required
                                class="w-full rounded-lg border border-line bg-surface px-5 py-3.5 text-sm font-medium outline-none transition placeholder:font-normal placeholder:text-slate-400 focus:border-cyan focus:bg-white focus:ring-2 focus:ring-cyan/20"></textarea>
                        </div>
                    </div>
                </div>

                <!-- Section 3: Technical Details -->
                <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-cyan via-cyan-mid to-cyan-deep p-8 text-white shadow-sm md:p-10">
                    <div class="pointer-events-none absolute -right-24 -top-20 h-[300px] w-[380px] rounded-[50%] border-[55px] border-white/10" aria-hidden="true"></div>

                    <div class="relative mb-8 flex items-center gap-4 border-b border-white/20 pb-6">
                        <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-orange text-sm font-extrabold text-white">3</span>
                        <div>
                            <h2 class="text-2xl font-extrabold tracking-[-.02em]">Technical Details</h2>
                            <p class="mt-1 text-xs font-semibold text-white/70">What powers the project</p>
                        </div>
                    </div>

                    <div class="relative space-y-8">
                        <div>
                            <label for="tech_stack" class="mb-2 block text-xs font-extrabold uppercase tracking-widest text-white/70">Tech Stack <span class="text-orange">*</span></label>
                            <input type="text" id="tech_stack" name="tech_stack" placeholder="React, Node, MongoDB..." required
                                class="w-full rounded-lg border border-white/30 bg-white/10 px-5 py-3.5 text-sm font-semibold text-white outline-none transition placeholder:font-normal placeholder:text-white/40 focus:border-white focus:bg-white/15 focus:ring-2 focus:ring-white/30" />
                        </div>

                        <div>
                            <label for="stage" class="mb-2 block text-xs font-extrabold uppercase tracking-widest text-white/70">Development Stage <span class="text-orange">*</span></label>
                            <select id="stage" name="stage" required
                                class="w-full cursor-pointer appearance-none rounded-lg border border-white/30 bg-white/10 px-5 py-3.5 text-sm font-semibold text-white outline-none transition focus:border-white focus:bg-white/15 focus:ring-2 focus:ring-white/30">
                                <option value="" class="bg-white text-ink">SELECT STAGE</option>
                                <option value="idea" class="bg-white text-ink">💡 CONCEPT ONLY</option>
                                <option value="in-progress" class="bg-white text-ink">🔨 ACTIVE DEVELOPMENT</option>
                                <option value="completed" class="bg-white text-ink">🚀 MVP READY / LIVE</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Section 4: Links & Resources -->
                <div class="rounded-2xl border border-line bg-white p-8 shadow-sm md:p-10">
                    <div class="mb-8 flex items-center gap-4 border-b border-line pb-6">
                        <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-cyan text-sm font-extrabold text-white">4</span>
                        <div>
                            <h2 class="text-2xl font-extrabold tracking-[-.02em] text-cyan-dark">Links & Resources</h2>
                            <p class="mt-1 text-xs font-semibold text-muted">Optional links to showcase your work</p>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                        <div>
                            <label for="github_url" class="mb-2 block text-xs font-extrabold uppercase tracking-widest text-muted">GitHub Repo</label>
                            <input type="url" id="github_url" name="github_url" placeholder="https://github.com/..."
                                class="w-full rounded-lg border border-line bg-surface px-5 py-3.5 text-sm font-semibold outline-none transition placeholder:font-normal placeholder:text-slate-400 focus:border-cyan focus:bg-white focus:ring-2 focus:ring-cyan/20" />
                        </div>
                        <div>
                            <label for="demo_url" class="mb-2 block text-xs font-extrabold uppercase tracking-widest text-muted">Live Demo</label>
                            <input type="url" id="demo_url" name="demo_url" placeholder="https://app-demo.com"
                                class="w-full rounded-lg border border-line bg-surface px-5 py-3.5 text-sm font-semibold outline-none transition placeholder:font-normal placeholder:text-slate-400 focus:border-cyan focus:bg-white focus:ring-2 focus:ring-cyan/20" />
                        </div>
                    </div>
                </div>

                <!-- Section 5: Team Structure -->
                <div class="rounded-2xl border border-line bg-white p-8 shadow-sm md:p-10">
                    <div class="mb-8 flex items-center gap-4 border-b border-line pb-6">
                        <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-orange text-sm font-extrabold text-white">5</span>
                        <div>
                            <h2 class="text-2xl font-extrabold tracking-[-.02em] text-cyan-dark">Team Structure</h2>
                            <p class="mt-1 text-xs font-semibold text-muted">Who's building this with you</p>
                        </div>
                    </div>

                    <div class="space-y-8">
                        <div>
                            <label for="team_type" class="mb-2 block text-xs font-extrabold uppercase tracking-widest text-muted">Founder Group <span class="text-orange">*</span></label>
                            <select id="team_type" name="team_type" required
                                class="w-full cursor-pointer appearance-none rounded-lg border border-line bg-surface px-5 py-3.5 text-sm font-semibold outline-none transition focus:border-cyan focus:bg-white focus:ring-2 focus:ring-cyan/20">
                                <option value="">SELECT STRUCTURE</option>
                                <option value="individual">👤 SOLO FOUNDER</option>
                                <option value="team">👥 CORE TEAM (2-3)</option>
                                <option value="large-team">👨‍👩‍👧‍👦 SCALE TEAM (4+)</option>
                            </select>
                        </div>

                        <div id="coFoundersSection" class="hidden">
                            <label for="co_founders_codes" class="mb-2 block text-xs font-extrabold uppercase tracking-widest text-muted">Co-Founders User Codes <span class="text-orange">*</span></label>
                            <textarea id="co_founders_codes" name="co_founders_codes" placeholder="Enter user codes separated by commas (e.g., USER001, USER002, USER003)" rows="3"
                                class="w-full rounded-lg border border-line bg-surface px-5 py-3.5 text-sm font-semibold outline-none transition placeholder:font-normal placeholder:text-slate-400 focus:border-cyan focus:bg-white focus:ring-2 focus:ring-cyan/20"></textarea>
                            <p class="mt-2 text-xs font-bold text-muted">
                                <i class="fa-solid fa-circle-info mr-1.5 text-cyan-dark" aria-hidden="true"></i>
                                Enter the user codes of your co-founders, separated by commas
                            </p>
                        </div>

                        <div class="rounded-xl border border-cyan/30 bg-cyan-soft p-6">
                            <div class="flex items-center gap-4">
                                <input type="checkbox" id="looking_for_cofounders" name="looking_for_cofounders" value="true"
                                    class="h-5 w-5 cursor-pointer rounded border-line accent-cyan" />
                                <label for="looking_for_cofounders" class="cursor-pointer text-sm font-extrabold uppercase tracking-tight text-cyan-dark">
                                    🔍 We are seeking technical co-founders
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Section 6: Final Details -->
                <div class="rounded-2xl border border-line bg-white p-8 shadow-sm md:p-10">
                    <div class="mb-8 flex items-center gap-4 border-b border-line pb-6">
                        <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-ink text-sm font-extrabold text-white">6</span>
                        <div>
                            <h2 class="text-2xl font-extrabold tracking-[-.02em] text-cyan-dark">Final Details</h2>
                            <p class="mt-1 text-xs font-semibold text-muted">Funding stage, industry, and confirmation</p>
                        </div>
                    </div>

                    <div class="mb-10 grid grid-cols-1 md:grid-cols-2 gap-8">
                        <div>
                            <label for="funding_stage" class="mb-2 block text-xs font-extrabold uppercase tracking-widest text-muted">Funding Stage</label>
                            <select id="funding_stage" name="funding_stage"
                                class="w-full cursor-pointer appearance-none rounded-lg border border-line bg-surface px-5 py-3.5 text-sm font-semibold outline-none transition focus:border-cyan focus:bg-white focus:ring-2 focus:ring-cyan/20">
                                <option value="">SELECT STAGE</option>
                                <option value="pre-seed">💡 PRE-SEED</option>
                                <option value="seed">🌱 SEED ROUND</option>
                                <option value="bootstrapped">💪 BOOTSTRAPPED</option>
                            </select>
                        </div>
                        <div>
                            <label for="domain" class="mb-2 block text-xs font-extrabold uppercase tracking-widest text-muted">Industry/Domain <span class="text-orange">*</span></label>
                            <input type="text" id="domain" name="domain" placeholder="E.g., Fintech, Healthtech" required
                                class="w-full rounded-lg border border-line bg-surface px-5 py-3.5 text-sm font-semibold outline-none transition placeholder:font-normal placeholder:text-slate-400 focus:border-cyan focus:bg-white focus:ring-2 focus:ring-cyan/20" />
                        </div>
                    </div>

                    <div class="rounded-xl border border-line bg-surface p-6">
                        <div class="flex items-start gap-3">
                            <input type="checkbox" id="agreeTerms" name="agreeTerms" required
                                class="mt-1 h-5 w-5 cursor-pointer rounded border-line accent-cyan" />
                            <label for="agreeTerms" class="text-sm font-semibold text-muted">
                                I confirm the project info is accurate and I have the rights to publish this content. <span class="text-orange">*</span>
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Submit Buttons -->
                <div class="flex flex-col gap-4 md:flex-row md:justify-end">
                    <a href="/v1/projects"
                        class="inline-flex items-center justify-center rounded-md border border-line bg-white px-10 py-3.5 text-sm font-bold uppercase tracking-wide text-ink shadow-sm transition hover:-translate-y-0.5 hover:bg-surface">
                        Cancel
                    </a>
                    <button type="submit"
                        class="inline-flex items-center justify-center gap-2 rounded-md bg-cyan px-10 py-3.5 text-sm font-extrabold uppercase tracking-wide text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-cyan-dark focus:outline-none focus:ring-2 focus:ring-cyan focus:ring-offset-2">
                        <i class="fa-solid fa-bolt text-xs" aria-hidden="true"></i>
                        Publish Project
                    </button>
                </div>
            </form>
        </div>
    </main>

    <%- include('../partials/footer.ejs') %>

    <script src="/js/add-project.js"></script>
</body>

</html>
