<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>

<body class="bg-surface text-ink font-sans flex flex-col min-h-screen">
    <%- include('../partials/header.ejs') %>

    <main class="flex-1 px-6 py-10 lg:px-10">
        <div class="mx-auto max-w-7xl">

            <a href="<%= routes.projects %>"
                class="inline-flex items-center gap-2 text-sm font-bold text-cyan-dark transition hover:text-orange">
                <i class="fa-solid fa-arrow-left text-xs" aria-hidden="true"></i>
                Back to Projects
            </a>

            <!-- Hero -->
            <section class="mt-8 overflow-hidden rounded-2xl border border-line bg-white shadow-sm">
                <div class="relative overflow-hidden bg-gradient-to-br from-cyan via-cyan-mid to-cyan-deep text-white">
                    <div class="pointer-events-none absolute -left-24 -top-20 h-[380px] w-[520px] rounded-[48%] border-[60px] border-white/10" aria-hidden="true"></div>
                    <div class="pointer-events-none absolute -right-28 bottom-[-180px] h-[460px] w-[560px] rounded-[50%] border-[70px] border-white/10" aria-hidden="true"></div>
                    <div class="pointer-events-none absolute right-[30%] top-12 h-16 w-16 rounded-full bg-white/10 blur-xl" aria-hidden="true"></div>

                    <div class="relative flex flex-col gap-6 p-8 md:flex-row md:items-start md:justify-between md:p-12">
                        <div class="max-w-3xl">
                            <p class="mb-4 inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[.24em] text-white/80">
                                <span class="h-2 w-2 rounded-full bg-orange" aria-hidden="true"></span>
                                Innovation Hub / Project
                            </p>
                            <h1 class="text-4xl font-extrabold leading-[1.05] tracking-[-.03em] sm:text-5xl">
                                <%= project.title %>
                            </h1>
                            <p class="mt-5 max-w-2xl border-l-2 border-white/40 pl-4 text-base italic leading-7 text-white/85 sm:text-lg">
                                "<%= project.description %>"
                            </p>
                        </div>
                        <span class="inline-flex shrink-0 items-center gap-2 self-start rounded-full border border-white/40 bg-white/15 px-4 py-2 text-xs font-bold uppercase tracking-wider text-white backdrop-blur-sm">
                            <i class="fa-solid fa-circle text-[7px] text-orange" aria-hidden="true"></i>
                            <%= project.status %>
                        </span>
                    </div>
                </div>

                <div class="grid gap-4 p-6 sm:grid-cols-3 md:p-8">
                    <div class="rounded-xl bg-cyan-soft p-6">
                        <div class="text-3xl font-extrabold tracking-[-.04em] text-cyan-dark"><%= project.team.length %></div>
                        <div class="mt-1 text-[10px] font-extrabold uppercase tracking-widest text-muted">Team Members</div>
                    </div>
                    <div class="rounded-xl bg-surface p-6">
                        <div class="truncate text-xl font-extrabold tracking-[-.02em] text-cyan-dark"><%= project.techStack[0] || 'N/A' %></div>
                        <div class="mt-1 text-[10px] font-extrabold uppercase tracking-widest text-muted">Main Framework</div>
                    </div>
                    <div class="rounded-xl bg-orange-soft p-6">
                        <div class="truncate text-xl font-extrabold tracking-[-.02em] text-orange-dark"><%= project.targetMarket.split(',')[0] %></div>
                        <div class="mt-1 text-[10px] font-extrabold uppercase tracking-widest text-muted">Industry</div>
                    </div>
                </div>
            </section>

            <!-- Body -->
            <div class="mt-10 grid grid-cols-1 gap-8 lg:grid-cols-3 lg:gap-10">
                <div class="space-y-8 lg:col-span-2">

                    <section class="rounded-2xl border border-line bg-white p-8 shadow-sm md:p-10">
                        <div class="mb-8 flex items-center gap-4 border-b border-line pb-6">
                            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-cyan text-sm text-white"><i class="fa-solid fa-bullseye" aria-hidden="true"></i></span>
                            <div>
                                <h2 class="text-2xl font-extrabold tracking-[-.02em] text-cyan-dark">The Problem</h2>
                                <p class="mt-1 text-xs font-semibold text-muted">What's broken</p>
                            </div>
                        </div>
                        <p class="text-base leading-7 text-ink"><%= project.problem %></p>
                    </section>

                    <section class="rounded-2xl border border-line bg-white p-8 shadow-sm md:p-10">
                        <div class="mb-8 flex items-center gap-4 border-b border-line pb-6">
                            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-orange text-sm text-white"><i class="fa-solid fa-lightbulb" aria-hidden="true"></i></span>
                            <div>
                                <h2 class="text-2xl font-extrabold tracking-[-.02em] text-cyan-dark">Our Solution</h2>
                                <p class="mt-1 text-xs font-semibold text-muted">The fix</p>
                            </div>
                        </div>
                        <p class="text-base leading-7 text-ink"><%= project.solution %></p>
                    </section>

                    <section class="rounded-2xl border border-line bg-white p-8 shadow-sm md:p-10">
                        <div class="mb-8 flex items-center gap-4 border-b border-line pb-6">
                            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-cyan text-sm text-white"><i class="fa-solid fa-layer-group" aria-hidden="true"></i></span>
                            <div>
                                <h2 class="text-2xl font-extrabold tracking-[-.02em] text-cyan-dark">Technology Stack</h2>
                                <p class="mt-1 text-xs font-semibold text-muted">What powers the project</p>
                            </div>
                        </div>
                        <div class="grid grid-cols-2 gap-4 sm:grid-cols-3">
                            <% project.techStack.forEach((tech, index)=> { %>
                                <div class="rounded-xl border border-line bg-surface p-5 transition hover:-translate-y-0.5 hover:border-cyan/40 hover:bg-white hover:shadow-sm">
                                    <div class="text-[10px] font-extrabold uppercase tracking-widest text-muted">Technology <%= index + 1 %></div>
                                    <div class="mt-1 break-words font-bold text-ink"><%= tech %></div>
                                </div>
                            <% }); %>
                        </div>
                    </section>

                    <section class="rounded-2xl border border-line bg-white p-8 shadow-sm md:p-10">
                        <div class="mb-8 flex items-center gap-4 border-b border-line pb-6">
                            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-ink text-sm text-white"><i class="fa-solid fa-users" aria-hidden="true"></i></span>
                            <div>
                                <h2 class="text-2xl font-extrabold tracking-[-.02em] text-cyan-dark">The Team</h2>
                                <p class="mt-1 text-xs font-semibold text-muted">Who's building this</p>
                            </div>
                        </div>
                        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                            <% project.team.forEach(member=> { %>
                                <div class="flex items-center gap-4 rounded-xl border border-line bg-surface p-5">
                                    <div class="grid h-12 w-12 shrink-0 place-items-center rounded-full bg-cyan text-sm font-bold text-white">
                                        <%= member.initials %>
                                    </div>
                                    <div class="min-w-0">
                                        <h3 class="truncate font-bold text-ink"><%= member.name %></h3>
                                        <p class="text-xs font-semibold text-muted"><%= member.role %></p>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    </section>

                </div>

                <aside class="space-y-6 lg:sticky lg:top-8 lg:self-start">

                    <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-cyan via-cyan-mid to-cyan-deep p-8 text-white shadow-sm">
                        <div class="pointer-events-none absolute -right-24 -top-20 h-[280px] w-[360px] rounded-[50%] border-[50px] border-white/10" aria-hidden="true"></div>
                        <div class="relative">
                            <h2 class="text-xl font-extrabold tracking-[-.02em]">Project Intel</h2>
                            <div class="mt-7 divide-y divide-white/15">
                                <div class="py-5 first:pt-0 last:pb-0">
                                    <div class="text-[10px] font-bold uppercase tracking-[.18em] text-white/65">Funding Stage</div>
                                    <div class="mt-1.5 text-lg font-extrabold capitalize"><%= project.fundingStage %></div>
                                </div>
                                <div class="py-5">
                                    <div class="text-[10px] font-bold uppercase tracking-[.18em] text-white/65">Target Market</div>
                                    <div class="mt-1.5 text-lg font-extrabold leading-tight"><%= project.targetMarket %></div>
                                </div>
                                <div class="py-5">
                                    <div class="text-[10px] font-bold uppercase tracking-[.18em] text-white/65">Launched</div>
                                    <div class="mt-1.5 text-lg font-extrabold"><%= project.startDate %></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <% if (project.looking_for_cofounders) { %>
                        <div class="flex items-center gap-4 rounded-2xl border border-orange/30 bg-orange-soft p-6">
                            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-orange text-white"><i class="fa-solid fa-user-plus" aria-hidden="true"></i></span>
                            <div>
                                <p class="text-sm font-extrabold uppercase tracking-wide text-orange-dark">Hiring co-founders</p>
                                <p class="mt-0.5 text-xs font-semibold text-muted">This team is open to technical co-founders.</p>
                            </div>
                        </div>
                    <% } %>

                    <div class="space-y-4 rounded-2xl border border-line bg-white p-6 shadow-sm">
                        <a href="<%= project.links.demo %>" target="_blank"
                            class="flex w-full items-center justify-center gap-3 rounded-md bg-orange px-6 py-3.5 text-sm font-extrabold text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-orange-dark focus:outline-none focus:ring-2 focus:ring-orange focus:ring-offset-2">
                            Live Demo
                            <i class="fa-solid fa-arrow-up-right-from-square text-xs" aria-hidden="true"></i>
                        </a>
                        <a href="<%= project.links.github %>" target="_blank"
                            class="flex w-full items-center justify-center gap-3 rounded-md border border-cyan bg-white px-6 py-3.5 text-sm font-bold text-cyan-dark transition hover:-translate-y-0.5 hover:bg-cyan-soft focus:outline-none focus:ring-2 focus:ring-cyan focus:ring-offset-2">
                            <i class="fa-brands fa-github text-base" aria-hidden="true"></i>
                            View on GitHub
                        </a>
                    </div>

                </aside>
            </div>
        </div>
    </main>

    <%- include('../partials/footer.ejs') %>
    <script src="/js/project-details.js"></script>
</body>
</html>
