<% const signedIn = typeof user !== 'undefined' && user; %>
<header class="border-b border-line bg-white" data-site-header>
  <div class="bg-cyan text-white">
    <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-6 py-2 text-[11px] font-semibold tracking-wide lg:px-10">
      <nav aria-label="Utility navigation" class="flex items-center gap-5 overflow-x-auto whitespace-nowrap">
        <a class="opacity-90 transition hover:opacity-100 hover:underline" href="/v1/about#faq">FAQ</a>
        <a class="opacity-90 transition hover:opacity-100 hover:underline" href="/v1/workshop">Events</a>
        <a class="opacity-90 transition hover:opacity-100 hover:underline" href="/#stories">Stories</a>
        <a class="opacity-90 transition hover:opacity-100 hover:underline" href="/#partners">Partners</a>
        <a class="opacity-90 transition hover:opacity-100 hover:underline" href="mailto:hello@dxvalley.com">Contact</a>
      </nav>

      <div aria-label="Social links" class="hidden items-center gap-2 sm:flex">
        <a aria-label="LinkedIn" class="grid h-6 w-6 place-items-center rounded-full border border-white/40 transition hover:bg-white hover:text-cyan" href="#linkedin" title="LinkedIn">
          <i class="fa-brands fa-linkedin-in text-[11px]" aria-hidden="true"></i>
        </a>
        <a aria-label="YouTube" class="grid h-6 w-6 place-items-center rounded-full border border-white/40 transition hover:bg-white hover:text-cyan" href="#youtube" title="YouTube">
          <i class="fa-brands fa-youtube text-[11px]" aria-hidden="true"></i>
        </a>
        <a aria-label="Instagram" class="grid h-6 w-6 place-items-center rounded-full border border-white/40 transition hover:bg-white hover:text-cyan" href="#instagram" title="Instagram">
          <i class="fa-brands fa-instagram text-[11px]" aria-hidden="true"></i>
        </a>
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-6 lg:px-10">
    <div class="flex min-h-[88px] items-center justify-between gap-6 py-4">
      <div class="flex min-w-0 items-center gap-4">
        <a aria-label="DxValley home" class="shrink-0" href="/">
          <img src="/brand/dxvalley-wordmark.jpeg" alt="DxValley Incubation Center" class="h-12 w-auto max-w-[210px] object-contain object-left mix-blend-multiply" loading="eager" decoding="async" />
        </a>
        <div class="hidden h-9 w-px bg-line sm:block" aria-hidden="true"></div>
        <div class="hidden text-[10px] font-semibold uppercase leading-tight tracking-[.16em] text-muted sm:block">
          Incubation arm of<br />
          <span class="text-cyan-dark">Cooperative Bank of Oromia</span>
        </div>
      </div>

      <div class="hidden items-center gap-4 lg:flex">
        <form class="relative" action="/v1/search" method="GET" role="search">
          <label class="sr-only" for="site-search">Search DxValley</label>
          <i class="fa-solid fa-magnifying-glass pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-xs text-muted" aria-hidden="true"></i>
          <input id="site-search" name="q" class="h-10 w-[200px] rounded-full border border-line bg-surface pl-9 pr-4 text-xs outline-none transition placeholder:text-slate-400 focus:border-cyan focus:ring-2 focus:ring-cyan/20" placeholder="Search DxValley" type="search" />
        </form>
        <a class="inline-flex items-center gap-2 rounded-full bg-orange px-5 py-2.5 text-sm font-bold text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-orange-dark focus:outline-none focus:ring-2 focus:ring-orange focus:ring-offset-2" href="<%= routes.signupRoute %>">
          Apply now
          <i class="fa-solid fa-arrow-up-right-from-square text-xs" aria-hidden="true"></i>
        </a>
      </div>

      <button id="menu-toggle" aria-controls="mobile-navigation" aria-expanded="false" aria-label="Open navigation menu" class="grid h-10 w-10 place-items-center rounded-full border border-line text-cyan-dark transition hover:bg-cyan-soft lg:hidden" title="Open navigation menu" type="button">
        <i class="fa-solid fa-bars" aria-hidden="true"></i>
      </button>
    </div>

    <div class="hidden border-t border-line py-4 lg:block">
      <nav aria-label="Main navigation" class="flex items-center justify-end gap-8 text-sm font-semibold text-ink">
        <a class="transition hover:text-cyan-dark" href="/#about">About DxValley</a>
        <a class="transition hover:text-cyan-dark" href="/#programs">Programs</a>
        <a class="transition hover:text-cyan-dark" href="/#how-it-works">How it works</a>
        <a class="transition hover:text-cyan-dark" href="/#community">Community</a>
        <a class="transition hover:text-cyan-dark" href="/#resources">Resources</a>
      </nav>
    </div>

    <div id="mobile-navigation" class="hidden border-t border-line py-4 lg:hidden">
      <nav aria-label="Mobile navigation" class="flex flex-col gap-1 text-sm font-semibold text-ink">
        <a class="rounded-md px-3 py-3 transition hover:bg-cyan-soft hover:text-cyan-dark" href="/#about">About DxValley</a>
        <a class="rounded-md px-3 py-3 transition hover:bg-cyan-soft hover:text-cyan-dark" href="/#programs">Programs</a>
        <a class="rounded-md px-3 py-3 transition hover:bg-cyan-soft hover:text-cyan-dark" href="/#how-it-works">How it works</a>
        <a class="rounded-md px-3 py-3 transition hover:bg-cyan-soft hover:text-cyan-dark" href="/#community">Community</a>
        <a class="rounded-md px-3 py-3 transition hover:bg-cyan-soft hover:text-cyan-dark" href="/#resources">Resources</a>
      </nav>
      <form class="relative mt-4" action="/v1/search" method="GET" role="search">
        <label class="sr-only" for="mobile-site-search">Search DxValley</label>
        <i class="fa-solid fa-magnifying-glass pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-xs text-muted" aria-hidden="true"></i>
        <input id="mobile-site-search" name="q" class="h-11 w-full rounded-md border border-line bg-surface pl-9 pr-4 text-sm outline-none transition placeholder:text-slate-400 focus:border-cyan focus:ring-2 focus:ring-cyan/20" placeholder="Search DxValley" type="search" />
      </form>
      <a class="mt-3 inline-flex w-full items-center justify-center gap-2 rounded-md bg-orange px-5 py-3 text-sm font-bold text-white transition hover:bg-orange-dark" href="<%= routes.signupRoute %>">
        Apply now
        <i class="fa-solid fa-arrow-up-right-from-square text-xs" aria-hidden="true"></i>
      </a>
    </div>

    <% if (signedIn) { %>
      <div class="flex items-center justify-end gap-3 border-t border-line py-3 text-xs font-semibold lg:hidden">
        <a href="/v1/auth/profile" class="text-cyan-dark hover:underline">Profile</a>
        <button type="button" onclick="handleLogout()" class="rounded-md bg-ink px-3 py-2 text-white transition hover:bg-slate-700">Logout</button>
      </div>
    <% } %>
  </div>

  <div class="hidden lg:block">
    <div class="mx-auto flex max-w-7xl items-center justify-end gap-3 px-6 pb-3 lg:px-10">
      <% if (signedIn) { %>
        <a href="/v1/auth/profile" class="text-xs font-semibold text-cyan-dark hover:underline">Profile</a>
        <button type="button" onclick="handleLogout()" class="rounded-md bg-ink px-3 py-2 text-xs font-semibold text-white transition hover:bg-slate-700">Logout</button>
      <% } else { %>
        <a href="<%= routes.loginRoute %>" class="text-xs font-semibold text-muted hover:text-cyan-dark hover:underline">Log in</a>
        <a href="<%= routes.signupRoute %>" class="rounded-md border border-cyan px-3 py-2 text-xs font-bold text-cyan-dark transition hover:bg-cyan-soft">Sign up</a>
      <% } %>
    </div>
  </div>
</header>

<script>
  (() => {
    const toggle = document.getElementById('menu-toggle');
    const navigation = document.getElementById('mobile-navigation');
    if (!toggle || !navigation) return;

    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isOpen));
      toggle.setAttribute('aria-label', isOpen ? 'Open navigation menu' : 'Close navigation menu');
      navigation.classList.toggle('hidden', isOpen);
      toggle.innerHTML = isOpen
        ? '<i class="fa-solid fa-bars" aria-hidden="true"></i>'
        : '<i class="fa-solid fa-xmark" aria-hidden="true"></i>';
    });

    navigation.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Open navigation menu');
        navigation.classList.add('hidden');
        toggle.innerHTML = '<i class="fa-solid fa-bars" aria-hidden="true"></i>';
      });
    });
  })();

  async function handleLogout() {
    try {
      const response = await fetch('/v1/auth/logout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include'
      });

      if (response.ok) {
        window.location.href = '<%= routes.loginRoute %>';
      } else {
        window.alert('Failed to logout. Please try again.');
      }
    } catch (error) {
      console.error('Logout error:', error);
      window.alert('An error occurred during logout.');
    }
  }
</script>
