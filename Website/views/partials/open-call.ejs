<!-- Application Modal (Hidden by default) -->
<div id="application-modal" class="fixed inset-0 bg-black/50 z-50 hidden items-center justify-center p-4 backdrop-blur-sm">
  <div class="bg-white w-full max-w-3xl max-h-[90vh] overflow-y-auto rounded-2xl shadow-xl flex flex-col">

    <!-- Header (Content & Document) -->
    <div class="bg-[#00ADEF] p-6 sticky top-0 z-10">
      <div class="flex justify-between items-start">
        <div class="flex-1">
          <span id="modal-badge" class="hidden bg-white/20 text-white px-3 py-1 font-bold text-xs uppercase tracking-wider rounded-full">Open Call</span>
          <h2 id="modal-title" class="text-2xl font-extrabold text-white mt-2"></h2>
        </div>
        <button onclick="closeApplicationModal()" class="text-white hover:bg-white/20 rounded-lg p-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>

      <!-- Rich Text Content -->
      <div id="modal-content" class="text-white/90 mt-3 text-sm prose prose-sm max-w-none"></div>

      <!-- Attached Document Link -->
      <div id="modal-document" class="mt-4"></div>

      <!-- Countdown -->
      <div id="modal-countdown" class="flex gap-4 mt-4 text-white text-center text-sm font-bold"></div>
    </div>

    <!-- Action Area (Apply Now Button or Closed Message) -->
    <div id="modal-action-area" class="p-6 text-center hidden">
      <button onclick="showApplicationForm()" class="px-8 py-3 bg-[#E38524] text-white rounded-xl font-bold hover:bg-[#C97019] transition">
        Apply Now
      </button>
    </div>

    <!-- Application Form (Hidden until Apply is clicked) -->
    <div id="form-container" class="hidden">
      <form id="application-form" class="p-6 space-y-5 border-t border-[#D6E4EA]">
        <h3 class="text-xl font-extrabold text-[#111827] mb-4">Application Form</h3>
        <input type="hidden" id="modal-announcement-id">




        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <div>
            <label class="block text-xs font-bold text-[#526274] mb-2 uppercase">Full Name</label>
            <input type="text" id="full_name" required class="w-full px-4 py-3 border border-[#D6E4EA] rounded-xl bg-[#F6FAFC] focus:outline-none focus:ring-2 focus:ring-[#00ADEF]">
          </div>
          <div>
            <label class="block text-xs font-bold text-[#526274] mb-2 uppercase">Email Address</label>
            <input type="email" id="email" required class="w-full px-4 py-3 border border-[#D6E4EA] rounded-xl bg-[#F6FAFC] focus:outline-none focus:ring-2 focus:ring-[#00ADEF]">
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <div>
            <label class="block text-xs font-bold text-[#526274] mb-2 uppercase">Phone Number</label>
            <input type="text" id="phone" class="w-full px-4 py-3 border border-[#D6E4EA] rounded-xl bg-[#F6FAFC] focus:outline-none focus:ring-2 focus:ring-[#00ADEF]">
          </div>
          <div>
            <label class="block text-xs font-bold text-[#526274] mb-2 uppercase">Background</label>
            <input type="text" id="background" class="w-full px-4 py-3 border border-[#D6E4EA] rounded-xl bg-[#F6FAFC] focus:outline-none focus:ring-2 focus:ring-[#00ADEF]">
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold text-[#526274] mb-2 uppercase">Startup Idea</label>
          <textarea id="startup_idea" rows="4" required class="w-full px-4 py-3 border border-[#D6E4EA] rounded-xl bg-[#F6FAFC] focus:outline-none focus:ring-2 focus:ring-[#00ADEF]"></textarea>
        </div>
 <div id="custom-form-fields" class="space-y-5"></div>
        <div>
          <label class="block text-xs font-bold text-[#526274] mb-2 uppercase">Attach Document (PDF, DOC, PNG, JPG - Max 5MB)</label>
          <input type="file" id="document_upload" accept=".pdf,.doc,.docx,.png,.jpg,.jpeg" class="w-full text-sm text-[#526274] file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:bg-[#EAF8FC] file:text-[#006F9E] file:font-bold hover:file:bg-[#D6E4EA]">
        </div>

        <div id="form-message" class="hidden p-4 rounded-xl text-sm font-bold text-center"></div>

        <button type="submit" class="w-full py-4 bg-[#E38524] text-white rounded-xl font-bold hover:bg-[#C97019] transition">
          Submit Application
        </button>
      </form>
    </div>

  </div>
</div>

<script>
  let countdownInterval;

    // 1. Smart Apply Button Logic
    window.handleGlobalApply = () => {
      if (window.announcementData && window.announcementData.length > 0) {
        // Find all active Open Calls
        const openCalls = window.announcementData.filter(ann => ann.is_open_call);

        if (openCalls.length === 1) {
          // If there is exactly 1 Open Call, open it directly!
          const openCallIndex = window.announcementData.findIndex(ann => ann.id === openCalls[0].id);
          openApplicationModal(openCallIndex);
          return;
        } else if (openCalls.length > 1) {
          // If there are multiple Open Calls, scroll to the list so they can choose!
          const updatesSection = document.getElementById('announcements');
          if (updatesSection) {
            updatesSection.scrollIntoView({ behavior: 'smooth', block: 'center' });
            return;
          }
        }
      }

      // If there are 0 Open Calls, also scroll to the list (or show alert)
      const updatesSection = document.getElementById('announcements');
      if (updatesSection) {
        updatesSection.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } else {
        alert('Applications are not open right now. Please check back soon!');
      }
    };

  // 2. Open Call Modal Logic
  window.openApplicationModal = (index) => {
    const ann = window.announcementData[index];
    if (!ann) return;

    document.getElementById('modal-announcement-id').value = ann.id;
    document.getElementById('modal-title').textContent = ann.title;
    document.getElementById('modal-content').innerHTML = ann.content;

    // Show Document Link if it exists
    const docDiv = document.getElementById('modal-document');
    if (ann.document_url) {
      docDiv.innerHTML = `<a href="${ann.document_url}" target="_blank" class="inline-flex items-center gap-2 text-white hover:underline bg-white/10 px-4 py-2 rounded-lg mt-2 text-xs font-bold"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg> View Attached Document</a>`;
    } else {
      docDiv.innerHTML = '';
    }

    // Show Badge & Action Area
    document.getElementById('modal-badge').classList.remove('hidden');
    const actionArea = document.getElementById('modal-action-area');
    actionArea.classList.remove('hidden');
    document.getElementById('form-container').classList.add('hidden');

    // Check if capacity is reached
    const currentCount = parseInt(ann.application_count || 0);
    const maxCap = ann.capacity ? parseInt(ann.capacity) : null;
    if (maxCap && currentCount >= maxCap) {
      actionArea.innerHTML = "<p class='text-red-600 font-bold bg-red-50 px-4 py-3 rounded-lg border border-red-200'>Maximum capacity reached. Applications are closed.</p>";
    } else {
      actionArea.innerHTML = "<button onclick='showApplicationForm()' class='px-8 py-3 bg-[#E38524] text-white rounded-xl font-bold hover:bg-[#C97019] transition'>Apply Now</button>";
    }

    const modal = document.getElementById('application-modal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';

    // Countdown Logic
    const deadlineDate = new Date(ann.deadline).getTime();
    clearInterval(countdownInterval);

    countdownInterval = setInterval(() => {
      const now = new Date().getTime();
      const distance = deadlineDate - now;

      if (distance < 0) {
        clearInterval(countdownInterval);
        document.getElementById('modal-countdown').innerHTML = "<span class='bg-red-500 px-3 py-1 rounded-full'>APPLICATION CLOSED</span>";
        document.getElementById('modal-action-area').classList.add('hidden');
        return;
      }

      const days = Math.floor(distance / (1000 * 60 * 60 * 24));
      const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((distance % (1000 * 60)) / 1000);

      document.getElementById('modal-countdown').innerHTML = `
        <span>${days}d</span> : <span>${hours}h</span> : <span>${minutes}m</span> : <span>${seconds}s</span>
      `;
    }, 1000);
  };

  // 3. Regular Announcement Modal (No form)
  window.openAnnouncementDetail = (index) => {
    const ann = window.announcementData[index];
    if (!ann) return;

    document.getElementById('modal-title').textContent = ann.title;
    document.getElementById('modal-content').innerHTML = ann.content;

    const docDiv = document.getElementById('modal-document');
    if (ann.document_url) {
      docDiv.innerHTML = `<a href="${ann.document_url}" target="_blank" class="inline-flex items-center gap-2 text-white hover:underline bg-white/10 px-4 py-2 rounded-lg mt-2 text-xs font-bold"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg> View Attached Document</a>`;
    } else {
      docDiv.innerHTML = '';
    }

    document.getElementById('modal-badge').classList.add('hidden');
    document.getElementById('modal-countdown').innerHTML = '';
    document.getElementById('modal-action-area').classList.add('hidden');
    document.getElementById('form-container').classList.add('hidden');

    const modal = document.getElementById('application-modal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
  };

  // 4. Show Form & Fetch Custom Questions
  window.showApplicationForm = async () => {
    document.getElementById('modal-action-area').classList.add('hidden');
    const formContainer = document.getElementById('form-container');
    formContainer.classList.remove('hidden');
    formContainer.scrollIntoView({ behavior: 'smooth' });

    const customFieldsDiv = document.getElementById('custom-form-fields');
    customFieldsDiv.innerHTML = '<p class="text-sm text-[#526274] font-bold">Loading questions...</p>';

    const annId = document.getElementById('modal-announcement-id').value;
    try {
      const res = await fetch(`/api/public/form-fields/${annId}`);
      const fields = await res.json();

      if (fields.length === 0) {
        customFieldsDiv.innerHTML = '';
        return;
      }

      customFieldsDiv.innerHTML = fields.map(field => {
        const isRequired = field.required ? 'required' : '';
        const reqMark = field.required ? '<span class="text-red-500">*</span>' : '';

        if (field.field_type === 'textarea') {
          return `
            <div>
              <label class="block text-xs font-bold text-[#526274] mb-2 uppercase">${field.label} ${reqMark}</label>
              <textarea name="custom_${field.id}" ${isRequired} class="w-full px-4 py-3 border border-[#D6E4EA] rounded-xl bg-[#F6FAFC] focus:outline-none focus:ring-2 focus:ring-[#00ADEF]"></textarea>
            </div>
          `;
                } else if (field.field_type === 'select') {
                  const opts = field.options.split(',').map(opt => `<option value="${opt.trim()}">${opt.trim()}</option>`).join('');
                  return `
                    <div>
                      <label class="block text-xs font-bold text-[#526274] mb-2 uppercase">${field.label} ${reqMark}</label>
                      <select name="custom_${field.id}" ${isRequired} onchange="toggleOtherInput(this)" class="w-full px-4 py-3 border border-[#D6E4EA] rounded-xl bg-[#F6FAFC] focus:outline-none focus:ring-2 focus:ring-[#00ADEF]">
                        <option value="">Select an option...</option>
                        ${opts}
                      </select>
                      <!-- Hidden text input for "Others" -->
                      <input type="text" name="custom_${field.id}_other" placeholder="Please specify..." class="hidden w-full mt-2 px-4 py-3 border border-[#D6E4EA] rounded-xl bg-[#F6FAFC] focus:outline-none focus:ring-2 focus:ring-[#00ADEF]">
                    </div>
                  `;
                } else if (field.field_type === 'checkbox') {
          return `
            <div class="flex items-center gap-3 py-2">
              <input type="checkbox" name="custom_${field.id}" ${isRequired} class="h-4 w-4 rounded border-gray-300 text-[#00ADEF] focus:ring-[#00ADEF]">
              <label class="text-sm font-bold text-[#526274]">${field.label} ${reqMark}</label>
            </div>
          `;
        } else {
          return `
            <div>
              <label class="block text-xs font-bold text-[#526274] mb-2 uppercase">${field.label} ${reqMark}</label>
              <input type="text" name="custom_${field.id}" ${isRequired} class="w-full px-4 py-3 border border-[#D6E4EA] rounded-xl bg-[#F6FAFC] focus:outline-none focus:ring-2 focus:ring-[#00ADEF]">
            </div>
          `;
        }
      }).join('');

    } catch (error) {
      console.error("Error loading custom fields:", error);
      customFieldsDiv.innerHTML = '';
    }
  };


    // Show/Hide "Others" text box based on dropdown selection
    window.toggleOtherInput = (selectElement) => {
      const otherInput = selectElement.parentElement.querySelector('input[type="text"]');
      if (!otherInput) return;

      if (selectElement.value.toLowerCase() === 'others') {
        otherInput.classList.remove('hidden');
        // If the dropdown is required, make the text box required too
        if (selectElement.hasAttribute('required')) {
          otherInput.setAttribute('required', 'true');
        }
      } else {
        otherInput.classList.add('hidden');
        otherInput.removeAttribute('required');
        otherInput.value = ''; // Clear text if they switch back
      }
    };

  // 5. Close Modal Function
  window.closeApplicationModal = () => {
    const modal = document.getElementById('application-modal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = 'auto';
    clearInterval(countdownInterval);
  };

  // 6. Form Submission Logic
  document.getElementById('application-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const msgBox = document.getElementById('form-message');
    const button = e.target.querySelector('button[type="submit"]');

    button.disabled = true;
    button.textContent = 'Submitting...';
    msgBox.className = 'hidden';

    const fileInput = document.getElementById('document_upload');
    const file = fileInput.files[0];
    if (file) {
      if (file.size > 5 * 1024 * 1024) {
        msgBox.className = 'p-4 rounded-xl text-sm font-bold text-center bg-red-100 text-red-800';
        msgBox.textContent = '❌ File is too large. Max 5MB.';
        msgBox.classList.remove('hidden');
        button.disabled = false;
        button.textContent = 'Submit Application';
        return;
      }
      const allowedExtensions = ['.pdf', '.doc', '.docx', '.png', '.jpg', '.jpeg'];
      const fileName = file.name.toLowerCase();
      const isValid = allowedExtensions.some(ext => fileName.endsWith(ext));
      if (!isValid) {
        msgBox.className = 'p-4 rounded-xl text-sm font-bold text-center bg-red-100 text-red-800';
        msgBox.textContent = '❌ Invalid file type. Only PDF, DOC, PNG, JPG allowed.';
        msgBox.classList.remove('hidden');
        button.disabled = false;
        button.textContent = 'Submit Application';
        return;
      }
    }

    const data = {
      announcement_id: document.getElementById('modal-announcement-id').value,
      full_name: document.getElementById('full_name').value,
      email: document.getElementById('email').value,
      phone: document.getElementById('phone').value,
      background: document.getElementById('background').value,
      startup_idea: document.getElementById('startup_idea').value,
      answers: {}
    };

            // Capture dynamic custom fields!
            const customInputs = document.querySelectorAll('[name^="custom_"]');
            customInputs.forEach(input => {
              // Skip the hidden "other" text inputs, we handle them below
              if (input.name.endsWith('_other')) return;

              if (input.type === 'checkbox') {
                data.answers[input.name] = input.checked;
              } else if (input.tagName === 'SELECT' && input.value.toLowerCase() === 'others') {
                // If dropdown is "Others", grab the text from the "other" input
                const otherInput = document.querySelector(`[name="${input.name}_other"]`);
                data.answers[input.name] = `Others: ${otherInput ? otherInput.value : ''}`;
              } else {
                data.answers[input.name] = input.value;
              }
            });

    try {
      const response = await fetch('/api/public/apply', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      const result = await response.json();

      if (response.ok) {
        msgBox.className = 'p-4 rounded-xl text-sm font-bold text-center bg-green-100 text-green-800';
        msgBox.textContent = '✅ ' + result.message;
        msgBox.classList.remove('hidden');
        document.getElementById('application-form').reset();
      } else {
        throw new Error(result.message || 'Failed to submit');
      }
    } catch (error) {
      msgBox.className = 'p-4 rounded-xl text-sm font-bold text-center bg-red-100 text-red-800';
      msgBox.textContent = '❌ ' + error.message;
      msgBox.classList.remove('hidden');
    } finally {
      button.disabled = false;
      button.textContent = 'Submit Application';
    }
  });
</script>