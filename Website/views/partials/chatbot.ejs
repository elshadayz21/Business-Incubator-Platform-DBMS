<% const chatRoutes = {
  apply: '/#apply',
  mentors: routes.mentors,
  workshops: routes.workshops,
  projects: routes.projects,
  funding: routes.funding,
  about: routes.about,
  contact: '/contact'
}; %>

<style>
  #dv-chatbot {
    --dv-bot-cyan: #00ADEF;
    --dv-bot-cyan-dark: #006F9E;
    --dv-bot-orange: #E38524;
    --dv-bot-ink: #111827;
    --dv-bot-muted: #526274;
    --dv-bot-line: #D6E4EA;
    --dv-bot-surface: #F6FAFC;
    font-family: 'Inter', system-ui, sans-serif;
  }

  #dv-chatbot .dv-bot-launcher {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 9999;
    display: grid;
    height: 58px;
    width: 58px;
    place-items: center;
    border: none;
    border-radius: 9999px;
    background: linear-gradient(135deg, var(--dv-bot-cyan) 0%, var(--dv-bot-cyan-dark) 100%);
    color: #fff;
    font-size: 22px;
    cursor: pointer;
    box-shadow: 0 12px 28px rgba(0, 111, 158, .35);
    transition: transform .2s ease, box-shadow .2s ease;
  }

  #dv-chatbot .dv-bot-launcher:hover {
    transform: translateY(-2px);
    box-shadow: 0 16px 34px rgba(0, 111, 158, .45);
  }

  #dv-chatbot .dv-bot-launcher:focus-visible {
    outline: 3px solid var(--dv-bot-orange);
    outline-offset: 2px;
  }

  #dv-chatbot .dv-bot-panel {
    position: fixed;
    right: 20px;
    bottom: 90px;
    z-index: 9999;
    display: flex;
    width: min(400px, calc(100vw - 24px));
    max-height: min(620px, calc(100vh - 120px));
    flex-direction: column;
    overflow: hidden;
    border-radius: 20px;
    border: 1px solid var(--dv-bot-line);
    background: #fff;
    box-shadow: 0 24px 70px rgba(17, 24, 39, .22);
    transform: translateY(16px) scale(.98);
    opacity: 0;
    pointer-events: none;
    transition: transform .22s ease, opacity .22s ease;
  }

  #dv-chatbot .dv-bot-panel.dv-bot-open {
    transform: translateY(0) scale(1);
    opacity: 1;
    pointer-events: auto;
  }

  #dv-chatbot .dv-bot-header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px;
    background: linear-gradient(135deg, var(--dv-bot-cyan) 0%, var(--dv-bot-cyan-dark) 100%);
    color: #fff;
  }

  #dv-chatbot .dv-bot-avatar {
    display: grid;
    height: 40px;
    width: 40px;
    flex-shrink: 0;
    place-items: center;
    border-radius: 9999px;
    background: #fff;
    color: var(--dv-bot-cyan-dark);
    font-size: 18px;
  }

  #dv-chatbot .dv-bot-title {
    min-width: 0;
    flex: 1;
  }

  #dv-chatbot .dv-bot-title strong {
    display: block;
    font-size: 15px;
    font-weight: 800;
    letter-spacing: .01em;
  }

  #dv-chatbot .dv-bot-title span {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 2px;
    font-size: 11px;
    font-weight: 600;
    opacity: .9;
  }

  #dv-chatbot .dv-bot-status-dot {
    height: 7px;
    width: 7px;
    border-radius: 9999px;
    background: #8CF0B1;
  }

  #dv-chatbot .dv-bot-close {
    display: grid;
    height: 34px;
    width: 34px;
    flex-shrink: 0;
    place-items: center;
    border: none;
    border-radius: 9999px;
    background: rgba(255, 255, 255, .18);
    color: #fff;
    font-size: 15px;
    cursor: pointer;
    transition: background .2s ease;
  }

  #dv-chatbot .dv-bot-close:hover {
    background: rgba(255, 255, 255, .32);
  }

  #dv-chatbot .dv-bot-close:focus-visible {
    outline: 3px solid var(--dv-bot-orange);
    outline-offset: 2px;
  }

  #dv-chatbot .dv-bot-messages {
    display: flex;
    flex-direction: column;
    gap: 10px;
    overflow-y: auto;
    padding: 16px;
    background: var(--dv-bot-surface);
  }

  #dv-chatbot .dv-bot-msg {
    max-width: 85%;
    padding: 10px 14px;
    border-radius: 14px;
    font-size: 13.5px;
    line-height: 1.55;
    word-break: break-word;
    white-space: pre-wrap;
  }

  #dv-chatbot .dv-bot-msg.dv-bot-user {
    align-self: flex-end;
    border-bottom-right-radius: 4px;
    background: var(--dv-bot-cyan-dark);
    color: #fff;
  }

  #dv-chatbot .dv-bot-msg.dv-bot-assistant {
    align-self: flex-start;
    border-bottom-left-radius: 4px;
    background: #fff;
    border: 1px solid var(--dv-bot-line);
    color: var(--dv-bot-ink);
  }

  #dv-chatbot .dv-bot-msg a {
    color: var(--dv-bot-cyan-dark);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  #dv-chatbot .dv-bot-msg a:hover {
    color: var(--dv-bot-orange);
  }

  #dv-chatbot .dv-bot-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 0 16px 12px;
    background: var(--dv-bot-surface);
  }

  #dv-chatbot .dv-bot-chip {
    border: 1px solid var(--dv-bot-cyan);
    border-radius: 9999px;
    background: #fff;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: 700;
    color: var(--dv-bot-cyan-dark);
    cursor: pointer;
    transition: background .18s ease, color .18s ease;
  }

  #dv-chatbot .dv-bot-chip:hover {
    background: var(--dv-bot-cyan-dark);
    color: #fff;
  }

  #dv-chatbot .dv-bot-chip:focus-visible {
    outline: 3px solid var(--dv-bot-orange);
    outline-offset: 2px;
  }

  #dv-chatbot .dv-bot-inputbar {
    display: flex;
    gap: 8px;
    align-items: center;
    border-top: 1px solid var(--dv-bot-line);
    background: #fff;
    padding: 12px;
  }

  #dv-chatbot .dv-bot-input {
    min-width: 0;
    flex: 1;
    border: 1px solid var(--dv-bot-line);
    border-radius: 9999px;
    background: var(--dv-bot-surface);
    padding: 10px 16px;
    font-size: 13.5px;
    color: var(--dv-bot-ink);
    outline: none;
    transition: border-color .18s ease, box-shadow .18s ease;
  }

  #dv-chatbot .dv-bot-input:focus {
    border-color: var(--dv-bot-cyan);
    box-shadow: 0 0 0 3px rgba(0, 173, 239, .18);
  }

  #dv-chatbot .dv-bot-send {
    display: grid;
    height: 40px;
    width: 40px;
    flex-shrink: 0;
    place-items: center;
    border: none;
    border-radius: 9999px;
    background: var(--dv-bot-orange);
    color: #fff;
    font-size: 15px;
    cursor: pointer;
    transition: background .18s ease, transform .18s ease;
  }

  #dv-chatbot .dv-bot-send:hover {
    background: #C97019;
    transform: translateY(-1px);
  }

  #dv-chatbot .dv-bot-send:disabled {
    opacity: .55;
    cursor: not-allowed;
    transform: none;
  }

  #dv-chatbot .dv-bot-send:focus-visible {
    outline: 3px solid var(--dv-bot-cyan);
    outline-offset: 2px;
  }

  @media (max-width: 640px) {
    #dv-chatbot .dv-bot-panel {
      right: 12px;
      bottom: 84px;
      width: calc(100vw - 24px);
      max-height: calc(100vh - 108px);
    }

    #dv-chatbot .dv-bot-launcher {
      right: 16px;
      bottom: 16px;
    }
  }
</style>

<div id="dv-chatbot">
  <button class="dv-bot-launcher" type="button" id="dv-bot-launcher" aria-label="Open chat assistant" aria-expanded="false" aria-controls="dv-bot-panel">
    <i class="fa-solid fa-comment-dots" aria-hidden="true"></i>
  </button>

  <div class="dv-bot-panel" id="dv-bot-panel" role="dialog" aria-label="DxValley chat assistant">
    <div class="dv-bot-header">
      <span class="dv-bot-avatar" aria-hidden="true"><i class="fa-solid fa-robot"></i></span>
      <div class="dv-bot-title">
        <strong>DxValley Assist</strong>
        <span><span class="dv-bot-status-dot" aria-hidden="true"></span> Online — typical reply: instantly</span>
      </div>
      <button class="dv-bot-close" type="button" id="dv-bot-close" aria-label="Close chat assistant">
        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
      </button>
    </div>

    <div class="dv-bot-messages" id="dv-bot-messages" aria-live="polite"></div>

    <div class="dv-bot-chips" id="dv-bot-chips">
      <button class="dv-bot-chip" type="button" data-question="How do I apply?">How do I apply?</button>
      <button class="dv-bot-chip" type="button" data-question="Do I need a team?">Do I need a team?</button>
      <button class="dv-bot-chip" type="button" data-question="How much does it cost?">How much does it cost?</button>
      <button class="dv-bot-chip" type="button" data-question="How does the program work?">How does the program work?</button>
      <button class="dv-bot-chip" type="button" data-question="How can I contact you?">How can I contact you?</button>
    </div>

    <div class="dv-bot-inputbar">
      <label class="sr-only" for="dv-bot-input">Type your question</label>
      <input class="dv-bot-input" id="dv-bot-input" type="text" autocomplete="off" maxlength="300" placeholder="Ask about applying, programs, mentors..." />
      <button class="dv-bot-send" type="button" id="dv-bot-send" aria-label="Send message">
        <i class="fa-solid fa-paper-plane" aria-hidden="true"></i>
      </button>
    </div>
  </div>
</div>

<script>
  (() => {
    const launcher = document.getElementById('dv-bot-launcher');
    const panel = document.getElementById('dv-bot-panel');
    const messages = document.getElementById('dv-bot-messages');
    const input = document.getElementById('dv-bot-input');
    const sendBtn = document.getElementById('dv-bot-send');
    const closeBtn = document.getElementById('dv-bot-close');
    const chips = document.getElementById('dv-bot-chips');
    if (!launcher || !panel || !messages || !input || !sendBtn || !closeBtn || !chips) return;

    const R = <%- JSON.stringify(chatRoutes) %>;

    const FAQ = [
      {
        id: 'apply',
        keywords: ['apply', 'application', 'apply now', 'sign up', 'signup', 'register', 'enroll', 'startup application', 'deadline', 'closing', 'closes', 'when', 'cohort apply', 'next cohort'],
        reply: 'Applications are reviewed in cohorts. The current Batch 04 application window closes 30 September 2026. You can start your application from the "Apply now" button in the top navigation.',
        link: { href: R.apply, label: 'Start your application' }
      },
      {
        id: 'team',
        keywords: ['team', 'cofounder', 'co-founder', 'solo', 'individual', 'alone', 'partner', 'someone else', 'need a team'],
        reply: 'Not at all. You can apply as an individual and meet collaborators through the center, its workshops, and the cohort community.'
      },
      {
        id: 'who',
        keywords: ['who', 'eligible', 'eligibility', 'qualify', 'qualification', 'support', 'startup', 'msme', 'business', 'founder', 'what kind', 'what type', 'stage', 'idea', 'mvp', 'scale', 'requirements', 'criteria'],
        reply: 'DxValley supports early-stage startups and MSMEs solving meaningful problems. Current tracks focus on Idea, MVP, and Scale-Up progress — whether you are validating a concept or ready to grow.'
      },
      {
        id: 'how',
        keywords: ['how it works', 'how does it work', 'cohort', 'program', 'progression', 'process', 'steps', 'stage', 'track', 'curriculum', 'structure', 'what happens', 'journey', 'learn'],
        reply: 'Accepted founders move through a focused progression: 1) Apply, 2) Build, and 3) Scale. Each cohort combines structured learning, mentor conversations, practical milestones, and peer accountability tailored to the founder\'s current stage.'
      },
      {
        id: 'equity',
        keywords: ['equity', 'stake', 'shares', 'share', 'percentage', 'percent', 'ownership', 'own part'],
        reply: 'Program terms depend on the specific cohort and support package. The application team shares the current terms with you before acceptance.'
      },
      {
        id: 'cost',
        keywords: ['cost', 'fee', 'fees', 'free', 'price', 'pay', 'payment', 'tuition', 'paid', 'afford', 'expensive', 'money'],
        reply: 'Program fees depend on the specific cohort and support package. The application team will confirm current pricing before you join — reach out for details.'
      },
      {
        id: 'mentors',
        keywords: ['mentor', 'mentoring', 'mentorship', 'coach', 'coaching', 'advisor', 'expert', 'advice', 'guidance', 'help me grow'],
        reply: 'Every cohort connects you with expert mentors for practical guidance and accountability. You can browse available mentors on the Mentors page.',
        link: { href: R.mentors, label: 'View mentors' }
      },
      {
        id: 'funding',
        keywords: ['funding', 'fund', 'finance', 'financial', 'investment', 'invest', 'grant', 'loan', 'capital', 'raise', 'investor'],
        reply: 'DxValley\'s funding support helps founders prepare for the next chapter of growth. Visit the Funding page to learn more about available options.',
        link: { href: R.funding, label: 'Explore funding' }
      },
      {
        id: 'workshops',
        keywords: ['workshop', 'workshops', 'event', 'events', 'training', 'session', 'gallery', 'class', 'workshop schedule'],
        reply: 'DxValley regularly hosts hands-on workshops, trainings, and events for founders and the wider community. Browse the Workshops page for upcoming sessions.',
        link: { href: R.workshops, label: 'See workshops' }
      },
      {
        id: 'projects',
        keywords: ['project', 'projects', 'portfolio', 'showcase', 'startup directory', 'show my project', 'add project', 'list project'],
        reply: 'You can showcase your work through the Projects section, where founders share what they are building. Head to the Projects page to explore or list your project.',
        link: { href: R.projects, label: 'Explore projects' }
      },
      {
        id: 'partners',
        keywords: ['partner', 'partnership', 'partner with', 'sponsor', 'sponsorship', 'collaborate', 'cooperate', 'cooperative bank', 'coopbank', 'bank'],
        reply: 'Yes — we welcome mentors and partners who can share practical expertise, open doors, host workshops, or help founders build stronger businesses. DxValley is powered by Cooperative Bank of Oromia.',
        link: { href: '/v1/about', label: 'Learn about DxValley' }
      },
      {
        id: 'about',
        keywords: ['about', 'what is', 'who are you', 'who is', 'tell me', 'dxvalley', 'yourself', 'mission', 'vision', 'about us'],
        reply: 'DxValley is the incubation arm of Cooperative Bank of Oromia. We help Ethiopian founders turn bold ideas into investable, scalable businesses through structured cohorts, expert mentorship, and a supportive community.'
      },
      {
        id: 'contact',
        keywords: ['contact', 'email', 'phone', 'reach', 'talk', 'human', 'location', 'address', 'office', 'where', 'get in touch', 'support', 'complaint'],
        reply: 'You can reach the DxValley team at hello@dxvalley.com or through the Contact page. Our office is in Addis Ababa, Ethiopia.',
        link: { href: R.contact, label: 'Go to Contact page' }
      },
      {
        id: 'terms',
        keywords: ['terms', 'conditions', 'policy', 'privacy', 'legal', 'rules'],
        reply: 'You can review the official Terms and Conditions on our Terms page.',
        link: { href: '/v1/terms', label: 'Read the terms' }
      }
    ];

    const GREETING = 'Hi there! I\'m DxValley Assist. I can help with applying, programs, mentorship, funding, workshops, and more. Ask me anything below, or tap a quick question.';
    const FALLBACK = 'I\'m not sure I caught that. Try asking about applying, the program, mentorship, funding, workshops, or partnerships — or message the team at hello@dxvalley.com and a human will help you.';

    const normalize = (text) => text.toLowerCase().replace(/[^a-z0-9\s']/g, ' ').replace(/\s+/g, ' ').trim();
    const wait = (ms) => new Promise((resolve) => setTimeout(resolve, ms));

    const addMessage = (text, who, isHtml) => {
      const bubble = document.createElement('div');
      bubble.className = `dv-bot-msg dv-bot-${who}`;
      if (isHtml) bubble.innerHTML = text;
      else bubble.textContent = text;
      messages.appendChild(bubble);
      messages.scrollTop = messages.scrollHeight;
      return bubble;
    };

    const renderReply = (reply, link) => {
      if (!link) return reply;
      const encoded = reply.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      return `${encoded}<br /><br /><a href="${link.href}" target="_blank" rel="noopener">${link.label} <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></a>`;
    };

    const answer = (raw) => {
      const query = normalize(raw);
      if (!query) return null;

      const smalltalk = [
        { match: /^(hi|hii+|hey|hello|yo|good (morning|afternoon|evening)|hi there)\b/, reply: 'Hello! How can I help you today? You can ask about applying, programs, mentorship, funding, or workshops.' },
        { match: /thank(s)?|thx|appreciate|grateful/, reply: 'You\'re welcome! Is there anything else I can help with?' },
        { match: /\bbye\b|goodbye|see you|good night/, reply: 'Goodbye! Feel free to come back anytime you need help.' }
      ];

      for (const item of smalltalk) {
        if (item.match.test(query)) return item.reply;
      }

      let best = null;
      let bestScore = 0;
      for (const faq of FAQ) {
        let score = 0;
        for (const keyword of faq.keywords) {
          if (query.includes(normalize(keyword))) score += 1;
        }
        if (score > bestScore) {
          best = faq;
          bestScore = score;
        }
      }

      return best ? { reply: best.reply, link: best.link } : FALLBACK;
    };

    const send = async (raw) => {
      const text = (raw ?? input.value).trim();
      if (!text) return;

      addMessage(text, 'user');
      input.value = '';

      const typing = addMessage('Typing...', 'assistant');
      await wait(500 + Math.min(text.length * 8, 800));

      const result = answer(text);
      typing.remove();

      if (typeof result === 'string') {
        addMessage(result, 'assistant');
      } else {
        addMessage(renderReply(result.reply, result.link), 'assistant', true);
      }
    };

    let opened = false;
    const openPanel = () => {
      panel.classList.add('dv-bot-open');
      launcher.setAttribute('aria-expanded', 'true');
      if (!opened) {
        opened = true;
        addMessage(GREETING, 'assistant');
      }
      input.focus();
    };

    const closePanel = () => {
      panel.classList.remove('dv-bot-open');
      launcher.setAttribute('aria-expanded', 'false');
    };

    launcher.addEventListener('click', openPanel);
    closeBtn.addEventListener('click', closePanel);
    sendBtn.addEventListener('click', () => send());
    input.addEventListener('keydown', (event) => {
      if (event.key === 'Enter') send();
    });

    chips.addEventListener('click', (event) => {
      const chip = event.target.closest('[data-question]');
      if (!chip) return;
      if (!panel.classList.contains('dv-bot-open')) openPanel();
      send(chip.dataset.question);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && panel.classList.contains('dv-bot-open')) {
        closePanel();
        launcher.focus();
      }
    });
  })();
</script>
