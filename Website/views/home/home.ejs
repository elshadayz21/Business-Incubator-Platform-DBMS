      <p class="text-lg text-muted font-medium mt-4">Stay up to date with the latest news, events, and cohort openings at DxValley.</p>
    </div>

    <div id="home-announcements-list" class="divide-y divide-line border-y border-line">
      <div class="py-4 text-center text-sm font-semibold text-muted">Loading announcements...</div>
    </div>
  </div>
</section>

<!-- Final CTA Section -->
<section class="bg-white py-20">
  <div class="mx-auto max-w-7xl px-6 lg:px-10 text-center">
    <h2 class="text-3xl font-extrabold tracking-tight text-ink sm:text-4xl">Ready to turn your idea into impact?</h2>
    <p class="mt-4 text-lg text-muted">Join the next cohort and build with a community that moves further, together.</p>

    <div class="mt-8 flex justify-center">
      <!-- HIDE APPLY BUTTON IF LOGGED IN -->
      <% if (!user) { %>
        <button onclick="handleGlobalApply()" class="inline-flex items-center justify-center gap-3 rounded-xl bg-orange px-8 py-4 text-sm font-extrabold text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-orange-dark">
          Start your application
          <i class="fa-solid fa-arrow-right text-xs"></i>
        </button>
      <% } %>
    </div>
  </div>
</section>

<script>
  // --- Smart Apply Button Logic ---
  window.handleGlobalApply = () => {
    if (window.announcementData && window.announcementData.length > 0) {
      const openCallIndex = window.announcementData.findIndex(ann => ann.is_open_call);
      if (openCallIndex !== -1) {
        window.location.href = `/v1/auth/signup`;
        return;
      }
    }
    const updatesSection = document.getElementById('announcements');
    if (updatesSection) {
      updatesSection.scrollIntoView({ behavior: 'smooth', block: 'center' });
    } else {
      window.location.href = '/v1/auth/signup';
    }
  };

  // --- Fetch Announcements ---
  (async () => {
    try {
      const response = await fetch('/api/public/announcements');
      let announcements = await response.json();

      const container = document.getElementById('home-announcements-list');
      if (!container) return;

      if (announcements.length === 0) {
        container.innerHTML = '<div class="py-4 text-center text-sm font-semibold text-muted">No new announcements at this time. Check back soon!</div>';
        return;
      }

      window.announcementData = announcements;

      container.innerHTML = announcements.map((ann, index) => {
        const dateStr = new Date(ann.created_at).toLocaleDateString('en-US', { day: '2-digit', month: 'short', year: 'numeric' });
        const isOpenCall = ann.is_open_call;

        if (isOpenCall) {
          return `
            <div class="group flex gap-4 py-4 cursor-pointer rounded-xl hover:bg-[#F6FAFC] transition p-2" onclick="window.location.href='/v1/auth/signup'">
              <span class="w-20 shrink-0 text-xs font-semibold text-muted">${dateStr}</span>
              <span class="text-sm font-semibold leading-6 text-ink transition group-hover:text-cyan-dark flex-grow">${ann.title}</span>
              <span class="ml-auto text-xs font-bold text-[#E38524] bg-[#FFF1E3] px-2 py-1 rounded-full border border-[#E38524]/20">Apply Now</span>
            </div>
          `;
        } else {
          return `
            <div class="group flex gap-4 py-4">
              <span class="w-20 shrink-0 text-xs font-semibold text-muted">${dateStr}</span>
              <span class="text-sm font-semibold leading-6 text-ink transition group-hover:text-cyan-dark flex-grow">${ann.title}</span>
            </div>
          `;
        }
      }).join('');

    } catch (error) {
      console.error('Error fetching home announcements:', error);
    }
  })();


  <section id="how-it-works" class="bg-cyan text-white">
    <div class="mx-auto max-w-7xl px-6 py-24 lg:px-10 lg:py-28">
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <div><p class="text-xs font-extrabold uppercase tracking-[.2em] text-white/70">A focused progression</p><h2 class="mt-4 max-w-[650px] text-4xl font-extrabold tracking-[-.04em] sm:text-5xl">Your path from idea to impact</h2></div>
        <p class="max-w-[320px] text-sm leading-7 text-white/75">Every cohort is designed to help you make the next useful decision — not just attend another program.</p>
      </div>

      <div class="relative mt-16 grid gap-8 md:grid-cols-3 md:gap-6">
        <div class="absolute left-[16.5%] right-[16.5%] top-7 hidden h-px bg-white/40 md:block" aria-hidden="true"></div>
        <article class="dv-reveal relative" data-delay="0"><div class="relative z-10 grid h-14 w-14 place-items-center rounded-full bg-orange text-lg font-extrabold text-white ring-8 ring-cyan">01</div><div class="mt-8 rounded-2xl bg-white p-6 text-ink shadow-[0_14px_28px_rgba(0,67,103,.14)]"><h3 class="text-xl font-extrabold">Apply</h3><p class="mt-3 text-sm leading-7 text-muted">Tell us what you are building, who it serves, and what you need to learn next.</p></div></article>
        <article class="dv-reveal relative" data-delay="90"><div class="relative z-10 grid h-14 w-14 place-items-center rounded-full bg-orange text-lg font-extrabold text-white ring-8 ring-cyan">02</div><div class="mt-8 rounded-2xl bg-white p-6 text-ink shadow-[0_14px_28px_rgba(0,67,103,.14)]"><h3 class="text-xl font-extrabold">Build</h3><p class="mt-3 text-sm leading-7 text-muted">Move through the right learning sprint with mentors, workshops, and a peer cohort.</p></div></article>
        <article class="dv-reveal relative" data-delay="180"><div class="relative z-10 grid h-14 w-14 place-items-center rounded-full bg-orange text-lg font-extrabold text-white ring-8 ring-cyan">03</div><div class="mt-8 rounded-2xl bg-white p-6 text-ink shadow-[0_14px_28px_rgba(0,67,103,.14)]"><h3 class="text-xl font-extrabold">Scale</h3><p class="mt-3 text-sm leading-7 text-muted">Turn progress into proof, partnerships, and a stronger platform for sustainable growth.</p></div></article>
      </div>
    </div>
  </section>

  <section id="community" class="bg-white">
    <div class="mx-auto grid max-w-7xl gap-14 px-6 py-24 lg:grid-cols-[1.45fr_.55fr] lg:gap-24 lg:px-10 lg:py-28">
      <article id="stories" class="dv-reveal overflow-hidden rounded-[26px] bg-surface" data-delay="0">
        <div class="grid min-h-[350px] items-end bg-gradient-to-br from-cyan-soft via-white to-orange-soft p-7 sm:p-10">
          <div class="max-w-[610px]"><p class="text-xs font-extrabold uppercase tracking-[.2em] text-orange">Inside the community</p><h2 class="mt-4 text-4xl font-extrabold leading-tight tracking-[-.04em] text-cyan-dark sm:text-5xl">Founders move further when they do the work together.</h2><blockquote class="mt-7 border-l-2 border-orange pl-5 text-base italic leading-7 text-muted">“DxValley gave us the structure to test the right assumptions, and the people around us made every hard week feel less lonely.”</blockquote><p class="mt-4 text-xs font-bold uppercase tracking-wider text-ink">— An incubatee, Batch 03</p></div>
        </div>
        <div class="flex flex-col items-start justify-between gap-4 border-t border-line bg-white px-7 py-5 sm:flex-row sm:items-center sm:px-10"><p class="text-sm font-semibold text-muted">A place to learn, share, and keep building.</p><a class="inline-flex items-center gap-2 text-sm font-bold text-cyan-dark transition hover:text-orange" href="#community">See the community <i class="fa-solid fa-arrow-right text-xs" aria-hidden="true"></i></a></div>
      </article>

      <aside class="dv-reveal lg:pt-8" data-delay="120"><p class="text-xs font-extrabold uppercase tracking-[.2em] text-orange">The ecosystem</p><div class="mt-7 divide-y divide-line border-y border-line"><div class="py-5"><p class="text-4xl font-extrabold tracking-[-.05em] text-cyan-dark">2</p><p class="mt-1 text-sm font-semibold text-muted">cohorts each year</p></div><div class="py-5"><p class="text-4xl font-extrabold tracking-[-.05em] text-cyan-dark">4</p><p class="mt-1 text-sm font-semibold text-muted">roles in the ecosystem</p></div><div class="py-5"><p class="text-4xl font-extrabold tracking-[-.05em] text-cyan-dark">1</p><p class="mt-1 text-sm font-semibold text-muted">founder network</p></div></div></aside>
    </div>
  </section>

  <% if (!isUserSignedIn) { %>
    <section id="apply" class="bg-cyan-soft">
      <div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-8 px-6 py-16 lg:flex-row lg:items-center lg:px-10 lg:py-20">
        <div><p class="text-xs font-extrabold uppercase tracking-[.2em] text-orange">Your next chapter starts here</p><h2 class="mt-3 max-w-[720px] text-4xl font-extrabold tracking-[-.04em] text-cyan-dark sm:text-5xl">Ready to turn your idea into impact?</h2><p class="mt-4 text-base text-muted">Applications are reviewed in cohorts. Bring the problem, the curiosity, and the courage to begin.</p></div>
         <a class="inline-flex shrink-0 items-center gap-3 rounded-md bg-orange px-7 py-4 text-sm font-extrabold text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-orange-dark focus:outline-none focus:ring-2 focus:ring-orange focus:ring-offset-2 cursor-pointer"
         onclick="handleGlobalApply()">
          Start your application
         <i class="fa-solid fa-arrow-right text-xs" aria-hidden="true"></i></a>
      </div>
    </section>
  <% } %>
</main>

<script>
  const revealItems = document.querySelectorAll('.dv-reveal');
  if ('IntersectionObserver' in window) {
    const revealObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.style.animationDelay = `${entry.target.dataset.delay || 0}ms`;
        entry.target.classList.add('dv-visible');
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.12 });
    revealItems.forEach((item) => revealObserver.observe(item));
  } else {
    revealItems.forEach((item) => item.classList.add('dv-visible'));
  }
</script>
