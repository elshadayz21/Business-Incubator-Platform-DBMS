<!-- Latest Announcements / Updates -->
<section id="announcements" class="bg-surface py-20">
  <div class="mx-auto max-w-7xl px-6 lg:px-10">
    <div class="mb-12 text-center max-w-2xl mx-auto">
      <span class="bg-[#EAF8FC] text-[#00ADEF] px-3 py-1 font-bold text-xs uppercase tracking-wider mb-3 inline-block rounded-full border border-[#00ADEF]/20">
        News & Updates
      </span>
      <h2 class="text-4xl md:text-5xl font-extrabold tracking-tight text-cyan-dark">Latest updates</h2>
      <p class="text-lg text-muted font-medium mt-4">Stay up to date with the latest news, events, and cohort openings at DxValley.</p>
    </div>

    <div id="home-announcements-list" class="divide-y divide-line border-y border-line">
      <div class="py-4 text-center text-sm font-semibold text-muted">Loading announcements...</div>
    </div>
  </div>
</section>

<!-- Final CTA Section -->
<section class="bg-white py-20">
  <div class="mx-auto max-w-7xl px-6 lg:px-10 text-center">
    <h2 class="text-3xl font-extrabold tracking-tight text-ink sm:text-4xl">Ready to turn your idea into impact?</h2>
    <p class="mt-4 text-lg text-muted">Join the next cohort and build with a community that moves further, together.</p>

    <div class="mt-8 flex justify-center">
      <!-- HIDE APPLY BUTTON IF LOGGED IN -->
      <% if (!user) { %>
        <button onclick="handleGlobalApply()" class="inline-flex items-center justify-center gap-3 rounded-xl bg-orange px-8 py-4 text-sm font-extrabold text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-orange-dark">
          Start your application
          <i class="fa-solid fa-arrow-right text-xs"></i>
        </button>
      <% } %>
    </div>
  </div>
</section>

<script>
  // --- Smart Apply Button Logic ---
  window.handleGlobalApply = () => {
    if (window.announcementData && window.announcementData.length > 0) {
      const openCallIndex = window.announcementData.findIndex(ann => ann.is_open_call);
      if (openCallIndex !== -1) {
        window.location.href = `/v1/auth/signup`;
        return;
      }
    }
    const updatesSection = document.getElementById('announcements');
    if (updatesSection) {
      updatesSection.scrollIntoView({ behavior: 'smooth', block: 'center' });
    } else {
      window.location.href = '/v1/auth/signup';
    }
  };

  // --- Fetch Announcements ---
  (async () => {
    try {
      const response = await fetch('/api/public/announcements');
      let announcements = await response.json();

      const container = document.getElementById('home-announcements-list');
      if (!container) return;

      if (announcements.length === 0) {
        container.innerHTML = '<div class="py-4 text-center text-sm font-semibold text-muted">No new announcements at this time. Check back soon!</div>';
        return;
      }

      window.announcementData = announcements;

      container.innerHTML = announcements.map((ann, index) => {
        const dateStr = new Date(ann.created_at).toLocaleDateString('en-US', { day: '2-digit', month: 'short', year: 'numeric' });
        const isOpenCall = ann.is_open_call;

        if (isOpenCall) {
          return `
            <div class="group flex gap-4 py-4 cursor-pointer rounded-xl hover:bg-[#F6FAFC] transition p-2" onclick="window.location.href='/v1/auth/signup'">
              <span class="w-20 shrink-0 text-xs font-semibold text-muted">${dateStr}</span>
              <span class="text-sm font-semibold leading-6 text-ink transition group-hover:text-cyan-dark flex-grow">${ann.title}</span>
              <span class="ml-auto text-xs font-bold text-[#E38524] bg-[#FFF1E3] px-2 py-1 rounded-full border border-[#E38524]/20">Apply Now</span>
            </div>
          `;
        } else {
          return `
            <div class="group flex gap-4 py-4">
              <span class="w-20 shrink-0 text-xs font-semibold text-muted">${dateStr}</span>
              <span class="text-sm font-semibold leading-6 text-ink transition group-hover:text-cyan-dark flex-grow">${ann.title}</span>
            </div>
          `;
        }
      }).join('');

    } catch (error) {
      console.error('Error fetching home announcements:', error);
    }
  })();

  // --- Fetch Photo Gallery ---
    // --- Fetch Photo Gallery & Auto-Slide ---
    (async () => {
      try {
        const response = await fetch('/api/public/gallery');
        const images = await response.json();

        const imgElement = document.getElementById('home-gallery-image');
        const captionBox = document.getElementById('home-gallery-caption-box');
        const captionText = document.getElementById('home-gallery-caption');

        if (!imgElement) return;

        if (images.length === 0) {
          imgElement.src = "https://images.unsplash.com/photo-1517245386807-bb43f82fee33?w=800"; // Fallback image
          imgElement.classList.remove('opacity-0');
          return;
        }

        let currentIndex = 0;

        const showImage = (index) => {
          // Fade out current image
          imgElement.classList.add('opacity-0');
          captionBox.classList.add('opacity-0');

          // Wait for fade out, then change image and fade back in
          setTimeout(() => {
            const img = images[index];
            // Check for image_url or url depending on what the backend returns
            const imgUrl = img.image_url || img.url;
            const title = img.title || 'DxValley Moment';

            imgElement.src = imgUrl;
            imgElement.alt = title;
            captionText.textContent = title;

            // Fade in new image
            imgElement.classList.remove('opacity-0');
            captionBox.classList.remove('opacity-0');
          }, 500); // 500ms matches the CSS transition duration
        };

        // Show first image immediately
        showImage(currentIndex);

        // Change image every 4 seconds
        setInterval(() => {
          currentIndex = (currentIndex + 1) % images.length;
          showImage(currentIndex);
        }, 4000);

      } catch (error) {
        console.error('Error fetching gallery:', error);
        const imgElement = document.getElementById('home-gallery-image');
        if (imgElement) imgElement.src = "https://images.unsplash.com/photo-1517245386807-bb43f82fee33?w=800";
        if (imgElement) imgElement.classList.remove('opacity-0');
      }
    })();
</script>