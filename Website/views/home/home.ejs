<script>
  let homeCountdownInterval;
  let homeRefreshInterval;
  let currentDeadlineId = null;

  function updateCountdownValues(deadline) {
    const now = new Date().getTime();
    const distance = deadline - now;
    const banner = document.getElementById('home-countdown-banner');

    if (distance < 0) {
      if (homeCountdownInterval) clearInterval(homeCountdownInterval);
      if (banner) {
        banner.innerHTML = '<div class="text-center py-2"><span class="bg-red-500 px-4 py-2 rounded-full text-sm font-bold">APPLICATION CLOSED</span></div>';
      }
      return;
    }

    const days = Math.floor(distance / (1000 * 60 * 60 * 24));
    const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
    const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
    const seconds = Math.floor((distance % (1000 * 60)) / 1000);

    const daysEl = document.getElementById('home-days');
    const hoursEl = document.getElementById('home-hours');
    const minutesEl = document.getElementById('home-minutes');
    const secondsEl = document.getElementById('home-seconds');

    if (daysEl) daysEl.textContent = days;
    if (hoursEl) hoursEl.textContent = hours;
    if (minutesEl) minutesEl.textContent = minutes;
    if (secondsEl) secondsEl.textContent = seconds;
  }

  let lastDeadlineMs = null;

  function startHomeCountdown(announcements) {
    const openCalls = announcements.filter(ann => ann.is_open_call && ann.deadline);
    const banner = document.getElementById('home-countdown-banner');
    if (openCalls.length === 0) {
      if (banner) banner.classList.add('hidden');
      return;
    }

    const latest = openCalls[0];
    const deadlineDate = new Date(latest.deadline).getTime();
    const newDeadlineId = latest.id;

    if (currentDeadlineId === newDeadlineId && lastDeadlineMs === deadlineDate) {
      return;
    }

    currentDeadlineId = newDeadlineId;
    lastDeadlineMs = deadlineDate;

    if (banner) {
      banner.classList.remove('hidden');
      banner.innerHTML = `
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
          <div class="flex items-center gap-3">
            <span class="w-10 h-10 bg-white/20 rounded-full flex items-center justify-center">
              <i class="fa-solid fa-clock text-sm"></i>
            </span>
            <div>
              <p class="text-xs font-bold uppercase tracking-wider text-white/80">Application Deadline</p>
              <p class="text-sm font-extrabold">${latest.title}</p>
            </div>
          </div>
          <div class="flex gap-3 text-center">
            <div class="bg-white/10 rounded-lg px-3 py-2 min-w-[60px]">
              <span id="home-days" class="text-2xl font-extrabold block">0</span>
              <span class="text-[10px] font-bold uppercase text-white/70">Days</span>
            </div>
            <div class="bg-white/10 rounded-lg px-3 py-2 min-w-[60px]">
              <span id="home-hours" class="text-2xl font-extrabold block">0</span>
              <span class="text-[10px] font-bold uppercase text-white/70">Hours</span>
            </div>
            <div class="bg-white/10 rounded-lg px-3 py-2 min-w-[60px]">
              <span id="home-minutes" class="text-2xl font-extrabold block">0</span>
              <span class="text-[10px] font-bold uppercase text-white/70">Mins</span>
            </div>
            <div class="bg-white/10 rounded-lg px-3 py-2 min-w-[60px]">
              <span id="home-seconds" class="text-2xl font-extrabold block">0</span>
              <span class="text-[10px] font-bold uppercase text-white/70">Secs</span>
            </div>
          </div>
        </div>
      `;
    }

    if (homeCountdownInterval) clearInterval(homeCountdownInterval);
    updateCountdownValues(deadlineDate);
    homeCountdownInterval = setInterval(() => updateCountdownValues(deadlineDate), 1000);
  }

  // --- SMART APPLY BUTTON LOGIC (NOW REDIRECTS TO DEDICATED PAGE!) ---
  window.handleGlobalApply = () => {
    if (window.announcementData && window.announcementData.length > 0) {
      const openCall = window.announcementData.find(ann => ann.is_open_call);
      if (openCall) {
        window.location.href = `/apply/${openCall.id}`; // REDIRECTS!
        return;
      }
    }
    const updatesSection = document.getElementById('announcements');
    if (updatesSection) {
      updatesSection.scrollIntoView({ behavior: 'smooth', block: 'center' });
    } else {
      alert('Applications are not open right now. Please check back soon!');
    }
  };

  async function refreshAnnouncements() {
    try {
      const response = await fetch('/api/public/announcements');
      let announcements = await response.json();
      window.announcementData = announcements;
      startHomeCountdown(announcements);
    } catch (error) {
      console.error('Error refreshing announcements:', error);
    }
  }

  (async () => {
    try {
      const response = await fetch('/api/public/announcements');
      let announcements = await response.json();

      const container = document.getElementById('home-announcements-list');
      if (!container) return;

      if (announcements.length === 0) {
        container.innerHTML = '<div class="py-4 text-center text-sm font-semibold text-muted">No new announcements at this time. Check back soon!</div>';
        window.announcementData = [];
        return;
      }

      window.announcementData = announcements;
      startHomeCountdown(announcements);
      homeRefreshInterval = setInterval(refreshAnnouncements, 30000);

      container.innerHTML = announcements.map((ann, index) => {
        const dateStr = new Date(ann.created_at).toLocaleDateString('en-US', { day: '2-digit', month: 'short', year: 'numeric' });
        const isOpenCall = ann.is_open_call;

        if (isOpenCall) {
          return `
            <div class="group flex gap-4 py-4 cursor-pointer rounded-xl hover:bg-[#F6FAFC] transition p-2" onclick="window.location.href='/apply/${ann.id}'">
              <span class="w-20 shrink-0 text-xs font-semibold text-muted">${dateStr}</span>
              <span class="text-sm font-semibold leading-6 text-ink transition group-hover:text-cyan-dark flex-grow">${ann.title}</span>
              <span class="ml-auto text-xs font-bold text-[#E38524] bg-[#FFF1E3] px-2 py-1 rounded-full border border-[#E38524]/20">Apply Now</span>
            </div>
          `;
        } else {
          return `
            <div class="group flex gap-4 py-4 cursor-pointer rounded-xl hover:bg-[#F6FAFC] transition p-2" onclick="openAnnouncementDetail(${index})">
              <span class="w-20 shrink-0 text-xs font-semibold text-muted">${dateStr}</span>
              <span class="text-sm font-semibold leading-6 text-ink transition group-hover:text-cyan-dark flex-grow">${ann.title}</span>
              <i class="fa-solid fa-arrow-up-right-from-square ml-auto mt-1 shrink-0 text-xs text-cyan" aria-hidden="true"></i>
            </div>
          `;
        }
      }).join('');

    } catch (error) {
      console.error('Error fetching home announcements:', error);
    }
  })();
</script>



