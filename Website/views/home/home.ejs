        </div>

        <!-- Gallery Grid Container -->
                <!-- Single Image Slider Container -->
                <div class="relative w-full aspect-video rounded-2xl overflow-hidden shadow-lg border border-[#D6E4EA] bg-[#F6FAFC]">
                  <img id="home-gallery-image" src="" alt="DxValley Gallery" class="w-full h-full object-cover transition-opacity duration-700 ease-in-out opacity-0" />

                  <!-- Caption Overlay -->
                  <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/70 to-transparent p-4 opacity-0 transition-opacity duration-700" id="home-gallery-caption-box">
                    <p id="home-gallery-caption" class="text-white text-sm font-bold uppercase tracking-wider"></p>
                  </div>
                </div>S
        </div>
