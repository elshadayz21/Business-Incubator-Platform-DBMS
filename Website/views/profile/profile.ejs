                                                <input
                                                  type="text"
                                                  id="negotiation-input-<%= request.id %>"
                                                  placeholder="Send a message..."
                                                  class="flex-1 rounded-md border border-line px-3 py-2 text-xs outline-none focus:border-cyan"
                                                />
                                                <button
                                                  type="button"
                                                  onclick="sendNegotiation(<%= request.id %>)"
