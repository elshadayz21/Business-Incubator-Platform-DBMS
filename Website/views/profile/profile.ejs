<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head.ejs') %>

<body class="bg-surface text-ink min-h-screen flex flex-col font-sans">
    <%- include('../partials/header.ejs') %>

    <main class="flex-1 px-6 py-12 lg:px-10">
        <div class="max-w-7xl mx-auto">

            <div class="mb-10">
                <p class="text-xs font-extrabold uppercase tracking-[.2em] text-orange">User Settings</p>
                <h1 class="mt-3 max-w-[680px] text-4xl font-extrabold leading-tight tracking-[-.04em] text-cyan-dark sm:text-5xl">
                    Your <span class="text-orange">Profile</span>
                </h1>
                <p class="mt-3 text-sm text-muted">Manage your account, projects, funding, workshops and activity.</p>
                <% if (user.role === 'admin' || user.role === 'superadmin') { %>
                    <a href="/admin"
                        class="mt-5 inline-flex items-center gap-2 rounded-full border border-line bg-white px-5 py-2.5 text-xs font-bold text-cyan-dark transition hover:border-cyan hover:bg-cyan-soft">
                        <i class="fa-solid fa-arrow-left text-[11px]" aria-hidden="true"></i>
                        Back to <%= user.role %> Dashboard
                    </a>
                <% } %>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">

                <aside class="lg:col-span-3">
                    <div class="rounded-2xl border border-line bg-white p-5 shadow-sm lg:sticky lg:top-6">
                        <nav class="space-y-1.5">
                            <!-- Tab: Profile Info (All) -->
                            <a href="?tab=info"
                                class="flex items-center gap-3 rounded-lg px-4 py-3 text-sm font-bold transition <%= dashboard.activeTab === 'info' ? 'bg-cyan text-white shadow-sm' : 'text-ink hover:bg-cyan-soft hover:text-cyan-dark' %>">
                                <span class="w-5 text-center text-base"><i class="fa-solid fa-id-card" aria-hidden="true"></i></span>
                                <span>Profile Info</span>
                            </a>

                            <% if (user.role === 'entrepreneur') { %>
                                <!-- Tab: My Projects (Entrepreneur) -->
                                <a href="?tab=projects"
                                    class="flex items-center gap-3 rounded-lg px-4 py-3 text-sm font-bold transition <%= dashboard.activeTab === 'projects' ? 'bg-cyan text-white shadow-sm' : 'text-ink hover:bg-cyan-soft hover:text-cyan-dark' %>">
                                    <span class="w-5 text-center text-base"><i class="fa-solid fa-rocket" aria-hidden="true"></i></span>
                                    <span>My Projects</span>
                                    <span class="ml-auto rounded-full bg-cyan-soft px-2 py-0.5 text-[10px] font-bold text-cyan-dark <%= dashboard.activeTab === 'projects' ? 'bg-white/20 text-white' : '' %>"><%= dashboard.projects.length %></span>
                                </a>
                                <!-- Tab: Funding Requests (Entrepreneur) -->
                                <a href="?tab=funding"
                                    class="flex items-center gap-3 rounded-lg px-4 py-3 text-sm font-bold transition <%= dashboard.activeTab === 'funding' ? 'bg-cyan text-white shadow-sm' : 'text-ink hover:bg-cyan-soft hover:text-cyan-dark' %>">
                                    <span class="w-5 text-center text-base"><i class="fa-solid fa-money-bill" aria-hidden="true"></i></span>
                                    <span>Funding Requests</span>
                                    <span class="ml-auto rounded-full bg-cyan-soft px-2 py-0.5 text-[10px] font-bold text-cyan-dark <%= dashboard.activeTab === 'funding' ? 'bg-white/20 text-white' : '' %>"><%= dashboard.fundingRequests.length %></span>
                                </a>
                                <!-- Tab: Enrolled Workshops (Entrepreneur) -->
                                <a href="?tab=workshops"
                                    class="flex items-center gap-3 rounded-lg px-4 py-3 text-sm font-bold transition <%= dashboard.activeTab === 'workshops' ? 'bg-cyan text-white shadow-sm' : 'text-ink hover:bg-cyan-soft hover:text-cyan-dark' %>">
                                    <span class="w-5 text-center text-base"><i class="fa-solid fa-graduation-cap" aria-hidden="true"></i></span>
                                    <span>My Workshops</span>
                                    <span class="ml-auto rounded-full bg-cyan-soft px-2 py-0.5 text-[10px] font-bold text-cyan-dark <%= dashboard.activeTab === 'workshops' ? 'bg-white/20 text-white' : '' %>"><%= dashboard.workshops.length %></span>
                                </a>
                                <!-- Tab: Notifications (Entrepreneur) -->
                                <% let unreadCount = dashboard.notifications.filter(n => !n.read).length; %>
                                <a href="?tab=notifications"
                                    class="flex items-center gap-3 rounded-lg px-4 py-3 text-sm font-bold transition <%= dashboard.activeTab === 'notifications' ? 'bg-cyan text-white shadow-sm' : 'text-ink hover:bg-cyan-soft hover:text-cyan-dark' %>">
                                    <span class="w-5 text-center text-base"><i class="fa-solid fa-bell" aria-hidden="true"></i></span>
                                    <span>Notifications</span>
                                    <% if (unreadCount > 0) { %>
                                        <span class="ml-auto grid min-w-5 place-items-center rounded-full bg-orange px-1.5 py-0.5 text-[10px] font-bold text-white"><%= unreadCount %></span>
                                    <% } %>
                                </a>
                            <% } else if (user.role === 'mentor') { %>
                                <!-- Tab: Assigned Projects (Mentor) -->
                                <a href="?tab=projects"
                                    class="flex items-center gap-3 rounded-lg px-4 py-3 text-sm font-bold transition <%= dashboard.activeTab === 'projects' ? 'bg-cyan text-white shadow-sm' : 'text-ink hover:bg-cyan-soft hover:text-cyan-dark' %>">
                                    <span class="w-5 text-center text-base"><i class="fa-solid fa-screwdriver-wrench" aria-hidden="true"></i></span>
                                    <span>Assigned Projects</span>
                                    <span class="ml-auto rounded-full bg-cyan-soft px-2 py-0.5 text-[10px] font-bold text-cyan-dark <%= dashboard.activeTab === 'projects' ? 'bg-white/20 text-white' : '' %>"><%= dashboard.projects.length %></span>
                                </a>
                                <!-- Tab: Workshops Led (Mentor) -->
                                <a href="?tab=workshops"
                                    class="flex items-center gap-3 rounded-lg px-4 py-3 text-sm font-bold transition <%= dashboard.activeTab === 'workshops' ? 'bg-cyan text-white shadow-sm' : 'text-ink hover:bg-cyan-soft hover:text-cyan-dark' %>">
                                    <span class="w-5 text-center text-base"><i class="fa-solid fa-chalkboard-user" aria-hidden="true"></i></span>
                                    <span>Workshops Led</span>
                                    <span class="ml-auto rounded-full bg-cyan-soft px-2 py-0.5 text-[10px] font-bold text-cyan-dark <%= dashboard.activeTab === 'workshops' ? 'bg-white/20 text-white' : '' %>"><%= dashboard.workshops.length %></span>
                                </a>
                            <% } else if (user.role === 'investor') { %>
                                <!-- Tab: Pending Funding (Investor) -->
                                <a href="?tab=funding"
                                    class="flex items-center gap-3 rounded-lg px-4 py-3 text-sm font-bold transition <%= dashboard.activeTab === 'funding' ? 'bg-cyan text-white shadow-sm' : 'text-ink hover:bg-cyan-soft hover:text-cyan-dark' %>">
                                    <span class="w-5 text-center text-base"><i class="fa-solid fa-inbox" aria-hidden="true"></i></span>
                                    <span>Pending Funding</span>
                                    <span class="ml-auto rounded-full bg-cyan-soft px-2 py-0.5 text-[10px] font-bold text-cyan-dark <%= dashboard.activeTab === 'funding' ? 'bg-white/20 text-white' : '' %>"><%= dashboard.pendingRequests.length %></span>
                                </a>
                                <!-- Tab: Portfolio (Investor) -->
                                <a href="?tab=portfolio"
                                    class="flex items-center gap-3 rounded-lg px-4 py-3 text-sm font-bold transition <%= dashboard.activeTab === 'portfolio' ? 'bg-cyan text-white shadow-sm' : 'text-ink hover:bg-cyan-soft hover:text-cyan-dark' %>">
                                    <span class="w-5 text-center text-base"><i class="fa-solid fa-briefcase" aria-hidden="true"></i></span>
                                    <span>My Portfolio</span>
                                    <span class="ml-auto rounded-full bg-cyan-soft px-2 py-0.5 text-[10px] font-bold text-cyan-dark <%= dashboard.activeTab === 'portfolio' ? 'bg-white/20 text-white' : '' %>"><%= dashboard.portfolio.length %></span>
                                </a>
                            <% } %>

                            <!-- Tab: Activity Timeline (All) -->
                            <a href="?tab=timeline"
                                class="flex items-center gap-3 rounded-lg px-4 py-3 text-sm font-bold transition <%= dashboard.activeTab === 'timeline' ? 'bg-cyan text-white shadow-sm' : 'text-ink hover:bg-cyan-soft hover:text-cyan-dark' %>">
                                <span class="w-5 text-center text-base"><i class="fa-solid fa-scroll" aria-hidden="true"></i></span>
                                <span>Activity Timeline</span>
                            </a>
                            <!-- Tab: Platform Stats (All) -->
                            <a href="?tab=stats"
                                class="flex items-center gap-3 rounded-lg px-4 py-3 text-sm font-bold transition <%= dashboard.activeTab === 'stats' ? 'bg-cyan text-white shadow-sm' : 'text-ink hover:bg-cyan-soft hover:text-cyan-dark' %>">
                                <span class="w-5 text-center text-base"><i class="fa-solid fa-chart-column" aria-hidden="true"></i></span>
                                <span>Platform Stats</span>
                            </a>
                        </nav>
                    </div>
                </aside>

                <div class="lg:col-span-9 space-y-8">

                    <% if (error) { %>
                        <div class="flex items-center gap-4 rounded-xl border border-red-200 bg-red-50 p-4">
                            <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-red-500 text-white"><i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i></span>
                            <div>
                                <h3 class="text-sm font-extrabold uppercase tracking-wide text-red-700">Error</h3>
                                <p class="mt-0.5 text-sm font-medium text-red-600"><%= error %></p>
                            </div>
                        </div>
                    <% } %>

                    <% if (success) { %>
                        <div class="flex items-center gap-4 rounded-xl border border-green-200 bg-green-50 p-4">
                            <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-green-500 text-white"><i class="fa-solid fa-circle-check" aria-hidden="true"></i></span>
                            <div>
                                <h3 class="text-sm font-extrabold uppercase tracking-wide text-green-700">Success</h3>
                                <p class="mt-0.5 text-sm font-medium text-green-600"><%= success %></p>
                            </div>
                        </div>
                    <% } %>

                    <!-- Active Tab Content -->
                    <% if (dashboard.activeTab === 'info') { %>
                        <!-- PROFILE SETTINGS TAB -->
                        <section id="profile-picture" class="rounded-2xl border border-line bg-white p-8 shadow-sm">
                            <div class="mb-8 flex items-center gap-3 border-b border-line pb-4">
                                <span class="grid h-10 w-10 place-items-center rounded-xl bg-cyan-soft text-cyan-dark"><i class="fa-solid fa-camera" aria-hidden="true"></i></span>
                                <h2 class="text-2xl font-extrabold tracking-[-.02em] text-cyan-dark">Avatar Settings</h2>
                            </div>

                            <div class="flex flex-col sm:flex-row items-center gap-8">
                                <div class="relative shrink-0">
                                    <% if (user && user.profilePicture) { %>
                                        <img src="<%= user.profilePicture %>?v=<%= Date.now() %>" alt="Profile"
                                            class="h-40 w-40 rounded-full border-4 border-white object-cover shadow-md ring-4 ring-cyan/20">
                                    <% } else { %>
                                        <div class="h-40 w-40 rounded-full border-4 border-white bg-cyan-soft shadow-md ring-4 ring-cyan/20 flex items-center justify-center">
                                            <span class="text-6xl font-extrabold text-cyan-dark"><%= user && user.name ? user.name.charAt(0).toUpperCase() : '?' %></span>
                                        </div>
                                    <% } %>
                                </div>

                                <div class="flex-1 w-full">
                                    <form action="/v1/auth/profile/upload-picture" method="POST" enctype="multipart/form-data" class="space-y-4">
                                        <label class="block text-xs font-extrabold uppercase tracking-widest text-muted mb-2">New Picture</label>
                                        <input name="profilePicture" type="file" accept="image/*" required
                                            class="w-full rounded-lg border border-line bg-surface p-2 text-sm font-medium text-ink outline-none transition file:mr-4 file:rounded-md file:border-0 file:bg-orange file:px-4 file:py-2 file:text-xs file:font-bold file:text-white file:uppercase hover:file:bg-orange-dark" />

                                        <button type="submit" class="inline-flex items-center gap-2 rounded-md bg-cyan px-6 py-3 text-sm font-bold text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-cyan-dark focus:outline-none focus:ring-2 focus:ring-cyan focus:ring-offset-2">
                                            <i class="fa-solid fa-upload text-xs" aria-hidden="true"></i>
                                            Update Avatar
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </section>

                        <section id="profile-info" class="rounded-2xl border border-line bg-white p-8 shadow-sm">
                            <div class="mb-8 flex items-center gap-3 border-b border-line pb-4">
                                <span class="grid h-10 w-10 place-items-center rounded-xl bg-cyan-soft text-cyan-dark"><i class="fa-solid fa-id-card" aria-hidden="true"></i></span>
                                <h2 class="text-2xl font-extrabold tracking-[-.02em] text-cyan-dark">Identity Data</h2>
                            </div>

                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-6">
                                <div class="space-y-2">
                                    <label class="block text-xs font-extrabold uppercase tracking-widest text-muted">Full Name</label>
                                    <input type="text" value="<%= user ? user.name : '' %>" readonly
                                        class="w-full rounded-lg border border-line bg-surface px-4 py-3 text-sm font-bold uppercase text-muted cursor-not-allowed" />
                                </div>
                                <div class="space-y-2">
                                    <label class="block text-xs font-extrabold uppercase tracking-widest text-muted">Email Address</label>
                                    <input type="email" value="<%= user ? user.email : '' %>" readonly
                                        class="w-full rounded-lg border border-line bg-surface px-4 py-3 text-sm font-semibold text-muted cursor-not-allowed" />
                                </div>
                                <% if (user && user.userCode) { %>
                                <div class="space-y-2">
                                    <label class="block text-xs font-extrabold uppercase tracking-widest text-muted">User Code</label>
                                    <div class="flex items-center gap-2">
                                        <input type="text" id="user-code-input" value="<%= user.userCode %>" readonly
                                            class="w-full rounded-lg border border-cyan/30 bg-cyan-soft px-4 py-3 text-sm font-extrabold tracking-wider text-cyan-dark cursor-pointer" title="Click to copy" />
                                        <button type="button" onclick="navigator.clipboard.writeText(document.getElementById('user-code-input').value).then(()=>{const b=this;b.textContent='Copied';setTimeout(()=>b.textContent='Copy',1500)})" class="shrink-0 rounded-lg border border-cyan/30 bg-white px-4 py-3 text-xs font-extrabold text-cyan-dark hover:bg-cyan-soft">Copy</button>
                                    </div>
                                    <p class="text-xs font-medium text-muted">Use this code when adding co-founders to your project.</p>
                                </div>
                                <% } %>
                            </div>

                            <% if (user.role === 'mentor' || user.role === 'investor') { %>
                                <div class="grid grid-cols-1 gap-6">
                                    <% if (user.expertise) { %>
                                    <div class="space-y-2">
                                        <label class="block text-xs font-extrabold uppercase tracking-widest text-muted">Area of Expertise</label>
                                        <input type="text" value="<%= user.expertise %>" readonly
                                            class="w-full rounded-lg border border-line bg-surface px-4 py-3 text-sm font-semibold text-muted cursor-not-allowed" />
                                    </div>
                                    <% } %>
                                    <% if (user.company) { %>
                                    <div class="space-y-2">
                                        <label class="block text-xs font-extrabold uppercase tracking-widest text-muted">Associated Company</label>
                                        <input type="text" value="<%= user.company %>" readonly
                                            class="w-full rounded-lg border border-line bg-surface px-4 py-3 text-sm font-semibold text-muted cursor-not-allowed" />
                                    </div>
                                    <% } %>
                                    <% if (user.bio) { %>
                                    <div class="space-y-2">
                                        <label class="block text-xs font-extrabold uppercase tracking-widest text-muted">Professional Bio</label>
                                        <textarea readonly rows="3" class="w-full rounded-lg border border-line bg-surface px-4 py-3 text-sm font-medium text-muted cursor-not-allowed resize-none"><%= user.bio %></textarea>
                                    </div>
                                    <% } %>
                                </div>
                            <% } %>
                        </section>

                        <section id="change-password" class="rounded-2xl border border-line bg-white p-8 shadow-sm">
                            <div class="mb-8 flex items-center gap-3 border-b border-line pb-4">
                                <span class="grid h-10 w-10 place-items-center rounded-xl bg-orange-soft text-orange"><i class="fa-solid fa-lock" aria-hidden="true"></i></span>
                                <h2 class="text-2xl font-extrabold tracking-[-.02em] text-cyan-dark">Security Access</h2>
                            </div>

                            <form action="/v1/auth/profile/update-password" method="POST" class="space-y-6">
                                <div class="space-y-2">
                                    <label class="block text-xs font-extrabold uppercase tracking-widest text-muted">Current Password</label>
                                    <input name="currentPassword" type="password" required placeholder="••••••••"
                                        class="w-full rounded-lg border border-line bg-surface px-4 py-3 text-sm font-semibold outline-none transition placeholder:text-slate-400 focus:border-cyan focus:bg-white focus:ring-2 focus:ring-cyan/20" />
                                </div>

                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                                    <div class="space-y-2">
                                        <label class="block text-xs font-extrabold uppercase tracking-widest text-muted">New Password</label>
                                        <input name="newPassword" type="password" required placeholder="••••••••"
                                            class="w-full rounded-lg border border-line bg-surface px-4 py-3 text-sm font-semibold outline-none transition placeholder:text-slate-400 focus:border-cyan focus:bg-white focus:ring-2 focus:ring-cyan/20" />
                                    </div>
                                    <div class="space-y-2">
                                        <label class="block text-xs font-extrabold uppercase tracking-widest text-muted">Confirm New</label>
                                        <input name="confirmPassword" type="password" required placeholder="••••••••"
                                            class="w-full rounded-lg border border-line bg-surface px-4 py-3 text-sm font-semibold outline-none transition placeholder:text-slate-400 focus:border-cyan focus:bg-white focus:ring-2 focus:ring-cyan/20" />
                                    </div>
                                </div>

                                <button type="submit" class="inline-flex items-center gap-2 rounded-md bg-orange px-8 py-4 text-sm font-bold text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-orange-dark focus:outline-none focus:ring-2 focus:ring-orange focus:ring-offset-2">
                                    <i class="fa-solid fa-key text-xs" aria-hidden="true"></i>
                                    Update Credentials
                                </button>
                            </form>
                        </section>

                    <% } else if (dashboard.activeTab === 'projects') { %>
                        <!-- PROJECTS LIST TAB -->
                        <section class="rounded-2xl border border-line bg-white p-8 shadow-sm">
                            <div class="mb-8 flex items-center justify-between gap-4 border-b border-line pb-4">
                                <div class="flex items-center gap-3">
                                    <span class="grid h-10 w-10 place-items-center rounded-xl bg-cyan-soft text-cyan-dark"><i class="fa-solid fa-rocket" aria-hidden="true"></i></span>
                                    <h2 class="text-2xl font-extrabold tracking-[-.02em] text-cyan-dark">Assigned Projects</h2>
                                </div>
                                <% if (user.role === 'entrepreneur') { %>
                                    <a href="/v1/projects/new" class="inline-flex shrink-0 items-center gap-2 rounded-md bg-orange px-4 py-2 text-xs font-bold uppercase text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-orange-dark">
                                        <i class="fa-solid fa-plus text-xs" aria-hidden="true"></i>
                                        New Project
                                    </a>
                                <% } %>
                            </div>

                            <% if (dashboard.projects && dashboard.projects.length > 0) { %>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                    <% dashboard.projects.forEach(project => { %>
                                        <div class="flex flex-col justify-between rounded-xl border border-line bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-md">
                                            <div>
                                                <div class="flex justify-between items-start gap-2 mb-2">
                                                    <h3 class="text-lg font-extrabold break-words text-ink"><%= project.name %></h3>
                                                    <span class="shrink-0 rounded-full bg-cyan-soft px-2 py-0.5 text-[10px] font-bold uppercase text-cyan-dark"><%= project.stage %></span>
                                                </div>
                                                <p class="text-xs font-bold uppercase text-muted mb-3"><%= project.domain %></p>
                                                <p class="text-sm font-medium leading-6 text-ink/70 line-clamp-2 italic mb-4">"<%= project.short_description %>"</p>
                                            </div>
                                            <div class="flex justify-between items-center border-t border-line pt-4">
                                                <span class="text-xs font-bold uppercase text-muted">Status: <%= project.status %></span>
                                                <a href="/v1/projects/<%= project.id %>" class="inline-flex items-center gap-1.5 text-xs font-bold text-cyan-dark transition hover:text-orange">
                                                    View Details
                                                    <i class="fa-solid fa-arrow-right text-[10px]" aria-hidden="true"></i>
                                                </a>
                                            </div>
                                        </div>
                                    <% }) %>
                                </div>
                            <% } else { %>
                                <div class="text-center py-14">
                                    <span class="mx-auto grid h-16 w-16 place-items-center rounded-full bg-cyan-soft text-2xl text-cyan-dark/40"><i class="fa-solid fa-rocket" aria-hidden="true"></i></span>
                                    <h3 class="mt-5 text-xl font-extrabold text-ink">No Projects Found</h3>
                                    <p class="mt-1 text-sm font-medium text-muted">There are no projects linked to this profile.</p>
                                </div>
                            <% } %>
                        </section>

                    <% } else if (dashboard.activeTab === 'funding') { %>
                        <!-- FUNDING TAB -->
                        <section class="rounded-2xl border border-line bg-white p-8 shadow-sm">
                            <div class="mb-8 flex items-center justify-between gap-4 border-b border-line pb-4">
                                <div class="flex items-center gap-3">
                                    <span class="grid h-10 w-10 place-items-center rounded-xl bg-green-100 text-green-700"><i class="fa-solid fa-money-bill" aria-hidden="true"></i></span>
                                    <h2 class="text-2xl font-extrabold tracking-[-.02em] text-cyan-dark">
                                        <%= user.role === 'investor' ? 'Pending Funding Requests' : 'My Funding Requests' %>
                                    </h2>
                                </div>
                                <% if (user.role === 'entrepreneur') { %>
                                    <a href="/v1/funding/new" class="inline-flex shrink-0 items-center gap-2 rounded-md bg-orange px-4 py-2 text-xs font-bold uppercase text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-orange-dark">
                                        <i class="fa-solid fa-plus text-xs" aria-hidden="true"></i>
                                        Request Funding
                                    </a>
                                <% } %>
                            </div>

                            <% if (user.role === 'entrepreneur') { %>
                                <!-- Entrepreneur Requests List -->
                                <% if (dashboard.fundingRequests && dashboard.fundingRequests.length > 0) { %>
                                    <div class="space-y-4">
                                        <% dashboard.fundingRequests.forEach(request => { %>
                                            <div class="flex flex-col sm:flex-row justify-between sm:items-center gap-4 rounded-xl border border-line bg-white p-6 shadow-sm">
                                                <div>
                                                    <div class="flex items-center gap-3 mb-2 flex-wrap">
                                                        <h3 class="font-extrabold text-lg text-ink"><%= request.project_name %></h3>
                                                        <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-bold uppercase text-slate-600"><%= request.funding_stage %></span>
                                                    </div>
                                                    <% if (request.description) { %>
                                                        <p class="text-sm font-medium italic text-ink/70 mb-2">Usage: <%= request.description %></p>
                                                    <% } %>
                                                    <span class="text-xs font-bold uppercase text-muted">Requested: <%= new Date(request.requested_at).toLocaleDateString('en-US') %></span>
                                                </div>
                                                <div class="flex sm:flex-col items-start sm:items-end justify-between sm:justify-center gap-2">
                                                    <span class="text-xl font-extrabold tracking-[-.02em] text-cyan-dark">$<%= parseFloat(request.amount).toLocaleString() %></span>
                                                    <%
                                                        let badgeBg = 'bg-orange-soft text-orange';
                                                        if (request.status === 'Approved') badgeBg = 'bg-green-100 text-green-700';
                                                        else if (request.status === 'Rejected') badgeBg = 'bg-red-100 text-red-700';
                                                    %>
                                                    <span class="rounded-full px-2.5 py-1 text-[10px] font-bold uppercase <%= badgeBg %>"><%= request.status %></span>
                                                </div>
                                            </div>
                                            <!-- Founder Accept/Decline Buttons -->
                                            <% if (request.status === 'Offer Under Review' && (request.founder_action === 'Pending' || !request.founder_action)) { %>
                                                <div class="mt-4 p-4 bg-[#EAF8FC] border border-[#00ADEF]/20 rounded-xl flex flex-col sm:flex-row justify-between sm:items-center gap-3">
                                                    <p class="text-sm font-bold text-[#006F9E]">
                                                        Offered Amount: $<%= parseFloat(request.approved_amount || request.amount).toLocaleString() %>
                                                    </p>
                                                    <div class="flex gap-2">
                                                        <button onclick="respondToFunding(<%= request.id %>, 'Founder Accepted')" class="px-4 py-2 bg-green-500 text-white rounded-lg text-xs font-bold hover:bg-green-600 transition">Accept Offer</button>
                                                        <button onclick="respondToFunding(<%= request.id %>, 'Founder Declined')" class="px-4 py-2 bg-red-500 text-white rounded-lg text-xs font-bold hover:bg-red-600 transition">Decline Offer</button>
                                                    </div>
                                                </div>
                                            <% } else if (request.status === 'Approved' && request.founder_action === 'Founder Accepted') { %>
                                                <div class="mt-4 p-3 bg-green-50 border border-green-200 rounded-xl">
                                                    <p class="text-sm font-bold text-green-700">✓ You accepted this funding offer.</p>
                                                </div>
                                            <% } else if (request.status === 'Approved' && request.founder_action === 'Founder Declined') { %>
                                                <div class="mt-4 p-3 bg-red-50 border border-red-200 rounded-xl">
                                                    <p class="text-sm font-bold text-red-700">✗ You declined this funding offer.</p>
                                                </div>
