    <%- include('../partials/footer.ejs') %>

    <!-- Client side dynamic scripting -->
    <script>
        // Update funding request status (Investor dashboard)
        async function updateRequestStatus(requestId, newStatus) {
            if (!confirm(`Are you sure you want to set this funding request to '${newStatus}'?`)) return;

            try {
                const response = await fetch(`/v1/funding/${requestId}/status`, {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ status: newStatus, notes: `Reviewed by investor.` })
                });

                const result = await response.json();
                if (response.ok && result.success) {
                    alert(`Funding request successfully ${newStatus.toLowerCase()}!`);

                    // Remove card or reload page
                    const card = document.getElementById(`request-card-${requestId}`);
                    if (card) {
                        card.style.opacity = '0.5';
                        setTimeout(() => { window.location.reload(); }, 500);
                    } else {
                        window.location.reload();
                    }
                } else {
                    alert(`Error: ${result.message || 'Failed to update request status.'}`);
                }
            } catch (err) {
                console.error('Request status update error:', err);
                alert('An error occurred while updating the status.');
            }
        }

        // Cancel workshop enrollment (Entrepreneur dashboard)
        async function cancelEnrollment(workshopId) {
            if (!confirm('Are you sure you want to cancel your enrollment in this workshop?')) return;

            try {
                const response = await fetch(`/v1/workshop/${workshopId}/attend`, {
                    method: 'DELETE',
                    headers: {
                        'Content-Type': 'application/json',
                    }
                });

                const result = await response.json();
                if (response.ok) {
                    alert('Workshop enrollment successfully cancelled!');

                    // Remove card or reload page
                    const card = document.getElementById(`workshop-card-${workshopId}`);
                    if (card) {
                        card.style.opacity = '0.5';
                        setTimeout(() => { window.location.reload(); }, 500);
                    } else {
                        window.location.reload();
                    }
                } else {
                    alert(`Error: ${result.message || 'Failed to cancel enrollment.'}`);
                }
            } catch (err) {
                console.error('Cancel enrollment error:', err);
                alert('An error occurred while cancelling your enrollment.');
            }
        }

        // Entrepreneur Accept/Decline Funding
        async function respondToFunding(fundingId, action) {
            if (!confirm(`Are you sure you want to ${action === 'Founder Accepted' ? 'accept' : 'decline'} this funding offer?`)) return;

            try {
                const response = await fetch(`/api/public/funding/${fundingId}/respond`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({ action })
                });

                // Read the response as text first so it never crashes!
                const text = await response.text();
                let data = {};
                try { data = JSON.parse(text); } catch(e) { /* It was HTML, not JSON */ }

                if (response.ok) {
                    alert('Your response has been recorded!');
                    window.location.reload();
                } else {
                    // This will now show the actual error message from the backend!
                    alert(`Error: ${data.message || 'Failed to update status. Server returned: ' + text.substring(0, 100)}`);
                }
            } catch (error) {
                console.error('Error responding to funding:', error);
                alert('Network error. Please check your connection.');
            }
        }

        // Negotiation Functions
        async function loadNegotiations(requestId) {
            const container = document.getElementById(`negotiation-thread-${requestId}`);
            if (!container) return;
            try {
                const res = await fetch(`/v1/funding/${requestId}/negotiations`, { credentials: 'include' });
                const data = await res.json();
                if (!data.success) return;
                container.innerHTML = data.data.length
                    ? data.data.map(n => `
                        <div class="rounded-lg border p-2 ${n.sender_role === 'admin' ? 'bg-cyan-soft border-cyan/30 ml-auto' : 'bg-white border-line'}" style="max-width:85%">
                            <p class="font-bold">${n.sender_name} <span class="font-normal text-muted">· ${n.sender_role}</span></p>
                            ${n.message ? `<p>${n.message}</p>` : ''}
                            ${n.proposed_amount ? `<p class="font-bold text-orange">Proposed: $${parseFloat(n.proposed_amount).toLocaleString()}</p>` : ''}
                        </div>
                    `).join('')
                    : '<p class="italic text-muted">No messages yet.</p>';
            } catch (err) {
                console.error('Error loading negotiations:', err);
            }
        }

        async function sendNegotiation(requestId) {
            const input = document.getElementById(`negotiation-input-${requestId}`);
            const message = input.value.trim();
            if (!message) return;
            try {
                await fetch(`/v1/funding/${requestId}/negotiations`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({ message }),
                });
                input.value = '';
                loadNegotiations(requestId);
            } catch (err) {
                console.error('Error sending message:', err);
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('[id^="negotiation-thread-"]').forEach(el => {
                const requestId = el.id.replace('negotiation-thread-', '');
                loadNegotiations(requestId);
            });
        });
    </script>
</body>

</html>