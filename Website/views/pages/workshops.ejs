<% 
  const formatDate = (value) => value
    ? new Date(value).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
    : 'Date to be announced';
  const formatTime = (start, end) => start && end ? `${start} – ${end}` : 'Time to be announced';
  const formatCategory = (value) => {
    const label = String(value || 'General').trim();
    return label.charAt(0).toUpperCase() + label.slice(1);
  };
  const statusLabel = (value) => {
    const label = String(value || 'scheduled').trim();
    return label.charAt(0).toUpperCase() + label.slice(1);
  };
  const statusClass = (value) => {
    if (value === 'completed') return 'border-line bg-surface text-muted';
    if (value === 'full') return 'border-orange/30 bg-orange-soft text-orange';
    if (value === 'cancelled') return 'border-red-200 bg-red-50 text-red-700';
    return 'border-cyan/30 bg-cyan-soft text-cyan-dark';
  };
  const categories = [...new Set((workshops || []).map((workshop) => String(workshop.category || 'general').trim()).filter(Boolean))].sort();
  const scheduledCount = (workshops || []).filter((workshop) => ['scheduled', 'active'].includes(workshop.status)).length;
%>
<!DOCTYPE html>
<html lang="en">
  <%- include('../partials/head') %>
  <body class="flex min-h-screen flex-col bg-white font-sans text-ink">
    <%- include('../partials/header.ejs') %>

    <main class="flex-grow">
      <section class="relative overflow-hidden border-b border-line bg-cyan-soft">
        <div class="pointer-events-none absolute -right-32 -top-44 h-[560px] w-[720px] rounded-[48%] border-[74px] border-white/60" aria-hidden="true"></div>
        <div class="pointer-events-none absolute -left-40 bottom-[-280px] h-[540px] w-[650px] rounded-[50%] border-[64px] border-cyan/10" aria-hidden="true"></div>

        <div class="relative mx-auto grid max-w-7xl gap-12 px-6 py-20 lg:grid-cols-[1.1fr_.9fr] lg:items-end lg:px-10 lg:py-24">
          <div class="dv-reveal max-w-[720px]" data-delay="0">
            <p class="mb-5 inline-flex items-center gap-2 text-xs font-extrabold uppercase tracking-[.24em] text-orange">
              <span class="h-2 w-2 rounded-full bg-orange" aria-hidden="true"></span>
              Learn &amp; grow
            </p>
            <h1 class="max-w-[760px] text-5xl font-extrabold leading-[1.02] tracking-[-.055em] text-cyan-dark sm:text-6xl lg:text-7xl">
              Workshops for founders with momentum.
            </h1>
            <p class="mt-7 max-w-[650px] text-lg leading-8 text-muted sm:text-xl">
              Build practical skills with hands-on sessions from people who have done the work — then take what you learn back to your business.
            </p>
            <div class="mt-8 flex flex-wrap items-center gap-3 text-sm font-semibold text-cyan-dark">
              <a class="inline-flex items-center gap-2 rounded-md bg-orange px-5 py-3 font-extrabold text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-orange-dark focus:outline-none focus:ring-2 focus:ring-orange focus:ring-offset-2" href="#workshop-catalogue">
                Browse workshops
                <i class="fa-solid fa-arrow-down text-xs" aria-hidden="true"></i>
              </a>

            </div>
          </div>

          <aside class="dv-reveal relative lg:justify-self-end" data-delay="120" aria-label="Workshop catalogue summary">
            <div class="relative w-full max-w-[470px] rounded-[26px] border border-white/80 bg-white/85 p-6 shadow-[0_18px_46px_rgba(0,88,125,.11)] backdrop-blur-sm sm:p-7">
              <div class="flex items-start justify-between gap-4 border-b border-line pb-5">
                <div>
                  <p class="text-xs font-extrabold uppercase tracking-[.2em] text-cyan-dark">The learning room</p>
                  <h2 class="mt-2 text-2xl font-extrabold tracking-[-.03em] text-ink">Choose your next useful skill.</h2>
                </div>
                <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-orange-soft text-orange" aria-hidden="true">
                  <i class="fa-solid fa-lightbulb"></i>
                </span>
              </div>
              <div class="grid grid-cols-2 gap-3 py-5 sm:grid-cols-3">
                <div class="rounded-xl bg-cyan-soft p-4">
                  <p class="text-2xl font-extrabold text-cyan-dark"><%= workshops.length %></p>
                  <p class="mt-1 text-xs font-semibold text-muted">Sessions listed</p>
                </div>
                <div class="rounded-xl bg-cyan-soft p-4">
                  <p class="text-2xl font-extrabold text-cyan-dark"><%= scheduledCount %></p>
                  <p class="mt-1 text-xs font-semibold text-muted">Open to join</p>
                </div>
                <div class="col-span-2 rounded-xl bg-orange-soft p-4 sm:col-span-1">
                  <p class="text-2xl font-extrabold text-orange"><%= categories.length %></p>
                  <p class="mt-1 text-xs font-semibold text-muted">Topic tracks</p>
                </div>
              </div>
              <div class="flex items-center gap-3 rounded-xl bg-cyan p-4 text-white">
                <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-white/15" aria-hidden="true"><i class="fa-solid fa-arrow-trend-up text-sm"></i></span>
                <p class="text-sm font-bold">Learn something you can apply this week.</p>
              </div>
            </div>
          </aside>
        </div>
      </section>

      <section id="workshop-catalogue" class="bg-white">
        <div class="mx-auto max-w-7xl px-6 py-20 lg:px-10 lg:py-24">
          <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
            <div class="dv-reveal max-w-[650px]" data-delay="0">
              <p class="text-xs font-extrabold uppercase tracking-[.2em] text-orange">The catalogue</p>
              <h2 class="mt-3 text-4xl font-extrabold tracking-[-.04em] text-cyan-dark sm:text-5xl">Find the next room to grow in.</h2>
              <p class="mt-4 text-base leading-8 text-muted">Search by topic or trainer, then open a session to see the full schedule and reserve your seat.</p>
            </div>
            <p class="text-sm font-semibold text-muted"><span id="visibleWorkshopCount"><%= workshops.length %></span> workshops available</p>
          </div>

          <div class="mt-10 grid gap-3 rounded-2xl border border-line bg-surface p-3 md:grid-cols-[1fr_260px_auto] md:items-center">
            <label class="relative block">
              <span class="sr-only">Search workshops</span>
              <i class="fa-solid fa-magnifying-glass pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-sm text-muted" aria-hidden="true"></i>
              <input id="searchInput" type="search" placeholder="Search by topic, trainer, or location" class="h-12 w-full rounded-xl border border-line bg-white pl-11 pr-4 text-sm text-ink outline-none transition placeholder:text-slate-400 focus:border-cyan focus:ring-2 focus:ring-cyan/20" />
            </label>
            <label class="relative block">
              <span class="sr-only">Filter by category</span>
              <select id="categoryFilter" class="h-12 w-full appearance-none rounded-xl border border-line bg-white px-4 pr-10 text-sm font-semibold text-ink outline-none transition focus:border-cyan focus:ring-2 focus:ring-cyan/20">
                <option value="">All categories</option>
                <% categories.forEach((category) => { %>
                  <option value="<%= category.toLowerCase() %>"><%= formatCategory(category) %></option>
                <% }); %>
              </select>
              <i class="fa-solid fa-chevron-down pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-xs text-muted" aria-hidden="true"></i>
            </label>
            <button id="resetFilters" type="button" class="h-12 rounded-xl border border-line px-4 text-sm font-bold text-cyan-dark transition hover:border-cyan hover:bg-cyan-soft focus:outline-none focus:ring-2 focus:ring-cyan/20">Reset filters</button>
          </div>

          <div id="workshopsGrid" class="mt-12 grid items-stretch gap-6 md:grid-cols-2 lg:grid-cols-3">
            <% workshops.forEach((workshop, index) => { %>
              <% const workshopCategory = String(workshop.category || 'general').trim().toLowerCase(); %>
              <% const workshopStatus = String(workshop.status || 'scheduled').trim().toLowerCase(); %>
              <% const workshopDescription = String(workshop.description || 'Practical guidance for founders building with momentum.'); %>
              <article class="workshop-card dv-reveal group flex h-full flex-col overflow-hidden rounded-2xl border border-line bg-white shadow-[0_12px_30px_rgba(0,88,125,.08)] transition duration-300 hover:-translate-y-1 hover:shadow-[0_18px_46px_rgba(0,88,125,.14)]" data-delay="<%= Math.min(index * 45, 270) %>" data-search="<%= `${workshop.title || ''} ${workshopDescription} ${workshopCategory} ${workshop.mentor_name || ''} ${workshop.location || ''}`.toLowerCase() %>" data-category="<%= workshopCategory %>">
                <div class="relative min-h-[136px] overflow-hidden bg-cyan">
                  <div class="pointer-events-none absolute -right-12 -top-20 h-48 w-64 rounded-[50%] border-[26px] border-white/15" aria-hidden="true"></div>
                  <div class="pointer-events-none absolute -left-12 bottom-[-84px] h-40 w-56 rounded-[50%] border-[22px] border-cyan-deep/30" aria-hidden="true"></div>
                  <div class="relative flex items-start justify-between gap-3 p-5">
                    <span class="grid h-12 w-12 place-items-center rounded-xl bg-orange text-white shadow-sm" aria-hidden="true"><i class="fa-solid fa-lightbulb text-lg"></i></span>
                    <span class="inline-flex items-center gap-2 rounded-full border border-white/60 bg-white/90 px-3 py-1.5 text-[11px] font-extrabold uppercase tracking-wide text-cyan-dark">
                      <i class="fa-solid fa-users text-[10px]" aria-hidden="true"></i>
                      <%= workshop.enrolled_count || 0 %>/<%= workshop.capacity || 30 %> seats
                    </span>
                  </div>
                </div>

                <div class="flex flex-1 flex-col p-6">
                  <div class="flex flex-wrap items-start justify-between gap-3">
                    <h3 class="min-w-0 flex-1 text-2xl font-extrabold leading-tight tracking-[-.03em] text-ink"><%= workshop.title %></h3>
                    <span class="rounded-md bg-cyan-soft px-2.5 py-1 text-[10px] font-extrabold uppercase tracking-wide text-cyan-dark"><%= formatCategory(workshop.category) %></span>
                  </div>
                  <p class="mt-4 line-clamp-3 text-sm leading-7 text-muted"><%= workshopDescription %></p>

                  <div class="mt-5 flex items-center gap-3 border-y border-line py-4">
                    <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full border border-cyan/30 bg-cyan-soft text-sm font-extrabold text-cyan-dark" aria-hidden="true"><%= (workshop.mentor_name || 'T').trim().charAt(0).toUpperCase() %></span>
                    <div class="min-w-0">
                      <p class="text-[10px] font-extrabold uppercase tracking-[.16em] text-muted">Trainer</p>
                      <p class="truncate text-sm font-bold text-ink"><%= workshop.mentor_name || 'Trainer to be announced' %></p>
                    </div>
                  </div>

                  <dl class="mt-5 space-y-3 text-sm font-semibold text-ink">
                    <div class="flex items-start gap-3"><dt class="w-4 shrink-0 text-orange"><i class="fa-solid fa-calendar-days" aria-hidden="true"></i><span class="sr-only">Date</span></dt><dd><%= formatDate(workshop.start_date) %></dd></div>
                    <div class="flex items-start gap-3"><dt class="w-4 shrink-0 text-cyan-dark"><i class="fa-solid fa-clock" aria-hidden="true"></i><span class="sr-only">Time</span></dt><dd><%= formatTime(workshop.start_time, workshop.end_time) %></dd></div>
                    <div class="flex items-start gap-3"><dt class="w-4 shrink-0 text-cyan-dark"><i class="fa-solid fa-location-dot" aria-hidden="true"></i><span class="sr-only">Location</span></dt><dd class="line-clamp-2"><%= workshop.location || 'Location to be announced' %></dd></div>
                  </dl>

                  <div class="mt-auto pt-6">
                    <span class="inline-flex items-center gap-2 rounded-full border px-3 py-1.5 text-xs font-bold <%= statusClass(workshopStatus) %>">
                      <span class="h-2 w-2 rounded-full <%= workshopStatus === 'scheduled' || workshopStatus === 'active' ? 'animate-pulse bg-cyan' : workshopStatus === 'full' ? 'bg-orange' : workshopStatus === 'cancelled' ? 'bg-red-500' : 'bg-muted' %>" aria-hidden="true"></span>
                      <%= statusLabel(workshop.status) %>
                    </span>
                  </div>
                </div>

                <div class="border-t border-line bg-surface p-4">
                  <a href="/v1/workshop/<%= workshop.id %>" class="view-workshop inline-flex h-12 w-full items-center justify-center gap-2 rounded-xl bg-cyan-dark px-4 text-sm font-extrabold text-white transition hover:bg-cyan focus:outline-none focus:ring-2 focus:ring-cyan focus:ring-offset-2">
                    View workshop details
                    <i class="fa-solid fa-arrow-up-right-from-square text-xs" aria-hidden="true"></i>
                  </a>
                </div>
              </article>
            <% }); %>
          </div>

          <div id="emptyState" class="mt-12 hidden rounded-2xl border border-line bg-surface px-6 py-20 text-center">
            <span class="mx-auto grid h-14 w-14 place-items-center rounded-full bg-orange-soft text-orange" aria-hidden="true"><i class="fa-solid fa-magnifying-glass text-xl"></i></span>
            <h3 class="mt-5 text-3xl font-extrabold tracking-[-.03em] text-cyan-dark">No workshops match that search.</h3>
            <p class="mx-auto mt-3 max-w-md text-sm leading-7 text-muted">Try a different topic, trainer, or category to find the right room.</p>
            <button id="emptyResetFilters" type="button" class="mt-6 inline-flex items-center gap-2 rounded-md bg-orange px-5 py-3 text-sm font-extrabold text-white transition hover:bg-orange-dark focus:outline-none focus:ring-2 focus:ring-orange focus:ring-offset-2">Clear filters <i class="fa-solid fa-arrow-rotate-left text-xs" aria-hidden="true"></i></button>
          </div>
        </div>
      </section>

      <section id="how-to-join" class="bg-cyan-dark text-white">
        <div class="mx-auto max-w-7xl px-6 py-20 lg:px-10 lg:py-24">
          <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
            <div><p class="text-xs font-extrabold uppercase tracking-[.2em] text-white/70">A simple progression</p><h2 class="mt-3 text-4xl font-extrabold tracking-[-.04em] sm:text-5xl">How to join</h2></div>
            <p class="max-w-[360px] text-sm leading-7 text-white/75">Pick a session, reserve your seat, and bring one useful question with you.</p>
          </div>
          <div class="relative mt-14 grid gap-8 md:grid-cols-3 md:gap-6">
            <div class="absolute left-[16.5%] right-[16.5%] top-7 hidden h-px bg-white/25 md:block" aria-hidden="true"></div>
            <article class="dv-reveal relative" data-delay="0"><div class="relative z-10 grid h-14 w-14 place-items-center rounded-full bg-orange text-lg font-extrabold text-white ring-8 ring-cyan-dark">01</div><div class="mt-8 rounded-2xl bg-white p-6 text-ink shadow-[0_14px_28px_rgba(0,67,103,.18)]"><h3 class="text-xl font-extrabold">Browse &amp; pick</h3><p class="mt-3 text-sm leading-7 text-muted">Use the catalogue to find a workshop that fits your current challenge.</p></div></article>
            <article class="dv-reveal relative" data-delay="90"><div class="relative z-10 grid h-14 w-14 place-items-center rounded-full bg-orange text-lg font-extrabold text-white ring-8 ring-cyan-dark">02</div><div class="mt-8 rounded-2xl bg-white p-6 text-ink shadow-[0_14px_28px_rgba(0,67,103,.18)]"><h3 class="text-xl font-extrabold">Reserve your seat</h3><p class="mt-3 text-sm leading-7 text-muted">Open the details page, check the schedule, and confirm your attendance.</p></div></article>
            <article class="dv-reveal relative" data-delay="180"><div class="relative z-10 grid h-14 w-14 place-items-center rounded-full bg-orange text-lg font-extrabold text-white ring-8 ring-cyan-dark">03</div><div class="mt-8 rounded-2xl bg-white p-6 text-ink shadow-[0_14px_28px_rgba(0,67,103,.18)]"><h3 class="text-xl font-extrabold">Show up &amp; learn</h3><p class="mt-3 text-sm leading-7 text-muted">Take notes, ask questions, and apply the next useful idea to your startup.</p></div></article>
          </div>
        </div>
      </section>

      <section class="bg-cyan-soft">
        <div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-8 px-6 py-16 lg:flex-row lg:items-center lg:px-10 lg:py-20">
          <div><p class="text-xs font-extrabold uppercase tracking-[.2em] text-orange">Bring your expertise</p><h2 class="mt-3 max-w-[650px] text-4xl font-extrabold tracking-[-.04em] text-cyan-dark sm:text-5xl">Want to host a workshop?</h2><p class="mt-4 max-w-[620px] text-base leading-8 text-muted">Share your experience and help Ethiopian founders make better decisions, faster.</p></div>
          <a class="inline-flex shrink-0 items-center gap-3 rounded-md bg-orange px-7 py-4 text-sm font-extrabold text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-orange-dark focus:outline-none focus:ring-2 focus:ring-orange focus:ring-offset-2" href="/contact">Contact to join <i class="fa-solid fa-arrow-up-right-from-square text-xs" aria-hidden="true"></i></a>
        </div>
      </section>
    </main>

    <%- include('../partials/footer.ejs') %>

    <script>
      (() => {
        const searchInput = document.getElementById('searchInput');
        const categoryFilter = document.getElementById('categoryFilter');
        const cards = Array.from(document.querySelectorAll('.workshop-card'));
        const emptyState = document.getElementById('emptyState');
        const visibleCount = document.getElementById('visibleWorkshopCount');
        const resetButtons = [document.getElementById('resetFilters'), document.getElementById('emptyResetFilters')].filter(Boolean);

        const filterWorkshops = () => {
          const query = (searchInput?.value || '').trim().toLowerCase();
          const category = (categoryFilter?.value || '').trim().toLowerCase();
          let count = 0;

          cards.forEach((card) => {
            const matchesQuery = !query || (card.dataset.search || '').includes(query);
            const matchesCategory = !category || card.dataset.category === category;
            const isVisible = matchesQuery && matchesCategory;
            card.classList.toggle('hidden', !isVisible);
            if (isVisible) count += 1;
          });

          if (visibleCount) visibleCount.textContent = String(count);
          emptyState?.classList.toggle('hidden', count !== 0);
        };

        const resetFilters = () => {
          if (searchInput) searchInput.value = '';
          if (categoryFilter) categoryFilter.value = '';
          filterWorkshops();
          searchInput?.focus();
        };

        searchInput?.addEventListener('input', filterWorkshops);
        categoryFilter?.addEventListener('change', filterWorkshops);
        resetButtons.forEach((button) => button.addEventListener('click', resetFilters));

        const revealItems = document.querySelectorAll('.dv-reveal');
        if ('IntersectionObserver' in window) {
          const revealObserver = new IntersectionObserver((entries, observer) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.style.animationDelay = `${entry.target.dataset.delay || 0}ms`;
              entry.target.classList.add('dv-visible');
              observer.unobserve(entry.target);
            });
          }, { threshold: 0.1 });
          revealItems.forEach((item) => revealObserver.observe(item));
        } else {
          revealItems.forEach((item) => item.classList.add('dv-visible'));
        }
      })();
    </script>
  </body>
</html>
