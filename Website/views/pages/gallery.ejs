<!DOCTYPE html>
<html lang="en">
  <%- include('../partials/head') %>
  <body class="flex min-h-screen flex-col bg-white font-sans text-ink">
    <%- include('../partials/header.ejs') %>

    <main class="flex-grow">
      <section class="relative overflow-hidden bg-gradient-to-br from-cyan via-cyan-mid to-cyan-deep text-white">
        <div class="pointer-events-none absolute -left-28 -top-32 h-[520px] w-[700px] rounded-[48%] border-[76px] border-white/10" aria-hidden="true"></div>
        <div class="pointer-events-none absolute -right-44 bottom-[-260px] h-[620px] w-[760px] rounded-[50%] border-[88px] border-white/10" aria-hidden="true"></div>

        <div class="relative mx-auto grid max-w-7xl gap-12 px-6 py-20 lg:grid-cols-[1.1fr_.9fr] lg:items-end lg:px-10 lg:py-24">
          <div class="dv-reveal max-w-[720px]" data-delay="0">
            <p class="mb-5 inline-flex items-center gap-2 text-xs font-extrabold uppercase tracking-[.24em] text-white/80">
              <span class="h-2 w-2 rounded-full bg-orange" aria-hidden="true"></span>
              Moments from the center
            </p>
            <h1 class="max-w-[760px] text-5xl font-extrabold leading-[1.02] tracking-[-.055em] sm:text-6xl lg:text-7xl">
              Inside DxValley,<br /><span class="text-white/75">frame by frame.</span>
            </h1>
            <p class="mt-7 max-w-[650px] text-lg leading-8 text-white/85 sm:text-xl">
              A look at the workshops, pitch days, and community moments that keep founders moving.
            </p>
          </div>

          <aside class="dv-reveal lg:justify-self-end" data-delay="120">
            <div class="relative w-full max-w-[470px] rounded-[26px] border border-white/30 bg-white/10 p-6 backdrop-blur-md sm:p-7">
              <div class="flex items-start justify-between gap-4 border-b border-white/20 pb-5">
                <div>
                  <p class="text-xs font-extrabold uppercase tracking-[.2em] text-white/65">Photo gallery</p>
                  <h2 class="mt-2 text-2xl font-extrabold tracking-[-.03em]"><%= photos.length %> <%= photos.length === 1 ? 'memory' : 'memories' %></h2>
                </div>
                <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-orange text-white" aria-hidden="true">
                  <i class="fa-solid fa-images"></i>
                </span>
              </div>
              <p class="mt-5 text-sm leading-7 text-white/80">Click any photo to view it full size. New photos are added as the community grows.</p>

              <!-- Filters: search + category -->
              <form method="get" action="<%= routes.gallery %>" class="mt-4 flex flex-col sm:flex-row gap-3">
                <input name="q" value="<%= q %>" type="search" placeholder="Search photos..." class="w-full sm:w-auto px-3.5 py-2.5 rounded-xl text-sm font-medium text-[#111827]" />
                <select name="category" class="px-3.5 py-2.5 rounded-xl text-sm font-bold">
                  <% (categories || ['All']).forEach(function(cat){ %>
                    <option value="<%= cat === 'All' ? 'all' : cat %>" <%= (selectedCategory === cat || (selectedCategory === 'all' && cat === 'All')) ? 'selected' : '' %>><%= cat %></option>
                  <% }) %>
                </select>
                <button type="submit" class="px-4 py-2 rounded-xl bg-orange text-white font-bold">Filter</button>
              </form>
            </div>
          </aside>
        </div>
      </section>

      <section id="gallery-grid" class="bg-white">
        <div class="mx-auto max-w-7xl px-6 py-20 lg:px-10 lg:py-24">
          <% if (photos.length > 0) { %>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
              <% photos.forEach((photo, index) => { %>
                    <div class="gallery-item group relative overflow-hidden rounded-2xl border border-line bg-surface focus-within:ring-2 focus-within:ring-orange focus-within:ring-offset-2" data-photo="<%= photo.url %>" data-index="<%= index %>" data-title="<%= photo.title %>" data-description="<%= photo.description %>" data-category="<%= photo.category %>" data-created="<%= photo.created_at ? new Date(photo.created_at).toISOString() : '' %>">
                      <button type="button" class="w-full h-56 block cursor-zoom-in" data-photo="<%= photo.url %>" data-index="<%= index %>" data-title="<%= photo.title %>" data-description="<%= photo.description %>" data-category="<%= photo.category %>" data-created="<%= photo.created_at ? new Date(photo.created_at).toISOString() : '' %>" aria-label="Open <%= photo.title || ('photo ' + (index + 1)) %>">
                        <img src="<%= photo.url %>" alt="<%= photo.title || ('DxValley photo ' + (index + 1)) %>" class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.03] group-hover:opacity-90" loading="lazy" decoding="async" onerror="this.onerror=null;this.src='/assets/images/default-avatar.svg'" />
                      </button>

                      <div class="gallery-overlay absolute inset-x-0 bottom-0 bg-gradient-to-t from-cyan-deep/90 to-transparent px-4 pb-3 pt-10 text-left transition duration-300 opacity-0 translate-y-3 group-hover:opacity-100 group-hover:translate-y-0">
                        <span class="block text-[10px] font-extrabold uppercase tracking-wider text-white/70"><%= photo.category %></span>
                        <span class="block text-sm font-bold text-white"><%= photo.title || '' %></span>
                        <% if (photo.description) { %>
                          <p class="mt-2 text-xs text-white/85 max-h-20 overflow-hidden text-ellipsis"><%= photo.description %></p>
                        <% } %>
                        <% if (photo.created_at) { %>
                          <span class="block text-[11px] text-white/80 mt-1"><%= new Date(photo.created_at).toLocaleDateString() %></span>
                        <% } %>
                      </div>

                      <div class="absolute inset-0 grid place-items-center bg-cyan-deep/0 opacity-0 transition group-hover:bg-cyan-deep/20 group-hover:opacity-100" aria-hidden="true">
                        <i class="fa-solid fa-magnifying-glass-plus text-2xl text-white"></i>
                      </div>
                    </div>
                  <% }); %>
                </div>
              <% } else { %>
            <div class="rounded-2xl border border-line bg-surface px-6 py-20 text-center">
              <span class="mx-auto grid h-14 w-14 place-items-center rounded-full bg-orange-soft text-orange" aria-hidden="true">
                <i class="fa-solid fa-images text-xl"></i>
              </span>
              <h2 class="mt-5 text-3xl font-extrabold tracking-[-.03em] text-cyan-dark">Photos coming soon.</h2>
              <p class="mx-auto mt-3 max-w-md text-sm leading-7 text-muted">We're collecting the best moments from our workshops and cohorts. Check back soon — and meanwhile explore our upcoming workshops.</p>
              <a class="mt-6 inline-flex items-center gap-2 rounded-md bg-orange px-5 py-3 text-sm font-extrabold text-white transition hover:bg-orange-dark focus:outline-none focus:ring-2 focus:ring-orange focus:ring-offset-2" href="<%= routes.workshops %>">Browse workshops <i class="fa-solid fa-arrow-right text-xs" aria-hidden="true"></i></a>
            </div>
          <% } %>
        </div>
      </section>
    </main>

    <div id="lightbox" class="fixed inset-0 z-50 hidden items-center justify-center bg-cyan-deep/90 p-4 backdrop-blur-sm" role="dialog" aria-modal="true" aria-label="Photo viewer">
      <button id="lightbox-close" type="button" class="absolute right-5 top-5 grid h-11 w-11 place-items-center rounded-full bg-white/15 text-white transition hover:bg-white hover:text-cyan-deep focus:outline-none focus:ring-2 focus:ring-white" aria-label="Close photo viewer"><i class="fa-solid fa-xmark text-lg"></i></button>
      <button id="lightbox-prev" type="button" class="absolute left-4 top-1/2 grid h-11 w-11 -translate-y-1/2 place-items-center rounded-full bg-white/15 text-white transition hover:bg-white hover:text-cyan-deep focus:outline-none focus:ring-2 focus:ring-white" aria-label="Previous photo"><i class="fa-solid fa-chevron-left"></i></button>
      <figure class="max-h-full max-w-5xl">
        <img id="lightbox-image" src="" alt="" class="mx-auto max-h-[80vh] w-auto rounded-2xl object-contain shadow-2xl" />
        <figcaption id="lightbox-caption" class="mt-4 text-center text-sm font-semibold text-white/85"></figcaption>
        <figcaption id="lightbox-meta" class="mt-1 text-center text-xs font-bold uppercase tracking-wider text-white/60"></figcaption>
      </figure>
      <button id="lightbox-next" type="button" class="absolute right-4 top-1/2 grid h-11 w-11 -translate-y-1/2 place-items-center rounded-full bg-white/15 text-white transition hover:bg-white hover:text-cyan-deep focus:outline-none focus:ring-2 focus:ring-white" aria-label="Next photo"><i class="fa-solid fa-chevron-right"></i></button>
    </div>

    <%- include('../partials/footer.ejs') %>

    <script>
      (() => {
        const items = Array.from(document.querySelectorAll('.gallery-item'));
        const lightbox = document.getElementById('lightbox');
        const lightboxImage = document.getElementById('lightbox-image');
        const lightboxCaption = document.getElementById('lightbox-caption');
        const lightboxMeta = document.getElementById('lightbox-meta');
        let current = 0;

        const openLightbox = (index) => {
          current = index;
          const item = items[current];
          if (!item) return;
          lightboxImage.src = item.dataset.photo;
          lightboxImage.alt = item.querySelector('img').alt;
          lightboxCaption.textContent = item.dataset.title
            ? item.dataset.title
            : `Photo ${current + 1} of ${items.length}`;
          lightboxMeta.textContent = item.dataset.description || (item.dataset.category || '');
          lightbox.classList.remove('hidden');
          lightbox.classList.add('flex');
          document.body.style.overflow = 'hidden';
        };
        const closeLightbox = () => {
          lightbox.classList.add('hidden');
          lightbox.classList.remove('flex');
          document.body.style.overflow = '';
          lightboxImage.src = '';
        };
        const showNext = () => openLightbox((current + 1) % items.length);
        const showPrev = () => openLightbox((current - 1 + items.length) % items.length);

        items.forEach((item) => item.addEventListener('click', () => openLightbox(Number(item.dataset.index))));
        document.getElementById('lightbox-close')?.addEventListener('click', closeLightbox);
        document.getElementById('lightbox-next')?.addEventListener('click', showNext);
        document.getElementById('lightbox-prev')?.addEventListener('click', showPrev);
        lightbox?.addEventListener('click', (e) => { if (e.target === lightbox) closeLightbox(); });
        document.addEventListener('keydown', (e) => {
          if (!lightbox || lightbox.classList.contains('hidden')) return;
          if (e.key === 'Escape') closeLightbox();
          if (e.key === 'ArrowRight') showNext();
          if (e.key === 'ArrowLeft') showPrev();
        });

        // Fallback: ensure overlay is visible on hover/focus for environments where Tailwind group-hover classes may be missing
        items.forEach((item) => {
          const overlay = item.querySelector('.gallery-overlay');
          if (!overlay) return;
          const showOverlay = () => {
            overlay.style.opacity = '1';
            overlay.style.transform = 'translateY(0)';
          };
          const hideOverlay = () => {
            overlay.style.opacity = '';
            overlay.style.transform = '';
          };
          item.addEventListener('mouseenter', showOverlay);
          item.addEventListener('mouseleave', hideOverlay);
          // keyboard accessibility: focus within
          item.addEventListener('focusin', showOverlay);
          item.addEventListener('focusout', hideOverlay);
        });

        const revealItems = document.querySelectorAll('.dv-reveal');
        if ('IntersectionObserver' in window) {
          const revealObserver = new IntersectionObserver((entries, observer) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.style.animationDelay = `${entry.target.dataset.delay || 0}ms`;
              entry.target.classList.add('dv-visible');
              observer.unobserve(entry.target);
            });
          }, { threshold: 0.12 });
          revealItems.forEach((item) => revealObserver.observe(item));
        } else {
          revealItems.forEach((item) => item.classList.add('dv-visible'));
        }
      })();
    </script>
  </body>
</html>
