<!DOCTYPE html>
<html lang="en">
  <%- include('../partials/head') %>
  <body class="flex min-h-screen flex-col bg-white font-sans text-ink">
    <%- include('../partials/header') %>

    <main class="flex-grow">
      <section class="relative overflow-hidden bg-gradient-to-br from-cyan via-cyan-mid to-cyan-deep text-white">
        <div class="relative mx-auto max-w-7xl px-6 py-20 lg:px-10 lg:py-24">
          <p class="mb-5 inline-flex items-center gap-2 text-xs font-extrabold uppercase tracking-[.24em] text-white/80">
            <span class="h-2 w-2 rounded-full bg-orange" aria-hidden="true"></span>
            From the center
          </p>
          <h1 class="max-w-[760px] text-5xl font-extrabold leading-[1.02] tracking-[-.055em] sm:text-6xl">
            Announcements
          </h1>
          <p class="mt-7 max-w-[650px] text-lg leading-8 text-white/85">
            News, cohort updates, and open calls from DxValley.
          </p>
        </div>
      </section>

      <section class="bg-white">
        <div class="mx-auto max-w-4xl px-6 py-20 lg:px-10">
          <% if (announcements && announcements.length > 0) { %>
            <div class="divide-y divide-line">
              <% announcements.forEach(a => { %>
                <a href="/v1/announcements/<%= a.id %>" class="group flex flex-col gap-2 py-8 transition hover:bg-surface sm:flex-row sm:items-start sm:gap-8">
                  <span class="w-28 shrink-0 text-xs font-bold uppercase tracking-wider text-muted">
                    <%= new Date(a.published_at).toLocaleDateString('en-US', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                  </span>
                  <div class="flex-1">
                    <h2 class="text-xl font-extrabold text-ink transition group-hover:text-cyan-dark"><%= a.title %></h2>
                    <p class="mt-2 line-clamp-2 text-sm leading-7 text-muted"><%= a.body %></p>
                  </div>
                  <i class="fa-solid fa-arrow-right mt-2 shrink-0 text-cyan opacity-0 transition group-hover:opacity-100" aria-hidden="true"></i>
                </a>
              <% }) %>
            </div>
          <% } else { %>
            <div class="rounded-2xl border border-line bg-surface p-12 text-center">
              <p class="text-sm text-muted">No announcements have been published yet. Check back soon.</p>
            </div>
          <% } %>
        </div>
      </section>
    </main>

    <%- include('../partials/footer') %>
  </body>
</html>