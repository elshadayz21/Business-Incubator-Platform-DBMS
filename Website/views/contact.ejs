<!DOCTYPE html>
<html lang="en">
    <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Us - DxValley</title>
<script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-[#FFFDF5] text-black font-sans">

<div class="max-w-2xl mx-auto py-16 px-6">
    <div class="text-center mb-12">
        <h1 class="text-5xl md:text-6xl font-black uppercase tracking-tighter mb-4">Get in <span class="text-[#00ADEF]">Touch</span></h1>
        <p class="text-xl text-slate-600 font-medium">Have a question? Reach out to the DxValley team.</p>
    </div>

    <!-- Contact Form Card -->
    <div class="bg-white border-4 border-black rounded-3xl p-8 md:p-12 shadow-[6px_6px_0px_0px_#000]">

        <!-- Success/Error Message Box -->
        <div id="form-message" class="hidden mb-6 p-4 rounded-2xl border-2 border-black text-center font-bold"></div>

        <form id="contact-form" class="space-y-6">
            <!-- Name Input -->
            <div>
                <label for="name" class="block text-lg font-bold mb-3">Full Name</label>
                <input type="text" id="name" name="name" required class="w-full px-5 py-4 rounded-2xl border-2 border-black text-lg font-medium focus:outline-none focus:ring-4 focus:ring-[#00ADEF] bg-white" placeholder="John Doe">
            </div>

            <!-- Email Input -->
            <div>
                <label for="email" class="block text-lg font-bold mb-3">Email Address</label>
                <input type="email" id="email" name="email" required class="w-full px-5 py-4 rounded-2xl border-2 border-black text-lg font-medium focus:outline-none focus:ring-4 focus:ring-[#00ADEF] bg-white" placeholder="you@example.com">
            </div>

            <!-- Message Input -->
            <div>
                <label for="message" class="block text-lg font-bold mb-3">Message</label>
                <textarea id="message" name="message" rows="4" required class="w-full px-5 py-4 rounded-2xl border-2 border-black text-lg font-medium focus:outline-none focus:ring-4 focus:ring-[#00ADEF] bg-white" placeholder="How can we help you?"></textarea>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="w-full py-4 md:py-5 rounded-2xl bg-[#E38524] text-black border-2 border-black font-bold text-lg md:text-xl shadow-lg hover:-translate-y-1 transition-all flex items-center justify-center gap-2">
                <span>Send Message</span> 🚀
            </button>
        </form>
    </div>
</div>

<!-- JavaScript to handle the form submission -->
<script>
    document.getElementById('contact-form').addEventListener('submit', async (e) => {
    e.preventDefault(); // Prevent page reload

    const name = document.getElementById('name').value;
    const email = document.getElementById('email').value;
    const message = document.getElementById('message').value;
    const messageBox = document.getElementById('form-message');
    const submitButton = e.target.querySelector('button[type="submit"]');

    // Change button to loading state
    submitButton.disabled = true;
    submitButton.innerHTML = '<span class="inline-block h-5 w-5 animate-spin rounded-full border-4 border-white border-t-transparent"></span> Sending...';

    try {
    // Send data to our new backend API!
    const response = await fetch('/api/public/contact', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ name, email, message })
});

    const data = await response.json();

    if (response.ok) {
    // Show Success Message
    messageBox.className = 'mb-6 p-4 rounded-2xl border-2 border-black text-center font-bold bg-green-300 text-black';
    messageBox.textContent = '✅ ' + data.message;
    messageBox.classList.remove('hidden');

    // Clear the form
    document.getElementById('contact-form').reset();
} else {
    throw new Error(data.message || 'Something went wrong');
}
} catch (error) {
    // Show Error Message
    messageBox.className = 'mb-6 p-4 rounded-2xl border-2 border-black text-center font-bold bg-red-300 text-black';
    messageBox.textContent = '❌ ' + error.message;
    messageBox.classList.remove('hidden');
} finally {
    // Reset button
    submitButton.disabled = false;
    submitButton.innerHTML = '<span>Send Message</span> 🚀';
}
});
</script>
</body>
</html>