<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>

<body class="bg-surface text-ink min-h-screen flex flex-col font-sans">
    <%- include('../partials/header.ejs') %>

    <main class="flex-1 px-6 py-12 lg:px-10">
        <div class="max-w-3xl mx-auto">
            <!-- Back to Profile Button -->
            <a href="/v1/auth/profile?tab=funding" class="inline-flex items-center gap-2 text-sm font-bold text-cyan-dark hover:text-orange transition mb-8">
                <i class="fa-solid fa-arrow-left text-xs"></i> Back to Profile
            </a>

            <div class="mb-10 text-center">
                <span class="inline-block px-3 py-1 rounded-full bg-cyan-soft text-cyan-dark text-xs font-bold uppercase tracking-wider mb-4">Secure Funding</span>
                <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-cyan-dark">Request Funding</h1>
                <p class="mt-3 text-sm text-muted max-w-xl mx-auto">Tell us how much funding you need and what stage your project is in. Our review team will evaluate your request.</p>
            </div>

            <!-- Flash Messages -->
            <% if (error) { %>
            <div class="flex items-start gap-3 rounded-xl border border-red-200 bg-red-50 p-4 mb-8" role="alert">
                <i class="fa-solid fa-circle-exclamation mt-0.5 text-red-600"></i>
                <div class="text-sm font-semibold text-red-700">
                    Error: <span class="font-medium italic"><%= error %></span>
                </div>
            </div>
            <% } %>

            <% if (success) { %>
            <div class="flex items-start gap-3 rounded-xl border border-green-200 bg-green-50 p-4 mb-8" role="status">
                <i class="fa-solid fa-circle-check mt-0.5 text-green-600"></i>
                <div class="text-sm font-semibold text-green-700">
                    Success: <span class="font-medium italic"><%= success %></span>
                </div>
            </div>
            <% } %>

            <form action="/v1/funding/create" method="POST" class="space-y-8" id="fundingForm">
                <!-- Section 1: Select Project -->
                <div class="bg-white rounded-2xl border border-line shadow-xs p-6 sm:p-8 space-y-6">
                    <div class="flex items-center gap-3 border-b border-line pb-4">
                        <span class="grid h-9 w-9 place-items-center rounded-xl bg-cyan-soft text-cyan-dark font-bold text-sm">1</span>
                        <h2 class="text-lg font-bold text-ink">Select Your Project</h2>
                    </div>

                    <% if (projects && projects.length > 0) { %>
                    <div>
                        <label for="project_id" class="block text-xs font-extrabold uppercase tracking-widest text-muted mb-2">Project <span class="text-cyan">*</span></label>
                        <select id="project_id" name="project_id" required class="w-full rounded-lg border border-line bg-surface py-3 pl-4 pr-10 text-sm font-semibold text-ink outline-none focus:border-cyan focus:bg-white focus:ring-2 focus:ring-cyan/20">
                            <option value="">-- Choose a project --</option>
                            <% projects.forEach(project => { %>
                            <option value="<%= project.id %>"><%= project.name %> (<%= project.domain %>)</option>
                            <% }); %>
                        </select>
                        <p class="text-xs text-muted mt-2 font-medium">Select the project you want to request funding for</p>
                    </div>
                    <% } else { %>
                    <div class="p-4 bg-orange-soft rounded-xl border border-orange/20 text-center">
                        <p class="font-bold text-orange mb-2">No Projects Found</p>
                        <p class="text-sm text-muted mb-4">You need to create a project first before requesting funding.</p>
                        <a href="/v1/projects/new" class="inline-flex items-center gap-2 rounded-md bg-orange px-4 py-2 text-xs font-bold uppercase text-white shadow-sm hover:bg-orange-dark transition">
                            Create a Project
                        </a>
                    </div>
                    <% } %>
                </div>

                <!-- Section 2: Funding Details -->
                <% if (projects && projects.length > 0) { %>
                <div class="bg-white rounded-2xl border border-line shadow-xs p-6 sm:p-8 space-y-6">
                    <div class="flex items-center gap-3 border-b border-line pb-4">
                        <span class="grid h-9 w-9 place-items-center rounded-xl bg-orange-soft text-orange font-bold text-sm">2</span>
                        <h2 class="text-lg font-bold text-ink">Funding Details</h2>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                        <div>
                            <label for="amount" class="block text-xs font-extrabold uppercase tracking-widest text-muted mb-2">Funding Amount (USD) <span class="text-cyan">*</span></label>
                            <div class="relative">
                                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-sm font-bold text-muted pointer-events-none">$</span>
                                <input type="number" id="amount" name="amount" placeholder="50000" step="0.01" min="0" required class="w-full rounded-lg border border-line bg-surface pl-8 pr-4 py-3 text-sm font-semibold text-ink outline-none focus:border-cyan focus:bg-white focus:ring-2 focus:ring-cyan/20">
                            </div>
                        </div>

                        <div>
                            <label for="funding_stage" class="block text-xs font-extrabold uppercase tracking-widest text-muted mb-2">Funding Stage <span class="text-cyan">*</span></label>
                            <select id="funding_stage" name="funding_stage" required class="w-full rounded-lg border border-line bg-surface py-3 pl-4 pr-10 text-sm font-semibold text-ink outline-none focus:border-cyan focus:bg-white focus:ring-2 focus:ring-cyan/20">
                                <option value="">-- Select stage --</option>
                                <option value="Pre-Seed">Pre-Seed</option>
                                <option value="Seed">Seed Round</option>
                                <option value="Series A">Series A</option>
                                <option value="Series B">Series B</option>
                                <option value="Series C">Series C</option>
                                <option value="Growth">Growth Stage</option>
                            </select>
                        </div>
                    </div>

                    <div>
                        <label for="description" class="block text-xs font-extrabold uppercase tracking-widest text-muted mb-2">Use of Funds (Optional)</label>
                        <textarea id="description" name="description" rows="4" placeholder="Explain how you'll use the funding..." class="w-full rounded-lg border border-line bg-surface pl-4 pr-4 py-3 text-sm font-medium text-ink outline-none focus:border-cyan focus:bg-white focus:ring-2 focus:ring-cyan/20 resize-none"></textarea>
                        <p class="text-xs text-muted mt-2 font-medium">Describe how you plan to use the funding (e.g., product development, marketing, hiring)</p>
                    </div>
                </div>

                <!-- Submit Section -->
                <div class="bg-white rounded-2xl border border-line shadow-xs p-6 flex flex-col sm:flex-row gap-4 justify-between items-center">
                    <p class="text-xs text-muted font-medium text-center sm:text-left">
                        <span class="font-bold text-ink">Note:</span> A member of our team will review your request within 5-7 business days.
                    </p>
                    <button type="submit" class="w-full sm:w-auto inline-flex justify-center items-center gap-2 rounded-xl bg-cyan px-6 py-3 text-sm font-extrabold text-white shadow-sm hover:bg-cyan-dark transition">
                        Submit Request
                        <i class="fa-solid fa-arrow-right text-xs"></i>
                    </button>
                </div>
                <% } %>
            </form>
        </div>
    </main>
    <%- include('../partials/footer.ejs') %>
</body>
</html>