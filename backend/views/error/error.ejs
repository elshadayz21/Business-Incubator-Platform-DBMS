<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= typeof title !== 'undefined' ? title : 'Error' %> | Business Incubator</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&family=Space+Grotesk:wght@300..700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="/css/style.css" rel="stylesheet" />
  </head>
  <body class="bg-[#F6FAFC] min-h-screen flex flex-col font-sans text-[#111827] antialiased selection:bg-[#E38524] selection:text-white">
     <%- include('../partials/header') %>
    <main class="flex-grow relative overflow-hidden bg-gradient-to-br from-[#00ADEF] via-[#078CC8] to-[#0878B4] text-white py-12 px-6 flex items-center justify-center">
      
      <div class="pointer-events-none absolute -left-24 -top-20 h-[460px] w-[620px] rounded-[48%] border-[70px] border-white/10" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -right-40 bottom-[-240px] h-[620px] w-[760px] rounded-[50%] border-[90px] border-white/10" aria-hidden="true"></div>

      <div class="relative w-full max-w-[440px] rounded-[24px] border border-white/30 bg-white p-8 sm:p-9 text-[#111827] shadow-[0_20px_60px_rgba(0,63,102,0.25)] text-center">
        
        <div class="w-20 h-20 mx-auto mb-5 rounded-full flex items-center justify-center text-3xl" style="background-color: <%= typeof color !== 'undefined' ? color : '#EAF8FC' %>;">
          <i class="<%= typeof icon !== 'undefined' ? icon : 'fa-solid fa-triangle-exclamation' %> text-[#006F9E]"></i>
        </div>

        <h1 class="text-7xl font-extrabold tracking-tight text-[#111827] mb-2">
          <%= typeof statusCode !== 'undefined' ? statusCode : '500' %>
        </h1>

        <h2 class="text-2xl font-extrabold text-[#111827] mb-3 uppercase tracking-wide">
          <%= typeof title !== 'undefined' ? title : 'Server Error' %>
        </h2>

        <p class="text-sm leading-relaxed text-[#526274] mb-8 font-medium">
          <%= typeof message !== 'undefined' ? message : 'Something went wrong.' %>
        </p>

        <a href="<%= typeof redirectLink !== 'undefined' ? redirectLink : '/' %>" class="inline-flex items-center justify-center gap-2 px-8 py-3 bg-[#E38524] text-white rounded-xl font-extrabold uppercase tracking-[.1em] text-xs shadow-[0_8px_20px_rgba(227,133,36,0.3)] transition hover:bg-[#C97019] hover:-translate-y-0.5 hover:shadow-[0_12px_24px_rgba(227,133,36,0.35)]">
          <%= typeof buttonText !== 'undefined' ? buttonText : 'Go Home' %> <i class="fa-solid fa-arrow-right text-xs"></i>
        </a>
      </div>

    </main>

      <%- include('../partials/footer') %>
  </body>
</html>