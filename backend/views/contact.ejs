<!DOCTYPE html>
<html lang="en">
  <%- include('./partials/head', { title: 'Contact Us - DxValley Incubation Center' }) %>
  <body class="flex min-h-screen flex-col bg-white font-sans text-ink">
    <%- include('./partials/header') %>

    <main class="flex-grow">
      <section class="relative overflow-hidden bg-gradient-to-br from-cyan via-cyan-mid to-cyan-deep text-white">
        <div class="pointer-events-none absolute -left-28 -top-32 h-[520px] w-[700px] rounded-[48%] border-[76px] border-white/10" aria-hidden="true"></div>
        <div class="pointer-events-none absolute -right-44 bottom-[-260px] h-[620px] w-[760px] rounded-[50%] border-[88px] border-white/10" aria-hidden="true"></div>
        <div class="relative mx-auto max-w-7xl px-6 py-20 lg:px-10 lg:py-24">
          <p class="mb-5 inline-flex items-center gap-2 text-xs font-extrabold uppercase tracking-[.24em] text-white/80">
            <span class="h-2 w-2 rounded-full bg-orange" aria-hidden="true"></span>
            Contact us
          </p>
          <h1 class="max-w-[760px] text-5xl font-extrabold leading-[1.02] tracking-[-.055em] sm:text-6xl lg:text-7xl">
            Let's start<br />
            <span class="text-white/75">the conversation.</span>
          </h1>
          <p class="mt-7 max-w-[650px] text-lg leading-8 text-white/85 sm:text-xl">
            Have a question about our programs, mentorship, or how your startup can grow with DxValley? Send us a message and the team will get back to you.
          </p>
        </div>
      </section>

      <section class="bg-surface">
        <div class="mx-auto grid max-w-7xl gap-10 px-6 py-20 lg:grid-cols-[.8fr_1.2fr] lg:gap-16 lg:px-10 lg:py-24">
          <!-- Contact Info -->
          <div class="space-y-5">
            <div>
              <p class="text-xs font-extrabold uppercase tracking-[.2em] text-orange">Reach the team</p>
              <h2 class="mt-3 text-4xl font-extrabold tracking-[-.04em] text-cyan-dark sm:text-5xl">Get in touch</h2>
              <p class="mt-5 max-w-md text-base leading-8 text-muted">
                Whether you are a founder, a mentor, or a partner, we would love to hear from you. Use the form or reach us directly.
              </p>
            </div>

            <div class="space-y-4">
              <a href="mailto:hello@dxvalley.com" class="flex items-center gap-4 rounded-2xl border border-line bg-white p-5 shadow-[0_12px_30px_rgba(0,88,125,.08)] transition hover:-translate-y-0.5 hover:border-cyan/40">
                <span class="grid h-12 w-12 shrink-0 place-items-center rounded-full bg-cyan-soft text-cyan-dark" aria-hidden="true"><i class="fa-solid fa-envelope text-lg"></i></span>
                <span>
                  <span class="block text-xs font-extrabold uppercase tracking-[.15em] text-muted">Email</span>
                  <span class="block text-base font-bold text-ink">hello@dxvalley.com</span>
                </span>
              </a>

              <div class="flex items-center gap-4 rounded-2xl border border-line bg-white p-5 shadow-[0_12px_30px_rgba(0,88,125,.08)]">
                <span class="grid h-12 w-12 shrink-0 place-items-center rounded-full bg-orange-soft text-orange-dark" aria-hidden="true"><i class="fa-solid fa-location-dot text-lg"></i></span>
                <span>
                  <span class="block text-xs font-extrabold uppercase tracking-[.15em] text-muted">Office</span>
                  <span class="block text-base font-bold text-ink">Addis Ababa, Ethiopia</span>
                </span>
              </div>

              <div class="flex items-center gap-4 rounded-2xl border border-line bg-white p-5 shadow-[0_12px_30px_rgba(0,88,125,.08)]">
                <span class="grid h-12 w-12 shrink-0 place-items-center rounded-full bg-cyan-soft text-cyan-dark" aria-hidden="true"><i class="fa-solid fa-building-columns text-lg"></i></span>
                <span>
                  <span class="block text-xs font-extrabold uppercase tracking-[.15em] text-muted">Powered by</span>
                  <span class="block text-base font-bold text-ink">Cooperative Bank of Oromia</span>
                </span>
              </div>
            </div>
          </div>

          <!-- Contact Form -->
          <div class="rounded-3xl border border-line bg-white p-6 shadow-[0_22px_70px_rgba(0,63,102,.12)] sm:p-10">
            <!-- Success/Error Message Box -->
            <div id="form-message" class="hidden mb-6 p-4 rounded-xl border border-line text-center font-bold"></div>

            <form id="contact-form" class="space-y-5">
              <div>
                <label for="name" class="mb-2 block text-sm font-bold text-ink">Full Name</label>
                <input type="text" id="name" name="name" required class="w-full rounded-xl border border-line bg-surface px-4 py-3.5 text-sm font-medium text-ink outline-none transition placeholder:text-slate-400 focus:border-cyan focus:ring-2 focus:ring-cyan/20" placeholder="John Doe">
              </div>

              <div>
                <label for="email" class="mb-2 block text-sm font-bold text-ink">Email Address</label>
                <input type="email" id="email" name="email" required class="w-full rounded-xl border border-line bg-surface px-4 py-3.5 text-sm font-medium text-ink outline-none transition placeholder:text-slate-400 focus:border-cyan focus:ring-2 focus:ring-cyan/20" placeholder="you@example.com">
              </div>

              <div>
                <label for="message" class="mb-2 block text-sm font-bold text-ink">Message</label>
                <textarea id="message" name="message" rows="5" required class="w-full resize-none rounded-xl border border-line bg-surface px-4 py-3.5 text-sm font-medium text-ink outline-none transition placeholder:text-slate-400 focus:border-cyan focus:ring-2 focus:ring-cyan/20" placeholder="How can we help you?"></textarea>
              </div>

              <button type="submit" class="inline-flex w-full items-center justify-center gap-3 rounded-xl bg-orange px-6 py-4 text-sm font-extrabold text-white shadow-[0_10px_24px_rgba(141,67,10,.24)] transition hover:-translate-y-0.5 hover:bg-orange-dark focus:outline-none focus:ring-2 focus:ring-orange focus:ring-offset-2">
                <span>Send Message</span>
                <i class="fa-solid fa-paper-plane text-xs" aria-hidden="true"></i>
              </button>
            </form>
          </div>
        </div>
      </section>
    </main>

    <%- include('./partials/footer') %>

    <!-- JavaScript to handle the form submission -->
    <script>
      document.getElementById('contact-form').addEventListener('submit', async (e) => {
        e.preventDefault(); // Prevent page reload

        const name = document.getElementById('name').value;
        const email = document.getElementById('email').value;
        const message = document.getElementById('message').value;
        const messageBox = document.getElementById('form-message');
        const submitButton = e.target.querySelector('button[type="submit"]');
        const originalLabel = submitButton.innerHTML;

        // Change button to loading state
        submitButton.disabled = true;
        submitButton.innerHTML = '<span class="inline-block h-5 w-5 animate-spin rounded-full border-4 border-white border-t-transparent"></span> Sending...';

        try {
          // Send data to our new backend API!
          const response = await fetch('/api/public/contact', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name, email, message })
          });

          const data = await response.json();

          if (response.ok) {
            // Show Success Message
            messageBox.className = 'mb-6 p-4 rounded-xl border border-cyan/30 text-center font-bold bg-cyan-soft text-cyan-dark';
            messageBox.textContent = '✅ ' + data.message;
            messageBox.classList.remove('hidden');

            // Clear the form
            document.getElementById('contact-form').reset();
          } else {
            throw new Error(data.message || 'Something went wrong');
          }
        } catch (error) {
          // Show Error Message
          messageBox.className = 'mb-6 p-4 rounded-xl border border-orange/30 text-center font-bold bg-orange-soft text-orange-dark';
          messageBox.textContent = '❌ ' + error.message;
          messageBox.classList.remove('hidden');
        } finally {
          // Reset button
          submitButton.disabled = false;
          submitButton.innerHTML = originalLabel;
        }
      });
    </script>
  </body>
</html>
