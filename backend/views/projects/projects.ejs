<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>

<body class="bg-surface text-ink font-sans flex flex-col min-h-screen">
    <%- include('../partials/header.ejs') %>

    <main class="flex-1">

        <!-- Hero -->
        <section class="relative overflow-hidden bg-gradient-to-br from-cyan via-cyan-mid to-cyan-deep text-white">
            <div class="pointer-events-none absolute -left-24 -top-20 h-[460px] w-[620px] rounded-[48%] border-[70px] border-white/10" aria-hidden="true"></div>
            <div class="pointer-events-none absolute -right-40 bottom-[-240px] h-[620px] w-[760px] rounded-[50%] border-[90px] border-white/10" aria-hidden="true"></div>
            <div class="pointer-events-none absolute right-[28%] top-14 h-20 w-20 rounded-full bg-white/10 blur-xl" aria-hidden="true"></div>

            <div class="relative mx-auto max-w-7xl px-6 py-16 lg:px-10 lg:py-24">
                <p class="mb-5 inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[.24em] text-white/80">
                    <span class="h-2 w-2 rounded-full bg-orange" aria-hidden="true"></span>
                    Innovation Hub
                </p>
                <h1 class="max-w-[700px] text-5xl font-extrabold leading-[1.02] tracking-[-.04em] sm:text-6xl">
                    Projects & <span class="text-white/75">Ideas</span>
                </h1>
                <p class="mt-6 max-w-[610px] text-base leading-7 text-white/85 sm:text-lg">
                    Explore innovative projects and startup ideas from our incubator community — and find the right technical partners.
                </p>

                <div class="mt-10 max-w-5xl rounded-2xl border border-white/30 bg-white p-4 text-ink shadow-[0_22px_70px_rgba(0,63,102,.25)] sm:p-5">
                    <div class="grid gap-4 md:grid-cols-[1fr_240px]">
                        <div class="relative">
                            <label class="sr-only" for="searchInput">Search projects</label>
                            <i class="fa-solid fa-magnifying-glass pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-sm text-muted" aria-hidden="true"></i>
                            <input type="text" id="searchInput" placeholder="Search projects..."
                                class="w-full rounded-full border border-line bg-surface py-3.5 pl-11 pr-5 text-sm font-semibold text-ink outline-none transition placeholder:font-normal placeholder:text-slate-400 focus:border-cyan focus:bg-white focus:ring-2 focus:ring-cyan/20" />
                        </div>
                        <div class="relative">
                            <label class="sr-only" for="statusFilter">Filter by status</label>
                            <select id="statusFilter"
                                class="w-full cursor-pointer appearance-none rounded-full border border-line bg-surface py-3.5 pl-5 pr-11 text-sm font-bold text-ink outline-none transition focus:border-cyan focus:bg-white focus:ring-2 focus:ring-cyan/20">
                                <option value="">All Status</option>
                                <option value="approved">Approved</option>
                                <option value="in-progress">In Progress</option>
                                <option value="completed">Completed</option>
                            </select>
                            <i class="fa-solid fa-chevron-down pointer-events-none absolute right-5 top-1/2 -translate-y-1/2 text-xs text-muted" aria-hidden="true"></i>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Project grid -->
        <section class="bg-surface">
            <div class="mx-auto max-w-7xl px-6 py-16 lg:px-10 lg:py-20">

                <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3" id="projectsGrid">

                    <% projects.forEach(project=> {
                        let headerColorBg = 'bg-cyan';
                        let softBg = 'bg-cyan-soft';
                        let accentBorder = 'border-cyan';
                        let accentText = 'text-cyan-dark';
                        let iconClass = 'fa-lightbulb';
                        let textColor = 'text-white';

                        const st = (project.status || '').toLowerCase();

                        if (st.includes('in-progress') || st.includes('in progress')) {
                            headerColorBg = 'bg-orange';
                            softBg = 'bg-orange-soft';
                            accentBorder = 'border-orange';
                            accentText = 'text-orange-dark';
                            iconClass = 'fa-rocket';
                            textColor = 'text-white';
                        } else if (st.includes('completed') || st.includes('complete')) {
                            headerColorBg = 'bg-emerald-600';
                            softBg = 'bg-emerald-50';
                            accentBorder = 'border-emerald-600';
                            accentText = 'text-emerald-700';
                            iconClass = 'fa-trophy';
                            textColor = 'text-white';
                        } else if (st.includes('approved')) {
                            headerColorBg = 'bg-cyan-dark';
                            softBg = 'bg-cyan-soft';
                            accentBorder = 'border-cyan-dark';
                            accentText = 'text-cyan-dark';
                            iconClass = 'fa-circle-check';
                            textColor = 'text-white';
                        }
                    %>

                    <div class="group relative flex h-full flex-col overflow-hidden rounded-2xl border border-line bg-white shadow-sm transition duration-300 hover:-translate-y-1.5 hover:border-cyan/30 hover:shadow-md project-card"
                         data-status="<%= project.status.toLowerCase() %>"
                         data-title="<%= project.title.toLowerCase() %>"
                         data-description="<%= project.description.toLowerCase() %>"
                         data-tech="<%= project.techStack.join(' ').toLowerCase() %>">

                        <a href="/v1/projects/<%= project.id %>" class="flex flex-grow flex-col text-inherit no-underline hover:no-underline">

                            <div class="relative h-28 <%= headerColorBg %>">
                                <div class="absolute inset-0 opacity-90" style="background-image: radial-gradient(rgba(255,255,255,.22) 1px, transparent 1px); background-size: 12px 12px;" aria-hidden="true"></div>
                                <span class="absolute left-5 top-1/2 -translate-y-1/2 grid h-12 w-12 place-items-center rounded-full bg-white/95 text-xl <%= accentText %> shadow-sm">
                                    <i class="fa-solid <%= iconClass %>" aria-hidden="true"></i>
                                </span>
                                <span class="absolute right-4 top-4 rounded-full border border-white/40 bg-white/15 px-3 py-1 text-[10px] font-bold uppercase tracking-wider text-white backdrop-blur-sm">
                                    <%= project.status %>
                                </span>
                            </div>

                            <div class="flex flex-grow flex-col p-6">
                                <h3 class="text-xl font-extrabold leading-tight tracking-[-.02em] text-ink transition-colors group-hover:text-cyan-dark">
                                    <%= project.title %>
                                </h3>
                                <p class="mt-3 border-l-2 <%= accentBorder %> pl-3 text-sm leading-6 text-muted line-clamp-3">
                                    <%= project.description %>
                                </p>

                                <div class="mt-5 rounded-xl <%= softBg %> p-4">
                                    <p class="text-[10px] font-extrabold uppercase tracking-[.18em] <%= accentText %>">Problem Solved</p>
                                    <p class="mt-1.5 line-clamp-2 text-sm font-semibold italic leading-snug text-ink">
                                        "<%= project.problem %>"
                                    </p>
                                </div>

                                <div class="mt-6">
                                    <p class="text-[10px] font-extrabold uppercase tracking-[.18em] text-muted">Tech Stack</p>
                                    <div class="mt-2.5 flex flex-wrap gap-2">
                                        <% project.techStack.forEach(tech=> { %>
                                            <span class="rounded-full border border-line bg-surface px-3 py-1 text-[11px] font-bold text-ink">
                                                <%= tech %>
                                            </span>
                                        <% }); %>
                                    </div>
                                </div>

                                <div class="mt-auto pt-6">
                                    <div class="flex items-center gap-3 border-t border-line pt-4">
                                        <div class="flex -space-x-2.5">
                                            <% project.team.slice(0, 3).forEach(member=> { %>
                                                <div class="relative z-10 grid h-8 w-8 place-items-center rounded-full <%= headerColorBg %> <%= textColor %> text-[10px] font-bold uppercase ring-2 ring-white">
                                                    <%= member.initials %>
                                                </div>
                                            <% }); %>
                                            <% if(project.team.length > 3) { %>
                                                <div class="relative z-10 grid h-8 w-8 place-items-center rounded-full bg-surface text-ink text-[10px] font-bold ring-2 ring-white">
                                                    +<%= project.team.length - 3 %>
                                                </div>
                                            <% } %>
                                        </div>
                                        <span class="text-xs font-bold text-muted"><%= project.team.length %> Members</span>
                                    </div>
                                </div>
                            </div>
                        </a>

                        <div class="grid grid-cols-2 divide-x divide-line border-t border-line">
                            <a href="<%= project.links.github %>" target="_blank"
                               class="flex items-center justify-center gap-2 bg-white py-3.5 text-sm font-bold text-ink transition-colors hover:bg-ink hover:text-white">
                                <i class="fa-brands fa-github text-base" aria-hidden="true"></i>
                                GitHub
                            </a>
                            <a href="<%= project.links.demo %>" target="_blank"
                               class="flex items-center justify-center gap-2 bg-white py-3.5 text-sm font-bold text-ink transition-colors hover:bg-cyan hover:text-white">
                                <i class="fa-solid fa-desktop text-sm" aria-hidden="true"></i>
                                Demo
                            </a>
                        </div>
                    </div>
                    <% }); %>

                </div>

                <div class="rounded-2xl border border-line bg-white px-6 py-20 text-center shadow-sm" id="emptyState" style="display: none;">
                    <div class="mx-auto grid h-16 w-16 place-items-center rounded-full bg-cyan-soft text-cyan-dark">
                        <i class="fa-solid fa-magnifying-glass text-2xl" aria-hidden="true"></i>
                    </div>
                    <h3 class="mt-6 text-2xl font-extrabold tracking-[-.02em] text-cyan-dark">No Projects Found</h3>
                    <p class="mx-auto mt-3 max-w-md text-sm leading-6 text-muted">
                        We couldn't find what you're looking for. Try adjusting your filters or search terms.
                    </p>
                    <button onclick="resetFilters()"
                        class="mt-8 inline-flex items-center gap-2 rounded-md bg-cyan px-6 py-3 text-sm font-extrabold uppercase tracking-wide text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-cyan-dark focus:outline-none focus:ring-2 focus:ring-cyan focus:ring-offset-2">
                        Reset Filters
                    </button>
                </div>
            </div>
        </section>

        <!-- CTA -->
        <section class="bg-cyan-soft">
            <div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-8 px-6 py-16 lg:flex-row lg:items-center lg:px-10 lg:py-20">
                <div>
                    <p class="text-xs font-extrabold uppercase tracking-[.2em] text-orange">Got an innovative idea?</p>
                    <h2 class="mt-3 max-w-[720px] text-4xl font-extrabold tracking-[-.04em] text-cyan-dark sm:text-5xl">Ready to turn your idea into a project?</h2>
                    <p class="mt-4 text-base text-muted">Submit your project definition. Get incubated. Build the future.</p>
                </div>
                <a href="/v1/projects/new"
                   class="inline-flex shrink-0 items-center gap-3 rounded-md bg-orange px-7 py-4 text-sm font-extrabold text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-orange-dark focus:outline-none focus:ring-2 focus:ring-orange focus:ring-offset-2">
                    Create a project
                    <i class="fa-solid fa-arrow-right text-xs" aria-hidden="true"></i>
                </a>
            </div>
        </section>

    </main>

    <%- include('../partials/footer.ejs') %>
    <script src="/js/projects.js"></script>
</body>
</html>
