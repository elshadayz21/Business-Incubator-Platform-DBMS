<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head.ejs') %>

<body class="bg-surface text-ink min-h-screen flex flex-col font-sans">

    <!-- Dedicated Portal Profile Header (No public website header/nav) -->
    <header class="sticky top-0 z-50 border-b border-line bg-white/95 backdrop-blur shadow-xs">
        <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-3.5 lg:px-10">
            <div class="flex items-center gap-4">
                <a href="/admin" class="flex items-center gap-3">
                    <img src="/brand/dxvalley-wordmark.jpeg" alt="DxValley" class="h-9 w-auto object-contain" />
                </a>
                <span class="hidden h-5 w-[1px] bg-line sm:block"></span>
                <span class="hidden text-xs font-bold text-muted sm:block">User Profile & Account Settings</span>
            </div>

            <div class="flex items-center gap-3">
                <a href="/admin"
                    class="inline-flex items-center gap-2 rounded-full border border-line bg-cyan-soft px-4 py-2 text-xs font-bold text-cyan-dark transition hover:bg-cyan hover:text-white">
                    <i class="fa-solid fa-arrow-left text-[11px]" aria-hidden="true"></i>
                    <span>Back to Dashboard</span>
                </a>

                <form action="/v1/auth/logout" method="POST" class="inline">
                    <button type="submit"
                        class="inline-flex items-center gap-1.5 rounded-full border border-red-200 bg-red-50 px-3.5 py-2 text-xs font-bold text-red-600 transition hover:bg-red-600 hover:text-white">
                        <i class="fa-solid fa-right-from-bracket text-[11px]" aria-hidden="true"></i>
                        <span class="hidden sm:inline">Sign Out</span>
                    </button>
                </form>
            </div>
        </div>
    </header>

    <main class="flex-1 px-6 py-10 lg:px-10">
        <div class="max-w-7xl mx-auto">

            <div class="mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-line pb-6">
                <div>
                    <p class="text-xs font-extrabold uppercase tracking-[.2em] text-orange">Account Management</p>
                    <h1 class="mt-1 text-3xl font-extrabold tracking-tight text-cyan-dark sm:text-4xl">
                        Your <span class="text-orange">Profile Settings</span>
                    </h1>
                    <p class="mt-1 text-xs font-semibold text-muted">Manage your personal details, avatar, and security preferences.</p>
                </div>
                <div>
                    <a href="/admin"
                        class="inline-flex items-center gap-2 rounded-xl border border-line bg-white px-4 py-2.5 text-xs font-bold text-cyan-dark transition hover:border-cyan hover:bg-cyan-soft shadow-xs">
                        <i class="fa-solid fa-arrow-left text-[11px]" aria-hidden="true"></i>
                        Back to <%= (user.role === 'admin' || user.role === 'superadmin') ? user.role : '' %> Dashboard
                    </a>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">

                <aside class="lg:col-span-3">
                    <div class="rounded-2xl border border-line bg-white p-5 shadow-sm lg:sticky lg:top-24">
                        <div class="mb-4 flex items-center gap-3 border-b border-line pb-3">
                            <span class="grid h-10 w-10 place-items-center rounded-full bg-cyan-soft text-cyan-dark font-extrabold text-sm">
                                <%= user && user.name ? user.name.charAt(0).toUpperCase() : 'U' %>
                            </span>
                            <div class="min-w-0">
                                <p class="truncate text-xs font-bold text-ink"><%= user.name %></p>
                                <p class="truncate text-[10px] font-semibold uppercase text-orange"><%= user.role %></p>
                            </div>
                        </div>
                        <nav class="space-y-1.5">
                            <a href="?tab=info"
                                class="flex items-center gap-3 rounded-lg px-4 py-3 text-sm font-bold transition <%= dashboard.activeTab === 'info' ? 'bg-cyan text-white shadow-sm' : 'text-ink hover:bg-cyan-soft hover:text-cyan-dark' %>">
                                <span class="w-5 text-center text-base"><i class="fa-solid fa-id-card" aria-hidden="true"></i></span>
                                <span>Profile Info</span>
                            </a>
                        </nav>
                    </div>
                </aside>

                <div class="lg:col-span-9 space-y-8">

                    <% if (error) { %>
                        <div class="flex items-center gap-4 rounded-xl border border-red-200 bg-red-50 p-4">
                            <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-red-500 text-white"><i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i></span>
                            <div>
                                <h3 class="text-sm font-extrabold uppercase tracking-wide text-red-700">Error</h3>
                                <p class="mt-0.5 text-sm font-medium text-red-600"><%= error %></p>
                            </div>
                        </div>
                    <% } %>

                    <% if (success) { %>
                        <div class="flex items-center gap-4 rounded-xl border border-green-200 bg-green-50 p-4">
                            <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-green-500 text-white"><i class="fa-solid fa-circle-check" aria-hidden="true"></i></span>
                            <div>
                                <h3 class="text-sm font-extrabold uppercase tracking-wide text-green-700">Success</h3>
                                <p class="mt-0.5 text-sm font-medium text-green-600"><%= success %></p>
                            </div>
                        </div>
                    <% } %>

                    <!-- PROFILE PICTURE TAB -->
                    <section id="profile-picture" class="rounded-2xl border border-line bg-white p-8 shadow-sm">
                        <div class="mb-8 flex items-center gap-3 border-b border-line pb-4">
                            <span class="grid h-10 w-10 place-items-center rounded-xl bg-cyan-soft text-cyan-dark"><i class="fa-solid fa-camera" aria-hidden="true"></i></span>
                            <h2 class="text-2xl font-extrabold tracking-[-.02em] text-cyan-dark">Avatar Settings</h2>
                        </div>

                        <div class="flex flex-col sm:flex-row items-center gap-8">
                            <div class="relative shrink-0">
                                <% if (user && user.profilePicture) { %>
                                    <img src="<%= user.profilePicture %>?v=<%= Date.now() %>" alt="Profile"
                                        class="h-36 w-36 rounded-full border-4 border-white object-cover shadow-md ring-4 ring-cyan/20">
                                <% } else { %>
                                    <div class="h-36 w-36 rounded-full border-4 border-white bg-cyan-soft shadow-md ring-4 ring-cyan/20 flex items-center justify-center">
                                        <span class="text-5xl font-extrabold text-cyan-dark"><%= user && user.name ? user.name.charAt(0).toUpperCase() : '?' %></span>
                                    </div>
                                <% } %>
                            </div>

                            <div class="flex-1 w-full">
                                <form action="/v1/auth/profile/upload-picture" method="POST" enctype="multipart/form-data" class="space-y-4">
                                    <label class="block text-xs font-extrabold uppercase tracking-widest text-muted mb-2">New Picture</label>
                                    <input name="profilePicture" type="file" accept="image/*" required
                                        class="w-full rounded-lg border border-line bg-surface p-2 text-sm font-medium text-ink outline-none transition file:mr-4 file:rounded-md file:border-0 file:bg-orange file:px-4 file:py-2 file:text-xs file:font-bold file:text-white file:uppercase hover:file:bg-orange-dark" />

                                    <button type="submit" class="inline-flex items-center gap-2 rounded-md bg-cyan px-6 py-3 text-sm font-bold text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-cyan-dark focus:outline-none focus:ring-2 focus:ring-cyan focus:ring-offset-2">
                                        <i class="fa-solid fa-upload text-xs" aria-hidden="true"></i>
                                        Update Avatar
                                    </button>
                                </form>
                            </div>
                        </div>
                    </section>

                    <!-- IDENTITY DATA -->
                    <section id="profile-info" class="rounded-2xl border border-line bg-white p-8 shadow-sm">
                        <div class="mb-8 flex items-center gap-3 border-b border-line pb-4">
                            <span class="grid h-10 w-10 place-items-center rounded-xl bg-cyan-soft text-cyan-dark"><i class="fa-solid fa-id-card" aria-hidden="true"></i></span>
                            <h2 class="text-2xl font-extrabold tracking-[-.02em] text-cyan-dark">Identity Data</h2>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-6">
                            <div class="space-y-2">
                                <label class="block text-xs font-extrabold uppercase tracking-widest text-muted">Full Name</label>
                                <input type="text" value="<%= user ? user.name : '' %>" readonly
                                    class="w-full rounded-lg border border-line bg-surface px-4 py-3 text-sm font-bold uppercase text-muted cursor-not-allowed" />
                            </div>
                            <div class="space-y-2">
                                <label class="block text-xs font-extrabold uppercase tracking-widest text-muted">Email Address</label>
                                <input type="email" value="<%= user ? user.email : '' %>" readonly
                                    class="w-full rounded-lg border border-line bg-surface px-4 py-3 text-sm font-semibold text-muted cursor-not-allowed" />
                            </div>
                            <% if (user && user.userCode) { %>
                            <div class="space-y-2 sm:col-span-2">
                                <label class="block text-xs font-extrabold uppercase tracking-widest text-muted">User Code</label>
                                <div class="flex items-center gap-2">
                                    <input type="text" id="user-code-input" value="<%= user.userCode %>" readonly
                                        class="w-full max-w-sm rounded-lg border border-cyan/30 bg-cyan-soft px-4 py-3 text-sm font-extrabold tracking-wider text-cyan-dark cursor-pointer" title="Click to copy" />
                                    <button type="button" onclick="navigator.clipboard.writeText(document.getElementById('user-code-input').value).then(()=>{const b=this;b.textContent='Copied';setTimeout(()=>b.textContent='Copy',1500)})" class="shrink-0 rounded-lg border border-cyan/30 bg-white px-4 py-3 text-xs font-extrabold text-cyan-dark hover:bg-cyan-soft">Copy</button>
                                </div>
                                <p class="text-xs font-medium text-muted">Use this code when adding co-founders to your project.</p>
                            </div>
                            <% } %>
                        </div>

                        <% if (user.role === 'mentor' || user.role === 'investor') { %>
                            <div class="grid grid-cols-1 gap-6">
                                <% if (user.expertise) { %>
                                <div class="space-y-2">
                                    <label class="block text-xs font-extrabold uppercase tracking-widest text-muted">Area of Expertise</label>
                                    <input type="text" value="<%= user.expertise %>" readonly
                                        class="w-full rounded-lg border border-line bg-surface px-4 py-3 text-sm font-semibold text-muted cursor-not-allowed" />
                                </div>
                                <% } %>
                                <% if (user.company) { %>
                                <div class="space-y-2">
                                    <label class="block text-xs font-extrabold uppercase tracking-widest text-muted">Associated Company</label>
                                    <input type="text" value="<%= user.company %>" readonly
                                        class="w-full rounded-lg border border-line bg-surface px-4 py-3 text-sm font-semibold text-muted cursor-not-allowed" />
                                </div>
                                <% } %>
                                <% if (user.bio) { %>
                                <div class="space-y-2">
                                    <label class="block text-xs font-extrabold uppercase tracking-widest text-muted">Professional Bio</label>
                                    <textarea readonly rows="3" class="w-full rounded-lg border border-line bg-surface px-4 py-3 text-sm font-medium text-muted cursor-not-allowed resize-none"><%= user.bio %></textarea>
                                </div>
                                <% } %>
                            </div>
                        <% } %>
                    </section>

                    <!-- SECURITY / PASSWORD -->
                    <section id="change-password" class="rounded-2xl border border-line bg-white p-8 shadow-sm">
                        <div class="mb-8 flex items-center gap-3 border-b border-line pb-4">
                            <span class="grid h-10 w-10 place-items-center rounded-xl bg-orange-soft text-orange"><i class="fa-solid fa-lock" aria-hidden="true"></i></span>
                            <h2 class="text-2xl font-extrabold tracking-[-.02em] text-cyan-dark">Security Access</h2>
                        </div>

                        <form action="/v1/auth/profile/update-password" method="POST" class="space-y-6">
                            <div class="space-y-2">
                                <label class="block text-xs font-extrabold uppercase tracking-widest text-muted">Current Password</label>
                                <input name="currentPassword" type="password" required placeholder="••••••••"
                                    class="w-full rounded-lg border border-line bg-surface px-4 py-3 text-sm font-semibold outline-none transition placeholder:text-slate-400 focus:border-cyan focus:bg-white focus:ring-2 focus:ring-cyan/20" />
                            </div>

                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                                <div class="space-y-2">
                                    <label class="block text-xs font-extrabold uppercase tracking-widest text-muted">New Password</label>
                                    <input name="newPassword" type="password" required placeholder="••••••••"
                                        class="w-full rounded-lg border border-line bg-surface px-4 py-3 text-sm font-semibold outline-none transition placeholder:text-slate-400 focus:border-cyan focus:bg-white focus:ring-2 focus:ring-cyan/20" />
                                </div>
                                <div class="space-y-2">
                                    <label class="block text-xs font-extrabold uppercase tracking-widest text-muted">Confirm New</label>
                                    <input name="confirmPassword" type="password" required placeholder="••••••••"
                                        class="w-full rounded-lg border border-line bg-surface px-4 py-3 text-sm font-semibold outline-none transition placeholder:text-slate-400 focus:border-cyan focus:bg-white focus:ring-2 focus:ring-cyan/20" />
                                </div>
                            </div>

                            <button type="submit" class="inline-flex items-center gap-2 rounded-md bg-orange px-8 py-4 text-sm font-bold text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-orange-dark focus:outline-none focus:ring-2 focus:ring-orange focus:ring-offset-2">
                                <i class="fa-solid fa-key text-xs" aria-hidden="true"></i>
                                Update Credentials
                            </button>
                        </form>
                    </section>

                </div>
            </div>
        </div>
    </main>

    <!-- Dedicated Portal Profile Footer (No public website footer) -->
    <footer class="mt-auto border-t border-line bg-white py-6">
        <div class="mx-auto max-w-7xl px-6 text-center lg:px-10">
            <p class="text-xs font-semibold text-muted">
                &copy; <%= new Date().getFullYear() %> DxValley Incubation Center &bull; Cooperative Bank of Oromia. All rights reserved.
            </p>
        </div>
    </footer>

</body>

</html>
