<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head.ejs') %>

<body class="bg-surface text-ink min-h-screen flex flex-col font-sans">

    <!-- Header -->
    <header class="sticky top-0 z-50 border-b border-line bg-white/95 backdrop-blur shadow-xs">
        <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-3.5 lg:px-10">
            <div class="flex items-center gap-4">
                <a href="/admin"
                    class="inline-flex items-center gap-2 rounded-full border border-line bg-cyan-soft px-4 py-2 text-xs font-bold text-cyan-dark transition hover:bg-cyan hover:text-white">
                    <i class="fa-solid fa-arrow-left text-[11px]" aria-hidden="true"></i>
                    <span>Back to Dashboard</span>
                </a>
            </div>
        </div>
    </header>

    <main class="flex-1 px-6 py-8 lg:px-10">
        <div class="max-w-5xl mx-auto">

            <!-- Profile Hero -->
            <div class="relative rounded-2xl border border-line bg-white shadow-sm overflow-hidden mb-8">
                <div class="h-32 bg-gradient-to-r from-cyan-dark via-cyan to-cyan-mid relative">
                    <div class="absolute inset-0 bg-[url('/brand/dxvalley-pattern.svg')] opacity-10"></div>
                </div>
                <div class="px-4 sm:px-8 pb-8">
                    <div class="-mt-16 relative z-10">
                        <div class="flex flex-col items-center sm:flex-row sm:items-end gap-4 sm:gap-5">
                            <!-- Clickable Avatar -->
                            <div class="relative shrink-0 cursor-pointer group" onclick="document.getElementById('avatar-input').click()">
                                <% if (user && user.profilePicture) { %>
                                    <img src="<%= user.profilePicture %>?v=<%= Date.now() %>" alt="Profile"
                                        class="h-24 w-24 sm:h-28 sm:w-28 rounded-full border-4 border-white object-cover shadow-lg transition group-hover:brightness-75">
                                <% } else { %>
                                    <div class="h-24 w-24 sm:h-28 sm:w-28 rounded-full border-4 border-white bg-gradient-to-br from-cyan to-cyan-dark shadow-lg flex items-center justify-center transition group-hover:brightness-75">
                                        <span class="text-3xl sm:text-4xl font-extrabold text-white"><%= user && user.name ? user.name.charAt(0).toUpperCase() : '?' %></span>
                                    </div>
                                <% } %>
                                <span class="absolute inset-0 grid h-full w-full place-items-center rounded-full bg-black/40 opacity-0 transition group-hover:opacity-100">
                                    <i class="fa-solid fa-camera text-white text-lg" aria-hidden="true"></i>
                                </span>
                                <span class="absolute -bottom-1 -right-1 grid h-7 w-7 place-items-center rounded-full border-2 border-white bg-green-500 text-white shadow-sm">
                                    <i class="fa-solid fa-check text-[10px]" aria-hidden="true"></i>
                                </span>
                            </div>

                            <!-- Name & Badges -->
                            <div class="flex-1 text-center sm:text-left pb-1 overflow-hidden">
                                <h1 class="text-xl sm:text-2xl font-extrabold tracking-tight text-ink leading-tight"><%= user ? user.name : 'User' %></h1>
                                <div class="mt-2 flex flex-wrap items-center justify-center sm:justify-start gap-1.5">
                                    <span class="inline-flex items-center gap-1 rounded-full border border-cyan/20 bg-cyan-soft px-2.5 py-0.5 text-[10px] sm:text-[11px] font-bold text-cyan-dark uppercase whitespace-nowrap">
                                        <i class="fa-solid fa-shield-halved text-[8px]" aria-hidden="true"></i>
                                        <%= user ? user.role : 'User' %>
                                    </span>
                                    <% if (user && user.userCode) { %>
                                    <span class="inline-flex items-center gap-1 rounded-full border border-line bg-surface px-2.5 py-0.5 text-[10px] sm:text-[11px] font-bold text-muted whitespace-nowrap">
                                        <i class="fa-solid fa-fingerprint text-[8px]" aria-hidden="true"></i>
                                        <%= user.userCode %>
                                    </span>
                                    <% } %>
                                    <span class="inline-flex items-center gap-1 rounded-full border border-line bg-surface px-2.5 py-0.5 text-[10px] sm:text-[11px] font-semibold text-muted whitespace-nowrap">
                                        <i class="fa-solid fa-envelope text-[8px] shrink-0" aria-hidden="true"></i>
                                        <span class="truncate max-w-[180px]"><%= user ? user.email : '' %></span>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Flash Messages -->
            <% if (error) { %>
                <div class="mb-6 flex items-center gap-4 rounded-xl border border-red-200 bg-red-50 p-4">
                    <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-red-500 text-white"><i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i></span>
                    <div>
                        <h3 class="text-sm font-extrabold uppercase tracking-wide text-red-700">Error</h3>
                        <p class="mt-0.5 text-sm font-medium text-red-600"><%= error %></p>
                    </div>
                </div>
            <% } %>
            <% if (success) { %>
                <div class="mb-6 flex items-center gap-4 rounded-xl border border-green-200 bg-green-50 p-4">
                    <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-green-500 text-white"><i class="fa-solid fa-circle-check" aria-hidden="true"></i></span>
                    <div>
                        <h3 class="text-sm font-extrabold uppercase tracking-wide text-green-700">Success</h3>
                        <p class="mt-0.5 text-sm font-medium text-green-600"><%= success %></p>
                    </div>
                </div>
            <% } %>

            <!-- Content Grid -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

                <!-- Left Column -->
                <div class="lg:col-span-2 space-y-6">

                    <!-- Personal Information -->
                    <section class="rounded-2xl border border-line bg-white p-6 shadow-sm">
                        <div class="mb-6 flex items-center justify-between border-b border-line pb-4">
                            <div class="flex items-center gap-3">
                                <span class="grid h-9 w-9 place-items-center rounded-xl bg-cyan-soft text-cyan-dark"><i class="fa-solid fa-user text-sm" aria-hidden="true"></i></span>
                                <h2 class="text-lg font-extrabold tracking-tight text-cyan-dark">Personal Information</h2>
                            </div>
                            <span class="rounded-full bg-green-50 border border-green-200 px-2.5 py-1 text-[10px] font-bold text-green-700 uppercase">Verified</span>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                            <!-- Full Name (read-only) -->
                            <div class="space-y-1.5">
                                <label class="block text-[10px] font-extrabold uppercase tracking-widest text-muted">Full Name</label>
                                <div class="flex items-center gap-2 rounded-lg border border-line bg-surface px-4 py-2.5">
                                    <i class="fa-solid fa-user text-xs text-muted" aria-hidden="true"></i>
                                    <span class="text-sm font-bold text-ink"><%= user ? user.name : '' %></span>
                                </div>
                            </div>
                            <!-- Email (read-only) -->
                            <div class="space-y-1.5">
                                <label class="block text-[10px] font-extrabold uppercase tracking-widest text-muted">Email Address</label>
                                <div class="flex items-center gap-2 rounded-lg border border-line bg-surface px-4 py-2.5">
                                    <i class="fa-solid fa-envelope text-xs text-muted" aria-hidden="true"></i>
                                    <span class="text-sm font-semibold text-ink"><%= user ? user.email : '' %></span>
                                </div>
                            </div>
                            <!-- Role (read-only) -->
                            <div class="space-y-1.5">
                                <label class="block text-[10px] font-extrabold uppercase tracking-widest text-muted">Role</label>
                                <div class="flex items-center gap-2 rounded-lg border border-line bg-surface px-4 py-2.5">
                                    <i class="fa-solid fa-shield-halved text-xs text-muted" aria-hidden="true"></i>
                                    <span class="text-sm font-bold text-ink capitalize"><%= user ? user.role : '' %></span>
                                </div>
                            </div>
                            <% if (user && user.userCode) { %>
                            <div class="space-y-1.5">
                                <label class="block text-[10px] font-extrabold uppercase tracking-widest text-muted">User Code</label>
                                <div class="flex items-center gap-2 rounded-lg border border-cyan/20 bg-cyan-soft px-4 py-2.5">
                                    <i class="fa-solid fa-fingerprint text-xs text-cyan-dark" aria-hidden="true"></i>
                                    <span class="text-sm font-extrabold text-cyan-dark tracking-wider"><%= user.userCode %></span>
                                    <button type="button" onclick="navigator.clipboard.writeText('<%= user.userCode %>').then(()=>{this.innerHTML='<i class=\'fa-solid fa-check\'></i> Copied';setTimeout(()=>this.innerHTML='<i class=\'fa-solid fa-copy\'></i>',1500)})"
                                        class="ml-auto shrink-0 rounded-md border border-cyan/20 bg-white px-2 py-1 text-[10px] font-bold text-cyan-dark hover:bg-cyan-soft">
                                        <i class="fa-solid fa-copy" aria-hidden="true"></i>
                                    </button>
                                </div>
                                <p class="text-[10px] font-medium text-muted">Share this code with team members to add you as a co-founder.</p>
                            </div>
                            <% } %>
                        </div>
                    </section>

                    <!-- Editable Details -->
                    <section class="rounded-2xl border border-line bg-white p-6 shadow-sm">
                        <div class="mb-6 flex items-center justify-between border-b border-line pb-4">
                            <div class="flex items-center gap-3">
                                <span class="grid h-9 w-9 place-items-center rounded-xl bg-orange-soft text-orange"><i class="fa-solid fa-briefcase text-sm" aria-hidden="true"></i></span>
                                <h2 class="text-lg font-extrabold tracking-tight text-cyan-dark">Details</h2>
                            </div>
                        </div>

                        <form action="/v1/auth/profile/update" method="POST" class="space-y-5">
                            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
                            <% if (user && (user.role === 'mentor' || user.role === 'investor' || user.role === 'entrepreneur')) { %>
                            <!-- Expertise -->
                            <div class="space-y-1.5">
                                <label class="block text-[10px] font-extrabold uppercase tracking-widest text-muted">Area of Expertise</label>
                                <div class="relative group">
                                    <i class="fa-solid fa-star absolute left-4 top-1/2 -translate-y-1/2 text-xs text-muted group-hover:text-cyan-dark transition" aria-hidden="true"></i>
                                    <input name="expertise" type="text" value="<%= user && user.expertise ? user.expertise : '' %>" placeholder="Click to add expertise..."
                                        class="w-full rounded-lg border border-line bg-surface pl-10 pr-4 py-2.5 text-sm font-semibold text-ink outline-none transition placeholder:text-slate-400 focus:border-cyan focus:bg-white focus:ring-2 focus:ring-cyan/20 cursor-text hover:border-cyan/40" />
                                </div>
                            </div>
                            <!-- Company -->
                            <div class="space-y-1.5">
                                <label class="block text-[10px] font-extrabold uppercase tracking-widest text-muted">Company / Organization</label>
                                <div class="relative group">
                                    <i class="fa-solid fa-building absolute left-4 top-1/2 -translate-y-1/2 text-xs text-muted group-hover:text-cyan-dark transition" aria-hidden="true"></i>
                                    <input name="company" type="text" value="<%= user && user.company ? user.company : '' %>" placeholder="Click to add company..."
                                        class="w-full rounded-lg border border-line bg-surface pl-10 pr-4 py-2.5 text-sm font-semibold text-ink outline-none transition placeholder:text-slate-400 focus:border-cyan focus:bg-white focus:ring-2 focus:ring-cyan/20 cursor-text hover:border-cyan/40" />
                                </div>
                            </div>
                            <% } %>
                            <!-- Bio -->
                            <div class="space-y-1.5">
                                <label class="block text-[10px] font-extrabold uppercase tracking-widest text-muted">Bio</label>
                                <textarea name="bio" rows="3" placeholder="Click to add a bio..."
                                    class="w-full rounded-lg border border-line bg-surface px-4 py-2.5 text-sm font-medium text-ink outline-none transition placeholder:text-slate-400 focus:border-cyan focus:bg-white focus:ring-2 focus:ring-cyan/20 resize-none cursor-text hover:border-cyan/40"><%= user && user.bio ? user.bio : '' %></textarea>
                            </div>
                            <!-- Name (hidden, always submitted) -->
                            <input type="hidden" name="name" value="<%= user ? user.name : '' %>">
                            <!-- Save -->
                            <div class="flex items-center gap-3 pt-1">
                                <button type="submit" class="inline-flex items-center gap-2 rounded-lg bg-cyan px-5 py-2 text-xs font-bold text-white shadow-sm transition hover:bg-cyan-dark">
                                    <i class="fa-solid fa-check text-[11px]" aria-hidden="true"></i>
                                    Save
                                </button>
                            </div>
                        </form>
                    </section>

                    <!-- Security -->
                    <section class="rounded-2xl border border-line bg-white p-6 shadow-sm">
                        <div class="mb-6 flex items-center justify-between border-b border-line pb-4">
                            <div class="flex items-center gap-3">
                                <span class="grid h-9 w-9 place-items-center rounded-xl bg-orange-soft text-orange"><i class="fa-solid fa-lock text-sm" aria-hidden="true"></i></span>
                                <h2 class="text-lg font-extrabold tracking-tight text-cyan-dark">Security Settings</h2>
                            </div>
                        </div>

                        <form action="/v1/auth/profile/update-password" method="POST" class="space-y-5">
                            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
                            <div class="space-y-1.5">
                                <label class="block text-[10px] font-extrabold uppercase tracking-widest text-muted">Current Password</label>
                                <div class="relative">
                                    <i class="fa-solid fa-lock absolute left-4 top-1/2 -translate-y-1/2 text-xs text-muted" aria-hidden="true"></i>
                                    <input name="currentPassword" type="password" required placeholder="Enter current password"
                                        class="w-full rounded-lg border border-line bg-surface pl-10 pr-4 py-2.5 text-sm font-semibold outline-none transition placeholder:text-slate-400 focus:border-cyan focus:bg-white focus:ring-2 focus:ring-cyan/20" />
                                </div>
                            </div>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                <div class="space-y-1.5">
                                    <label class="block text-[10px] font-extrabold uppercase tracking-widest text-muted">New Password</label>
                                    <div class="relative">
                                        <i class="fa-solid fa-key absolute left-4 top-1/2 -translate-y-1/2 text-xs text-muted" aria-hidden="true"></i>
                                        <input name="newPassword" type="password" required placeholder="Min. 8 characters"
                                            class="w-full rounded-lg border border-line bg-surface pl-10 pr-4 py-2.5 text-sm font-semibold outline-none transition placeholder:text-slate-400 focus:border-cyan focus:bg-white focus:ring-2 focus:ring-cyan/20" />
                                    </div>
                                </div>
                                <div class="space-y-1.5">
                                    <label class="block text-[10px] font-extrabold uppercase tracking-widest text-muted">Confirm New Password</label>
                                    <div class="relative">
                                        <i class="fa-solid fa-shield-check absolute left-4 top-1/2 -translate-y-1/2 text-xs text-muted" aria-hidden="true"></i>
                                        <input name="confirmPassword" type="password" required placeholder="Re-enter password"
                                            class="w-full rounded-lg border border-line bg-surface pl-10 pr-4 py-2.5 text-sm font-semibold outline-none transition placeholder:text-slate-400 focus:border-cyan focus:bg-white focus:ring-2 focus:ring-cyan/20" />
                                    </div>
                                </div>
                            </div>
                            <button type="submit" class="inline-flex items-center gap-2 rounded-lg bg-orange px-6 py-2.5 text-xs font-bold text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-orange-dark focus:outline-none focus:ring-2 focus:ring-orange focus:ring-offset-2">
                                <i class="fa-solid fa-key text-[11px]" aria-hidden="true"></i>
                                Update Password
                            </button>
                        </form>
                    </section>
                </div>

                <!-- Right Column -->
                <div class="space-y-6">

                    <!-- Profile Completion -->
                    <div class="rounded-2xl border border-line bg-white p-6 shadow-sm">
                        <h3 class="text-sm font-extrabold tracking-tight text-ink mb-4">Profile Completion</h3>
                        <%
                            let completed = 0;
                            let total = 4;
                            if (user && user.name) completed++;
                            if (user && user.email) completed++;
                            if (user && user.profilePicture) completed++;
                            if (user && user.bio) completed++;
                            let pct = Math.round((completed / total) * 100);
                        %>
                        <div class="relative h-2 rounded-full bg-surface overflow-hidden mb-3">
                            <div class="absolute inset-y-0 left-0 rounded-full bg-gradient-to-r from-cyan to-cyan-dark transition-all duration-500" style="width: <%= pct %>%"></div>
                        </div>
                        <p class="text-xs font-bold text-muted"><%= pct %>% Complete</p>
                        <p class="mt-2 text-[10px] font-medium text-muted leading-relaxed">
                            <% if (pct < 100) { %>
                                Click on any field above to fill it in and complete your profile.
                            <% } else { %>
                                Your profile is fully complete. Looking great!
                            <% } %>
                        </p>
                    </div>

                    <!-- Account Details -->
                    <div class="rounded-2xl border border-line bg-white p-6 shadow-sm">
                        <h3 class="text-sm font-extrabold tracking-tight text-ink mb-4">Account Details</h3>
                        <div class="space-y-3">
                            <div class="flex items-center justify-between">
                                <span class="text-xs font-semibold text-muted">Status</span>
                                <span class="inline-flex items-center gap-1 rounded-full bg-green-50 border border-green-200 px-2 py-0.5 text-[10px] font-bold text-green-700">
                                    <span class="h-1.5 w-1.5 rounded-full bg-green-500"></span>
                                    Active
                                </span>
                            </div>
                            <div class="h-px bg-line"></div>
                            <div class="flex items-center justify-between">
                                <span class="text-xs font-semibold text-muted">Role</span>
                                <span class="text-xs font-bold text-ink capitalize"><%= user ? user.role : '' %></span>
                            </div>
                            <div class="h-px bg-line"></div>
                            <div class="flex items-center justify-between">
                                <span class="text-xs font-semibold text-muted">Member Since</span>
                                <span class="text-xs font-bold text-ink"><%= new Date().toLocaleDateString('en-US', { month: 'short', year: 'numeric' }) %></span>
                            </div>
                        </div>
                    </div>

                    <!-- Quick Links -->
                    <div class="rounded-2xl border border-line bg-white p-6 shadow-sm">
                        <h3 class="text-sm font-extrabold tracking-tight text-ink mb-4">Quick Links</h3>
                        <div class="space-y-2">
                            <a href="/admin" class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-xs font-bold text-ink transition hover:bg-cyan-soft hover:text-cyan-dark">
                                <span class="grid h-7 w-7 place-items-center rounded-lg bg-cyan-soft text-cyan-dark"><i class="fa-solid fa-gauge-high text-[11px]" aria-hidden="true"></i></span>
                                Dashboard
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="mt-auto border-t border-line bg-white py-6">
        <div class="mx-auto max-w-7xl px-6 text-center lg:px-10">
            <p class="text-xs font-semibold text-muted">
                &copy; <%= new Date().getFullYear() %> DxValley Incubation Center &bull; Cooperative Bank of Oromia. All rights reserved.
            </p>
        </div>
    </footer>

    <!-- Hidden Avatar Upload Form -->
    <form id="avatar-form" action="/v1/auth/profile/upload-picture?_csrf=<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" method="POST" enctype="multipart/form-data" class="hidden">
        <input id="avatar-input" name="profilePicture" type="file" accept="image/jpeg,image/png" onchange="document.getElementById('avatar-form').submit()" />
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
    </form>

</body>
</html>
