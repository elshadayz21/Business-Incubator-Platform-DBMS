<!DOCTYPE html>
<html lang="en">
<%- include('./partials/head', { title: 'Apply - DxValley' }) %>
<body class="bg-surface text-ink min-h-screen flex flex-col font-sans">


    <main class="flex-1 px-6 py-12 lg:px-10">
        <div class="max-w-4xl mx-auto">
            <div class="flex items-center justify-between gap-4 flex-wrap mb-8">
                <a href="/" class="inline-flex items-center gap-2 text-sm font-bold text-cyan-dark hover:text-orange transition">
                    <i class="fa-solid fa-arrow-left text-xs"></i> Back to Home
                </a>

                <div class="bg-cyan text-white rounded-xl px-4 py-2.5 flex items-center gap-3 shadow-sm">
                    <span class="text-[10px] font-bold uppercase tracking-wider text-white/70">Closes in:</span>
                    <div id="countdown" class="flex gap-3 text-sm font-extrabold"></div>
                </div>
            </div>

            <div id="announcement-details-box">
                <!-- White Box for Title and Content (Easier to read) -->
                <div class="bg-white border border-[#D6E4EA] rounded-2xl p-8 shadow-sm mb-8 break-words whitespace-normal overflow-hidden">
                    <h1 class="text-3xl sm:text-4xl font-extrabold mb-4 text-cyan-dark"><%= announcement.title %></h1>
                    <div class="text-[#526274] prose prose-sm max-w-none mt-4">
                        <%- announcement.content %>
                    </div>
                </div>

                <!-- Document Links (If any) -->
                <% if (announcement.documents && announcement.documents.length > 0) { %>
                <div class="bg-white border border-[#D6E4EA] rounded-xl p-4 mb-8">
                    <p class="text-sm font-bold text-ink mb-3">Please review the attached document<%= announcement.documents.length > 1 ? 's' : '' %> before applying.</p>
                    <div class="flex flex-wrap gap-2">
                        <% announcement.documents.forEach(function(doc, i) { %>
                        <a href="<%= doc.slug ? `/documents/${doc.slug}` : doc.url %>" target="_blank" class="inline-flex items-center gap-2 px-4 py-2 bg-[#EAF8FC] text-[#006F9E] rounded-lg text-xs font-bold border border-[#00ADEF]/20 hover:bg-[#D6E4EA] transition">
                            <i class="fa-solid fa-file-pdf"></i> <%= doc.filename || (announcement.documents.length > 1 ? `View Document ${i + 1}` : 'View Document') %>
                        </a>
                        <% }); %>
                    </div>
                </div>
                <% } %>
            </div>

            <!-- Start Application Button -->
            <div id="start-application-box" class="text-center">
                <button onclick="showApplicationForm()" class="inline-flex items-center justify-center gap-2 rounded-xl bg-orange px-8 py-4 text-sm font-extrabold text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-orange-dark">
                    Start Application <i class="fa-solid fa-arrow-right text-xs"></i>
                </button>
            </div>

            <!-- Application Form (Hidden until clicked) -->
            <div id="application-form-container" class="hidden bg-white border border-[#D6E4EA] rounded-2xl p-8 shadow-sm mt-8">
                <h2 class="text-xl font-bold text-ink border-b border-[#D6E4EA] pb-4 mb-6">Application Form</h2>

                <!-- Milestone progress bar. Only shown once we know how many
                     steps the form actually has (a single-section form stays
                     a single page, exactly like before). -->
                <div id="apply-progress" class="mb-8"></div>

                <form id="application-form" class="space-y-5">
                    <input type="hidden" id="modal-announcement-id" value="<%= announcement.id %>">

                    <!-- One .apply-page per section; only the current page is visible. -->
                    <div id="apply-pages">
                        <p class="text-sm text-[#526274] font-bold">Loading questions...</p>
                    </div>

                    <!-- Document attachment lives on the final step, right before submit. -->
                    <div id="final-page-extra" class="hidden">
                        <label class="block text-xs font-bold text-[#526274] mb-2 uppercase">Attach Documents (PDF, DOC, PNG, JPG - up to 5 files, 5MB each)</label>
                        <input type="file" id="document_upload" multiple accept=".pdf,.doc,.docx,.png,.jpg,.jpeg" class="w-full text-sm text-[#526274] file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:bg-[#EAF8FC] file:text-[#006F9E] file:font-bold hover:file:bg-[#D6E4EA]">
                        <ul id="document-upload-list" class="mt-2 space-y-1 text-xs text-[#526274]"></ul>
                    </div>

                    <div id="form-message" class="hidden p-4 rounded-xl text-sm font-bold text-center"></div>

                    <p id="draft-save-indicator" class="opacity-0 transition-opacity duration-500 text-xs font-bold text-[#00ADEF] text-right">
                        <i class="fa-solid fa-check"></i> Progress saved
                    </p>

                    <div class="flex items-center gap-3 pt-2">
                        <button type="button" id="apply-back-btn" class="hidden px-6 py-4 rounded-xl font-bold text-[#526274] border border-[#D6E4EA] hover:bg-[#F6FAFC] transition">
                            <i class="fa-solid fa-arrow-left text-xs mr-1"></i> Back
                        </button>
                        <button type="button" id="apply-next-btn" class="flex-1 py-4 bg-[#00ADEF] text-white rounded-xl font-bold hover:bg-[#006F9E] transition">
                            Next <i class="fa-solid fa-arrow-right text-xs ml-1"></i>
                        </button>
                        <button type="submit" id="apply-submit-btn" class="hidden flex-1 py-4 bg-[#00ADEF] text-white rounded-xl font-bold hover:bg-[#006F9E] transition">Submit Application</button>
                    </div>
                </form>
            </div>
        </div>
    </main>


    <script>
        // --- Countdown Logic ---
        const deadline = new Date("<%= announcement.deadline %>").getTime();
        const interval = setInterval(() => {
            const now = new Date().getTime();
            const distance = deadline - now;
            if (distance < 0) {
                clearInterval(interval);
                document.getElementById("countdown").innerHTML = "<span class='text-red-200'>CLOSED</span>";
                document.getElementById("start-application-box").innerHTML = "<p class='text-red-500 font-bold'>This application is now closed.</p>";
                return;
            }
            const days = Math.floor(distance / (1000 * 60 * 60 * 24));
            const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
            document.getElementById("countdown").innerHTML = `
                <span>${days}<span class="text-[10px] font-semibold text-white/70">d</span></span>
                <span>${hours}<span class="text-[10px] font-semibold text-white/70">h</span></span>
                <span>${minutes}<span class="text-[10px] font-semibold text-white/70">m</span></span>
            `;
        }, 1000);

        // --- FORM STATE PERSISTENCE (Auto-Save) ---
        const formStorageKey = `dx_apply_form_<%= announcement.id %>`;

        function collectFormData() {
            const form = document.getElementById('application-form');
            if (!form) return null;
            const inputs = form.querySelectorAll('input, textarea, select');
            const dataObj = {};
            inputs.forEach(input => {
                if (!input.name) return;
                if (input.type === 'checkbox') {
                    if (input.name.endsWith('[]')) {
                        if (!dataObj[input.name]) dataObj[input.name] = [];
                        if (input.checked) dataObj[input.name].push(input.value);
                    } else { dataObj[input.name] = input.checked; }
                } else if (input.type === 'radio') {
                    if (input.checked) dataObj[input.name] = input.value;
                } else { dataObj[input.name] = input.value; }
            });
            return dataObj;
        }

        function applyFormData(dataObj) {
            if (!dataObj) return;
            const form = document.getElementById('application-form');
            if (!form) return;
            const inputs = form.querySelectorAll('input, textarea, select');
            inputs.forEach(input => {
                if (!input.name || dataObj[input.name] === undefined) return;
                if (input.type === 'checkbox') {
                    if (input.name.endsWith('[]')) {
                        input.checked = Array.isArray(dataObj[input.name]) && dataObj[input.name].includes(input.value);
                    } else { input.checked = Boolean(dataObj[input.name]); }
                } else if (input.type === 'radio') {
                    input.checked = (dataObj[input.name] === input.value);
                } else { input.value = dataObj[input.name]; }
            });
        }

        // Small, unobtrusive "Progress saved" flash near the nav buttons —
        // just enough feedback that the applicant trusts leaving and coming
        // back will actually work.
        function flashDraftSavedIndicator() {
            const el = document.getElementById('draft-save-indicator');
            if (!el) return;
            el.classList.remove('opacity-0');
            clearTimeout(flashDraftSavedIndicator._t);
            flashDraftSavedIndicator._t = setTimeout(() => el.classList.add('opacity-0'), 2000);
        }

        // Debounced so we're not hitting the server on every keystroke — only
        // once the applicant pauses. Only fires once we can identify them by
        // email (an admin-configured question mapped to "email"); without
        // that we have no way to find this draft again later, so it just
        // stays in localStorage as before.
        let draftSaveTimer = null;
        function scheduleDraftSave(dataObj) {
            clearTimeout(draftSaveTimer);
            draftSaveTimer = setTimeout(() => saveDraftToServer(dataObj), 1200);
        }

        async function saveDraftToServer(dataObj) {
            const emailField = applyPages.flatMap(p => p.fields).find(f => f.maps_to === 'email');
            if (!emailField) return;
            const email = (dataObj[`custom_${emailField.id}`] || '').trim();
            if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return;

            try {
                const response = await fetch('/api/public/apply/draft', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        announcement_id: <%= announcement.id %>,
                        email,
                        answers: dataObj,
                        current_page: currentPage,
                    }),
                });
                if (response.ok) flashDraftSavedIndicator();
            } catch (e) {
                console.error('Error saving draft:', e);
            }
        }

        function saveFormData() {
            const dataObj = collectFormData();
            if (!dataObj) return;
            localStorage.setItem(formStorageKey, JSON.stringify(dataObj));
            scheduleDraftSave(dataObj);
        }

        function loadFormData() {
            const savedData = localStorage.getItem(formStorageKey);
            if (!savedData) return;
            try { applyFormData(JSON.parse(savedData)); } catch (e) { console.error("Error loading saved form data:", e); }
        }

        // --- Pagination state ---
        // `applyPages` is an array of { name, fields } — one entry per
        // section, in the order sections first appear on the form.
        // `currentPage` is the step currently shown; `maxReachedPage` is the
        // furthest step the applicant has validated their way to, which is
        // also how far back the milestone bar lets them click.
        let applyPages = [];
        let currentPage = 0;
        let maxReachedPage = 0;

        const escapeHtml = (str) => {
            const div = document.createElement('div');
            div.textContent = str == null ? '' : String(str);
            return div.innerHTML;
        };

        // Groups the flat field list returned by the API into pages by
        // `field.section`, preserving first-appearance order. A form whose
        // questions were never split into sections (or that only has one)
        // collapses back to a single page — same as before this feature.
        const groupIntoSections = (fields) => {
            const pages = [];
            const byName = new Map();
            fields.forEach(field => {
                const name = (field.section && String(field.section).trim()) || 'General Information';
                if (!byName.has(name)) {
                    const page = { name, fields: [] };
                    byName.set(name, page);
                    pages.push(page);
                }
                byName.get(name).fields.push(field);
            });
            return pages;
        };

        // Long-form fields (textarea) always take the full row. Choice
        // fields with more than 3 options also get the full row so their
        // option list has room to breathe. Everything else (single-line
        // inputs, selects, short choice lists) shares a row two-up so we
        // don't waste horizontal space on a one-line answer.
        //
        // An admin can override this per-question via field.width ('half' |
        // 'full'). 'auto' (or anything else/missing) falls back to the
        // heuristic above.
        const resolveSpan = (field, autoIsFull) => {
            if (field.width === 'full') return 'sm:col-span-2';
            if (field.width === 'half') return '';
            return autoIsFull ? 'sm:col-span-2' : '';
        };

        const renderFieldHtml = (field) => {
            const isRequired = field.required ? 'required' : '';
            const reqMark = field.required ? '<span class="text-red-500">*</span>' : '';

            let optsStr = field.options || '';
            if (Array.isArray(optsStr)) { optsStr = optsStr.join(', '); }
            else if (typeof optsStr === 'string' && optsStr.startsWith('[')) {
                try { optsStr = JSON.parse(optsStr).join(', '); } catch (e) {}
            }

            if (field.field_type === 'textarea') {
                const spanClass = resolveSpan(field, true);
                return `<div class="${spanClass}"><label class="block text-xs font-bold text-[#526274] mb-2 uppercase">${field.label} ${reqMark}</label><textarea name="custom_${field.id}" ${isRequired} class="w-full px-4 py-3 border border-[#D6E4EA] rounded-xl bg-[#F6FAFC] focus:outline-none focus:ring-2 focus:ring-[#00ADEF]"></textarea></div>`;
            }
            if (field.field_type === 'select') {
                const spanClass = resolveSpan(field, false);
                const opts = optsStr.split(',').map(opt => `<option value="${opt.trim()}">${opt.trim()}</option>`).join('');
                return `<div class="${spanClass}"><label class="block text-xs font-bold text-[#526274] mb-2 uppercase">${field.label} ${reqMark}</label><select name="custom_${field.id}" ${isRequired} class="w-full px-4 py-3 border border-[#D6E4EA] rounded-xl bg-[#F6FAFC] focus:outline-none focus:ring-2 focus:ring-[#00ADEF]"><option value="">Select...</option>${opts}</select></div>`;
            }
            if (field.field_type === 'radio') {
                const opts = optsStr.split(',').map(opt => opt.trim()).filter(Boolean);
                const spanClass = resolveSpan(field, opts.length > 3);
                const radioInputs = opts.map(opt => `<label class="flex items-center gap-2 py-1.5 cursor-pointer"><input type="radio" name="custom_${field.id}" value="${opt}" ${isRequired} class="h-4 w-4 border-gray-300 text-[#00ADEF] focus:ring-[#00ADEF]"><span class="text-sm font-medium text-[#111827]">${opt}</span></label>`).join('');
                return `<div class="${spanClass}"><label class="block text-xs font-bold text-[#526274] mb-2 uppercase">${field.label} ${reqMark}</label><div class="flex flex-col gap-1 mt-1 p-3 bg-[#F6FAFC] border border-[#D6E4EA] rounded-xl">${radioInputs}</div></div>`;
            }
            if (field.field_type === 'checkbox') {
                const opts = optsStr.split(',').map(opt => opt.trim()).filter(Boolean);
                if (opts.length > 0) {
                    const spanClass = resolveSpan(field, opts.length > 3);
                    const checkboxInputs = opts.map(opt => `<label class="flex items-center gap-2 py-1.5 cursor-pointer"><input type="checkbox" name="custom_${field.id}[]" value="${opt}" class="h-4 w-4 border-gray-300 text-[#00ADEF] focus:ring-[#00ADEF]"><span class="text-sm font-medium text-[#111827]">${opt}</span></label>`).join('');
                    return `<div class="${spanClass}"><label class="block text-xs font-bold text-[#526274] mb-2 uppercase">${field.label} ${reqMark}</label><div class="flex flex-col gap-1 mt-1 p-3 bg-[#F6FAFC] border border-[#D6E4EA] rounded-xl">${checkboxInputs}</div></div>`;
                } else {
                    const spanClass = resolveSpan(field, false);
                    return `<div class="flex items-center gap-3 py-2 self-end ${spanClass}"><input type="checkbox" name="custom_${field.id}" ${isRequired} class="h-4 w-4 rounded border-gray-300 text-[#00ADEF] focus:ring-[#00ADEF]"><label class="text-sm font-bold text-[#526274]">${field.label} ${reqMark}</label></div>`;
                }
            }
            if (field.field_type === 'number') {
                const spanClass = resolveSpan(field, false);
                return `<div class="${spanClass}"><label class="block text-xs font-bold text-[#526274] mb-2 uppercase">${field.label} ${reqMark}</label><input type="number" name="custom_${field.id}" ${isRequired} class="w-full px-4 py-3 border border-[#D6E4EA] rounded-xl bg-[#F6FAFC] focus:outline-none focus:ring-2 focus:ring-[#00ADEF]"></div>`;
            }
            if (field.field_type === 'date') {
                const spanClass = resolveSpan(field, false);
                return `<div class="${spanClass}"><label class="block text-xs font-bold text-[#526274] mb-2 uppercase">${field.label} ${reqMark}</label><input type="date" name="custom_${field.id}" ${isRequired} class="w-full px-4 py-3 border border-[#D6E4EA] rounded-xl bg-[#F6FAFC] focus:outline-none focus:ring-2 focus:ring-[#00ADEF]"></div>`;
            }
            if (field.field_type === 'email') {
                const spanClass = resolveSpan(field, false);
                return `<div class="${spanClass}"><label class="block text-xs font-bold text-[#526274] mb-2 uppercase">${field.label} ${reqMark}</label><input type="email" name="custom_${field.id}" ${isRequired} class="w-full px-4 py-3 border border-[#D6E4EA] rounded-xl bg-[#F6FAFC] focus:outline-none focus:ring-2 focus:ring-[#00ADEF]"></div>`;
            }
            if (field.field_type === 'tel') {
                const spanClass = resolveSpan(field, false);
                return `<div class="${spanClass}"><label class="block text-xs font-bold text-[#526274] mb-2 uppercase">${field.label} ${reqMark}</label><input type="tel" name="custom_${field.id}" ${isRequired} class="w-full px-4 py-3 border border-[#D6E4EA] rounded-xl bg-[#F6FAFC] focus:outline-none focus:ring-2 focus:ring-[#00ADEF]"></div>`;
            }
            // Default: Short Text
            const spanClass = resolveSpan(field, false);
            return `<div class="${spanClass}"><label class="block text-xs font-bold text-[#526274] mb-2 uppercase">${field.label} ${reqMark}</label><input type="text" name="custom_${field.id}" ${isRequired} class="w-full px-4 py-3 border border-[#D6E4EA] rounded-xl bg-[#F6FAFC] focus:outline-none focus:ring-2 focus:ring-[#00ADEF]"></div>`;
        };

        const renderPages = () => {
            const pagesDiv = document.getElementById('apply-pages');
            pagesDiv.innerHTML = applyPages.map((page, i) => `
                <div class="apply-page grid grid-cols-1 sm:grid-cols-2 gap-x-5 gap-y-5" data-page="${i}" style="${i === 0 ? '' : 'display:none;'}">
                    ${applyPages.length > 1 ? `<h3 class="sm:col-span-2 text-sm font-extrabold text-[#111827] uppercase tracking-wider border-b border-[#D6E4EA] pb-3">${escapeHtml(page.name)}</h3>` : ''}
                    ${page.fields.map(renderFieldHtml).join('')}
                </div>
            `).join('');
        };

        // Renders the milestone bar. Completed steps show a check and are
        // clickable to jump back; the current step is highlighted; steps
        // the applicant hasn't reached yet are shown but disabled, so they
        // always know how much is left without being able to skip ahead of
        // fields that haven't been validated yet.
        const renderProgress = () => {
            const bar = document.getElementById('apply-progress');
            if (applyPages.length <= 1) { bar.innerHTML = ''; return; }

            bar.innerHTML = `<div class="flex items-start">${applyPages.map((page, i) => {
                const isDone = i < currentPage;
                const isActive = i === currentPage;
                const clickable = i <= maxReachedPage;
                const circleClasses = isDone
                    ? 'bg-[#00ADEF] text-white'
                    : isActive
                        ? 'bg-orange text-white'
                        : 'bg-[#EAF8FC] text-[#8896A6] border border-[#D6E4EA]';
                return `
                    <div class="flex items-start ${i < applyPages.length - 1 ? 'flex-1' : ''}">
                        <button type="button" data-goto="${i}" ${clickable ? '' : 'disabled'} class="flex flex-col items-center gap-1.5 ${clickable ? 'cursor-pointer' : 'cursor-not-allowed'} bg-transparent border-0 p-0">
                            <span class="w-8 h-8 shrink-0 rounded-full flex items-center justify-center text-xs font-extrabold ${circleClasses}">${isDone ? '<i class="fa-solid fa-check text-[10px]"></i>' : i + 1}</span>
                            <span class="text-[10px] font-bold uppercase tracking-wide text-center max-w-[90px] ${isActive ? 'text-[#111827]' : 'text-[#8896A6]'}">${escapeHtml(page.name)}</span>
                        </button>
                        ${i < applyPages.length - 1 ? `<div class="flex-1 h-0.5 mt-4 mx-2 ${isDone ? 'bg-[#00ADEF]' : 'bg-[#D6E4EA]'}"></div>` : ''}
                    </div>`;
            }).join('')}</div>`;

            bar.querySelectorAll('[data-goto]').forEach(btn => {
                btn.addEventListener('click', () => {
                    const idx = parseInt(btn.dataset.goto, 10);
                    if (idx <= maxReachedPage) goToPage(idx);
                });
            });
        };

        const showPage = (i) => {
            document.querySelectorAll('.apply-page').forEach(p => {
                p.style.display = (parseInt(p.dataset.page, 10) === i) ? '' : 'none';
            });
            const isLastPage = i === applyPages.length - 1 || applyPages.length === 0;
            document.getElementById('apply-back-btn').classList.toggle('hidden', i === 0);
            document.getElementById('apply-next-btn').classList.toggle('hidden', isLastPage);
            document.getElementById('apply-submit-btn').classList.toggle('hidden', !isLastPage);
            document.getElementById('final-page-extra').classList.toggle('hidden', !isLastPage);
            renderProgress();
            document.getElementById('application-form-container').scrollIntoView({ behavior: 'smooth', block: 'start' });
        };

        const goToPage = (i) => { currentPage = i; showPage(i); };

        // Only checks the fields on the page currently in view — required
        // fields on pages the applicant hasn't gotten to yet shouldn't block
        // them from moving forward through the ones before it.
        const validateCurrentPage = () => {
            const page = document.querySelector(`.apply-page[data-page="${currentPage}"]`);
            if (!page) return true;
            const inputs = page.querySelectorAll('input, select, textarea');
            for (const input of inputs) {
                if (!input.reportValidity()) return false;
            }
            return true;
        };

        document.getElementById('apply-next-btn').addEventListener('click', () => {
            if (!validateCurrentPage()) return;
            saveFormData();
            if (currentPage < applyPages.length - 1) {
                currentPage++;
                maxReachedPage = Math.max(maxReachedPage, currentPage);
                showPage(currentPage);
            }
        });

        document.getElementById('apply-back-btn').addEventListener('click', () => {
            if (currentPage > 0) {
                currentPage--;
                showPage(currentPage);
            }
        });

        // --- Show Form Logic ---
        // opts.prefill / opts.startPage let a resume link jump straight to a
        // server-saved draft instead of the normal localStorage restore.
        window.showApplicationForm = (opts = {}) => {
            document.getElementById("announcement-details-box").classList.add("hidden");
            document.getElementById("start-application-box").classList.add("hidden");
            const formContainer = document.getElementById("application-form-container");
            formContainer.classList.remove("hidden");
            window.scrollTo({ top: 0, behavior: 'smooth' });

            const pagesDiv = document.getElementById("apply-pages");
            pagesDiv.innerHTML = '<p class="text-sm text-[#526274] font-bold">Loading questions...</p>';

            fetch(`/api/public/form-fields/<%= announcement.id %>`)
                .then(res => res.json())
                .then(fields => {
                    applyPages = (fields && fields.length > 0) ? groupIntoSections(fields) : [];
                    renderPages();
                    if (opts.prefill) {
                        applyFormData(opts.prefill);
                        currentPage = maxReachedPage = Math.min(opts.startPage || 0, Math.max(applyPages.length - 1, 0));
                    } else {
                        currentPage = 0;
                        maxReachedPage = 0;
                        loadFormData();
                    }
                    showPage(currentPage);
                }).catch(err => {
                    console.error("Error loading custom fields:", err);
                    pagesDiv.innerHTML = '<p class="text-red-500 text-sm">Failed to load form questions.</p>';
                });
        };

        // --- Multi-file attachment picker ---
        // Native <input type="file" multiple> replaces its whole FileList on
        // every selection, so a plain re-render would lose files picked in
        // an earlier pass. Selected files are tracked in `selectedDocuments`
        // instead, and the input's FileList is rebuilt from it via
        // DataTransfer after every add/remove — that's what lets each file
        // show up with its own "remove" button below the picker.
        const MAX_DOCUMENTS = 5;
        const MAX_DOCUMENT_SIZE = 5 * 1024 * 1024; // 5MB
        const ALLOWED_DOCUMENT_EXTENSIONS = ['.pdf', '.doc', '.docx', '.png', '.jpg', '.jpeg'];
        let selectedDocuments = [];

        const syncDocumentInput = () => {
            const input = document.getElementById('document_upload');
            const dt = new DataTransfer();
            selectedDocuments.forEach(f => dt.items.add(f));
            input.files = dt.files;
        };

        const renderDocumentList = () => {
            const list = document.getElementById('document-upload-list');
            list.innerHTML = selectedDocuments.map((f, i) => `
                <li class="flex items-center justify-between gap-2 bg-[#F6FAFC] border border-[#D6E4EA] rounded-lg px-3 py-1.5">
                    <span class="truncate"><i class="fa-solid fa-paperclip mr-1"></i>${escapeHtml(f.name)}</span>
                    <button type="button" data-remove-doc="${i}" class="text-red-500 hover:text-red-700 font-bold shrink-0">&times;</button>
                </li>
            `).join('');
            list.querySelectorAll('[data-remove-doc]').forEach(btn => {
                btn.addEventListener('click', () => {
                    selectedDocuments.splice(parseInt(btn.dataset.removeDoc, 10), 1);
                    syncDocumentInput();
                    renderDocumentList();
                });
            });
        };

        document.getElementById('document_upload')?.addEventListener('change', (e) => {
            const msgBox = document.getElementById('form-message');
            const incoming = Array.from(e.target.files || []);

            for (const file of incoming) {
                if (selectedDocuments.length >= MAX_DOCUMENTS) {
                    msgBox.className = 'p-4 rounded-xl text-sm font-bold text-center bg-red-100 text-red-800';
                    msgBox.textContent = `❌ You can attach up to ${MAX_DOCUMENTS} documents.`;
                    msgBox.classList.remove('hidden');
                    break;
                }
                if (file.size > MAX_DOCUMENT_SIZE) {
                    msgBox.className = 'p-4 rounded-xl text-sm font-bold text-center bg-red-100 text-red-800';
                    msgBox.textContent = `❌ "${file.name}" is too large. Max 5MB per file.`;
                    msgBox.classList.remove('hidden');
                    continue;
                }
                const isValidType = ALLOWED_DOCUMENT_EXTENSIONS.some(ext => file.name.toLowerCase().endsWith(ext));
                if (!isValidType) {
                    msgBox.className = 'p-4 rounded-xl text-sm font-bold text-center bg-red-100 text-red-800';
                    msgBox.textContent = `❌ "${file.name}" isn't an allowed file type.`;
                    msgBox.classList.remove('hidden');
                    continue;
                }
                selectedDocuments.push(file);
            }

            syncDocumentInput();
            renderDocumentList();
        });

        // --- Form Submission Logic ---
        document.getElementById('application-form')?.addEventListener('submit', async (e) => {
            e.preventDefault();
            const msgBox = document.getElementById('form-message');
            const button = e.target.querySelector('button[type="submit"]');
            button.disabled = true;
            button.textContent = 'Submitting...';
            msgBox.className = 'hidden';

            const answers = {};
            const customInputs = document.querySelectorAll('[name^="custom_"]');
            const handledNames = new Set();
            customInputs.forEach(input => {
                if (input.type === 'radio') {
                    if (!handledNames.has(input.name)) {
                        const checkedRadio = document.querySelector(`input[name="${input.name}"]:checked`);
                        answers[input.name] = checkedRadio ? checkedRadio.value : '';
                        handledNames.add(input.name);
                    }
                } else if (input.type === 'checkbox' && input.name.endsWith('[]')) {
                    if (!handledNames.has(input.name)) {
                        const checkedBoxes = document.querySelectorAll(`input[name="${input.name}"]:checked`);
                        answers[input.name] = Array.from(checkedBoxes).map(cb => cb.value);
                        handledNames.add(input.name);
                    }
                } else if (input.type === 'checkbox') {
                    answers[input.name] = input.checked;
                } else {
                    answers[input.name] = input.value;
                }
            });

            const formData = new FormData();
            formData.append('announcement_id', document.getElementById('modal-announcement-id').value);
            formData.append('answers', JSON.stringify(answers));
            selectedDocuments.forEach(file => formData.append('documents', file));

            try {
                const response = await fetch('/api/public/apply', {
                    method: 'POST', body: formData
                });
                const result = await response.json();
                if (response.ok) {
                    localStorage.removeItem(formStorageKey);
                    msgBox.className = 'p-4 rounded-xl text-sm font-bold text-center bg-green-100 text-green-800';
                    msgBox.textContent = '✅ ' + result.message;
                    msgBox.classList.remove('hidden');
                    document.getElementById('application-form').reset();
                    selectedDocuments = [];
                    renderDocumentList();
                    document.getElementById('application-form-container').scrollIntoView({ behavior: 'smooth', block: 'start' });
                } else {
                    throw new Error(result.message || 'Failed to submit');
                }
            } catch (error) {
                msgBox.className = 'p-4 rounded-xl text-sm font-bold text-center bg-red-100 text-red-800';
                msgBox.textContent = '❌ ' + error.message;
                msgBox.classList.remove('hidden');
            } finally {
                button.disabled = false;
                button.textContent = 'Submit Application';
            }
        });

        // --- ATTACH EVENT LISTENERS FOR AUTO-SAVE ---
        const appForm = document.getElementById('application-form');
        if (appForm) {
            appForm.addEventListener('input', saveFormData);
            appForm.addEventListener('change', saveFormData);
        }

        // --- RESUME FROM EMAILED LINK ---
        // A reminder email (or a link the applicant saved themselves) points
        // back here as .../apply/<slug>?resume=<token>. If that token still
        // resolves to an in-progress draft, skip straight to the form,
        // pre-filled and on the right page. An invalid/expired/already-
        // submitted token just falls back to the normal "Start Application"
        // flow — no error shown, since the applicant may just be visiting
        // the page normally.
        (function resumeFromLink() {
            const token = new URLSearchParams(window.location.search).get('resume');
            if (!token) return;
            fetch(`/api/public/apply/resume/${encodeURIComponent(token)}`)
                .then(res => { if (!res.ok) throw new Error('not resumable'); return res.json(); })
                .then(data => {
                    if (data && data.draft) {
                        showApplicationForm({ prefill: data.draft.answers, startPage: data.draft.current_page });
                    }
                })
                .catch(() => { /* Silently fall back to the normal start-application flow. */ });
        })();
    </script>
</body>
</html>