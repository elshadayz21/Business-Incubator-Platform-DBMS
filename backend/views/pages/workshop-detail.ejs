<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>

<body class="bg-surface text-ink flex min-h-screen flex-col font-sans">
    <%- include('../partials/header.ejs') %>

    <main class="flex-1 px-6 py-12 lg:px-10">
        <div class="mx-auto max-w-6xl">
            <a href="/v1/workshop" class="inline-flex items-center gap-2 text-sm font-bold text-cyan-dark transition hover:text-orange">
                <i class="fa-solid fa-arrow-left text-xs" aria-hidden="true"></i>
                Back to Workshops
            </a>

            <!-- Workshop Hero -->
            <section class="relative mt-8 overflow-hidden rounded-[28px] bg-gradient-to-br from-cyan via-cyan-mid to-cyan-deep p-8 text-white sm:p-12">
                <div class="pointer-events-none absolute -left-20 -top-16 h-[340px] w-[460px] rounded-[48%] border-[55px] border-white/10" aria-hidden="true"></div>
                <div class="pointer-events-none absolute -right-28 bottom-[-200px] h-[420px] w-[520px] rounded-[50%] border-[70px] border-white/10" aria-hidden="true"></div>

                <div class="relative">
                    <div class="mb-5 flex flex-wrap items-center gap-3">
                        <% if (workshop.category) { %>
                            <span class="rounded-full bg-orange px-3 py-1 text-[10px] font-bold uppercase tracking-wider text-white"><%= workshop.category %></span>
                        <% } %>
                        <span class="inline-flex items-center gap-2 rounded-full bg-white/15 px-3 py-1 text-[10px] font-bold uppercase tracking-wider text-white/80">
                            <span class="h-2 w-2 rounded-full <%= workshop.status === 'active' ? 'bg-green-400 animate-pulse' : 'bg-white/60' %>" aria-hidden="true"></span>
                            <%= workshop.status ? workshop.status.charAt(0).toUpperCase() + workshop.status.slice(1) : 'General' %>
                        </span>
                    </div>

                    <div class="flex flex-col justify-between gap-8 md:flex-row md:items-start">
                        <div class="max-w-[680px]">
                            <h1 class="max-w-[680px] text-4xl font-extrabold leading-[1.05] tracking-[-.045em] sm:text-5xl"><%= workshop.title %></h1>
                            <p class="mt-5 max-w-[620px] text-base leading-8 text-white/85"><%= workshop.description %></p>

                            <div class="mt-8 flex flex-wrap items-center gap-3">
                                                                <% if (user) { %>
                                                                    <% if (isEnrolled) { %>
                                                                        <button id="enrollBtn" class="inline-flex items-center gap-2 rounded-md bg-red-500 px-6 py-3 text-sm font-bold text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-red-600 focus:outline-none focus:ring-2 focus:ring-red-400 focus:ring-offset-2 focus:ring-offset-cyan-deep">
                                                                            <i class="fa-solid fa-xmark text-xs" aria-hidden="true"></i>
                                                                            Unenroll
                                                                        </button>
                                                                    <% } else { %>
                                                                        <button id="enrollBtn" class="inline-flex items-center gap-2 rounded-md bg-orange px-6 py-3 text-sm font-bold text-white shadow-[0_10px_24px_rgba(141,67,10,.24)] transition hover:-translate-y-0.5 hover:bg-orange-dark focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-cyan-deep">
                                                                            <i class="fa-solid fa-check-circle text-xs" aria-hidden="true"></i>
                                                                            Enroll Now
                                                                        </button>
                                                                    <% } %>
                                                                <% } else { %>
                                                                    <!-- Public (no account) enrollment form -->
                                                                    <div id="publicEnrollBox" class="w-full max-w-[440px] rounded-2xl bg-white/95 p-5 text-ink shadow-sm">
                                                                        <p class="text-[11px] font-extrabold uppercase tracking-widest text-cyan-dark">Reserve your seat</p>
                                                                        <p class="mt-1 text-xs text-muted">No account needed — just tell us who's coming.</p>
                                                                        <form id="publicEnrollForm" class="mt-4 space-y-3">
                                                                            <input type="hidden" name="workshopId" value="<%= workshop.id %>" />
                                                                            <input id="publicName" type="text" required placeholder="Full name" autocomplete="name"
                                                                                class="h-11 w-full rounded-xl border border-line bg-white px-4 text-sm font-semibold text-ink outline-none transition placeholder:font-normal placeholder:text-slate-400 focus:border-cyan focus:ring-2 focus:ring-cyan/20" />
                                                                            <input id="publicEmail" type="email" required placeholder="Email address" autocomplete="email"
                                                                                class="h-11 w-full rounded-xl border border-line bg-white px-4 text-sm font-semibold text-ink outline-none transition placeholder:font-normal placeholder:text-slate-400 focus:border-cyan focus:ring-2 focus:ring-cyan/20" />
                                                                            <button type="submit" id="publicEnrollBtn" class="inline-flex h-12 w-full items-center justify-center gap-2 rounded-xl bg-orange px-6 text-sm font-extrabold uppercase tracking-wide text-white shadow-[0_10px_24px_rgba(141,67,10,.24)] transition hover:-translate-y-0.5 hover:bg-orange-dark focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2">
                                                                                <i class="fa-solid fa-check-circle text-xs" aria-hidden="true"></i>
                                                                                Reserve my seat
                                                                            </button>
                                                                            <p id="publicEnrollMsg" class="hidden rounded-xl px-4 py-2.5 text-xs font-bold" role="status"></p>
                                                                        </form>
                                                                    </div>

                                <% } %>
                            </div>
                        </div>
                    </div>

                    <!-- Info tiles -->
                    <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
                        <div class="flex items-center gap-3 rounded-xl bg-white/10 p-4">
                            <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-orange text-sm"><i class="fa-solid fa-chalkboard-user" aria-hidden="true"></i></span>
                            <div class="min-w-0">
                                <p class="text-[10px] font-bold uppercase tracking-wider text-white/70">Instructor</p>
                                <p class="mt-0.5 truncate text-sm font-bold"><%= workshop.mentor_name %></p>
                            </div>
                        </div>
                        <div class="flex items-center gap-3 rounded-xl bg-white/10 p-4">
                            <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-orange text-sm"><i class="fa-solid fa-location-dot" aria-hidden="true"></i></span>
                            <div class="min-w-0">
                                <p class="text-[10px] font-bold uppercase tracking-wider text-white/70">Location</p>
                                <p class="mt-0.5 truncate text-sm font-bold"><%= workshop.location %></p>
                            </div>
                        </div>
                        <div class="flex items-center gap-3 rounded-xl bg-white/10 p-4">
                            <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-orange text-sm"><i class="fa-regular fa-calendar" aria-hidden="true"></i></span>
                            <div class="min-w-0">
                                <p class="text-[10px] font-bold uppercase tracking-wider text-white/70">Date</p>
                                <p class="mt-0.5 text-sm font-bold">
                                    <% if (workshop.start_date && workshop.end_date) { %>
                                        <%= new Date(workshop.start_date).toLocaleDateString('en-US', {month: 'short', day: 'numeric', year: 'numeric'}) %>
                                        to <%= new Date(workshop.end_date).toLocaleDateString('en-US', {month: 'short', day: 'numeric', year: 'numeric'}) %>
                                    <% } else { %>
                                        TBD
                                    <% } %>
                                </p>
                            </div>
                        </div>
                        <div class="flex items-center gap-3 rounded-xl bg-white/10 p-4">
                            <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-orange text-sm"><i class="fa-regular fa-clock" aria-hidden="true"></i></span>
                            <div class="min-w-0">
                                <p class="text-[10px] font-bold uppercase tracking-wider text-white/70">Time</p>
                                <p class="mt-0.5 text-sm font-bold">
                                    <% if (workshop.start_time && workshop.end_time) { %>
                                        <%= workshop.start_time %> - <%= workshop.end_time %>
                                    <% } else { %>
                                        TBD
                                    <% } %>
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Enrollment progress -->
                    <div class="mt-10 rounded-2xl bg-white p-5 text-ink shadow-[0_18px_40px_rgba(0,63,102,.22)]">
                        <div class="mb-3 flex items-center justify-between gap-4">
                            <p class="flex items-center gap-2 text-xs font-extrabold uppercase tracking-widest text-muted">
                                <i class="fa-solid fa-users text-cyan-dark" aria-hidden="true"></i>
                                Enrollment progress
                            </p>
                            <p class="text-sm font-extrabold text-cyan-dark"><%= workshop.enrolled_count || 0 %> / <%= workshop.capacity || 30 %> seats</p>
                        </div>
                        <div class="h-3 overflow-hidden rounded-full bg-surface">
                            <% let pct = Math.min(100, Math.round(((workshop.enrolled_count || 0) / (workshop.capacity || 30)) * 100)); %>
                            <div class="h-full rounded-full bg-gradient-to-r from-cyan to-orange transition-all duration-500" style="width: <%= pct %>%;"></div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </main>

    <%- include('../partials/footer.ejs') %>

    <script>
        // Enrollment functionality
        document.getElementById('enrollBtn')?.addEventListener('click', async function(e) {
            e.preventDefault();

            const workshopId = '<%= workshop.id %>';
            const isCurrentlyEnrolled = <%= isEnrolled ? 'true' : 'false' %>;
            const method = isCurrentlyEnrolled ? 'DELETE' : 'POST';

            try {
                // Show loading state
                const btn = this;
                const originalText = btn.innerHTML;
                btn.disabled = true;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processing...';

                const options = {
                    method: method,
                    headers: {
                        'Content-Type': 'application/json',
                        'x-csrf-token': '<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>',
                    }
                };

                const response = await fetch(`/v1/workshop/${workshopId}/attend`, options);

                if (response.redirected) {
                    alert('Please log in to enroll.');
                    window.location.href = '<%= routes.loginRoute %>';
                    return;
                }

                const data = await response.json();

                if (response.ok) {
                    // Show success message
                    alert(data.message || 'Success!');
                    // Reload the page to update the enrollment status
                    window.location.reload();
                } else {
                    alert(data.message || 'Something went wrong. Please try again.');
                    btn.disabled = false;
                    btn.innerHTML = originalText;
                }
            } catch (error) {
                console.error('Error:', error);
                alert('An error occurred. Please try again.');
                location.reload();
            }
        });
                // Public (anonymous) enrollment
                document.getElementById('publicEnrollForm')?.addEventListener('submit', async function(e) {
                    e.preventDefault();

                    const workshopId = this.querySelector('[name="workshopId"]').value;
                    const name = document.getElementById('publicName').value.trim();
                    const email = document.getElementById('publicEmail').value.trim();
                    const btn = document.getElementById('publicEnrollBtn');
                    const msg = document.getElementById('publicEnrollMsg');

                    if (!name || !email) return;

                    const originalText = btn.innerHTML;
                    btn.disabled = true;
                    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Reserving...';
                    msg.classList.add('hidden');

                    try {
                        const response = await fetch(`/v1/workshop/${workshopId}/attend-public`, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'x-csrf-token': '<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>',
                            },
                            body: JSON.stringify({ full_name: name, email: email }),
                        });

                        const data = await response.json().catch(() => ({}));

                        if (response.ok) {
                            msg.className = 'block rounded-xl bg-green-50 border border-green-200 px-4 py-2.5 text-xs font-bold text-green-700';
                            msg.textContent = data.message || 'Your seat has been reserved!';
                            btn.disabled = true;
                            btn.innerHTML = '<i class="fa-solid fa-check text-xs"></i> Seat reserved';
                            // Reload after a short delay to refresh seat count + progress bar
                            setTimeout(() => window.location.reload(), 1500);
                        } else {
                            msg.className = 'block rounded-xl bg-red-50 border border-red-200 px-4 py-2.5 text-xs font-bold text-red-700';
                            msg.textContent = data.message || 'Something went wrong. Please try again.';
                            btn.disabled = false;
                            btn.innerHTML = originalText;
                        }
                    } catch (error) {
                        console.error('Error:', error);
                        msg.className = 'block rounded-xl bg-red-50 border border-red-200 px-4 py-2.5 text-xs font-bold text-red-700';
                        msg.textContent = 'An error occurred. Please try again.';
                        btn.disabled = false;
                        btn.innerHTML = originalText;
                    }
                });
    </script>
</body>
</html>
