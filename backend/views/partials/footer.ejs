<footer id="resources" class="bg-cyan text-white">
  <!-- Full-width container with edge padding -->
  <div class="w-full px-6 py-8 lg:px-12 lg:py-12">


    <!-- Middle Row: Navigation Links & Connect Button -->
    <div class="grid gap-8 pt-8 md:grid-cols-2 lg:grid-cols-4">

      <!-- Column 1: Connect Button -->
      <div>
        <h2 class="text-xs font-extrabold uppercase tracking-[.16em]">Connect</h2>
        <div class="mt-3">
          <a href="https://linktr.ee/CoopDxValley" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-full border border-white/60 bg-white/10 px-4 py-2 text-xs font-semibold text-white transition hover:bg-white hover:text-cyan focus:outline-none focus:ring-2 focus:ring-white">
            <span>Connect with us</span>
            <i class="fa-solid fa-arrow-up-right-from-square text-[10px]" aria-hidden="true"></i>
          </a>
        </div>
      </div>

      <!-- Column 2: Platform -->
      <div>
        <h2 class="text-xs font-extrabold uppercase tracking-[.16em]">Platform</h2>
        <nav class="mt-3 flex flex-col gap-2 text-xs text-white/80" aria-label="Platform links">
          <a class="transition hover:text-white hover:underline" href="/">Home</a>
          <a class="transition hover:text-white hover:underline" href="<%= routes.about %>">About</a>
          <a class="transition hover:text-white hover:underline" href="<%= routes.mentors %>">Mentors</a>
          <a class="transition hover:text-white hover:underline" href="<%= routes.projects %>">Projects</a>
        </nav>
      </div>

      <!-- Column 3: Program & Events -->
      <div>
        <h2 class="text-xs font-extrabold uppercase tracking-[.16em]">Program &amp; Events</h2>
        <nav class="mt-3 flex flex-col gap-2 text-xs text-white/80" aria-label="Program and events links">
          <a class="transition hover:text-white hover:underline" href="<%= routes.workshops %>">Workshops</a>
          <a class="transition hover:text-white hover:underline" href="/v1/workshop">Events</a>
          <a class="transition hover:text-white hover:underline" href="/#announcements">Announcements</a>
          <a class="transition hover:text-white hover:underline" href="<%= routes.gallery %>">Gallery</a>
        </nav>
      </div>

      <!-- Column 4: Legal & Contact -->
      <div>
        <h2 class="text-xs font-extrabold uppercase tracking-[.16em]">Legal &amp; Contact</h2>
        <nav class="mt-3 flex flex-col gap-2 text-xs text-white/80" aria-label="Legal and contact links">
          <a class="transition hover:text-white hover:underline" href="/v1/terms">Terms &amp; conditions</a>
          <a class="opacity-90 transition hover:opacity-100 hover:underline" href="/contact">Contact</a>
        </nav>
      </div>
    </div>

    <!-- Bottom Copyright -->
    <div class="mt-8 border-t border-white/25 pt-6 flex justify-end">
      <p class="text-xs text-white/75">© <%= new Date().getFullYear() %> DxValley Incubation Center. All rights reserved.</p>
    </div>
  </div>

  <div class="bg-cyan-dark">
    <div class="h-px w-full bg-white/25" aria-hidden="true"></div>
  </div>
</footer>

<script>
  (() => {
    const form = document.getElementById('newsletter-form');
    const status = document.getElementById('newsletter-status');
    if (!form || !status) return;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const emailInput = document.getElementById('newsletter');
      if (!emailInput) return;
      const email = emailInput.value;

      if (!email) {
        status.textContent = '❌ Please enter an email address.';
        return;
      }

      const button = form.querySelector('button[type="submit"]');

      button.disabled = true;
      button.textContent = 'Subscribing...';
      status.textContent = '';

      try {
        const response = await fetch('/api/public/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email })
        });
        const data = await response.json();

        if (response.ok) {
          status.textContent = '✅ ' + data.message;
          form.reset();
        } else {
          status.textContent = '❌ ' + (data.message || 'Subscription failed.');
        }
      } catch (error) {
        status.textContent = '❌ Network error. Please try again.';
      } finally {
        button.disabled = false;
        button.textContent = 'Subscribe';
      }
    });
  })();
</script>

<%- include('./chatbot') %>
