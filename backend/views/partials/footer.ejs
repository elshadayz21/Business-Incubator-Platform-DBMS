<footer id="resources" class="bg-cyan text-white border-t border-white/10">
  <!-- Added bottom padding (pb-16 lg:pb-12) to clear the floating chat widget -->
  <div class="w-full px-6 pt-10 pb-16 lg:px-12 lg:pb-12">

    <!-- Top Section: Logo & Newsletter Row -->
    <div class="flex flex-col gap-8 lg:flex-row lg:items-start lg:justify-between border-b border-white/15 pb-8">

      <!-- Left: Logo & Brand Tagline -->
      <div class="shrink-0 max-w-sm">
        <a href="#" onclick="event.preventDefault(); window.scrollTo({ top: 0, behavior: 'smooth' });" aria-label="Back to top" class="inline-block rounded focus:outline-none focus:ring-2 focus:ring-white">
          <img src="/brand/dxvalley-wordmark.jpeg" alt="DxValley Incubation Center" class="h-10 w-auto max-w-[180px] object-contain object-left mix-blend-multiply" loading="lazy" decoding="async" />
        </a>
        <p class="mt-3 text-xs leading-relaxed text-white/90">
          A practical incubation center for Ethiopia’s ambitious founders, powered by community and accountable progress.
        </p>
      </div>

      <!-- Right: Newsletter Subscription Block -->
      <div class="w-full max-w-md shrink-0 lg:ml-auto">
        <form id="newsletter-form" class="w-full" novalidate>
          <label class="block text-xs font-bold uppercase tracking-wider text-white" for="newsletter">Stay close to us</label>
          <p class="mt-1 text-[11px] text-white/80">Get the latest workshop schedules and incubator updates directly to your inbox.</p>
          <div class="mt-2.5 flex">
            <input id="newsletter" name="email" class="w-full min-w-0 rounded-l-md bg-white px-3.5 py-2 text-xs text-slate-900 outline-none placeholder:text-slate-400 focus:ring-2 focus:ring-orange" placeholder="Your email address" type="email" required aria-describedby="newsletter-status" />
            <button class="shrink-0 rounded-r-md bg-orange px-4 py-2 text-xs font-bold text-white transition hover:bg-orange-dark focus:outline-none focus:ring-2 focus:ring-white cursor-pointer" type="submit">Subscribe</button>
          </div>
          <p id="newsletter-status" class="mt-2 text-xs font-medium text-white" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>

    <!-- Middle Section: Clean 3-Column Navigation Grid -->
    <div class="mt-8 grid gap-8 grid-cols-1 sm:grid-cols-3 max-w-4xl">

      <!-- Column 1: Platform Links -->
      <div>
        <h2 class="text-xs font-extrabold uppercase tracking-[.16em] text-white">Platform</h2>
        <nav class="mt-3 flex flex-col gap-2.5 text-xs font-medium text-white/90" aria-label="Platform navigation links">
          <a class="transition hover:text-white hover:underline focus:outline-none focus:ring-1 focus:ring-white w-max" href="/">Home</a>
          <a class="transition hover:text-white hover:underline focus:outline-none focus:ring-1 focus:ring-white w-max" href="<%= routes.about %>">About</a>
          <a class="transition hover:text-white hover:underline focus:outline-none focus:ring-1 focus:ring-white w-max" href="<%= routes.mentors %>">Mentors</a>
          <a class="transition hover:text-white hover:underline focus:outline-none focus:ring-1 focus:ring-white w-max" href="<%= routes.projects %>">Projects</a>
        </nav>
      </div>

      <!-- Column 2: Program & Events Links -->
      <div>
        <h2 class="text-xs font-extrabold uppercase tracking-[.16em] text-white">Program &amp; Events</h2>
        <nav class="mt-3 flex flex-col gap-2.5 text-xs font-medium text-white/90" aria-label="Program and events navigation links">
          <a class="transition hover:text-white hover:underline focus:outline-none focus:ring-1 focus:ring-white w-max" href="<%= routes.workshops %>">Workshops</a>
          <a class="transition hover:text-white hover:underline focus:outline-none focus:ring-1 focus:ring-white w-max" href="/#announcements">Announcements</a>
          <a class="transition hover:text-white hover:underline focus:outline-none focus:ring-1 focus:ring-white w-max" href="<%= routes.gallery %>">Gallery</a>
        </nav>
      </div>

      <!-- Column 3: Legal & Contact + Linktree Link -->
      <div>
        <h2 class="text-xs font-extrabold uppercase tracking-[.16em] text-white">Legal &amp; Contact</h2>
        <nav class="mt-3 flex flex-col gap-2.5 text-xs font-medium text-white/90" aria-label="Legal and contact navigation links">
          <a class="transition hover:text-white hover:underline focus:outline-none focus:ring-1 focus:ring-white w-max" href="/v1/terms">Terms &amp; conditions</a>
          <a class="transition hover:text-white hover:underline focus:outline-none focus:ring-1 focus:ring-white w-max" href="/contact">Contact Us</a>
          <a href="https://linktr.ee/CoopDxValley" target="_blank" rel="noopener noreferrer" class="mt-1 inline-flex items-center gap-1.5 transition hover:text-white hover:underline focus:outline-none focus:ring-1 focus:ring-white w-max">
            <span>Linktree Hub</span>
            <i class="fa-solid fa-arrow-up-right-from-square text-[10px]" aria-hidden="true"></i>
          </a>
        </nav>
      </div>

    </div>

    <!-- Bottom Section: Copyright Notice -->
    <div class="mt-10 border-t border-white/10 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-white/80">
        © <%= new Date().getFullYear() %> DxValley Incubation Center. All rights reserved.
      </p>
      <p class="text-[11px] text-white/70">
        Powered by Cooperative Bank of Oromia
      </p>
    </div>

  </div>
</footer>

<script>
  (() => {
    const form = document.getElementById('newsletter-form');
    const status = document.getElementById('newsletter-status');
    if (!form || !status) return;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const emailInput = document.getElementById('newsletter');
      if (!emailInput) return;
      const email = emailInput.value.trim();

      if (!email) {
        status.textContent = '❌ Please enter an email address.';
        return;
      }

      const button = form.querySelector('button[type="submit"]');
      button.disabled = true;
      button.textContent = 'Subscribing...';
      status.textContent = '';

      try {
        const response = await fetch('/api/public/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email })
        });
        const data = await response.json();

        if (response.ok) {
          status.textContent = '✅ ' + (data.message || 'Subscribed successfully!');
          form.reset();
        } else {
          status.textContent = '❌ ' + (data.message || 'Subscription failed.');
        }
      } catch (error) {
        status.textContent = '❌ Network error. Please try again.';
      } finally {
        button.disabled = false;
        button.textContent = 'Subscribe';
      }
    });
  })();
</script>

<%- include('./chatbot') %>