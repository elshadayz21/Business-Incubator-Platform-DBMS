<footer id="resources" class="bg-cyan text-white">
  <div class="mx-auto max-w-7xl px-6 py-16 lg:px-10 lg:py-20">
    <div class="grid gap-12 lg:grid-cols-[1.35fr_.75fr_.75fr_1fr] lg:gap-10">
      <div>
        <img src="/brand/dxvalley-wordmark.jpeg" alt="DxValley Incubation Center" class="h-14 w-auto max-w-[230px] object-contain object-left mix-blend-multiply" loading="lazy" decoding="async" />
        <p class="mt-5 max-w-[290px] text-sm leading-7 text-white/80">
          A practical incubation center for Ethiopia’s ambitious founders, powered by community and accountable progress.
        </p>
                <div class="mt-7 flex items-center gap-2" aria-label="Social links">
                  <a aria-label="LinkedIn" class="grid h-8 w-8 place-items-center rounded-full border border-white/50 transition hover:bg-white hover:text-cyan" href="https://linktr.ee/CoopDxValley" target="_blank" rel="noopener noreferrer" title="View all social links">
                    <i class="fa-brands fa-linkedin-in text-sm" aria-hidden="true"></i>
                  </a>
                  <a aria-label="YouTube" class="grid h-8 w-8 place-items-center rounded-full border border-white/50 transition hover:bg-white hover:text-cyan" href="https://linktr.ee/CoopDxValley" target="_blank" rel="noopener noreferrer" title="View all social links">
                    <i class="fa-brands fa-youtube text-sm" aria-hidden="true"></i>
                  </a>
                  <a aria-label="Instagram" class="grid h-8 w-8 place-items-center rounded-full border border-white/50 transition hover:bg-white hover:text-cyan" href="https://linktr.ee/CoopDxValley" target="_blank" rel="noopener noreferrer" title="View all social links">
                    <i class="fa-brands fa-instagram text-sm" aria-hidden="true"></i>
                  </a>
                </div>
      </div>

      <div>
        <h2 class="text-sm font-extrabold uppercase tracking-[.16em]">Platform</h2>
        <nav class="mt-5 flex flex-col gap-3 text-sm text-white/80" aria-label="Platform links">
          <a class="transition hover:text-white hover:underline" href="/">Home</a>
          <a class="transition hover:text-white hover:underline" href="<%= routes.about %>">About</a>
          <a class="transition hover:text-white hover:underline" href="<%= routes.mentors %>">Mentors</a>
          <a class="transition hover:text-white hover:underline" href="<%= routes.workshops %>">Workshops</a>
          <a class="transition hover:text-white hover:underline" href="<%= routes.projects %>">Projects</a>
        </nav>
      </div>

      <div>
        <h2 class="text-sm font-extrabold uppercase tracking-[.16em]">Resources</h2>
        <nav class="mt-5 flex flex-col gap-3 text-sm text-white/80" aria-label="Resource links">
          <a class="transition hover:text-white hover:underline" href="/#announcements">Announcements</a>
          <a class="transition hover:text-white hover:underline" href="<%= routes.gallery %>">Gallery</a>
          <a class="transition hover:text-white hover:underline" href="/v1/terms">Terms &amp; conditions</a>
          <a class="opacity-90 transition hover:opacity-100 hover:underline" href="/contact">Contact</a>
        </nav>
      </div>
<form id="newsletter-form" class="max-w-[430px]" novalidate>
            <label class="text-sm font-bold" for="newsletter">Stay close to the next cohort</label>
            <div class="mt-3 flex">
              <input id="newsletter" name="email" class="min-w-0 flex-1 rounded-l-md bg-white px-4 py-3 text-sm text-ink outline-none placeholder:text-slate-400 focus:ring-2 focus:ring-orange" placeholder="Your email address" type="email" required aria-describedby="newsletter-status" />
              <button class="rounded-r-md bg-orange px-5 py-3 text-sm font-bold text-white transition hover:bg-orange-dark focus:outline-none focus:ring-2 focus:ring-white" type="submit">Subscribe</button>
            </div>
            <p id="newsletter-status" class="mt-2 text-xs text-white/75" role="status" aria-live="polite"></p>
          </form>
    <div class="mt-14 grid gap-8 border-t border-white/25 pt-8 lg:grid-cols-[1fr_auto] lg:items-end">

      <p class="text-xs text-white/75 lg:text-right">© <%= new Date().getFullYear() %> DxValley Incubation Center. All rights reserved.</p>
    </div>
     </div>
  <div class="bg-cyan-dark">
  </div>
</footer>

<script>
  (() => {
    const form = document.getElementById('newsletter-form');
    const status = document.getElementById('newsletter-status');
    if (!form || !status) return;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const emailInput = document.getElementById('newsletter');
      if (!emailInput) return;
      const email = emailInput.value;

      if (!email) {
        status.textContent = '❌ Please enter an email address.';
        return;
      }

      const button = form.querySelector('button[type="submit"]');

      button.disabled = true;
      button.textContent = 'Subscribing...';
      status.textContent = '';

      try {
        const response = await fetch('/api/public/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email })
        });
        const data = await response.json();

        if (response.ok) {
          status.textContent = '✅ ' + data.message;
          form.reset();
        } else {
          status.textContent = '❌ ' + (data.message || 'Subscription failed.');
        }
      } catch (error) {
        status.textContent = '❌ Network error. Please try again.';
      } finally {
        button.disabled = false;
        button.textContent = 'Subscribe';
      }
    });
  })();
</script>

<%- include('./chatbot') %>
