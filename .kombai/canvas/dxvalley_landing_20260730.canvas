ar(--color-muted)]\" data-kid=\"1-3-7-1-2-2-3\">\n                            Simple projection tools tailored for early-stage Ethiopian startups.\n                        </p>\n                    </div>\n                    <div class=\"dv-reveal rounded-2xl border border-[var(--color-line)] bg-white p-6 shadow-sm transition hover:shadow-md\" data-delay=\"120\" data-kid=\"1-3-7-1-2-3\">\n                        <div class=\"grid h-10 w-10 place-items-center rounded-lg bg-[var(--color-cyan-soft)] text-[var(--color-cyan-dark)]\" data-kid=\"1-3-7-1-2-3-1\">\n                            <i class=\"h-5 w-5\" data-kid=\"1-3-7-1-2-3-1-1\" data-lucide=\"users\">\n                            </i>\n                        </div>\n                        <h3 class=\"mt-4 text-lg font-bold text-[var(--color-ink)]\" data-kid=\"1-3-7-1-2-3-2\">\n                            Pitch Deck Essentials\n                        </h3>\n                        <p class=\"mt-2 text-xs leading-6 text-[var(--color-muted)]\" data-kid=\"1-3-7-1-2-3-3\">\n                            Key slides and metrics investors look for during early funding rounds.\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"bg-gradient-to-br from-[var(--color-cyan-deep)] to-[#00587D] text-white\" data-kid=\"1-3-8\" id=\"apply\">\n            <div class=\"mx-auto max-w-[1280px] px-6 py-20 text-center lg:px-10 lg:py-24\" data-kid=\"1-3-8-1\">\n                <h2 class=\"text-4xl font-extrabold tracking-[-.04em] sm:text-5xl\" data-kid=\"1-3-8-1-1\">\n                    Ready to build your startup?\n                </h2>\n                <p class=\"mx-auto mt-5 max-w-[580px] text-lg text-white/80\" data-kid=\"1-3-8-1-2\">\n                    Applications for Batch 04 are open. Join a community of founders shaping the future.\n                </p>\n                <div class=\"mt-8 flex justify-center gap-4\" data-kid=\"1-