      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Roboto:wght@400;500;700&display=swap');\n  :root {\n    --color-cyan: #00ADEF;\n    --color-cyan-deep: #0878B4;\n    --color-cyan-dark: #006F9E;\n    --color-cyan-soft: #EAF8FC;\n    --color-orange: #E38524;\n    --color-orange-soft: #FFF1E3;\n    --color-ink: #111827;\n    --color-muted: #526274;\n    --color-line: #D6E4EA;\n    --color-surface: #F6FAFC;\n    --shadow-soft: 0 18px 46px rgba(0, 88, 125, .11);\n    --shadow-card: 0 12px 30px rgba(0, 88, 125, .08);\n  }\n  @keyframes dvFadeUp { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: translateY(0); } }\n  .dv-reveal { opacity: 1; transform: none; }\n  .dv-reveal.dv-visible { animation: dvFadeUp .7s cubic-bezier(.2,.7,.2,1) forwards; }\n  @media (prefers-reduced-motion: reduce) { .dv-reveal { opacity: 1; transform: none; } .dv-reveal.dv-visible { animation: none; } }\n</style>\n<div class=\"min-h-screen bg-white font-['Inter',sans-serif] text-[var(--color-ink)] antialiased\" data-kid=\"1\">\n    <div class=\"bg-[var(--color-cyan)] text-white\" data-kid=\"1-1\">\n        <div class=\"mx-auto flex max-w-[1280px] items-center justify-between px-6 py-2 text-[11px] font-semibold tracking-wide lg:px-10\" data-kid=\"1-1-1\">\n            <nav aria-label=\"Utility navigation\" class=\"flex items-center gap-5 overflow-x-auto whitespace-nowrap\" data-kid=\"1-1-1-1\">\n                <a class=\"opacity-90 transition hover:opacity-100 hover:underline\" data-kid=\"1-1-1-1-1\" href=\"#faq\">\n                    FAQ\n                </a>\n                <a class=\"opacity-90 transition hover:opacity-100 hover:underline\" data-kid=\"1-1-1-1-2\" href=\"#events\">\n                    Events\n                </a>\n                <a class=\"opacity-90 transition hover:opacity-100 hover:underline\" data-kid=\"1-1-1-1-3\" href=\"#stories\">\n                    Stories\n                </a>\n                <a class=\"opacity-90 transition hover:opacity-100 hover:underline\" data-kid=\"1-1-1-1-4\" href=\"#partners\">\n                    Partners\n                </a>\n                <a class=\"opacity-90 transition hover:opacity-100 hover:underline\" data-kid=\"1-1-1-1-5\" href=\"#contact\">\n                    Contact\n                </a>\n            </nav>\n            <div aria-label=\"Social links\" class=\"hidden items-center gap-2 sm:flex\" data-kid=\"1-1-1-2\">\n                <a aria-label=\"LinkedIn\" class=\"grid h-6 w-6 place-items-center rounded-full border border-white/40 transition hover:bg-white hover:text-[var(--color-cyan)]\" data-kid=\"1-1-1-2-1\" href=\"#linkedin\" title=\"LinkedIn\">\n                    <i class=\"h-3.5 w-3.5\" data-kid=\"1-1-1-2-1-1\" data-lucide=\"linkedin\">\n                    </i>\n                </a>\n                <a aria-label=\"YouTube\" class=\"grid h-6 w-6 place-items-center rounded-full border border-white/40 transition hover:bg-white hover:text-[var(--color-cyan)]\" data-kid=\"1-1-1-2-2\" href=\"#youtube\" title=\"YouTube\">\n                    <i class=\"h-3.5 w-3.5\" data-kid=\"1-1-1-2-2-1\" data-lucide=\"youtube\">\n                    </i>\n                </a>\n                <a aria-label=\"Instagram\" class=\"grid h-6 w-6 place-items-center rounded-full border border-white/40 transition hover:bg-white hover:text-[var(--color-cyan)]\" data-kid=\"1-1-1-2-3\" href=\"#instagram\" title=\"Instagram\">\n                    <i class=\"h-3.5 w-3.5\" data-kid=\"1-1-1-2-3-1\" data-lucide=\"instagram\">\n                    </i>\n                </a>\n            </div>\n        </div>\n    </div>\n    <header class=\"border-b border-[var(--color-line)] bg-white\" data-kid=\"1-2\">\n        <div class=\"mx-auto max-w-[1280px] px-6 lg:px-10\" data-kid=\"1-2-1\">\n            <div class=\"flex min-h-[88px] items-center justify-between gap-6 py-4\" data-kid=\"1-2-1-1\">\n                <div class=\"flex min-w-0 items-center gap-4\" data-kid=\"1-2-1-1-1\">\n                    <a aria-label=\"DxValley home\" class=\"shrink-0\" data-kid=\"1-2-1-1-1-1\" href=\"#top\">\n                        <img alt=\"DxValley Incubation Center\" class=\"h-12 w-auto max-w-[210px] object-contain object-left mix-blend-multiply\" data-kid=\"1-2-1-1-1-1-1\" decoding=\"async\" loading=\"eager\" src=\"/api/local/images/Website/public/brand/dxvalley-wordmark.jpeg\"/>\n                    </a>\n                    <div class=\"hidden h-9 w-px bg-[var(--color-line)] sm:block\" data-kid=\"1-2-1-1-1-2\">\n                    </div>\n                    <div class=\"hidden text-[10px] font-semibold uppercase leading-tight tracking-[.16em] text-[var(--color-muted)] sm:block\" data-kid=\"1-2-1-1-1-3\">\n                        Incubation arm of\n                        <br data-kid=\"1-2-1-1-1-3-1\"/>\n                        <span class=\"text-[var(--color-cyan-dark)]\" data-kid=\"1-2-1-1-1-3-2\">\n                            Cooperative Bank of Oromia\n                        </span>\n                    </div>\n                </div>\n                <div class=\"hidden items-center gap-4 lg:flex\" data-kid=\"1-2-1-1-2\">\n                    <label class=\"relative block\" data-kid=\"1-2-1-1-2-1\" for=\"site-search\">\n                        <span class=\"sr-only\" data-kid=\"1-2-1-1-2-1-1\">\n                            Search DxValley\n                        </span>\n                        <i class=\"pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-[var(--color-muted)]\" data-kid=\"1-2-1-1-2-1-2\" data-lucide=\"search\">\n                        </i>\n                        <input class=\"h-10 w-[200px] rounded-full border border-[var(--color-line)] bg-[var(--color-surface)] pl-9 pr-4 text-xs outline-none transition placeholder:text-slate-400 focus:border-[var(--color-cyan)] focus:ring-2 focus:ring-[var(--color-cyan)]/20\" data-kid=\"1-2-1-1-2-1-3\" id=\"site-search\" placeholder=\"Search DxValley\" type=\"search\"/>\n                    </label>\n                    <a class=\"inline-flex items-center gap-2 rounded-full bg-[var(--color-orange)] px-5 py-2.5 text-sm font-bold text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-[#c97019] focus:outline-none focus:ring-2 focus:ring-[var(--color-orange)] focus:ring-offset-2\" data-kid=\"1-2-1-1-2-2\" href=\"#apply\">\n                        Apply now\n                        <i class=\"h-4 w-4\" data-kid=\"1-2-1-1-2-2-1\" data-lucide=\"arrow-up-right\">\n                        </i>\n                    </a>\n                </div>\n                <button aria-controls=\"main-navigation\" aria-label=\"Open navigation menu\" class=\"grid h-10 w-10 place-items-center rounded-full border border-[var(--color-line)] text-[var(--color-cyan-dark)] lg:hidden\" data-kid=\"1-2-1-1-3\" title=\"Open navigation menu\" type=\"button\">\n                    <i class=\"h-5 w-5\" data-kid=\"1-2-1-1-3-1\" data-lucide=\"menu\">\n                    </i>\n                </button>\n            </div>\n            <div class=\"hidden border-t border-[var(--color-line)] py-4 lg:block\" data-kid=\"1-2-1-2\" id=\"main-navigation\">\n                <nav aria-label=\"Main navigation\" class=\"flex items-center justify-end gap-8 text-sm font-semibold text-[var(--color-ink)]\" data-kid=\"1-2-1-2-1\">\n                    <a class=\"transition hover:text-[var(--color-cyan-dark)]\" data-kid=\"1-2-1-2-1-1\" href=\"#about\">\n                        About DxValley\n                    </a>\n                    <a class=\"transition hover:text-[var(--color-cyan-dark)]\" data-kid=\"1-2-1-2-1-2\" href=\"#programs\">\n                        Programs\n                    </a>\n                    <a class=\"transition hover:text-[var(--color-cyan-dark)]\" data-kid=\"1-2-1-2-1-3\" href=\"#how-it-works\">\n                        How it works\n                    </a>\n                    <a class=\"transition hover:text-[var(--color-cyan-dark)]\" data-kid=\"1-2-1-2-1-4\" href=\"#community\">\n                        Community\n                    </a>\n                    <a class=\"transition hover:text-[var(--color-cyan-dark)]\" data-kid=\"1-2-1-2-1-5\" href=\"#resources\">\n                        Resources\n                    </a>\n                </nav>\n            </div>\n        </div>\n    </header>\n    <main data-kid=\"1-3\" id=\"top\">\n        <section class=\"relative overflow-hidden bg-gradient-to-br from-[var(--color-cyan)] via-[#078CC8] to-[var(--color-cyan-deep)] text-white\" data-kid=\"1-3-1\">\n            <div class=\"pointer-events-none absolute -left-24 -top-20 h-[460px] w-[620px] rounded-[48%] border-[70px] border-white/10\" data-kid=\"1-3-1-1\">\n            </div>\n            <div class=\"pointer-events-none absolute -right-40 bottom-[-240px] h-[620px] w-[760px] rounded-[50%] border-[90px] border-white/10\" data-kid=\"1-3-1-2\">\n            </div>\n            <div class=\"pointer-events-none absolute right-[28%] top-14 h-20 w-20 rounded-full bg-white/10 blur-xl\" data-kid=\"1-3-1-3\">\n            </div>\n            <div class=\"relative mx-auto grid max-w-[1280px] items-center gap-12 px-6 py-20 lg:grid-cols-[1.06fr_.94fr] lg:px-10 lg:py-24\" data-kid=\"1-3-1-4\">\n                <div class=\"dv-reveal max-w-[680px]\" data-delay=\"0\" data-kid=\"1-3-1-4-1\">\n                    <p class=\"mb-5 inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[.24em] text-white/80\" data-kid=\"1-3-1-4-1-1\">\n                        <span class=\"h-2 w-2 rounded-full bg-[var(--color-orange)]\" data-kid=\"1-3-1-4-1-1-1\">\n                        </span>\n                        DxValley Incubation Center\n                    </p>\n                    <h1 class=\"max-w-[700px] text-5xl font-extrabold leading-[1.02] tracking-[-.055em] sm:text-6xl lg:text-7xl\" data-kid=\"1-3-1-4-1-2\">\n                        Build what\n                        <br data-kid=\"1-3-1-4-1-2-1\"/>\n                        <span class=\"text-white/75\" data-kid=\"1-3-1-4-1-2-2\">\n                            Ethiopia needs.\n                        </span>\n                    </h1>\n                    <p class=\"mt-7 max-w-[610px] text-lg leading-8 text-white/85 sm:text-xl\" data-kid=\"1-3-1-4-1-3\">\n                        We help bold ideas become investable, scalable businesses through structured cohorts, expert mentorship, and a community that keeps founders moving.\n                    </p>\n                    <div class=\"mt-9 flex flex-col gap-3 sm:flex-row\" data-kid=\"1-3-1-4-1-4\">\n                        <a class=\"inline-flex items-center justify-center gap-3 rounded-md bg-[var(--color-orange)] px-6 py-3.5 text-sm font-extrabold text-white shadow-[0_10px_24px_rgba(141,67,10,.24)] transition hover:-translate-y-0.5 hover:bg-[#c97019] focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-[var(--color-cyan-deep)]\" data-kid=\"1-3-1-4-1-4-1\" href=\"#apply\">\n                            Apply to the next cohort\n                            <i class=\"h-4 w-4\" data-kid=\"1-3-1-4-1-4-1-1\" data-lucide=\"arrow-right\">\n                            </i>\n                        </a>\n                        <a class=\"inline-flex items-center justify-center gap-3 rounded-md border border-white/70 bg-white/5 px-6 py-3.5 text-sm font-bold text-white transition hover:bg-white hover:text-[var(--color-cyan-deep)] focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-[var(--color-cyan-deep)]\" data-kid=\"1-3-1-4-1-4-2\" href=\"#programs\">\n                            Explore programs\n                            <i class=\"h-4 w-4\" data-kid=\"1-3-1-4-1-4-2-1\" data-lucide=\"chevron-right\">\n                            </i>\n                        </a>\n                    </div>\n                </div>\n                <div class=\"dv-reveal relative lg:justify-self-end\" data-delay=\"140\" data-kid=\"1-3-1-4-2\">\n                    <div class=\"relative w-full max-w-[520px] rounded-[28px] border border-white/30 bg-white/12 p-5 shadow-[0_22px_70px_rgba(0,63,102,.25)] backdrop-blur-md sm:p-7\" data-kid=\"1-3-1-4-2-1\">\n                        <div class=\"flex items-start justify-between gap-4 border-b border-white/20 pb-6\" data-kid=\"1-3-1-4-2-1-1\">\n                            <div data-kid=\"1-3-1-4-2-1-1-1\">\n                                <p class=\"text-xs font-bold uppercase tracking-[.2em] text-white/65\" data-kid=\"1-3-1-4-2-1-1-1-1\">\n                                    Founder dashboard\n                                </p>\n                                <p class=\"mt-2 text-2xl font-bold\" data-kid=\"1-3-1-4-2-1-1-1-2\">\n                                    Make the next move.\n                                </p>\n                            </div>\n                            <span class=\"rounded-full bg-white/15 px-3 py-1 text-[10px] font-bold uppercase tracking-wider text-white/80\" data-kid=\"1-3-1-4-2-1-1-2\">\n                                Batch 04\n                            </span>\n                        </div>\n                        <div class=\"grid grid-cols-2 gap-3 py-6 sm:grid-cols-3\" data-kid=\"1-3-1-4-2-1-2\">\n                            <div class=\"rounded-xl bg-white/12 p-4\" data-kid=\"1-3-1-4-2-1-2-1\">\n                                <p class=\"text-2xl font-extrabold\" data-kid=\"1-3-1-4-2-1-2-1-1\">\n                                    03\n                                </p>\n                                <p class=\"mt-1 text-xs text-white/70\" data-kid=\"1-3-1-4-2-1-2-1-2\">\n                                    Growth stages\n                                </p>\n                            </div>\n                            <div class=\"rounded-xl bg-white/12 p-4\" data-kid=\"1-3-1-4-2-1-2-2\">\n                                <p class=\"text-2xl font-extrabold\" data-kid=\"1-3-1-4-2-1-2-2-1\">\n                                    02\n                                </p>\n                                <p class=\"mt-1 text-xs text-white/70\" data-kid=\"1-3-1-4-2-1-2-2-2\">\n                                    Cohort tracks\n                                </p>\n                            </div>\n                            <div class=\"col-span-2 rounded-xl bg-white/12 p-4 sm:col-span-1\" data-kid=\"1-3-1-4-2-1-2-3\">\n                                <p class=\"text-2xl font-extrabold\" data-kid=\"1-3-1-4-2-1-2-3-1\">\n                                    01\n                                </p>\n                                <p class=\"mt-1 text-xs text-white/70\" data-kid=\"1-3-1-4-2-1-2-3-2\">\n                                    Founder network\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"flex items-center justify-between rounded-xl bg-white p-4 text-[var(--color-ink)]\" data-kid=\"1-3-1-4-2-1-3\">\n                            <div data-kid=\"1-3-1-4-2-1-3-1\">\n                                <p class=\"text-[10px] font-bold uppercase tracking-[.16em] text-[var(--color-cyan-dark)]\" data-kid=\"1-3-1-4-2-1-3-1-1\">\n                                    Current focus\n                                </p>\n                                <p class=\"mt-1 text-sm font-bold\" data-kid=\"1-3-1-4-2-1-3-1-2\">\n                                    Validate your market\n                                </p>\n                            </div>\n                            <span class=\"grid h-9 w-9 place-items-center rounded-full bg-[var(--color-orange-soft)] text-[var(--color-orange)]\" data-kid=\"1-3-1-4-2-1-3-2\">\n                                <i class=\"h-4 w-4\" data-kid=\"1-3-1-4-2-1-3-2-1\" data-lucide=\"sparkles\">\n                                </i>\n                            </span>\n                        </div>\n                        <div class=\"absolute -bottom-8 -left-6 hidden items-center gap-3 rounded-2xl bg-white p-3 text-[var(--color-ink)] shadow-[0_18px_40px_rgba(0,63,102,.22)] sm:flex\" data-kid=\"1-3-1-4-2-1-4\">\n                            <img alt=\"DxValley\" class=\"h-10 w-[118px] object-contain object-left mix-blend-multiply\" data-kid=\"1-3-1-4-2-1-4-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/Website/public/brand/dxvalley-wordmark.jpeg\"/>\n                            <span class=\"h-8 w-px bg-[var(--color-line)]\" data-kid=\"1-3-1-4-2-1-4-2\">\n                            </span>\n                            <span class=\"pr-2 text-[10px] font-bold uppercase tracking-wider text-[var(--color-muted)]\" data-kid=\"1-3-1-4-2-1-4-3\">\n                                For founders\n                                <br data-kid=\"1-3-1-4-2-1-4-3-1\"/>\n                                with momentum\n                            </span>\n                        </div>\n                    </div>\n                    <img alt=\"Cooperative Bank of Oromia partner mark\" class=\"pointer-events-none absolute -bottom-12 -right-12 hidden h-40 w-40 object-contain opacity-[.12] mix-blend-screen lg:block\" data-kid=\"1-3-1-4-2-2\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/Website/public/brand/coopbank-mark.jpeg\"/>\n                </div>\n            </div>\n        </section>\n        <section class=\"border-b border-[var(--color-line)] bg-[var(--color-cyan-soft)]\" data-kid=\"1-3-2\">\n            <div class=\"mx-auto grid max-w-[1280px] gap-6 px-6 py-7 lg:grid-cols-[1.1fr_1.5fr_auto] lg:items-center lg:px-10\" data-kid=\"1-3-2-1\">\n                <div data-kid=\"1-3-2-1-1\">\n                    <p class=\"text-xs font-extrabold uppercase tracking-[.18em] text-[var(--color-cyan-dark)]\" data-kid=\"1-3-2-1-1-1\">\n                        Batch 04 applications open\n                    </p>\n                    <p class=\"mt-2 text-sm font-semibold text-[var(--color-ink)]\" data-kid=\"1-3-2-1-1-2\">\n                        Closes 30 September 2026\n                    </p>\n                </div>\n                <div aria-label=\"Application countdown\" class=\"grid grid-cols-4 gap-2 sm:gap-4\" data-kid=\"1-3-2-1-2\">\n                    <div class=\"border-l-2 border-[var(--color-cyan)] pl-3\" data-kid=\"1-3-2-1-2-1\">\n                        <p class=\"text-2xl font-extrabold text-[var(--color-cyan-dark)]\" data-dynamic=\"true\" data-kid=\"1-3-2-1-2-1-1\" data-name=\"days countdown value\" data-reason=\"number text counted down by script\">\n                            62\n                        </p>\n                        <p class=\"text-[10px] font-bold uppercase tracking-wider text-[var(--color-muted)]\" data-kid=\"1-3-2-1-2-1-2\">\n                            Days\n                        </p>\n                    </div>\n                    <div class=\"border-l-2 border-[var(--color-cyan)] pl-3\" data-kid=\"1-3-2-1-2-2\">\n                        <p class=\"text-2xl font-extrabold text-[var(--color-cyan-dark)]\" data-dynamic=\"true\" data-kid=\"1-3-2-1-2-2-1\" data-name=\"hours countdown value\" data-reason=\"number text counted down by script\">\n                            14\n                        </p>\n                        <p class=\"text-[10px] font-bold uppercase tracking-wider text-[var(--color-muted)]\" data-kid=\"1-3-2-1-2-2-2\">\n                            Hours\n                        </p>\n                    </div>\n                    <div class=\"border-l-2 border-[var(--color-cyan)] pl-3\" data-kid=\"1-3-2-1-2-3\">\n                        <p class=\"text-2xl font-extrabold text-[var(--color-cyan-dark)]\" data-dynamic=\"true\" data-kid=\"1-3-2-1-2-3-1\" data-name=\"minutes countdown value\" data-reason=\"number text counted down by script\">\n                            38\n                        </p>\n                        <p class=\"text-[10px] font-bold uppercase tracking-wider text-[var(--color-muted)]\" data-kid=\"1-3-2-1-2-3-2\">\n                            Minutes\n                        </p>\n                    </div>\n                    <div class=\"border-l-2 border-[var(--color-cyan)] pl-3\" data-kid=\"1-3-2-1-2-4\">\n                        <p class=\"text-2xl font-extrabold text-[var(--color-cyan-dark)]\" data-dynamic=\"true\" data-kid=\"1-3-2-1-2-4-1\" data-name=\"seconds countdown value\" data-reason=\"number text counted down by script\">\n                            09\n                        </p>\n                        <p class=\"text-[10px] font-bold uppercase tracking-wider text-[var(--color-muted)]\" data-kid=\"1-3-2-1-2-4-2\">\n                            Seconds\n                        </p>\n                    </div>\n                </div>\n                <a class=\"inline-flex items-center gap-2 text-sm font-bold text-[var(--color-cyan-dark)] transition hover:text-[var(--color-orange)]\" data-kid=\"1-3-2-1-3\" href=\"#eligibility\">\n                    View eligibility\n                    <i class=\"h-4 w-4\" data-kid=\"1-3-2-1-3-1\" data-lucide=\"arrow-up-right\">\n                    </i>\n                </a>\n            </div>\n        </section>\n        <section class=\"bg-white\" data-kid=\"1-3-3\" id=\"about\">\n            <div class=\"mx-auto grid max-w-[1280px] gap-16 px-6 py-24 lg:grid-cols-[1.05fr_.95fr] lg:gap-24 lg:px-10 lg:py-28\" data-kid=\"1-3-3-1\">\n                <div class=\"dv-reveal\" data-delay=\"0\" data-kid=\"1-3-3-1-1\">\n                    <p class=\"text-xs font-extrabold uppercase tracking-[.2em] text-[var(--color-orange)]\" data-kid=\"1-3-3-1-1-1\">\n                        A practical place to start\n                    </p>\n                    <h2 class=\"mt-4 max-w-[590px] text-4xl font-extrabold leading-tight tracking-[-.04em] text-[var(--color-cyan-dark)] sm:text-5xl\" data-kid=\"1-3-3-1-1-2\">\n                        A launchpad for ambitious founders\n                    </h2>\n                    <p class=\"mt-7 max-w-[610px] text-base leading-8 text-[var(--color-muted)]\" data-kid=\"1-3-3-1-1-3\">\n                        DxValley is the incubation arm of Cooperative Bank of Oromia, built for founders solving real problems. We support startups and MSME growth cohorts with a focused progression from Idea to MVP to Scale-Up.\n                    </p>\n                    <p class=\"mt-4 max-w-[610px] text-base leading-8 text-[var(--color-muted)]\" data-kid=\"1-3-3-1-1-4\">\n                        No noise, no one-size-fits-all playbook — just the right people, practical tools, and accountable momentum for the stage you are in.\n                    </p>\n                    <a class=\"mt-8 inline-flex items-center gap-3 rounded-md bg-[var(--color-cyan)] px-5 py-3 text-sm font-bold text-white transition hover:bg-[var(--color-cyan-dark)] focus:outline-none focus:ring-2 focus:ring-[var(--color-cyan)] focus:ring-offset-2\" data-kid=\"1-3-3-1-1-5\" href=\"#about-more\">\n                        Learn about DxValley\n                        <i class=\"h-4 w-4\" data-kid=\"1-3-3-1-1-5-1\" data-lucide=\"arrow-right\">\n                        </i>\n                    </a>\n                </div>\n                <div class=\"dv-reveal\" data-delay=\"120\" data-kid=\"1-3-3-1-2\">\n                    <div class=\"mb-5 flex items-end justify-between\" data-kid=\"1-3-3-1-2-1\">\n                        <div data-kid=\"1-3-3-1-2-1-1\">\n                            <p class=\"text-xs font-extrabold uppercase tracking-[.2em] text-[var(--color-orange)]\" data-kid=\"1-3-3-1-2-1-1-1\">\n                                From the center\n                            </p>\n                            <h3 class=\"mt-2 text-3xl font-extrabold tracking-[-.03em] text-[var(--color-cyan-dark)]\" data-kid=\"1-3-3-1-2-1-1-2\">\n                                Latest updates\n                            </h3>\n                        </div>\n                        <a class=\"text-xs font-bold text-[var(--color-cyan-dark)] underline underline-offset-4 transition hover:text-[var(--color-orange)]\" data-kid=\"1-3-3-1-2-1-2\" href=\"#announcements\">\n                            View all\n                        </a>\n                    </div>\n                    <div class=\"divide-y divide-[var(--color-line)] border-y border-[var(--color-line)]\" data-kid=\"1-3-3-1-2-2\">\n                        <a class=\"group flex gap-4 py-4\" data-kid=\"1-3-3-1-2-2-1\" href=\"#news-1\">\n                            <span class=\"w-20 shrink-0 text-xs font-semibold text-[var(--color-muted)]\" data-kid=\"1-3-3-1-2-2-1-1\">\n                                18 Jun 2026\n                            </span>\n                            <span class=\"text-sm font-semibold leading-6 text-[var(--color-ink)] transition group-hover:text-[var(--color-cyan-dark)]\" data-kid=\"1-3-3-1-2-2-1-2\">\n                                DxValley opens applications for Batch 04 startup and MSME cohorts\n                            </span>\n                            <i class=\"ml-auto mt-1 h-4 w-4 shrink-0 text-[var(--color-cyan)]\" data-kid=\"1-3-3-1-2-2-1-3\" data-lucide=\"arrow-up-right\">\n                            </i>\n                        </a>\n                        <a class=\"group flex gap-4 py-4\" data-kid=\"1-3-3-1-2-2-2\" href=\"#news-2\">\n                            <span class=\"w-20 shrink-0 text-xs font-semibold text-[var(--color-muted)]\" data-kid=\"1-3-3-1-2-2-2-1\">\n                                09 Jun 2026\n                            </span>\n                            <span class=\"text-sm font-semibold leading-6 text-[var(--color-ink)] transition group-hover:text-[var(--color-cyan-dark)]\" data-kid=\"1-3-3-1-2-2-2-2\">\n                                What a strong first customer looks like for an early-stage team\n                            </span>\n                            <i class=\"ml-auto mt-1 h-4 w-4 shrink-0 text-[var(--color-cyan)]\" data-kid=\"1-3-3-1-2-2-2-3\" data-lucide=\"arrow-up-right\">\n                            </i>\n                        </a>\n                        <a class=\"group flex gap-4 py-4\" data-kid=\"1-3-3-1-2-2-3\" href=\"#news-3\">\n                            <span class=\"w-20 shrink-0 text-xs font-semibold text-[var(--color-muted)]\" data-kid=\"1-3-3-1-2-2-3-1\">\n                                28 May 2026\n                            </span>\n                            <span class=\"text-sm font-semibold leading-6 text-[var(--color-ink)] transition group-hover:text-[var(--color-cyan-dark)]\" data-kid=\"1-3-3-1-2-2-3-2\">\n                                Meet the mentors joining our next founder learning sprint\n                            </span>\n                            <i class=\"ml-auto mt-1 h-4 w-4 shrink-0 text-[var(--color-cyan)]\" data-kid=\"1-3-3-1-2-2-3-3\" data-lucide=\"arrow-up-right\">\n                            </i>\n                        </a>\n                        <a class=\"group flex gap-4 py-4\" data-kid=\"1-3-3-1-2-2-4\" href=\"#news-4\">\n                            <span class=\"w-20 shrink-0 text-xs font-semibold text-[var(--color-muted)]\" data-kid=\"1-3-3-1-2-2-4-1\">\n                                16 May 2026\n                            </span>\n                            <span class=\"text-sm font-semibold leading-6 text-[var(--color-ink)] transition group-hover:text-[var(--color-cyan-dark)]\" data-kid=\"1-3-3-1-2-2-4-2\">\n                                Inside the validation room: turning interviews into better decisions\n                            </span>\n                            <i class=\"ml-auto mt-1 h-4 w-4 shrink-0 text-[var(--color-cyan)]\" data-kid=\"1-3-3-1-2-2-4-3\" data-lucide=\"arrow-up-right\">\n                            </i>\n                        </a>\n                        <a class=\"group flex gap-4 py-4\" data-kid=\"1-3-3-1-2-2-5\" href=\"#news-5\">\n                            <span class=\"w-20 shrink-0 text-xs font-semibold text-[var(--color-muted)]\" data-kid=\"1-3-3-1-2-2-5-1\">\n                                02 May 2026\n                            </span>\n                            <span class=\"text-sm font-semibold leading-6 text-[var(--color-ink)] transition group-hover:text-[var(--color-cyan-dark)]\" data-kid=\"1-3-3-1-2-2-5-2\">\n                                A field guide to building for Ethiopia’s next million customers\n                            </span>\n                            <i class=\"ml-auto mt-1 h-4 w-4 shrink-0 text-[var(--color-cyan)]\" data-kid=\"1-3-3-1-2-2-5-3\" data-lucide=\"arrow-up-right\">\n                            </i>\n                        </a>\n                        <a class=\"group flex gap-4 py-4\" data-kid=\"1-3-3-1-2-2-6\" href=\"#news-6\">\n                            <span class=\"w-20 shrink-0 text-xs font-semibold text-[var(--color-muted)]\" data-kid=\"1-3-3-1-2-2-6-1\">\n                                21 Apr 2026\n                            </span>\n                            <span class=\"text-sm font-semibold leading-6 text-[var(--color-ink)] transition group-hover:text-[var(--color-cyan-dark)]\" data-kid=\"1-3-3-1-2-2-6-2\">\n                                Founders, mentors, and partners gather for the DxValley community day\n                            </span>\n                            <i class=\"ml-auto mt-1 h-4 w-4 shrink-0 text-[var(--color-cyan)]\" data-kid=\"1-3-3-1-2-2-6-3\" data-lucide=\"arrow-up-right\">\n                            </i>\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"bg-[var(--color-surface)]\" data-kid=\"1-3-4\" id=\"programs\">\n            <div class=\"mx-auto max-w-[1280px] px-6 py-24 lg:px-10 lg:py-28\" data-kid=\"1-3-4-1\">\n                <div class=\"max-w-[700px] dv-reveal\" data-delay=\"0\" data-kid=\"1-3-4-1-1\">\n                    <p class=\"text-xs font-extrabold uppercase tracking-[.2em] text-[var(--color-orange)]\" data-kid=\"1-3-4-1-1-1\">\n                        Built around your stage\n                    </p>\n                    <h2 class=\"mt-4 text-4xl font-extrabold tracking-[-.04em] text-[var(--color-cyan-dark)] sm:text-5xl\" data-kid=\"1-3-4-1-1-2\">\n                        What we unlock\n                    </h2>\n                    <p class=\"mt-5 text-base leading-8 text-[var(--color-muted)]\" data-kid=\"1-3-4-1-1-3\">\n                        A clearer path, better conversations, and practical support that compounds as your business grows.\n                    </p>\n                </div>\n                <div class=\"mt-14 divide-y divide-[var(--color-line)] border-y border-[var(--color-line)]\" data-kid=\"1-3-4-1-2\">\n                    <article class=\"dv-reveal grid gap-8 py-9 lg:grid-cols-[1.35fr_1fr_auto] lg:items-center\" data-delay=\"60\" data-kid=\"1-3-4-1-2-1\">\n                        <div data-kid=\"1-3-4-1-2-1-1\">\n                            <p class=\"text-xs font-extrabold uppercase tracking-[.18em] text-[var(--color-cyan-dark)]\" data-kid=\"1-3-4-1-2-1-1-1\">\n                                01 / Discover\n                            </p>\n                            <h3 class=\"mt-3 text-2xl font-extrabold tracking-[-.03em] text-[var(--color-ink)]\" data-kid=\"1-3-4-1-2-1-1-2\">\n                                Validate the idea\n                            </h3>\n                            <p class=\"mt-3 max-w-[560px] text-sm leading-7 text-[var(--color-muted)]\" data-kid=\"1-3-4-1-2-1-1-3\">\n                                Turn a strong hunch into a tested opportunity with customer conversations, market framing, and a sharper problem worth solving.\n                            </p>\n                        </div>\n                        <div class=\"flex items-center gap-4\" data-kid=\"1-3-4-1-2-1-2\">\n                            <span class=\"h-3 w-3 shrink-0 rounded-full bg-[var(--color-orange)]\" data-kid=\"1-3-4-1-2-1-2-1\">\n                            </span>\n                            <span class=\"text-sm font-semibold text-[var(--color-muted)]\" data-kid=\"1-3-4-1-2-1-2-2\">\n                                Idea → evidence\n                            </span>\n                        </div>\n                        <span class=\"rounded-full border border-[var(--color-cyan)]/30 bg-[var(--color-cyan-soft)] px-4 py-2 text-xs font-bold text-[var(--color-cyan-dark)]\" data-kid=\"1-3-4-1-2-1-3\">\n                            Start with clarity\n                        </span>\n                    </article>\n                    <article class=\"dv-reveal grid gap-8 py-9 lg:grid-cols-[1.35fr_1fr_auto] lg:items-center\" data-delay=\"120\" data-kid=\"1-3-4-1-2-2\">\n                        <div data-kid=\"1-3-4-1-2-2-1\">\n                            <p class=\"text-xs font-extrabold uppercase tracking-[.18em] text-[var(--color-cyan-dark)]\" data-kid=\"1-3-4-1-2-2-1-1\">\n                                02 / Build\n                            </p>\n                            <h3 class=\"mt-3 text-2xl font-extrabold tracking-[-.03em] text-[var(--color-ink)]\" data-kid=\"1-3-4-1-2-2-1-2\">\n                                Build with experts\n                            </h3>\n                            <p class=\"mt-3 max-w-[560px] text-sm leading-7 text-[var(--color-muted)]\" data-kid=\"1-3-4-1-2-2-1-3\">\n                                Work alongside mentors and peers to shape your MVP, strengthen the model, and make decisions with more confidence.\n                            </p>\n                        </div>\n                        <div class=\"flex items-center gap-4\" data-kid=\"1-3-4-1-2-2-2\">\n                            <span class=\"h-3 w-3 shrink-0 rounded-full bg-[var(--color-orange)]\" data-kid=\"1-3-4-1-2-2-2-1\">\n                            </span>\n                            <span class=\"text-sm font-semibold text-[var(--color-muted)]\" data-kid=\"1-3-4-1-2-2-2-2\">\n                                MVP → traction\n                            </span>\n                        </div>\n                        <span class=\"rounded-full border border-[var(--color-cyan)]/30 bg-[var(--color-cyan-soft)] px-4 py-2 text-xs font-bold text-[var(--color-cyan-dark)]\" data-kid=\"1-3-4-1-2-2-3\">\n                            Build with signal\n                        </span>\n                    </article>\n                    <article class=\"dv-reveal grid gap-8 py-9 lg:grid-cols-[1.35fr_1fr_auto] lg:items-center\" data-delay=\"180\" data-kid=\"1-3-4-1-2-3\">\n                        <div data-kid=\"1-3-4-1-2-3-1\">\n                            <p class=\"text-xs font-extrabold uppercase tracking-[.18em] text-[var(--color-cyan-dark)]\" data-kid=\"1-3-4-1-2-3-1-1\">\n                                03 / Scale\n                            </p>\n                            <h3 class=\"mt-3 text-2xl font-extrabold tracking-[-.03em] text-[var(--color-ink)]\" data-kid=\"1-3-4-1-2-3-1-2\">\n                                Grow with confidence\n                            </h3>\n                            <p class=\"mt-3 max-w-[560px] text-sm leading-7 text-[var(--color-muted)]\" data-kid=\"1-3-4-1-2-3-1-3\">\n                                Prepare for the next chapter with accountable milestones, stronger partnerships, and a founder network that travels with you.\n                            </p>\n                        </div>\n                        <div class=\"flex items-center gap-4\" data-kid=\"1-3-4-1-2-3-2\">\n                            <span class=\"h-3 w-3 shrink-0 rounded-full bg-[var(--color-orange)]\" data-kid=\"1-3-4-1-2-3-2-1\">\n                            </span>\n                            <span class=\"text-sm font-semibold text-[var(--color-muted)]\" data-kid=\"1-3-4-1-2-3-2-2\">\n                                Scale-Up → impact\n                            </span>\n                        </div>\n                        <span class=\"rounded-full border border-[var(--color-cyan)]/30 bg-[var(--color-cyan-soft)] px-4 py-2 text-xs font-bold text-[var(--color-cyan-dark)]\" data-kid=\"1-3-4-1-2-3-3\">\n                            Keep momentum\n                        </span>\n                    </article>\n                </div>\n            </div>\n        </section>\n        <section class=\"bg-[var(--color-cyan)] text-white\" data-kid=\"1-3-5\" id=\"how-it-works\">\n            <div class=\"mx-auto max-w-[1280px] px-6 py-24 lg:px-10 lg:py-28\" data-kid=\"1-3-5-1\">\n                <div class=\"flex flex-col justify-between gap-6 md:flex-row md:items-end\" data-kid=\"1-3-5-1-1\">\n                    <div data-kid=\"1-3-5-1-1-1\">\n                        <p class=\"text-xs font-extrabold uppercase tracking-[.2em] text-white/70\" data-kid=\"1-3-5-1-1-1-1\">\n                            A focused progression\n                        </p>\n                        <h2 class=\"mt-4 max-w-[650px] text-4xl font-extrabold tracking-[-.04em] sm:text-5xl\" data-kid=\"1-3-5-1-1-1-2\">\n                            Your path from idea to impact\n                        </h2>\n                    </div>\n                    <p class=\"max-w-[320px] text-sm leading-7 text-white/75\" data-kid=\"1-3-5-1-1-2\">\n                        Every cohort is designed to help you make the next useful decision — not just attend another program.\n                    </p>\n                </div>\n                <div class=\"relative mt-16 grid gap-8 md:grid-cols-3 md:gap-6\" data-kid=\"1-3-5-1-2\">\n                    <div class=\"absolute left-[16.5%] right-[16.5%] top-7 hidden h-px bg-white/40 md:block\" data-kid=\"1-3-5-1-2-1\">\n                    </div>\n                    <article class=\"dv-reveal relative\" data-delay=\"0\" data-kid=\"1-3-5-1-2-2\">\n                        <div class=\"relative z-10 grid h-14 w-14 place-items-center rounded-full bg-[var(--color-orange)] text-lg font-extrabold text-white ring-8 ring-[var(--color-cyan)]\" data-kid=\"1-3-5-1-2-2-1\">\n                            01\n                        </div>\n                        <div class=\"mt-8 rounded-2xl bg-white p-6 text-[var(--color-ink)] shadow-[0_14px_28px_rgba(0,67,103,.14)]\" data-kid=\"1-3-5-1-2-2-2\">\n                            <h3 class=\"text-xl font-extrabold\" data-kid=\"1-3-5-1-2-2-2-1\">\n                                Apply\n                            </h3>\n                            <p class=\"mt-3 text-sm leading-7 text-[var(--color-muted)]\" data-kid=\"1-3-5-1-2-2-2-2\">\n                                Tell us what you are building, who it serves, and what you need to learn next.\n                            </p>\n                        </div>\n                    </article>\n                    <article class=\"dv-reveal relative\" data-delay=\"90\" data-kid=\"1-3-5-1-2-3\">\n                        <div class=\"relative z-10 grid h-14 w-14 place-items-center rounded-full bg-[var(--color-orange)] text-lg font-extrabold text-white ring-8 ring-[var(--color-cyan)]\" data-kid=\"1-3-5-1-2-3-1\">\n                            02\n                        </div>\n                        <div class=\"mt-8 rounded-2xl bg-white p-6 text-[var(--color-ink)] shadow-[0_14px_28px_rgba(0,67,103,.14)]\" data-kid=\"1-3-5-1-2-3-2\">\n                            <h3 class=\"text-xl font-extrabold\" data-kid=\"1-3-5-1-2-3-2-1\">\n                                Build\n                            </h3>\n                            <p class=\"mt-3 text-sm leading-7 text-[var(--color-muted)]\" data-kid=\"1-3-5-1-2-3-2-2\">\n                                Move through the right learning sprint with mentors, workshops, and a peer cohort.\n                            </p>\n                        </div>\n                    </article>\n                    <article class=\"dv-reveal relative\" data-delay=\"180\" data-kid=\"1-3-5-1-2-4\">\n                        <div class=\"relative z-10 grid h-14 w-14 place-items-center rounded-full bg-[var(--color-orange)] text-lg font-extrabold text-white ring-8 ring-[var(--color-cyan)]\" data-kid=\"1-3-5-1-2-4-1\">\n                            03\n                        </div>\n                        <div class=\"mt-8 rounded-2xl bg-white p-6 text-[var(--color-ink)] shadow-[0_14px_28px_rgba(0,67,103,.14)]\" data-kid=\"1-3-5-1-2-4-2\">\n                            <h3 class=\"text-xl font-extrabold\" data-kid=\"1-3-5-1-2-4-2-1\">\n                                Scale\n                            </h3>\n                            <p class=\"mt-3 text-sm leading-7 text-[var(--color-muted)]\" data-kid=\"1-3-5-1-2-4-2-2\">\n                                Turn progress into proof, partnerships, and a stronger platform for sustainable growth.\n                            </p>\n                        </div>\n                    </article>\n                </div>\n            </div>\n        </section>\n        <section class=\"bg-white\" data-kid=\"1-3-6\" id=\"community\">\n            <div class=\"mx-auto grid max-w-[1280px] gap-14 px-6 py-24 lg:grid-cols-[1.45fr_.55fr] lg:gap-24 lg:px-10 lg:py-28\" data-kid=\"1-3-6-1\">\n                <article class=\"dv-reveal overflow-hidden rounded-[26px] bg-[var(--color-surface)]\" data-delay=\"0\" data-kid=\"1-3-6-1-1\" id=\"stories\">\n                    <div class=\"grid min-h-[350px] items-end bg-gradient-to-br from-[var(--color-cyan-soft)] via-white to-[var(--color-orange-soft)] p-7 sm:p-10\" data-kid=\"1-3-6-1-1-1\">\n                        <div class=\"max-w-[610px]\" data-kid=\"1-3-6-1-1-1-1\">\n                            <p class=\"text-xs font-extrabold uppercase tracking-[.2em] text-[var(--color-orange)]\" data-kid=\"1-3-6-1-1-1-1-1\">\n                                Inside the community\n                            </p>\n                            <h2 class=\"mt-4 text-4xl font-extrabold leading-tight tracking-[-.04em] text-[var(--color-cyan-dark)] sm:text-5xl\" data-kid=\"1-3-6-1-1-1-1-2\">\n                                Founders move further when they do the work together.\n                            </h2>\n                        </div>\n                    </div>\n                    <div class=\"p-7 sm:p-10\" data-kid=\"1-3-6-1-1-2\">\n                        <blockquote class=\"text-lg leading-8 text-[var(--color-ink)]\" data-kid=\"1-3-6-1-1-2-1\">\n                            \" DxValley gave us a clear cadence. Instead of guessing what to tackle next, we focused on customer feedback, refined our core offer, and built a foundation that held as we grew. \"\n                        </blockquote>\n                        <div class=\"mt-6 flex items-center gap-4\" data-kid=\"1-3-6-1-1-2-2\">\n                            <div class=\"grid h-12 w-12 place-items-center rounded-full bg-[var(--color-cyan-soft)] font-extrabold text-[var(--color-cyan-dark)]\" data-kid=\"1-3-6-1-1-2-2-1\">\n                                FC\n                            </div>\n                            <div data-kid=\"1-3-6-1-1-2-2-2\">\n                                <p class=\"text-sm font-bold text-[var(--color-ink)]\" data-kid=\"1-3-6-1-1-2-2-2-1\">\n                                    Founder Cohort Member\n                                </p>\n                                <p class=\"text-xs text-[var(--color-muted)]\" data-kid=\"1-3-6-1-1-2-2-2-2\">\n                                    Batch 02 Alumni\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                </article>\n                <div class=\"dv-reveal flex flex-col justify-between gap-8 rounded-[26px] border border-[var(--color-line)] bg-white p-7 sm:p-8\" data-delay=\"120\" data-kid=\"1-3-6-1-2\" id=\"eligibility\">\n                    <div data-kid=\"1-3-6-1-2-1\">\n                        <p class=\"text-xs font-extrabold uppercase tracking-[.2em] text-[var(--color-orange)]\" data-kid=\"1-3-6-1-2-1-1\">\n                            Who should apply\n                        </p>\n                        <h3 class=\"mt-3 text-2xl font-extrabold tracking-[-.03em] text-[var(--color-cyan-dark)]\" data-kid=\"1-3-6-1-2-1-2\">\n                            Is DxValley right for you?\n                        </h3>\n                        <ul class=\"mt-6 space-y-4 text-sm font-medium text-[var(--color-muted)]\" data-kid=\"1-3-6-1-2-1-3\">\n                            <li class=\"flex items-start gap-3\" data-kid=\"1-3-6-1-2-1-3-1\">\n                                <i class=\"mt-0.5 h-4 w-4 shrink-0 text-[var(--color-cyan)]\" data-kid=\"1-3-6-1-2-1-3-1-1\" data-lucide=\"check-circle-2\">\n                                </i>\n                                <span data-kid=\"1-3-6-1-2-1-3-1-2\">\n                                    Early-stage tech startups or growth-oriented MSMEs operating in Ethiopia.\n                                </span>\n                            </li>\n                            <li class=\"flex items-start gap-3\" data-kid=\"1-3-6-1-2-1-3-2\">\n                                <i class=\"mt-0.5 h-4 w-4 shrink-0 text-[var(--color-cyan)]\" data-kid=\"1-3-6-1-2-1-3-2-1\" data-lucide=\"check-circle-2\">\n                                </i>\n                                <span data-kid=\"1-3-6-1-2-1-3-2-2\">\n                                    Committed founding teams ready to engage in structured sprints.\n                                </span>\n                            </li>\n                            <li class=\"flex items-start gap-3\" data-kid=\"1-3-6-1-2-1-3-3\">\n                                <i class=\"mt-0.5 h-4 w-4 shrink-0 text-[var(--color-cyan)]\" data-kid=\"1-3-6-1-2-1-3-3-1\" data-lucide=\"check-circle-2\">\n                                </i>\n                                <span data-kid=\"1-3-6-1-2-1-3-3-2\">\n                                    Focus on real market problems with potential for scale.\n                                </span>\n                            </li>\n                        </ul>\n                    </div>\n                    <a class=\"inline-flex items-center justify-center gap-2 rounded-md bg-[var(--color-orange)] px-5 py-3 text-sm font-bold text-white transition hover:bg-[#c97019] focus:outline-none focus:ring-2 focus:ring-[var(--color-orange)] focus:ring-offset-2\" data-kid=\"1-3-6-1-2-2\" href=\"#apply\">\n                        Apply now\n                        <i class=\"h-4 w-4\" data-kid=\"1-3-6-1-2-2-1\" data-lucide=\"arrow-right\">\n                        </i>\n                    </a>\n                </div>\n            </div>\n        </section>\n        <section class=\"bg-[var(--color-surface)] border-t border-[var(--color-line)]\" data-kid=\"1-3-7\" id=\"resources\">\n            <div class=\"mx-auto max-w-[1280px] px-6 py-24 lg:px-10 lg:py-28\" data-kid=\"1-3-7-1\">\n                <div class=\"flex flex-col justify-between gap-6 md:flex-row md:items-end\" data-kid=\"1-3-7-1-1\">\n                    <div data-kid=\"1-3-7-1-1-1\">\n                        <p class=\"text-xs font-extrabold uppercase tracking-[.2em] text-[var(--color-orange)]\" data-kid=\"1-3-7-1-1-1-1\">\n                            Founder toolkit\n                        </p>\n                        <h2 class=\"mt-4 text-4xl font-extrabold tracking-[-.04em] text-[var(--color-cyan-dark)] sm:text-5xl\" data-kid=\"1-3-7-1-1-1-2\">\n                            Resources for the journey\n                        </h2>\n                    </div>\n                    <a class=\"text-sm font-bold text-[var(--color-cyan-dark)] underline underline-offset-4 transition hover:text-[var(--color-orange)]\" data-kid=\"1-3-7-1-1-2\" href=\"#all-resourc