      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,500;0,600;0,700;0,800;1,500&family=Space+Grotesk:wght@400;500;600;700&display=swap');\n</style>\n<link data-kid=\"1\" data-name=\"font awesome stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\" rel=\"stylesheet\"/>\n<div class=\"min-h-[1030px] bg-black font-sans text-white\" data-kid=\"2\" data-name=\"page layout container\">\n    <header class=\"border-b border-slate-200 bg-white text-slate-950\" data-kid=\"2-1\" data-name=\"header section\">\n        <div class=\"bg-[#00ADEF] text-white\" data-kid=\"2-1-1\" data-name=\"utility top bar\">\n            <div class=\"mx-auto flex max-w-[1216px] items-center justify-between gap-6 px-8 py-2.5 text-[12px] font-semibold tracking-wide\" data-kid=\"2-1-1-1\" data-name=\"utility navigation and social container\">\n                <nav aria-label=\"Utility navigation\" class=\"flex items-center gap-6 whitespace-nowrap\" data-kid=\"2-1-1-1-1\" data-name=\"utility navigation links\">\n                    <a class=\"opacity-95\" data-kid=\"2-1-1-1-1-1\" data-name=\"faq link\" href=\"#faq\">\n                        FAQ\n                    </a>\n                    <a class=\"opacity-95\" data-kid=\"2-1-1-1-1-2\" data-name=\"events link\" href=\"#events\">\n                        Events\n                    </a>\n                    <a class=\"opacity-95\" data-kid=\"2-1-1-1-1-3\" data-name=\"stories link\" href=\"#stories\">\n                        Stories\n                    </a>\n                    <a class=\"opacity-95\" data-kid=\"2-1-1-1-1-4\" data-name=\"partners link\" href=\"#partners\">\n                        Partners\n                    </a>\n                    <a class=\"opacity-95\" data-kid=\"2-1-1-1-1-5\" data-name=\"contact link\" href=\"#contact\">\n                        Contact\n                    </a>\n                </nav>\n                <div aria-label=\"Social links\" class=\"flex items-center gap-2.5\" data-kid=\"2-1-1-1-2\" data-name=\"social media links container\">\n                    <a aria-label=\"LinkedIn\" class=\"grid h-7 w-7 place-items-center rounded-full border border-white/45 text-[12px]\" data-kid=\"2-1-1-1-2-1\" data-name=\"linkedin link\" href=\"#linkedin\">\n                        <i aria-hidden=\"true\" class=\"fa-brands fa-linkedin-in\" data-kid=\"2-1-1-1-2-1-1\" data-name=\"linkedin icon\">\n                        </i>\n                    </a>\n                    <a aria-label=\"YouTube\" class=\"grid h-7 w-7 place-items-center rounded-full border border-white/45 text-[11px]\" data-kid=\"2-1-1-1-2-2\" data-name=\"youtube link\" href=\"#youtube\">\n                        <i aria-hidden=\"true\" class=\"fa-brands fa-youtube\" data-kid=\"2-1-1-1-2-2-1\" data-name=\"youtube icon\">\n                        </i>\n                    </a>\n                    <a aria-label=\"Instagram\" class=\"grid h-7 w-7 place-items-center rounded-full border border-white/45 text-[12px]\" data-kid=\"2-1-1-1-2-3\" data-name=\"instagram link\" href=\"#instagram\">\n                        <i aria-hidden=\"true\" class=\"fa-brands fa-instagram\" data-kid=\"2-1-1-1-2-3-1\" data-name=\"instagram icon\">\n                        </i>\n                    </a>\n                </div>\n            </div>\n        </div>\n        <div class=\"mx-auto max-w-[1216px] px-8\" data-kid=\"2-1-2\" data-name=\"header content container\">\n            <div class=\"flex min-h-[88px] items-center justify-between gap-8 py-4\" data-kid=\"2-1-2-1\" data-name=\"header main row\">\n                <div class=\"flex min-w-0 items-center gap-5\" data-kid=\"2-1-2-1-1\" data-name=\"brand and partner branding container\">\n                    <a aria-label=\"DxValley home\" class=\"shrink-0\" data-kid=\"2-1-2-1-1-1\" data-name=\"home link\" href=\"#home\">\n                        <img alt=\"DxValley Incubation Center\" class=\"h-12 w-[214px] object-contain object-left mix-blend-multiply\" data-kid=\"2-1-2-1-1-1-1\" data-name=\"dxvalley wordmark logo\" decoding=\"async\" loading=\"eager\" src=\"/api/local/images/Website/public/brand/dxvalley-wordmark.jpeg\"/>\n                    </a>\n                    <span aria-hidden=\"true\" class=\"h-10 w-px bg-slate-200\" data-kid=\"2-1-2-1-1-2\" data-name=\"vertical separator\">\n                    </span>\n                    <div class=\"text-[11px] font-semibold uppercase leading-[1.35] tracking-[0.18em] text-slate-500\" data-kid=\"2-1-2-1-1-3\" data-name=\"incubation arm branding text\">\n                        Incubation arm of\n                        <br data-kid=\"2-1-2-1-1-3-1\" data-name=\"line break\"/>\n                        <span class=\"text-[#006F9E]\" data-kid=\"2-1-2-1-1-3-2\" data-name=\"partner bank name\">\n                            Cooperative Bank of Oromia\n                        </span>\n                    </div>\n                </div>\n                <div class=\"flex items-center gap-5\" data-kid=\"2-1-2-1-2\" data-name=\"search and apply actions\">\n                    <div class=\"relative flex h-11 w-[205px] items-center rounded-full border border-slate-200 bg-slate-50 pl-4 pr-3 text-[12px] text-slate-400\" data-kid=\"2-1-2-1-2-1\" data-name=\"search input field wrapper\">\n                        <i aria-hidden=\"true\" class=\"fa-solid fa-magnifying-glass mr-3 text-[12px] text-slate-500\" data-kid=\"2-1-2-1-2-1-1\" data-name=\"search icon\">\n                        </i>\n                        <span data-kid=\"2-1-2-1-2-1-2\" data-name=\"search label text\">\n                            Search DxValley\n                        </span>\n                    </div>\n                    <a class=\"inline-flex items-center gap-2 rounded-full bg-[#E38524] px-6 py-3 text-[14px] font-extrabold text-white shadow-[0_2px_3px_rgba(141,67,10,.24)]\" data-kid=\"2-1-2-1-2-2\" data-name=\"apply now button\" href=\"#apply\">\n                        Apply now\n                        <i aria-hidden=\"true\" class=\"fa-solid fa-arrow-up-right-from-square text-[11px]\" data-kid=\"2-1-2-1-2-2-1\" data-name=\"arrow icon\">\n                        </i>\n                    </a>\n                </div>\n            </div>\n            <div class=\"border-t border-slate-200 py-4\" data-kid=\"2-1-2-2\" data-name=\"main navigation row\">\n                <nav aria-label=\"Main navigation\" class=\"flex items-center justify-end gap-9 text-[15px] font-semibold\" data-kid=\"2-1-2-2-1\" data-name=\"main navigation links\">\n                    <a data-kid=\"2-1-2-2-1-1\" data-name=\"about dxvalley link\" href=\"#about\">\n                        About DxValley\n                    </a>\n                    <a data-kid=\"2-1-2-2-1-2\" data-name=\"programs link\" href=\"#programs\">\n                        Programs\n                    </a>\n                    <a data-kid=\"2-1-2-2-1-3\" data-name=\"how it works link\" href=\"#how-it-works\">\n                        How it works\n                    </a>\n                    <a data-kid=\"2-1-2-2-1-4\" data-name=\"community link\" href=\"#community\">\n                        Community\n                    </a>\n                    <a data-kid=\"2-1-2-2-1-5\" data-name=\"resources link\" href=\"#resources\">\n                        Resources\n                    </a>\n                </nav>\n            </div>\n        </div>\n        <div class=\"mx-auto flex max-w-[1216px] items-center justify-end gap-3 px-8 pb-3 text-[13px] font-semibold\" data-kid=\"2-1-3\" data-name=\"header auth actions\">\n            <a class=\"text-slate-500\" data-kid=\"2-1-3-1\" data-name=\"log in link\" href=\"#login\">\n                Log in\n            </a>\n            <a class=\"rounded-md border border-[#00ADEF] px-4 py-2 font-bold text-[#006F9E]\" data-kid=\"2-1-3-2\" data-name=\"sign up link\" href=\"#signup\">\n                Sign up\n            </a>\n        </div>\n    </header>\n    <main class=\"min-h-[802px] bg-black\" data-kid=\"2-2\" data-name=\"main content area\">\n        <div class=\"mx-auto grid min-h-[802px] max-w-[1040px] grid-cols-[1fr_490px] items-center gap-[78px] px-8 py-12\" data-kid=\"2-2-1\" data-name=\"hero section container\">\n            <section class=\"pb-5\" data-kid=\"2-2-1-1\" data-name=\"hero text content\">\n                <p class=\"mb-4 font-display text-[16px] font-bold uppercase tracking-[0.18em] text-[#00ADEF]\" data-kid=\"2-2-1-1-1\" data-name=\"hero pre-headline text\">\n                    Get started\n                </p>\n                <h1 class=\"font-display text-[62px] font-bold uppercase leading-[0.94] tracking-[-0.065em] text-white\" data-kid=\"2-2-1-1-2\" data-name=\"hero headline\">\n                    Create your\n                    <br data-kid=\"2-2-1-1-2-1\" data-name=\"headline line break\"/>\n                    <span class=\"text-[#E38524]\" data-kid=\"2-2-1-1-2-2\" data-name=\"headline accent text\">\n                        account\n                    </span>\n                </h1>\n                <p class=\"mt-9 max-w-[500px] border-l-[5px] border-[#00ADEF] pl-7 font-sans text-[20px] italic leading-[1.55] text-slate-400\" data-kid=\"2-2-1-1-3\" data-name=\"hero subheadline description\">\n                    Join the incubator platform to track milestones, access resources, and connect with technical wizards.\n                </p>\n            </section>\n            <section class=\"border-4 border-black bg-white p-10 text-black shadow-[8px_8px_0_#000]\" data-kid=\"2-2-1-2\" data-name=\"sign-up form container\">\n                <form action=\"#create-account\" class=\"space-y-6\" data-kid=\"2-2-1-2-1\" data-name=\"create account form\" method=\"post\">\n                    <div data-kid=\"2-2-1-2-1-1\" data-name=\"full name input group\">\n                        <label class=\"mb-2 block font-display text-[12px] font-bold uppercase tracking-[0.16em] text-slate-500\" data-kid=\"2-2-1-2-1-1-1\" data-name=\"full name label\" for=\"signup-name\">\n                            Full name\n                        </label>\n                        <input class=\"h-16 w-full border-4 border-black bg-slate-50 px-5 font-sans text-[18px] font-bold text-black outline-none placeholder:text-slate-300\" data-kid=\"2-2-1-2-1-1-2\" data-name=\"full name input\" id=\"signup-name\" name=\"name\" placeholder=\"YOUR NAME\" type=\"text\"/>\n                    </div>\n                    <div data-kid=\"2-2-1-2-1-2\" data-name=\"email input group\">\n                        <label class=\"mb-2 block font-display text-[12px] font-bold uppercase tracking-[0.16em] text-slate-500\" data-kid=\"2-2-1-2-1-2-1\" data-name=\"email label\" for=\"signup-email\">\n                            Email address\n                        </label>\n                        <input class=\"h-16 w-full border-4 border-black bg-slate-50 px-5 font-sans text-[18px] font-bold text-black outline-none placeholder:text-slate-300\" data-kid=\"2-2-1-2-1-2-2\" data-name=\"email input\" id=\"signup-email\" name=\"email\" placeholder=\"YOU@EXAMPLE.COM\" type=\"email\"/>\n                    </div>\n                    <div data-kid=\"2-2-1-2-1-3\" data-name=\"password input group\">\n                        <label class=\"mb-2 block font-display text-[12px] font-bold uppercase tracking-[0.16em] text-slate-500\" data-kid=\"2-2-1-2-1-3-1\" data-name=\"password label\" for=\"signup-password\">\n                            Password\n                        </label>\n                        <input class=\"h-16 w-full border-4 border-black bg-slate-50 px-5 font-sans text-[18px] font-bold text-black outline-none placeholder:text-slate-400\" data-kid=\"2-2-1-2-1-3-2\" data-name=\"password input\" id=\"signup-password\" name=\"password\" placeholder=\"********\" type=\"password\"/>\n                    </div>\n                    <div data-kid=\"2-2-1-2-1-4\" data-name=\"confirm password input group\">\n                        <label class=\"mb-2 block font-display text-[12px] font-bold uppercase tracking-[0.16em] text-slate-500\" data-kid=\"2-2-1-2-1-4-1\" data-name=\"confirm password label\" for=\"signup-confirm\">\n                            Confirm password\n                        </label>\n                        <input class=\"h-16 w-full border-4 border-black bg-slate-50 px-5 font-sans text-[18px] font-bold text-black outline-none placeholder:text-slate-400\" data-kid=\"2-2-1-2-1-4-2\" data-name=\"confirm password input\" id=\"signup-confirm\" name=\"confirmPassword\" placeholder=\"********\" type=\"password\"/>\n                    </div>\n                    <label class=\"flex cursor-pointer items-start gap-3 pt-1 text-[15px] font-bold leading-6 text-slate-600\" data-kid=\"2-2-1-2-1-5\" data-name=\"terms agreement checkbox group\" for=\"terms\">\n                        <input class=\"mt-1 h-5 w-5 accent-[#00ADEF]\" data-kid=\"2-2-1-2-1-5-1\" data-name=\"terms checkbox input\" id=\"terms\" type=\"checkbox\"/>\n                        <span data-kid=\"2-2-1-2-1-5-2\" data-name=\"terms agreement text\">\n                            I agree to the Terms of Service and Privacy Policy.\n                        </span>\n                    </label>\n                    <button class=\"h-[68px] w-full border-4 border-black bg-[#00ADEF] font-display text-[21px] font-bold uppercase tracking-[0.13em] text-white shadow-[7px_7px_0_#000]\" data-kid=\"2-2-1-2-1-6\" data-name=\"submit form button\" type=\"submit\">\n                        Create Account\n                    </button>\n                    <p class=\"pt-1 text-center font-sans text-[15px] font-bold uppercase tracking-[-0.01em] text-slate-500\" data-kid=\"2-2-1-2-1-7\" data-name=\"login redirect link container\">\n                        Already have an account?\n                        <a class=\"ml-1 text-[#00ADEF] underline underline-offset-2\" data-kid=\"2-2-1-2-1-7-1\" data-name=\"login redirect link\" href=\"#login\">\n                            Sign in\n                        </a>\n                    </p>\n                </form>\n            </section>\n        </div>\n    </main>\n</div>\n",
