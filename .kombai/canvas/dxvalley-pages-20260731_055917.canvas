      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,400;0,14..32,500;0,14..32,600;0,14..32,700;0,14..32,800&family=Space+Grotesk:wght@400;500;600;700&display=swap');\n  @import url('https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css');\n  .dv-ring-left { border: 70px solid rgba(255,255,255,.10); border-radius: 48%; transform: rotate(-9deg); }\n  .dv-ring-right { border: 90px solid rgba(255,255,255,.10); border-radius: 50%; transform: rotate(14deg); }\n  .dv-hero-noise { background: radial-gradient(circle at 74% 28%, rgba(255,255,255,.12), transparent 26%), radial-gradient(circle at 91% 80%, rgba(255,255,255,.10), transparent 18%); }\n  .dv-dashboard-grid { background-image: linear-gradient(rgba(255,255,255,.08) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.08) 1px, transparent 1px); background-size: 38px 38px; }\n</style>\n<div class=\"min-h-screen bg-white font-sans text-[#111827]\" data-kid=\"1\">\n    <header class=\"border-b border-[#D6E4EA] bg-white\" data-kid=\"1-1\">\n        <div class=\"bg-[#00ADEF] text-white\" data-kid=\"1-1-1\">\n            <div class=\"mx-auto flex max-w-7xl items-center justify-between gap-6 px-10 py-2 text-[11px] font-semibold tracking-wide\" data-kid=\"1-1-1-1\">\n                <nav aria-label=\"Utility navigation\" class=\"flex items-center gap-5 whitespace-nowrap\" data-kid=\"1-1-1-1-1\">\n                    <a class=\"opacity-90 hover:underline\" data-kid=\"1-1-1-1-1-1\" href=\"#faq\">\n                        FAQ\n                    </a>\n                    <a class=\"opacity-90 hover:underline\" data-kid=\"1-1-1-1-1-2\" href=\"#events\">\n                        Events\n                    </a>\n                    <a class=\"opacity-90 hover:underline\" data-kid=\"1-1-1-1-1-3\" href=\"#stories\">\n                        Stories\n                    </a>\n                    <a class=\"opacity-90 hover:underline\" data-kid=\"1-1-1-1-1-4\" href=\"#partners\">\n                        Partners\n                    </a>\n                    <a class=\"opacity-90 hover:underline\" data-kid=\"1-1-1-1-1-5\" href=\"mailto:hello@dxvalley.com\">\n                        Contact\n                    </a>\n                </nav>\n                <div aria-label=\"Social links\" class=\"flex items-center gap-2\" data-kid=\"1-1-1-1-2\">\n                    <a aria-label=\"LinkedIn\" class=\"grid h-7 w-7 place-items-center rounded-full border border-white/40 hover:bg-white hover:text-[#00ADEF]\" data-kid=\"1-1-1-1-2-1\" href=\"#linkedin\">\n                        <i class=\"fa-brands fa-linkedin-in text-[12px] text-current\" data-kid=\"1-1-1-1-2-1-1\">\n                        </i>\n                    </a>\n                    <a aria-label=\"YouTube\" class=\"grid h-7 w-7 place-items-center rounded-full border border-white/40 hover:bg-white hover:text-[#00ADEF]\" data-kid=\"1-1-1-1-2-2\" href=\"#youtube\">\n                        <i class=\"fa-brands fa-youtube text-[12px] text-current\" data-kid=\"1-1-1-1-2-2-1\">\n                        </i>\n                    </a>\n                    <a aria-label=\"Instagram\" class=\"grid h-7 w-7 place-items-center rounded-full border border-white/40 hover:bg-white hover:text-[#00ADEF]\" data-kid=\"1-1-1-1-2-3\" href=\"#instagram\">\n                        <i class=\"fa-brands fa-instagram text-[12px] text-current\" data-kid=\"1-1-1-1-2-3-1\">\n                        </i>\n                    </a>\n                </div>\n            </div>\n        </div>\n        <div class=\"mx-auto max-w-7xl px-10\" data-kid=\"1-1-2\">\n            <div class=\"flex min-h-[88px] items-center justify-between gap-8 py-4\" data-kid=\"1-1-2-1\">\n                <div class=\"flex min-w-0 items-center gap-5\" data-kid=\"1-1-2-1-1\">\n                    <a aria-label=\"DxValley home\" class=\"shrink-0\" data-kid=\"1-1-2-1-1-1\" href=\"#top\">\n                        <img alt=\"DxValley Incubation Center\" class=\"h-12 w-[210px] object-contain object-left mix-blend-multiply\" data-kid=\"1-1-2-1-1-1-1\" decoding=\"async\" loading=\"eager\" src=\"/api/local/images/Website/public/brand/dxvalley-wordmark.jpeg\"/>\n                    </a>\n                    <div class=\"h-9 w-px bg-[#D6E4EA]\" data-kid=\"1-1-2-1-1-2\">\n                    </div>\n                    <div class=\"text-[10px] font-semibold uppercase leading-tight tracking-[.16em] text-[#526274]\" data-kid=\"1-1-2-1-1-3\">\n                        Incubation arm of\n                        <br data-kid=\"1-1-2-1-1-3-1\"/>\n                        <span class=\"text-[#006F9E]\" data-kid=\"1-1-2-1-1-3-2\">\n                            Cooperative Bank of Oromia\n                        </span>\n                    </div>\n                </div>\n                <div class=\"flex items-center gap-4\" data-kid=\"1-1-2-1-2\">\n                    <div class=\"flex h-10 w-[200px] items-center gap-3 rounded-full border border-[#D6E4EA] bg-[#F6FAFC] px-4 text-xs text-[#526274]\" data-kid=\"1-1-2-1-2-1\">\n                        <i class=\"fa-solid fa-magnifying-glass text-[12px] text-[#526274]\" data-kid=\"1-1-2-1-2-1-1\">\n                        </i>\n                        <span data-kid=\"1-1-2-1-2-1-2\">\n                            Search DxValley\n                        </span>\n                    </div>\n                    <a class=\"inline-flex items-center gap-2 rounded-full bg-[#E38524] px-5 py-2.5 text-sm font-bold text-white shadow-sm hover:bg-[#C97019]\" data-kid=\"1-1-2-1-2-2\" href=\"#apply\">\n                        Apply now\n                        <i class=\"fa-solid fa-arrow-up-right-from-square text-[12px] text-white\" data-kid=\"1-1-2-1-2-2-1\">\n                        </i>\n                    </a>\n                </div>\n            </div>\n            <div class=\"border-t border-[#D6E4EA] py-4\" data-kid=\"1-1-2-2\">\n                <nav aria-label=\"Main navigation\" class=\"flex items-center justify-end gap-8 text-sm font-semibold text-[#111827]\" data-kid=\"1-1-2-2-1\">\n                    <a class=\"hover:text-[#006F9E]\" data-kid=\"1-1-2-2-1-1\" href=\"#about\">\n                        About DxValley\n                    </a>\n                    <a class=\"hover:text-[#006F9E]\" data-kid=\"1-1-2-2-1-2\" href=\"#programs\">\n                        Programs\n                    </a>\n                    <a class=\"hover:text-[#006F9E]\" data-kid=\"1-1-2-2-1-3\" href=\"#how-it-works\">\n                        How it works\n                    </a>\n                    <a class=\"hover:text-[#006F9E]\" data-kid=\"1-1-2-2-1-4\" href=\"#community\">\n                        Community\n                    </a>\n                    <a class=\"hover:text-[#006F9E]\" data-kid=\"1-1-2-2-1-5\" href=\"#resources\">\n                        Resources\n                    </a>\n                </nav>\n            </div>\n        </div>\n        <div class=\"mx-auto flex max-w-7xl items-center justify-end gap-3 px-10 pb-3 text-xs\" data-kid=\"1-1-3\">\n            <a class=\"font-semibold text-[#526274] hover:text-[#006F9E]\" data-kid=\"1-1-3-1\" href=\"#login\">\n                Log in\n            </a>\n            <a class=\"rounded-md border border-[#00ADEF] px-3 py-2 font-bold text-[#006F9E] hover:bg-[#EAF8FC]\" data-kid=\"1-1-3-2\" href=\"#signup\">\n                Sign up\n            </a>\n        </div>\n    </header>\n    <main data-kid=\"1-2\" id=\"top\">\n        <section class=\"relative overflow-hidden bg-gradient-to-br from-[#00ADEF] via-[#078CC8] to-[#0878B4] text-white\" data-kid=\"1-2-1\">\n            <div class=\"dv-hero-noise pointer-events-none absolute inset-0\" data-kid=\"1-2-1-1\">\n            </div>\n            <div class=\"dv-ring-left pointer-events-none absolute -left-24 -top-20 h-[460px] w-[620px]\" data-kid=\"1-2-1-2\">\n            </div>\n            <div class=\"dv-ring-right pointer-events-none absolute -bottom-[240px] -right-40 h-[620px] w-[760px]\" data-kid=\"1-2-1-3\">\n            </div>\n            <div class=\"pointer-events-none absolute right-[28%] top-14 h-20 w-20 rounded-full bg-white/10 blur-xl\" data-kid=\"1-2-1-4\">\n            </div>\n            <div class=\"pointer-events-none absolute bottom-[-80px] right-[6%] h-[290px] w-[290px] rounded-full border-[48px] border-white/10\" data-kid=\"1-2-1-5\">\n            </div>\n            <div class=\"relative mx-auto grid min-h-[560px] max-w-7xl items-center gap-16 px-10 py-24 lg:grid-cols-[1.06fr_.94fr]\" data-kid=\"1-2-1-6\">\n                <div class=\"max-w-[680px]\" data-kid=\"1-2-1-6-1\">\n                    <p class=\"mb-5 inline-flex items-center gap-3 text-xs font-bold uppercase tracking-[.24em] text-white/80\" data-kid=\"1-2-1-6-1-1\">\n                        <span class=\"h-2.5 w-2.5 rounded-full bg-[#E38524]\" data-kid=\"1-2-1-6-1-1-1\">\n                        </span>\n                        DxValley Incubation Center\n                    </p>\n                    <h1 class=\"max-w-[700px] font-display text-7xl font-extrabold leading-[1.02] tracking-[-.055em] text-white\" data-kid=\"1-2-1-6-1-2\">\n                        Build what\n                        <br data-kid=\"1-2-1-6-1-2-1\"/>\n                        <span class=\"text-white/75\" data-kid=\"1-2-1-6-1-2-2\">\n                            Ethiopia needs.\n                        </span>\n                    </h1>\n                    <p class=\"mt-7 max-w-[610px] text-xl leading-8 text-white/85\" data-kid=\"1-2-1-6-1-3\">\n                        We help bold ideas become investable, scalable businesses through structured cohorts, expert mentorship, and a community that keeps founders moving.\n                    </p>\n                    <div class=\"mt-9 flex items-center gap-3\" data-kid=\"1-2-1-6-1-4\">\n                        <a class=\"inline-flex items-center gap-3 rounded-md bg-[#E38524] px-6 py-3.5 text-sm font-extrabold text-white shadow-[0_10px_24px_rgba(141,67,10,.24)] hover:bg-[#C97019]\" data-kid=\"1-2-1-6-1-4-1\" href=\"#apply\">\n                            Apply to the next cohort\n                            <i class=\"fa-solid fa-arrow-right text-[12px] text-white\" data-kid=\"1-2-1-6-1-4-1-1\">\n                            </i>\n                        </a>\n                        <a class=\"inline-flex items-center gap-3 rounded-md border border-white/70 bg-white/5 px-6 py-3.5 text-sm font-bold text-white hover:bg-white hover:text-[#0878B4]\" data-kid=\"1-2-1-6-1-4-2\" href=\"#programs\">\n                            Explore programs\n                            <i class=\"fa-solid fa-chevron-right text-[12px] text-current\" data-kid=\"1-2-1-6-1-4-2-1\">\n                            </i>\n                        </a>\n                    </div>\n                </div>\n                <div class=\"relative justify-self-end\" data-kid=\"1-2-1-6-2\">\n                    <div class=\"dv-dashboard-grid relative w-[520px] rounded-[28px] border border-white/30 bg-white/10 p-7 shadow-[0_22px_70px_rgba(0,63,102,.25)] backdrop-blur-md\" data-kid=\"1-2-1-6-2-1\">\n                        <div class=\"flex items-start justify-between gap-4 border-b border-white/20 pb-6\" data-kid=\"1-2-1-6-2-1-1\">\n                            <div data-kid=\"1-2-1-6-2-1-1-1\">\n                                <p class=\"text-xs font-bold uppercase tracking-[.2em] text-white/65\" data-kid=\"1-2-1-6-2-1-1-1-1\">\n                                    Founder dashboard\n                                </p>\n                                <p class=\"mt-2 font-display text-2xl font-bold\" data-kid=\"1-2-1-6-2-1-1-1-2\">\n                                    Make the next move.\n                                </p>\n                            </div>\n                            <span class=\"rounded-full bg-white/15 px-3 py-1 text-[10px] font-bold uppercase tracking-wider text-white/80\" data-kid=\"1-2-1-6-2-1-1-2\">\n                                Batch 04\n                            </span>\n                        </div>\n                        <div class=\"grid grid-cols-3 gap-3 py-6\" data-kid=\"1-2-1-6-2-1-2\">\n                            <div class=\"rounded-xl bg-white/10 p-4\" data-kid=\"1-2-1-6-2-1-2-1\">\n                                <p class=\"font-display text-2xl font-extrabold\" data-kid=\"1-2-1-6-2-1-2-1-1\">\n                                    03\n                                </p>\n                                <p class=\"mt-1 text-xs text-white/70\" data-kid=\"1-2-1-6-2-1-2-1-2\">\n                                    Growth stages\n                                </p>\n                            </div>\n                            <div class=\"rounded-xl bg-white/10 p-4\" data-kid=\"1-2-1-6-2-1-2-2\">\n                                <p class=\"font-display text-2xl font-extrabold\" data-kid=\"1-2-1-6-2-1-2-2-1\">\n                                    02\n                                </p>\n                                <p class=\"mt-1 text-xs text-white/70\" data-kid=\"1-2-1-6-2-1-2-2-2\">\n                                    Cohort tracks\n                                </p>\n                            </div>\n                            <div class=\"rounded-xl bg-white/10 p-4\" data-kid=\"1-2-1-6-2-1-2-3\">\n                                <p class=\"font-display text-2xl font-extrabold\" data-kid=\"1-2-1-6-2-1-2-3-1\">\n                                    01\n                                </p>\n                                <p class=\"mt-1 text-xs text-white/70\" data-kid=\"1-2-1-6-2-1-2-3-2\">\n                                    Founder network\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"flex items-center justify-between rounded-xl bg-white p-4 text-[#111827]\" data-kid=\"1-2-1-6-2-1-3\">\n                            <div data-kid=\"1-2-1-6-2-1-3-1\">\n                                <p class=\"text-[10px] font-bold uppercase tracking-[.16em] text-[#006F9E]\" data-kid=\"1-2-1-6-2-1-3-1-1\">\n                                    Current focus\n                                </p>\n                                <p class=\"mt-1 text-sm font-bold\" data-kid=\"1-2-1-6-2-1-3-1-2\">\n                                    Validate your market\n                                </p>\n                            </div>\n                            <span class=\"grid h-9 w-9 place-items-center rounded-full bg-[#FFF1E3] text-[#E38524]\" data-kid=\"1-2-1-6-2-1-3-2\">\n                                <i class=\"fa-solid fa-wand-magic-sparkles text-[14px] text-[#E38524]\" data-kid=\"1-2-1-6-2-1-3-2-1\">\n                                </i>\n                            </span>\n                        </div>\n                        <div class=\"absolute -bottom-8 -left-6 flex items-center gap-3 rounded-2xl bg-white p-3 text-[#111827] shadow-[0_18px_40px_rgba(0,63,102,.22)]\" data-kid=\"1-2-1-6-2-1-4\">\n                            <img alt=\"DxValley\" class=\"h-10 w-[118px] object-contain object-left mix-blend-multiply\" data-kid=\"1-2-1-6-2-1-4-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/Website/public/brand/dxvalley-wordmark.jpeg\"/>\n                            <span class=\"h-8 w-px bg-[#D6E4EA]\" data-kid=\"1-2-1-6-2-1-4-2\">\n                            </span>\n                            <span class=\"pr-2 text-[10px] font-bold uppercase tracking-wider text-[#526274]\" data-kid=\"1-2-1-6-2-1-4-3\">\n                                For founders\n                                <br data-kid=\"1-2-1-6-2-1-4-3-1\"/>\n                                with momentum\n                            </span>\n                        </div>\n                    </div>\n                    <img alt=\"\" aria-hidden=\"true\" class=\"pointer-events-none absolute -bottom-12 -right-12 h-40 w-40 object-contain opacity-[.12] mix-blend-screen\" data-kid=\"1-2-1-6-2-2\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/Website/public/brand/coopbank-mark.jpeg\"/>\n                </div>\n            </div>\n        </section>\n        <section aria-label=\"Batch 04 application status\" class=\"border-b border-[#D6E4EA] bg-[#EAF8FC]\" data-dynamic=\"true\" data-kid=\"1-2-2\" data-name=\"application countdown timer\" data-reason=\"text values for days, hours, minutes, and seconds updated by script\">\n            <div class=\"mx-auto grid max-w-7xl grid-cols-[1.1fr_1.5fr_auto] items-center gap-8 px-10 py-7\" data-kid=\"1-2-2-1\">\n                <div data-kid=\"1-2-2-1-1\">\n                    <p class=\"text-xs font-extrabold uppercase tracking-[.18em] text-[#006F9E]\" data-kid=\"1-2-2-1-1-1\">\n                        Batch 04 applications open\n                    </p>\n                    <p class=\"mt-2 text-sm font-semibold text-[#111827]\" data-kid=\"1-2-2-1-1-2\">\n                        Closes 30 September 2026\n                    </p>\n                </div>\n                <div class=\"grid grid-cols-4 gap-4\" data-kid=\"1-2-2-1-2\">\n                    <div class=\"border-l-2 border-[#00ADEF] pl-3\" data-kid=\"1-2-2-1-2-1\">\n                        <p class=\"font-display text-3xl font-extrabold text-[#006F9E]\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2-1-1\" data-name=\"days remaining count\" data-reason=\"text replaced by countdown script\">\n                            61\n                        </p>\n                        <p class=\"text-[10px] font-bold uppercase tracking-wider text-[#526274]\" data-kid=\"1-2-2-1-2-1-2\">\n                            Days\n                        </p>\n                    </div>\n                    <div class=\"border-l-2 border-[#00ADEF] pl-3\" data-kid=\"1-2-2-1-2-2\">\n                        <p class=\"font-display text-3xl font-extrabold text-[#006F9E]\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2-2-1\" data-name=\"hours remaining count\" data-reason=\"text replaced by countdown script\">\n                            14\n                        </p>\n                        <p class=\"text-[10px] font-bold uppercase tracking-wider text-[#526274]\" data-kid=\"1-2-2-1-2-2-2\">\n                            Hours\n                        </p>\n                    </div>\n                    <div class=\"border-l-2 border-[#00ADEF] pl-3\" data-kid=\"1-2-2-1-2-3\">\n                        <p class=\"font-display text-3xl font-extrabold text-[#006F9E]\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2-3-1\" data-name=\"minutes remaining count\" data-reason=\"text replaced by countdown script\">\n                            59\n                        </p>\n                        <p class=\"text-[10px] font-bold uppercase tracking-wider text-[#526274]\" data-kid=\"1-2-2-1-2-3-2\">\n                            Minutes\n                        </p>\n                    </div>\n                    <div class=\"border-l-2 border-[#00ADEF] pl-3\" data-kid=\"1-2-2-1-2-4\">\n                        <p class=\"font-display text-3xl font-extrabold text-[#006F9E]\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2-4-1\" data-name=\"seconds remaining count\" data-reason=\"text replaced by countdown script\">\n                            53\n                        </p>\n                        <p class=\"text-[10px] font-bold uppercase tracking-wider text-[#526274]\" data-kid=\"1-2-2-1-2-4-2\">\n                            Seconds\n                        </p>\n                    </div>\n                </div>\n                <a class=\"inline-flex items-center gap-2 text-sm font-bold text-[#006F9E] hover:text-[#E38524]\" data-kid=\"1-2-2-1-3\" href=\"#programs\">\n                    View eligibility\n                    <i class=\"fa-solid fa-arrow-up-right-from-square text-[12px] text-current\" data-kid=\"1-2-2-1-3-1\">\n                    </i>\n                </a>\n            </div>\n        </section>\n        <section class=\"bg-white\" data-kid=\"1-2-3\" id=\"about\">\n            <div class=\"mx-auto grid max-w-7xl grid-cols-[1.05fr_.95fr] gap-24 px-10 py-28\" data-kid=\"1-2-3-1\">\n                <div data-kid=\"1-2-3-1-1\">\n                    <p class=\"text-xs font-extrabold uppercase tracking-[.2em] text-[#E38524]\" data-kid=\"1-2-3-1-1-1\">\n                        A practical place to start\n                    </p>\n                    <h2 class=\"mt-4 max-w-[590px] font-display text-5xl font-extrabold leading-tight tracking-[-.04em] text-[#006F9E]\" data-kid=\"1-2-3-1-1-2\">\n                        A launchpad for ambitious founders\n                    </h2>\n                    <p class=\"mt-7 max-w-[610px] text-base leading-8 text-[#526274]\" data-kid=\"1-2-3-1-1-3\">\n                        DxValley is the incubation arm of Cooperative Bank of Oromia, built for founders solving real problems. We support startups and MSME growth cohorts with a focused progression from Idea to MVP to Scale-Up.\n                    </p>\n                    <p class=\"mt-4 max-w-[610px] text-base leading-8 text-[#526274]\" data-kid=\"1-2-3-1-1-4\">\n                        No noise, no one-size-fits-all playbook — just the right people, practical tools, and accountable momentum for the stage you are in.\n                    </p>\n                    <a class=\"mt-8 inline-flex items-center gap-3 rounded-md bg-[#00ADEF] px-5 py-3 text-sm font-bold text-white hover:bg-[#006F9E]\" data-kid=\"1-2-3-1-1-5\" href=\"#community\">\n                        Learn about DxValley\n                        <i class=\"fa-solid fa-arrow-right text-[12px] text-white\" data-kid=\"1-2-3-1-1-5-1\">\n                        </i>\n                    </a>\n                </div>\n                <div data-kid=\"1-2-3-1-2\" id=\"announcements\">\n                    <div class=\"mb-5 flex items-end justify-between gap-5\" data-kid=\"1-2-3-1-2-1\">\n                        <div data-kid=\"1-2-3-1-2-1-1\">\n                            <p class=\"text-xs font-extrabold uppercase tracking-[.2em] text-[#E38524]\" data-kid=\"1-2-3-1-2-1-1-1\">\n                                From the center\n                            </p>\n                            <h2 class=\"mt-2 font-display text-3xl font-extrabold tracking-[-.03em] text-[#006F9E]\" data-kid=\"1-2-3-1-2-1-1-2\">\n                                Latest updates\n                            </h2>\n                        </div>\n                        <a class=\"text-xs font-bold text-[#006F9E] underline underline-offset-4 hover:text-[#E38524]\" data-kid=\"1-2-3-1-2-1-2\" href=\"#resources\">\n                            View all\n                        </a>\n                    </div>\n                    <div class=\"divide-y divide-[#D6E4EA] border-y border-[#D6E4EA]\" data-kid=\"1-2-3-1-2-2\">\n                        <a class=\"flex gap-4 py-4\" data-kid=\"1-2-3-1-2-2-1\" href=\"#news-1\">\n                            <span class=\"w-20 shrink-0 text-xs font-semibold text-[#526274]\" data-kid=\"1-2-3-1-2-2-1-1\">\n                                18 Jun 2026\n                            </span>\n                            <span class=\"text-sm font-semibold leading-6 text-[#111827]\" data-kid=\"1-2-3-1-2-2-1-2\">\n                                DxValley opens applications for Batch 04 startup and MSME cohorts\n                            </span>\n                            <i class=\"fa-solid fa-arrow-up-right-from-square ml-auto mt-1 text-[12px] text-[#00ADEF]\" data-kid=\"1-2-3-1-2-2-1-3\">\n                            </i>\n                        </a>\n                        <a class=\"flex gap-4 py-4\" data-kid=\"1-2-3-1-2-2-2\" href=\"#news-2\">\n                            <span class=\"w-20 shrink-0 text-xs font-semibold text-[#526274]\" data-kid=\"1-2-3-1-2-2-2-1\">\n                                09 Jun 2026\n                            </span>\n                            <span class=\"text-sm font-semibold leading-6 text-[#111827]\" data-kid=\"1-2-3-1-2-2-2-2\">\n                                What a strong first customer looks like for an early-stage team\n                            </span>\n                            <i class=\"fa-solid fa-arrow-up-right-from-square ml-auto mt-1 text-[12px] text-[#00ADEF]\" data-kid=\"1-2-3-1-2-2-2-3\">\n                            </i>\n                        </a>\n                        <a class=\"flex gap-4 py-4\" data-kid=\"1-2-3-1-2-2-3\" href=\"#news-3\">\n                            <span class=\"w-20 shrink-0 text-xs font-semibold text-[#526274]\" data-kid=\"1-2-3-1-2-2-3-1\">\n                                28 May 2026\n                            </span>\n                            <span class=\"text-sm font-semibold leading-6 text-[#111827]\" data-kid=\"1-2-3-1-2-2-3-2\">\n                                Meet the mentors joining our next founder learning sprint\n                            </span>\n                            <i class=\"fa-solid fa-arrow-up-right-from-square ml-auto mt-1 text-[12px] text-[#00ADEF]\" data-kid=\"1-2-3-1-2-2-3-3\">\n                            </i>\n                        </a>\n                        <a class=\"flex gap-4 py-4\" data-kid=\"1-2-3-1-2-2-4\" href=\"#news-4\">\n                            <span class=\"w-20 shrink-0 text-xs font-semibold text-[#526274]\" data-kid=\"1-2-3-1-2-2-4-1\">\n                                16 May 2026\n                            </span>\n                            <span class=\"text-sm font-semibold leading-6 text-[#111827]\" data-kid=\"1-2-3-1-2-2-4-2\">\n                                Inside the validation room: turning interviews into better decisions\n                            </span>\n                            <i class=\"fa-solid fa-arrow-up-right-from-square ml-auto mt-1 text-[12px] text-[#00ADEF]\" data-kid=\"1-2-3-1-2-2-4-3\">\n                            </i>\n                        </a>\n                        <a class=\"flex gap-4 py-4\" data-kid=\"1-2-3-1-2-2-5\" href=\"#news-5\">\n                            <span class=\"w-20 shrink-0 text-xs font-semibold text-[#526274]\" data-kid=\"1-2-3-1-2-2-5-1\">\n                                02 May 2026\n                            </span>\n                            <span class=\"text-sm font-semibold leading-6 text-[#111827]\" data-kid=\"1-2-3-1-2-2-5-2\">\n                                A field guide to building for Ethiopia’s next million customers\n                            </span>\n                            <i class=\"fa-solid fa-arrow-up-right-from-square ml-auto mt-1 text-[12px] text-[#00ADEF]\" data-kid=\"1-2-3-1-2-2-5-3\">\n                            </i>\n                        </a>\n                        <a class=\"flex gap-4 py-4\" data-kid=\"1-2-3-1-2-2-6\" href=\"#news-6\">\n                            <span class=\"w-20 shrink-0 text-xs font-semibold text-[#526274]\" data-kid=\"1-2-3-1-2-2-6-1\">\n                                21 Apr 2026\n                            </span>\n                            <span class=\"text-sm font-semibold leading-6 text-[#111827]\" data-kid=\"1-2-3-1-2-2-6-2\">\n                                Founders, mentors, and partners gather for the DxValley community day\n                            </span>\n                            <i class=\"fa-solid fa-arrow-up-right-from-square ml-auto mt-1 text-[12px] text-[#00ADEF]\" data-kid=\"1-2-3-1-2-2-6-3\">\n                            </i>\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"bg-[#F6FAFC]\" data-kid=\"1-2-4\" id=\"programs\">\n            <div class=\"mx-auto max-w-7xl px-10 py-28\" data-kid=\"1-2-4-1\">\n                <div class=\"max-w-[700px]\" data-kid=\"1-2-4-1-1\">\n                    <p class=\"text-xs font-extrabold uppercase tracking-[.2em] text-[#E38524]\" data-kid=\"1-2-4-1-1-1\">\n                        Built around your stage\n                    </p>\n                    <h2 class=\"mt-4 font-display text-5xl font-extrabold tracking-[-.04em] text-[#006F9E]\" data-kid=\"1-2-4-1-1-2\">\n                        What we unlock\n                    </h2>\n                    <p class=\"mt-5 text-base leading-8 text-[#526274]\" data-kid=\"1-2-4-1-1-3\">\n                        A clearer path, better conversations, and practical support that compounds as your business grows.\n                    </p>\n                </div>\n                <div class=\"mt-14 divide-y divide-[#D6E4EA] border-y border-[#D6E4EA]\" data-kid=\"1-2-4-1-2\">\n                    <article class=\"grid grid-cols-[1.35fr_1fr_auto] items-center gap-8 py-9\" data-kid=\"1-2-4-1-2-1\">\n                        <div data-kid=\"1-2-4-1-2-1-1\">\n                            <p class=\"text-xs font-extrabold uppercase tracking-[.18em] text-[#006F9E]\" data-kid=\"1-2-4-1-2-1-1-1\">\n                                01 / Discover\n                            </p>\n                            <h3 class=\"mt-3 font-display text-2xl font-extrabold tracking-[-.03em] text-[#111827]\" data-kid=\"1-2-4-1-2-1-1-2\">\n                                Validate the idea\n                            </h3>\n                            <p class=\"mt-3 max-w-[560px] text-sm leading-7 text-[#526274]\" data-kid=\"1-2-4-1-2-1-1-3\">\n                                Turn a strong hunch into a tested opportunity with customer conversations, market framing, and a sharper problem worth solving.\n                            </p>\n                        </div>\n                        <div class=\"flex items-center gap-4\" data-kid=\"1-2-4-1-2-1-2\">\n                            <span class=\"h-3 w-3 rounded-full bg-[#E38524]\" data-kid=\"1-2-4-1-2-1-2-1\">\n                            </span>\n                            <span class=\"text-sm font-semibold text-[#526274]\" data-kid=\"1-2-4-1-2-1-2-2\">\n                                Idea → evidence\n                            </span>\n                        </div>\n                        <span class=\"rounded-full border border-[#00ADEF]/30 bg-[#EAF8FC] px-4 py-2 text-xs font-bold text-[#006F9E]\" data-kid=\"1-2-4-1-2-1-3\">\n                            Start with clarity\n                        </span>\n                    </article>\n                    <article class=\"grid grid-cols-[1.35fr_1fr_auto] items-center gap-8 py-9\" data-kid=\"1-2-4-1-2-2\">\n                        <div data-kid=\"1-2-4-1-2-2-1\">\n                            <p class=\"text-xs font-extrabold uppercase tracking-[.18em] text-[#006F9E]\" data-kid=\"1-2-4-1-2-2-1-1\">\n                                02 / Build\n                            </p>\n                            <h3 class=\"mt-3 font-display text-2xl font-extrabold tracking-[-.03em] text-[#111827]\" data-kid=\"1-2-4-1-2-2-1-2\">\n                                Build with experts\n                            </h3>\n                            <p class=\"mt-3 max-w-[560px] text-sm leading-7 text-[#526274]\" data-kid=\"1-2-4-1-2-2-1-3\">\n                                Work alongside mentors and peers to shape your MVP, strengthen the model, and make decisions with more confidence.\n                            </p>\n                        </div>\n                        <div class=\"flex items-center gap-4\" data-kid=\"1-2-4-1-2-2-2\">\n                            <span class=\"h-3 w-3 rounded-full bg-[#E38524]\" data-kid=\"1-2-4-1-2-2-2-1\">\n                            </span>\n                            <span class=\"text-sm font-semibold text-[#526274]\" data-kid=\"1-2-4-1-2-2-2-2\">\n                                MVP → traction\n                            </span>\n                        </div>\n                        <span class=\"rounded-full border border-[#00ADEF]/30 bg-[#EAF8FC] px-4 py-2 text-xs font-bold text-[#006F9E]\" data-kid=\"1-2-4-1-2-2-3\">\n                            Build with signal\n                        </span>\n                    </article>\n                    <article class=\"grid grid-cols-[1.35fr_1fr_auto] items-center gap-8 py-9\" data-kid=\"1-2-4-1-2-3\">\n                        <div data-kid=\"1-2-4-1-2-3-1\">\n                            <p class=\"text-xs font-extrabold uppercase tracking-[.18em] text-[#006F9E]\" data-kid=\"1-2-4-1-2-3-1-1\">\n                                03 / Scale\n                            </p>\n                            <h3 class=\"mt-3 font-display text-2xl font-extrabold tracking-[-.03em] text-[#111827]\" data-kid=\"1-2-4-1-2-3-1-2\">\n                                Grow with confidence\n                            </h3>\n                            <p class=\"mt-3 max-w-[560px] text-sm leading-7 text-[#526274]\" data-kid=\"1-2-4-1-2-3-1-3\">\n                                Prepare for the next chapter with accountable milestones, stronger partnerships, and a founder network that travels with you.\n                            </p>\n                        </div>\n                        <div class=\"flex items-center gap-4\" data-kid=\"1-2-4-1-2-3-2\">\n                            <span class=\"h-3 w-3 rounded-full bg-[#E38524]\" data-kid=\"1-2-4-1-2-3-2-1\">\n                            </span>\n                            <span class=\"text-sm font-semibold text-[#526274]\" data-kid=\"1-2-4-1-2-3-2-2\">\n                                Scale-Up → impact\n                            </span>\n                        </div>\n                        <span class=\"rounded-full border border-[#00ADEF]/30 bg-[#EAF8FC] px-4 py-2 text-xs font-bold text-[#006F9E]\" data-kid=\"1-2-4-1-2-3-3\">\n                            Keep momentum\n                        </span>\n                    </article>\n                </div>\n            </div>\n        </section>\n        <section class=\"bg-[#00ADEF] text-white\" data-kid=\"1-2-5\" id=\"how-it-works\">\n            <div class=\"mx-auto max-w-7xl px-10 py-28\" data-kid=\"1-2-5-1\">\n                <div class=\"flex items-end justify-between gap-6\" data-kid=\"1-2-5-1-1\">\n                    <div data-kid=\"1-2-5-1-1-1\">\n                        <p class=\"text-xs font-extrabold uppercase tracking-[.2em] text-white/70\" data-kid=\"1-2-5-1-1-1-1\">\n                            A focused progression\n                        </p>\n                        <h2 class=\"mt-4 max-w-[650px] font-display text-5xl font-extrabold tracking-[-.04em]\" data-kid=\"1-2-5-1-1-1-2\">\n                            Your path from idea to impact\n                        </h2>\n                    </div>\n                    <p class=\"max-w-[320px] text-sm leading-7 text-white/75\" data-kid=\"1-2-5-1-1-2\">\n                        Every cohort is designed to help you make the next useful decision — not just attend another program.\n                    </p>\n                </div>\n                <div class=\"relative mt-16 grid grid-cols-3 gap-6\" data-kid=\"1-2-5-1-2\">\n                    <div class=\"absolute left-[16.5%] right-[16.5%] top-7 h-px bg-white/40\" data-kid=\"1-2-5-1-2-1\">\n                    </div>\n                    <article class=\"relative\" data-kid=\"1-2-5-1-2-2\">\n                        <div class=\"relative z-10 grid h-14 w-14 place-items-center rounded-full bg-[#E38524] text-lg font-extrabold text-white ring-8 ring-[#00ADEF]\" data-kid=\"1-2-5-1-2-2-1\">\n                            01\n                        </div>\n                        <div class=\"mt-8 rounded-2xl bg-white p-6 text-[#111827] shadow-[0_14px_28px_rgba(0,67,103,.14)]\" data-kid=\"1-2-5-1-2-2-2\">\n                            <h3 class=\"font-display text-xl font-extrabold\" data-kid=\"1-2-5-1-2-2-2-1\">\n                                Apply\n                            </h3>\n                            <p class=\"mt-3 text-sm leading-7 text-[#526274]\" data-kid=\"1-2-5-1-2-2-2-2\">\n                                Tell us what you are building, who it serves, and what you need to learn next.\n                            </p>\n                        </div>\n                    </article>\n                    <article class=\"relative\" data-kid=\"1-2-5-1-2-3\">\n                        <div class=\"relative z-10 grid h-14 w-14 place-items-center rounded-full bg-[#E38524] text-lg font-extrabold text-white ring-8 ring-[#00ADEF]\" data-kid=\"1-2-5-1-2-3-1\">\n                            02\n                        </div>\n                        <div class=\"mt-8 rounded-2xl bg-white p-6 text-[#111827] shadow-[0_14px_28px_rgba(0,67,103,.14)]\" data-kid=\"1-2-5-1-2-3-2\">\n                            <h3 class=\"font-display text-xl font-extrabold\" data-kid=\"1-2-5-1-2-3-2-1\">\n                                Build\n                            </h3>\n                            <p class=\"mt-3 text-sm leading-7 text-[#526274]\" data-kid=\"1-2-5-1-2-3-2-2\">\n                                Move through the right learning sprint with mentors, workshops, and a peer cohort.\n                            </p>\n                        </div>\n                    </article>\n                    <article class=\"relative\" data-kid=\"1-2-5-1-2-4\">\n                        <div class=\"relative z-10 grid h-14 w-14 place-items-center rounded-full bg-[#E38524] text-lg font-extrabold text-white ring-8 ring-[#00ADEF]\" data-kid=\"1-2-5-1-2-4-1\">\n                            03\n                        </div>\n                        <div class=\"mt-8 rounded-2xl bg-white p-6 text-[#111827] shadow-[0_14px_28px_rgba(0,67,103,.14)]\" data-kid=\"1-2-5-1-2-4-2\">\n                            <h3 class=\"font-display text-xl font-extrabold\" data-kid=\"1-2-5-1-2-4-2-1\">\n                                Scale\n                            </h3>\n                            <p class=\"mt-3 text-sm leading-7 text-[#526274]\" data-kid=\"1-2-5-1-2-4-2-2\">\n                                Turn progress into proof, partnerships, and a stronger platform for sustainable growth.\n                            </p>\n                        </div>\n                    </article>\n                </div>\n            </div>\n        </section>\n        <section class=\"bg-white\" data-kid=\"1-2-6\" id=\"community\">\n            <div class=\"mx-auto grid max-w-7xl grid-cols-[1.45fr_.55fr] gap-24 px-10 py-28\" data-kid=\"1-2-6-1\">\n                <article class=\"overflow-hidden rounded-[26px] bg-[#F6FAFC]\" data-kid=\"1-2-6-1-1\" id=\"stories\">\n                    <div class=\"grid min-h-[350px] items-end bg-gradient-to-br from-[#EAF8FC] via-white to-[#FFF1E3] p-10\" data-kid=\"1-2-6-1-1-1\">\n                        <div class=\"max-w-[610px]\" data-kid=\"1-2-6-1-1-1-1\">\n                            <p class=\"text-xs font-extrabold uppercase tracking-[.2em] text-[#E38524]\" data-kid=\"1-2-6-1-1-1-1-1\">\n                                Inside the community\n                            </p>\n                            <h2 class=\"mt-4 font-display text-5xl font-extrabold leading-tight tracking-[-.04em] text-[#006F9E]\" data-kid=\"1-2-6-1-1-1-1-2\">\n                                Founders move further when they do the work together.\n                            </h2>\n                            <blockquote class=\"mt-7 border-l-2 border-[#E38524] pl-5 text-base italic leading-7 text-[#526274]\" data-kid=\"1-2-6-1-1-1-1-3\">\n                                “DxValley gave us the structure to test the right assumptions, and the people around us made every hard week feel less lonely.”\n                            </blockquote>\n                            <p class=\"mt-4 text-xs font-bold uppercase tracking-wider text-[#111827]\" data-kid=\"1-2-6-1-1-1-1-4\">\n                                — An incubatee, Batch 03\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"flex items-center justify-between border-t border-[#D6E4EA] bg-white px-10 py-5\" data-kid=\"1-2-6-1-1-2\">\n                        <p class=\"text-sm font-semibold text-[#526274]\" data-kid=\"1-2-6-1-1-2-1\">\n                            A place to learn, share, and keep building.\n                        </p>\n                        <a class=\"inline-flex items-center gap-2 text-sm font-bold text-[#006F9E] hover:text-[#E38524]\" data-kid=\"1-2-6-1-1-2-2\" href=\"#community\">\n                            See the community\n                            <i class=\"fa-solid fa-arrow-right text-[12px] text-current\" data-kid=\"1-2-6-1-1-2-2-1\">\n                            </i>\n                        </a>\n                    </div>\n                </article>\n                <aside class=\"pt-8\" data-kid=\"1-2-6-1-2\">\n                    <p class=\"text-xs font-extrabold uppercase tracking-[.2em] text-[#E38524]\" data-kid=\"1-2-6-1-2-1\">\n                        The ecosystem\n                    </p>\n                    <div class=\"mt-7 divide-y divide-[#D6E4EA] border-y border-[#D6E4EA]\" data-kid=\"1-2-6-1-2-2\">\n                        <div class=\"py-5\" data-kid=\"1-2-6-1-2-2-1\">\n                            <p class=\"font-display text-4xl font-extrabold tracking-[-.05em] text-[#006F9E]\" data-kid=\"1-2-6-1-2-2-1-1\">\n                                2\n                            </p>\n                            <p class=\"mt-1 text-sm font-semibold text-[#526274]\" data-kid=\"1-2-6-1-2-2-1-2\">\n                                cohorts each year\n                            </p>\n                        </div>\n                        <div class=\"py-5\" data-kid=\"1-2-6-1-2-2-2\">\n                            <p class=\"font-display text-4xl font-extrabold tracking-[-.05em] text-[#006F9E]\" data-kid=\"1-2-6-1-2-2-2-1\">\n                                4\n                            </p>\n                            <p class=\"mt-1 text-sm font-semibold text-[#526274]\" data-kid=\"1-2-6-1-2-2-2-2\">\n                                roles in the ecosystem\n                            </p>\n                        </div>\n                        <div class=\"py-5\" data-kid=\"1-2-6-1-2-2-3\">\n                            <p class=\"font-display text-4xl font-extrabold tracking-[-.05em] text-[#006F9E]\" data-kid=\"1-2-6-1-2-2-3-1\">\n                                1\n                            </p>\n                            <p class=\"mt-1 text-sm font-semibold text-[#526274]\" data-kid=\"1-2-6-1-2-2-3-2\">\n                                founder network\n                            </p>\n                        </div>\n                    </div>\n                </aside>\n            </div>\n        </section>\n        <section class=\"bg-[#EAF8FC]\" data-kid=\"1-2-7\" id=\"apply\">\n            <div class=\"mx-auto flex max-w-7xl items-center justify-between gap-8 px-10 py-20\" data-kid=\"1-2-7-1\">\n                <div data-kid=\"1-2-7-1-1\">\n                    <p class=\"text-xs font-extrabold uppercase tracking-[.2em] text-[#E38524]\" data-kid=\"1-2-7-1-1-1\">\n                        Your next chapter starts here\n                    </p>\n                    <h2 class=\"mt-3 max-w-[720px] font-display text-5xl font-extrabold tracking-[-.04em] text-[#006F9E]\" data-kid=\"1-2-7-1-1-2\">\n                        Ready to turn your idea into impact?\n                    </h2>\n                    <p class=\"mt-4 text-base text-[#526274]\" data-kid=\"1-2-7-1-1-3\">\n                        Applications are reviewed in cohorts. Bring the problem, the curiosity, and the courage to begin.\n                    </p>\n                </div>\n                <a class=\"inline-flex shrink-0 items-center gap-3 rounded-md bg-[#E38524] px-7 py-4 text-sm font-extrabold text-white shadow-sm hover:bg-[#C97019]\" data-kid=\"1-2-7-1-2\" href=\"#signup\">\n                    Start your application\n                    <i class=\"fa-solid fa-arrow-right text-[12px] text-white\" data-kid=\"1-2-7-1-2-1\">\n                    </i>\n                </a>\n            </div>\n        </section>\n    </main>\n    <footer class=\"bg-[#00ADEF] text-white\" data-kid=\"1-3\" id=\"resources\">\n        <div class=\"mx-auto max-w-7xl px-10 py-20\" data-kid=\"1-3-1\">\n            <div class=\"grid grid-cols-[1.35fr_.75fr_.75fr_1fr] gap-10\" data-kid=\"1-3-1-1\">\n                <div data-kid=\"1-3-1-1-1\">\n                    <img alt=\"DxValley Incubation Center\" class=\"h-14 w-[230px] object-contain object-left mix-blend-multiply\" data-kid=\"1-3-1-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/Website/public/brand/dxvalley-wordmark.jpeg\"/>\n                    <p class=\"mt-5 max-w-[290px] text-sm leading-7 text-white/80\" data-kid=\"1-3-1-1-1-2\">\n                        A practical incubation center for Ethiopia’s ambitious founders, powered by community and accountable progress.\n                    </p>\n                    <div class=\"mt-7 flex items-center gap-2\" data-kid=\"1-3-1-1-1-3\">\n                        <a aria-label=\"LinkedIn\" class=\"grid h-8 w-8 place-items-center rounded-full border border-white/50 hover:bg-white hover:text-[#00ADEF]\" data-kid=\"1-3-1-1-1-3-1\" href=\"#linkedin\">\n                            <i class=\"fa-brands fa-linkedin-in text-[14px] text-current\" data-kid=\"1-3-1-1-1-3-1-1\">\n                            </i>\n                        </a>\n                        <a aria-label=\"YouTube\" class=\"grid h-8 w-8 place-items-center rounded-full border border-white/50 hover:bg-white hover:text-[#00ADEF]\" data-kid=\"1-3-1-1-1-3-2\" href=\"#youtube\">\n                            <i class=\"fa-brands fa-youtube text-[14px] text-current\" data-kid=\"1-3-1-1-1-3-2-1\">\n                            </i>\n                        </a>\n                        <a aria-label=\"Instagram\" class=\"grid h-8 w-8 place-items-center rounded-full border border-white/50 hover:bg-white hover:text-[#00ADEF]\" data-kid=\"1-3-1-1-1-3-3\" href=\"#instagram\">\n                            <i class=\"fa-brands fa-instagram text-[14px] text-current\" data-kid=\"1-3-1-1-1-3-3-1\">\n                            </i>\n                        </a>\n                    </div>\n                </div>\n                <div data-kid=\"1-3-1-1-2\">\n                    <h2 class=\"text-sm font-extrabold uppercase tracking-[.16em]\" data-kid=\"1-3-1-1-2-1\">\n                        Platform\n                    </h2>\n                    <nav class=\"mt-5 flex flex-col gap-3 text-sm text-white/80\" data-kid=\"1-3-1-1-2-2\">\n                        <a class=\"hover:text-white hover:underline\" data-kid=\"1-3-1-1-2-2-1\" href=\"#programs\">\n                            Programs\n                        </a>\n                        <a class=\"hover:text-white hover:underline\" data-kid=\"1-3-1-1-2-2-2\" href=\"#mentors\">\n                            Mentors\n                        </a>\n                        <a class=\"hover:text-white hover:underline\" data-kid=\"1-3-1-1-2-2-3\" href=\"#events\">\n                            Workshops\n                        </a>\n                        <a class=\"hover:text-white hover:underline\" data-kid=\"1-3-1-1-2-2-4\" href=\"#search\">\n                            Project search\n                        </a>\n                    </nav>\n                </div>\n                <div data-kid=\"1-3-1-1-3\">\n                    <h2 class=\"text-sm font-extrabold uppercase tracking-[.16em]\" data-kid=\"1-3-1-1-3-1\">\n                        Resources\n                    </h2>\n                    <nav class=\"mt-5 flex flex-col gap-3 text-sm text-white/80\" data-kid=\"1-3-1-1-3-2\">\n                        <a class=\"hover:text-white hover:underline\" data-kid=\"1-3-1-1-3-2-1\" href=\"#announcements\">\n                            Announcements\n                        </a>\n                        <a class=\"hover:text-white hover:underline\" data-kid=\"1-3-1-1-3-2-2\" href=\"#gallery\">\n                            Gallery\n                        </a>\n                        <a class=\"hover:text-white hover:underline\" data-kid=\"1-3-1-1-3-2-3\" href=\"#terms\">\n                            Terms & conditions\n                        </a>\n                        <a class=\"hover:text-white hover:underline\" data-kid=\"1-3-1-1-3-2-4\" href=\"mailto:hello@dxvalley.com\">\n                            Contact\n                        </a>\n                    </nav>\n                </div>\n                <div data-kid=\"1-3-1-1-4\" id=\"partners\">\n                    <h2 class=\"text-sm font-extrabold uppercase tracking-[.16em]\" data-kid=\"1-3-1-1-4-1\">\n                        Partner\n                    </h2>\n                    <img alt=\"Cooperative Bank of Oromia\" class=\"mt-5 h-16 w-[210px] rounded bg-white object-contain object-left p-2\" data-kid=\"1-3-1-1-4-2\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/Website/public/brand/coopbank-wordmark.jpeg\"/>\n                    <p class=\"mt-3 text-xs leading-5 text-white/75\" data-kid=\"1-3-1-1-4-3\">\n                        Cooperative Bank of Oromia\n                        <br data-kid=\"1-3-1-1-4-3-1\"/>\n                        Incubation arm partner\n                    </p>\n                </div>\n            </div>\n            <div class=\"mt-14 grid grid-cols-[1fr_auto] items-end gap-8 border-t border-white/25 pt-8\" data-kid=\"1-3-1-2\">\n                <div data-kid=\"1-3-1-2-1\">\n                    <label class=\"text-sm font-bold\" data-kid=\"1-3-1-2-1-1\" for=\"newsletter\">\n                        Stay close to the next cohort\n                    </label>\n                    <div class=\"mt-3 flex max-w-[430px]\" data-kid=\"1-3-1-2-1-2\">\n                        <input class=\"min-w-0 flex-1 rounded-l-md bg-white px-4 py-3 text-sm text-[#111827] outline-none placeholder:text-slate-400\" data-kid=\"1-3-1-2-1-2-1\" id=\"newsletter\" name=\"email\" placeholder=\"Your email address\" type=\"email\"/>\n                        <button class=\"rounded-r-md bg-[#E38524] px-5 py-3 text-sm font-bold text-white hover:bg-[#C97019]\" data-kid=\"1-3-1-2-1-2-2\" type=\"button\">\n                            Subscribe\n                        </button>\n                    </div>\n                </div>\n                <p class=\"text-xs text-white/75\" data-kid=\"1-3-1-2-2\">\n                    © 2026 DxValley Incubation Center. All rights reserved.\n                </p>\n            </div>\n        </div>\n        <div class=\"bg-[#006F9E]\" data-kid=\"1-3-2\">\n            <div class=\"mx-auto flex max-w-7xl items-center justify-between px-10 py-4 text-[11px] text-white/75\" data-kid=\"1-3-2-1\">\n                <span data-kid=\"1-3-2-1-1\">\n                    Built for founders with momentum.\n                </span>\n                <span data-kid=\"1-3-2-1-2\">\n                    Cooperative Bank of Oromia × DxValley\n                </span>\n            </div>\n        </div>\n    </footer>\n</div>\n",
